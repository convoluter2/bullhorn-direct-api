LinesAsObject);\\n                                    version.placementRateCardLineGroups.data.forEach(function (placementRateCardLineGroup) {\\n                                        existingLineGroups.push(placementRateCardLineGroup.earnCodeGroup.id);\\n                                        if (placementRateCardLineGroupsAsObject[placementRateCardLineGroup.earnCodeGroup.id]) {\\n                                            console.log(\\\"OUR GROUP EXISITS GROUP\\\");\\n                                            placementRateCardLineGroup.placementRateCardLines.data.forEach(function (placementRateCardLine) {\\n                                                var newItemData = placementRateCardLinesAsObject[placementRateCardLine.earnCode.id];\\n                                                placementRateCardLine.alias = newItemData.alias;\\n                                                placementRateCardLine.payRate = newItemData.payRate;\\n                                                placementRateCardLine.billRate = newItemData.billRate;\\n                                                placementRateCardLine.customFloat1 = newItemData.customFloat1;\\n                                            });\\n                                            console.log(\\\"placementRateCardLineGroup.id\\\", placementRateCardLineGroup.id);\\n                                            updatedVersion.placementRateCardLineGroups.push({\\n                                                id: placementRateCardLineGroup.id,\\n                                                earnCodeGroup: { id: placementRateCardLineGroup.earnCodeGroup.id },\\n                                                isBase: placementRateCardLineGroup.isBase,\\n                                                placementRateCardLines: placementRateCardLineGroup.placementRateCardLines.data.map(function (item) {\\n                                                    return {\\n                                                        alias: item.alias,\\n                                                        billRate: item.billRate,\\n                                                        earnCode: { id: item.earnCode.id },\\n                                                        id: item.id,\\n                                                        payRate: item.payRate,\\n                                                        customFloat1: item.customFloat1\\n                                                    };\\n                                                }),\\n                                            });\\n                                        }\\n                                        else {\\n                                            console.log(\\\"GROUP DOESNT USED FOR DS\\\");\\n                                            updatedVersion.placementRateCardLineGroups.push({\\n                                                id: placementRateCardLineGroup.id,\\n                                                earnCodeGroup: { id: placementRateCardLineGroup.earnCodeGroup.id },\\n                                                isBase: placementRateCardLineGroup.isBase,\\n                                                placementRateCardLines: placementRateCardLineGroup.placementRateCardLines.data.map(function (item) {\\n                                                    return {\\n                                                        alias: item.alias,\\n                                                        billMultiplier: item.billMultiplier,\\n                                                        billRate: item.billRate,\\n                                                        earnCode: { id: item.earnCode.id },\\n                                                        id: item.id,\\n                                                        markupPercent: item.markupPercent,\\n                                                        markupValue: item.markupValue,\\n                                                        payMultiplier: item.payMultiplier,\\n                                                        payRate: item.payRate,\\n                                                        customFloat1: item.customFloat1\\n                                                    };\\n                                                }),\\n                                            });\\n                                        }\\n                                    });\\n                                    var newGroups = placementRateCardLineGroups.filter(function (item) { return existingLineGroups.indexOf(item.earnCodeGroup.id) === -1; });\\n                                    updatedVersion.placementRateCardLineGroups = updatedVersion.placementRateCardLineGroups.concat(newGroups);\\n                                    updatedVersion.placementRateCardLineGroups = updatedVersion.placementRateCardLineGroups.filter(function (item) { return !earnCodesToBeRemoved[item.earnCodeGroup.id]; });\\n                                    controller.updateExisitngPlacementRateCard(updatedVersion, existingPlacementRateCard[0].id).then(function () {\\n                                        console.log(\\\"Newbury copy DS to placement: saving rates done\\\");\\n                                        resolve();\\n                                    });\\n                                });\\n                            }\\n                            else {\\n                                console.log(\\\"INSERTING NEW VERSION\\\");\\n                                controller.insertNewVersion(rateObject, existingPlacementRateCard[0].id).then(function () {\\n                                    console.log(\\\"Newbury copy DS to placement: saving rates done\\\");\\n                                    resolve();\\n                                });\\n                            }\\n                        }\\n                        else {\\n                            console.log(\\\"add NEW RECORD\\\");\\n                            controller.saveRateBH1(rateObject).then(function () {\\n                                console.log(\\\"Newbury copy DS to placement: saving rates done\\\");\\n                                resolve();\\n                            });\\n                        }\\n                    });\\n                    // controller.saveRateBH1(rateObject).then(function(){\\n                    //     console.log(\\\"Newbury copy DS to placement: saving rates done\\\")\\n                    //     resolve()\\n                    // })\\n                });\\n            },\\n            getHighLevelSettings: function () {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/highLevelSettings/highLevelSettings/read?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    fetch(url, {\\n                        method: 'get',\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: highLevelSettings', data);\\n                        resolve(data);\\n                    });\\n                });\\n            },\\n            getPlacementRateCardStatus: function () {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"query/PlacementRateCardStatusLookup?where=id>0\\\" + \\\"&fields=id,label&count=500\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        if (API.appBridge)\\n                            resolve(result.data.data);\\n                        else\\n                            resolve(result.data);\\n                    });\\n                });\\n            },\\n            copyDealsheetDataToPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    controller.getPlacement(id).then(function (placement) {\\n                        console.log(\\\"Newbury copy DS to placement: placement Object\\\", placement);\\n                        if (placement[controller.dealsheetPathAtPlacement] && placement[controller.dealsheetPathAtPlacement].length) {\\n                            Promise.all([\\n                                controller.getJob(placement.jobOrder.id),\\n                                controller.getDealsheet(placement[controller.dealsheetPathAtPlacement]),\\n                                controller.getHealthBenefitsRecords(),\\n                                controller.getEarnCodes(),\\n                                controller.getHighLevelSettings(),\\n                                controller.getPlacementRateCardStatus(),\\n                                controller.getBillingTerm(placement.jobOrder.billingProfile.id)\\n                            ]).then(function (data) {\\n                                console.log(\\\"Newbury copy DS to placement: data\\\", data);\\n                                var job = data[0];\\n                                var dealsheet = data[1];\\n                                var healthBenefits = data[2];\\n                                var earnCodes = data[3];\\n                                var highLevelSettings = data[4];\\n                                var placementStatus = data[5];\\n                                var billingTerm = data[6];\\n                                var placementRateCardStatus = placementStatus.find(function (item) { return item.label === \\\"Active\\\"; });\\n                                var customText9;\\n                                console.log(\\\"placementRateCardStatus\\\", placementRateCardStatus);\\n                                var overTimePayRate, doubleTimeRate;\\n                                var advancedOtStatesIndex = highLevelSettings.findIndex(function (item) { return item.role === \\\"Advanced OT Rates Apply\\\"; });\\n                                var advancedStates = highLevelSettings[advancedOtStatesIndex];\\n                                advancedStates = advancedStates.field.split(\\\",\\\");\\n                                var advancedStateIndex = advancedStates.indexOf(dealsheet.DealSheetJob.jobState);\\n                                var billableOT = dealsheet.DealSheetClient.billableOT || \\\"\\\";\\n                                billableOT = billableOT.split(\\\" \\\")[1];\\n                                billableOT = billableOT === \\\"36\\\" ? \\\"3640\\\" : billableOT;\\n                                // if(dealsheet.DealSheetJob.division != \\\"Fastaff\\\"){\\n                                //   billableOT = \\\"40\\\"\\n                                // }\\n                                overTimePayRate = advancedStateIndex > -1 ? Number(dealsheet.payRate8) || 0 : Number(dealsheet[\\\"payRate\\\" + billableOT]) || 0;\\n                                doubleTimeRate = advancedStateIndex > -1 ? Number(dealsheet.payRate12) || 0 : 0;\\n                                if (dealsheet.DealSheetJob.jobState === \\\"Colorado\\\") {\\n                                    overTimePayRate = dealsheet.payRate12;\\n                                    doubleTimeRate = 0;\\n                                }\\n                                if (dealsheet.DealSheetJob.jobState === \\\"Alaska\\\") {\\n                                    doubleTimeRate = 0;\\n                                }\\n                                // if(dealsheet.DealSheetJob.division === \\\"Fastaff\\\" && advancedStateIndex === -1){\\n                                //   doubleTimeRate = 2 * dealsheet.regularPay\\n                                // }\\n                                if (dealsheet.taxedPerDiem) {\\n                                    customText9 = \\\"36 Hour Weekly Bonus\\\";\\n                                }\\n                                else if (placement.employmentType !== \\\"PRN\\\") {\\n                                    if (+dealsheet.DealSheetJob.shifts === 3) {\\n                                        customText9 = \\\"3 Scheduled Shifts per Week\\\";\\n                                    }\\n                                    else if (+dealsheet.DealSheetJob.shifts === 4) {\\n                                        customText9 = \\\"4 Scheduled Shifts per Week\\\";\\n                                    }\\n                                    else if (+dealsheet.DealSheetJob.shifts === 5) {\\n                                        customText9 = \\\"5 Scheduled Shifts per Week\\\";\\n                                    }\\n                                }\\n                                else {\\n                                    customText9 = \\\"PRN Days Worked\\\";\\n                                }\\n                                dealsheet.benefits = dealsheet.benefits && dealsheet.benefits.length ? dealsheet.benefits.split(\\\",\\\") : [];\\n                                var selectedBenefits = healthBenefits.filter(function (item) {\\n                                    return dealsheet.benefits.indexOf(item.fieldId.toString()) > -1;\\n                                });\\n                                console.log(\\\"Newbury copy DS to placement: selectedBenefits\\\", selectedBenefits);\\n                                var body = {\\n                                    dateBegin: new Date(dealsheet.DealSheetCandidate.startDate).setHours(12),\\n                                    dateEnd: new Date(dealsheet.DealSheetCandidate.endDate).setHours(12),\\n                                    durationWeeks: dealsheet.DealSheetJob.contractLengthWeeks,\\n                                    correlatedCustomInt1: parseInt(dealsheet.DealSheetJob.shifts),\\n                                    clientBillRate: dealsheet.DealSheetJob.billRate,\\n                                    customInt2: parseInt(dealsheet.DealSheetClient.nonBillableOrientationHours),\\n                                    customFloat1: dealsheet.DealSheetClient.vmsFeePercentage,\\n                                    customTextBlock3: dealsheet.DealSheetClient.cancellationPolicy,\\n                                    customTextBlock4: dealsheet.DealSheetClient.exhibiteAndRiderNotes,\\n                                    customInt1: parseInt(dealsheet.DealSheetJob.guaranteedScheduledHours),\\n                                    customText13: dealsheet.DealSheetCandidate.approvedTimeOff,\\n                                };\\n                                if (customText9) {\\n                                    body.customText9 = customText9;\\n                                }\\n                                if (API.globals.user.stopUpdatingStartAndEndDate) {\\n                                    delete body.dateBegin;\\n                                    delete body.dateEnd;\\n                                    delete body.customText9;\\n                                }\\n                                controller.updatePlacement(id, body).then(function (result) {\\n                                    console.log(\\\"Newbury copy DS to placement: save placement result\\\", result);\\n                                    // controller.addRateObjects(dealsheet,placement).then(function(result2){\\n                                    controller.buildRateObjectBH1(dealsheet, earnCodes, placement, overTimePayRate, doubleTimeRate, placementRateCardStatus, advancedStateIndex, billingTerm).then(function (result3) {\\n                                        resolve();\\n                                    });\\n                                    // })\\n                                });\\n                            });\\n                        }\\n                        else {\\n                            resolve();\\n                        }\\n                    });\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            console.log(\\\"Newbury copy DS to placement: API\\\", API);\\n            console.log(\\\"Newbury copy DS to placement: form\\\", form);\\n            var data;\\n            if (Array.isArray(form.data[0].data))\\n                data = form.data[0].data[0];\\n            else if (Array.isArray(form.data[0]))\\n                data = form.data[0];\\n            else\\n                data = form.data[1].data[0];\\n            var placementId = data.filter(function (item) { return item.changedEntityType === \\\"Placement\\\"; })[0].changedEntityId;\\n            console.log(\\\"Newbury copy DS to placement: placementId\\\", placementId);\\n            if (placementId) {\\n                return controller.copyDealsheetDataToPlacement(placementId);\\n            }\\n        }\\n        else {\\n            return;\\n        }\",\"sortOrder\":10,\"dateLastModified\":1776673794427},{\"id\":2407,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zweli\",\"lastName\":\"Mphanza\"},\"name\":\"fill-portal-uploader-copy-with-portal-uploader-value-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            portalUploaderField: 'customText1',\\n            portalUploaderFieldCopy: 'customTextBlock7',\\n            init: () => {\\n                console.log('fill-portal-uploader-copy-with-portal-uploader-value');\\n                if (form.data\\n                    && form.data.customText1) {\\n                    form.data[app.portalUploaderFieldCopy] = form.data.customText1;\\n                    return form;\\n                }\\n                return form;\\n            },\\n        };\\n        if (API.currentEntity === 'PlacementCertification') {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":20,\"dateLastModified\":1763074245530},{\"id\":2408,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zweli\",\"lastName\":\"Mphanza\"},\"name\":\"1218G- Candidate validations on placement Approval\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\r\\n            placementId: API.currentEntityId,\\r\\n            statusToCheck: 'Approved',\\r\\n            errorMessage: '',\\r\\n            addressFieldsToCheck: [\\r\\n                {\\r\\n                    field: 'address1',\\r\\n                    label: 'address',\\r\\n                },\\r\\n                {\\r\\n                    field: 'city',\\r\\n                    label: 'city',\\r\\n                },\\r\\n                {\\r\\n                    field: 'state',\\r\\n                    label: 'state',\\r\\n                },\\r\\n                {\\r\\n                    field: 'zip',\\r\\n                    label: 'zip',\\r\\n                },\\r\\n                {\\r\\n                    field: 'countryID',\\r\\n                    label: 'Country',\\r\\n                },\\r\\n            ],\\r\\n            candidateFieldsToCheck: [\\r\\n                'ssn',\\r\\n                'dateOfBirth',\\r\\n                'address(address1,city,state,zip,countryID)',\\r\\n            ],\\r\\n            // Checks if we should run validations\\r\\n            shouldValidationsRun() {\\r\\n                const selectedStatus = form.controls.status.value;\\r\\n                return app.statusToCheck === selectedStatus;\\r\\n            },\\r\\n            getCandidateDetails() {\\r\\n                const url = `${API.http.restURL}/query/Placement?where=id=${app.placementId}&fields=candidate(${app.candidateFieldsToCheck.join(',')})`;\\r\\n                return API.http.get(url).toPromise().then((result) => {\\r\\n                    if (result.data[0].candidate) {\\r\\n                        return Promise.resolve(result.data[0].candidate);\\r\\n                    }\\r\\n                    return Promise.reject(new Error('Cannot get Candidate to run validations on Approval'));\\r\\n                }, (err) => {\\r\\n                    console.error(err);\\r\\n                    return Promise.reject(err);\\r\\n                });\\r\\n            },\\r\\n            runAddressValidation(candidate) {\\r\\n                app.addressFieldsToCheck.forEach((field) => {\\r\\n                    if (candidate.address[field.field] === undefined || candidate.address[field.field] === null || candidate.address[field.field] === '') {\\r\\n                        app.errorMessage += `Please update Candidate ${field.label}.\\\\n`;\\r\\n                    }\\r\\n                });\\r\\n            },\\r\\n            // Run the validations\\r\\n            validate() {\\r\\n                return new Promise((resolve, reject) => {\\r\\n                    return app.getCandidateDetails()\\r\\n                        .then((candidate) => {\\r\\n                        app.candidateFieldsToCheck.forEach((field) => {\\r\\n                            if (field.indexOf('address') === 0) {\\r\\n                                app.runAddressValidation(candidate);\\r\\n                            }\\r\\n                            else if (candidate[field] === undefined || candidate[field] === null || candidate[field] === '') {\\r\\n                                app.errorMessage += `Please update Candidate ${field}.\\\\n`;\\r\\n                            }\\r\\n                        });\\r\\n                        if (app.errorMessage) {\\r\\n                            form.isFormValid = false;\\r\\n                            API.displayToast({\\r\\n                                title: 'Candidate validations on Placement Approval',\\r\\n                                icon: 'caution',\\r\\n                                theme: 'danger',\\r\\n                                position: 'fixedTop',\\r\\n                                hideDelay: 8000,\\r\\n                                message: app.errorMessage,\\r\\n                            });\\r\\n                            form.errorMessage = `CANDIDATE VALIDATIONS ON PLACEMENT APPROVAL\\\\n${app.errorMessage}`;\\r\\n                        }\\r\\n                        return resolve(form.errorMessage);\\r\\n                    })\\r\\n                        .catch((reason) => {\\r\\n                        return reject(reason);\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Placement' && app.shouldValidationsRun() && form.isFormValid === true) {\\r\\n            return app.validate();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":20,\"dateLastModified\":1767733451847},{\"id\":2397,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zweli\",\"lastName\":\"Mphanza\"},\"name\":\"limit-status-change-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            allowedUserTypes: new Set([\\n                '149908',\\n                '206100',\\n                '206101',\\n                '206099',\\n                '206102',\\n                '149895',\\n            ]),\\n            init: () => {\\n                const status = form.controls.status.value;\\n                if (status === 'Agency Cleared' || status === 'Client Approved') {\\n                    const isEditable = app.allowedUserTypes.has(API.globals.user.userTypeId.toString());\\n                    if (!isEditable && app.hasFieldChanged('status')) {\\n                        form.errorMessage = `Only Credentialing user type is allowed to change the status to ${status}`;\\n                        form.isFormValid = false;\\n                        return form;\\n                    }\\n                }\\n                return form;\\n            },\\n            hasFieldChanged: (field) => {\\n                if (!form.controls[field]) {\\n                    return false;\\n                }\\n                const control = form.controls[field];\\n                return (!control.pristine)\\n                    && (control.valueHistory.length > 1\\n                        && control.valueHistory[0] !== control.valueHistory[control.valueHistory.length - 1]);\\n            },\\n        };\\n        return app.init();\",\"sortOrder\":20,\"dateLastModified\":1755850806993},{\"id\":1828,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2256,\"firstName\":\"Leonardo\",\"lastName\":\"Salatino\"},\"name\":\"1218G. End Date validations\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            TERM_REASONS_ON_END_DATE: [\\r\\n                'Post-Start Candidate Leave Early',\\r\\n                'Post-Start Company Early End',\\r\\n                'Post-Start Company Termination-Clinical',\\r\\n                'Post-Start Company Termination-Prof',\\r\\n                'Post-Start Completed Assignment',\\r\\n                'Post-Start Ingenovis Moved to a New Order',\\r\\n                'Post-Start Insufficient Test Scores',\\r\\n                'Post-Start Missing/Expired Documents',\\r\\n                'Post-Start Traveler No Show',\\r\\n                'Post-Start Violation of Company Policy',\\r\\n                'Post-Start Worker\\\\'s Comp Injury/Illness',\\r\\n            ],\\r\\n            validatePlacement: function () {\\r\\n                return new Promise(function (resolve) {\\r\\n                    var termReason = form.controls.terminationReason;\\r\\n                    var dateEnd = form.controls.dateEnd;\\r\\n                    var status = form.controls.status;\\r\\n                    var dateBegin = form.controls.dateBegin;\\r\\n                    var assignedRecruiter = form.controls.customText43;\\r\\n                    // Actual End Date must be changed if any of the Termination End Reasons\\r\\n                    if (termReason) {\\r\\n                        if (termReason.value !== null && termReason.value !== undefined\\r\\n                            && termReason.value !== termReason.initialValue) {\\r\\n                            if (app.TERM_REASONS_ON_END_DATE.includes(termReason.value)\\r\\n                                && dateEnd.value === dateEnd.initialValue) {\\r\\n                                form.errorMessage = dateEnd.label + \\\" must be changed when this \\\" + termReason.label + \\\" is selected\\\";\\r\\n                            }\\r\\n                        }\\r\\n                    }\\r\\n                    // Placement is changed from Ended to any, Actual End Date must be changed to an End Date in the future\\r\\n                    if (status.value !== status.initialValue\\r\\n                        && status.initialValue === 'Ended') {\\r\\n                        if (dateEnd.value <= dateEnd.initialValue) {\\r\\n                            form.errorMessage = dateEnd.label + \\\" must be changed to a future date when Placement stops being Ended\\\";\\r\\n                        }\\r\\n                    }\\r\\n                    // Start Date cannot be grater or equal to End Date\\r\\n                    if (dateEnd.value <= dateBegin.value) {\\r\\n                        form.errorMessage = dateBegin.label + \\\" cannot be grater or equal to \\\" + dateEnd.label;\\r\\n                    }\\r\\n                    // Assigned Recruiter must contain the character \\\"|\\\"\\r\\n                    if (assignedRecruiter.value !== null && assignedRecruiter.value !== undefined && !assignedRecruiter.value.includes('|')) {\\r\\n                        form.errorMessage = assignedRecruiter.label + \\\" must contain the character \\\\\\\"|\\\\\\\"\\\";\\r\\n                    }\\r\\n                    if (form.errorMessage) {\\r\\n                        form.isFormValid = false;\\r\\n                    }\\r\\n                    return resolve(form.errorMessage);\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Placement' && form.isFormValid === true) {\\r\\n            return app.validatePlacement();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":20,\"dateLastModified\":1707746913433},{\"id\":2361,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2256,\"firstName\":\"Leonardo\",\"lastName\":\"Salatino\"},\"name\":\"1218G-Candidate Actions on Approved\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            FLD_MATCH_ELIG_DT: 'customDate6',\\r\\n            FLD_ORIGINAL_HIRE_DT: 'customDate7',\\r\\n            init: function () {\\r\\n                return new Promise(function (resolve) {\\r\\n                    var status = form.controls.status;\\r\\n                    if (status.valueHistory) {\\r\\n                        if (status.value !== status.valueHistory[0] && status.value === 'Approved') {\\r\\n                            return app.getCandidate(API.currentEntityId).then(function (placement) {\\r\\n                                if (placement.candidate) {\\r\\n                                    if (placement.candidate.id) {\\r\\n                                        if (placement.candidate[app.FLD_MATCH_ELIG_DT] === null || placement.candidate[app.FLD_MATCH_ELIG_DT] === undefined) {\\r\\n                                            var matchEligDate = void 0;\\r\\n                                            if (placement.candidate[app.FLD_ORIGINAL_HIRE_DT] === null || placement.candidate[app.FLD_ORIGINAL_HIRE_DT] === undefined) {\\r\\n                                                matchEligDate = new Date(form.controls.dateBegin.value);\\r\\n                                            }\\r\\n                                            else {\\r\\n                                                matchEligDate = new Date(placement.candidate[app.FLD_ORIGINAL_HIRE_DT]);\\r\\n                                            }\\r\\n                                            var monthsToAdd = matchEligDate.getDate() === 1 ? 0 : 1;\\r\\n                                            matchEligDate.setFullYear(matchEligDate.getFullYear() + 1, matchEligDate.getMonth() + monthsToAdd, 1);\\r\\n                                            matchEligDate.setHours(12);\\r\\n                                            return app.setCandidateMatchEligibleDate(placement.candidate.id, matchEligDate.getTime()).then(function () {\\r\\n                                                return resolve(null);\\r\\n                                            });\\r\\n                                        }\\r\\n                                    }\\r\\n                                    else {\\r\\n                                        console.error('Candidate Actions on Approved: Cannot get Candidate ID');\\r\\n                                    }\\r\\n                                }\\r\\n                                else {\\r\\n                                    console.error('Candidate Actions on Approved: Cannot get Candidate');\\r\\n                                }\\r\\n                                return resolve(null);\\r\\n                            });\\r\\n                        }\\r\\n                    }\\r\\n                    return resolve(null);\\r\\n                });\\r\\n            },\\r\\n            getCandidate: function (placementId) {\\r\\n                var url = app.baseUrl + \\\"/entity/Placement/\\\" + placementId + \\\"?fields=candidate(id,\\\" + app.FLD_MATCH_ELIG_DT + \\\",\\\" + app.FLD_ORIGINAL_HIRE_DT + \\\")\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data);\\r\\n                }, function (err) {\\r\\n                    console.error(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n            setCandidateMatchEligibleDate: function (candId, eligDate) {\\r\\n                var _a;\\r\\n                var url = app.baseUrl + \\\"/entity/Candidate/\\\" + candId;\\r\\n                return API.http.post(url, (_a = {},\\r\\n                    _a[app.FLD_MATCH_ELIG_DT] = eligDate,\\r\\n                    _a)).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result);\\r\\n                }, function (err) {\\r\\n                    console.error(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Placement') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":30,\"dateLastModified\":1738155536647},{\"id\":1836,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2256,\"firstName\":\"Leonardo\",\"lastName\":\"Salatino\"},\"name\":\"59-update-customDate2-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                return new Promise(function (resolve, reject) {\\r\\n                    // +  Leonardo Ariel Salatino - 23-06-30 - Support #153\\r\\n                    var JobSubmissionId = API.currentEntityId;\\r\\n                    var Status = form.data.status;\\r\\n                    // Get data in different way for: Page Context = MoveToClientSubmission\\r\\n                    if (JobSubmissionId === undefined || JobSubmissionId === null || JobSubmissionId === '') {\\r\\n                        if (API.pageContext['selected']) {\\r\\n                            JobSubmissionId = API.pageContext['selected'][0].id;\\r\\n                        }\\r\\n                    }\\r\\n                    if (Status === undefined || Status === null || Status === '') {\\r\\n                        if (API.pageContext['selected']) {\\r\\n                            Status = API.pageContext['selected'][0].status;\\r\\n                        }\\r\\n                    }\\r\\n                    if (API.pageContext === 'MoveToClientSubmission') {\\r\\n                        Status = 'DoChangeMeNow';\\r\\n                    }\\r\\n                    // Set the date\\r\\n                    if (JobSubmissionId !== undefined && JobSubmissionId !== null && JobSubmissionId !== '') {\\r\\n                        if (Status !== undefined && Status !== null && Status !== '') {\\r\\n                            app.getDetails(JobSubmissionId).then(function (result) {\\r\\n                                if (result.status !== Status) {\\r\\n                                    // -  Leonardo Ariel Salatino - 23-06-30 - Support #153\\r\\n                                    API.appBridge.httpPOST(\\\"entity/JobSubmission/\\\" + JobSubmissionId, {\\r\\n                                        // +  Leonardo Ariel Salatino - 23-05-15 - Support #153\\r\\n                                        // customDate2: result.dateLastModified,\\r\\n                                        customDate2: new Date().getTime(),\\r\\n                                    }).then(function () {\\r\\n                                        // +  Leonardo Ariel Salatino - 24-04-12 - Support #498\\r\\n                                        // Promise should wait for the httpPost to release\\r\\n                                        /*\\r\\n                                        console.log('Update Done');\\r\\n                                      });\\r\\n                                    }\\r\\n                                  });\\r\\n                                }\\r\\n                              }\\r\\n                              resolve(null);\\r\\n                              */\\r\\n                                        resolve(null);\\r\\n                                    })\\r\\n                                        .catch(function (reason) {\\r\\n                                        reject(reason);\\r\\n                                    });\\r\\n                                }\\r\\n                                else {\\r\\n                                    resolve(null);\\r\\n                                }\\r\\n                            })\\r\\n                                .catch(function (reason) {\\r\\n                                reject(reason);\\r\\n                            });\\r\\n                        }\\r\\n                        else {\\r\\n                            resolve(null);\\r\\n                        }\\r\\n                    }\\r\\n                    else {\\r\\n                        resolve(null);\\r\\n                    }\\r\\n                    // -  Leonardo Ariel Salatino - 24-04-12 - Support #498\\r\\n                });\\r\\n            },\\r\\n            getDetails: function (ID) {\\r\\n                var url = app.baseUrl + \\\"/query/JobSubmission?fields=id,status,dateLastModified&where=id=\\\" + ID;\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data[0]);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && form.isFormValid === true\\r\\n            // +  Leonardo Ariel Salatino - 23-05-15 - Support #153\\r\\n            && API.pageContext !== 'Record'\\r\\n        // -  Leonardo Ariel Salatino - 23-05-15 - Support #153\\r\\n        ) {\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":90,\"dateLastModified\":1712956512620}]}"
