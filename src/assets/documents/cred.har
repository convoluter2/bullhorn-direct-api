Math.abs(regBillRate - chargeBillRate)\\n                    // otHolidayBillRate = Math.max(otBillRate,holidayBillRate)\\n                    // dtHolidayPayRate  = 0\\n                    otCallBackPayRate = callBackPayRate;\\n                    otCallBackBillRate = callBackBillRate;\\n                    dtCallBackePayRate = Math.max(callBackPayRate, 2 * regPay);\\n                    dtCallBackBillRate = callBackBillRate;\\n                    otChargePayRate = chargePayRate * 1.5;\\n                    otChargeBillRate = controller.calculateRate(chargeBillRate, controller.getOTBillRateModifier(billingTerm)); // need to be handled.\\n                    dtChargePayRate = chargePayRate * 2;\\n                    dtChargeBillRate = 0;\\n                    otHolidayPayRate = holidayPayRate || 1.5 * regPay;\\n                    otHolidayBillRate = holidayBillRate || otBillRate;\\n                    dtHolidayPayRate = holidayPayRate || 2 * regPay;\\n                    dtHolidayBillRate = holidayBillRate || otBillRate;\\n                    orientationOTPayRate = 1.5 * regPay;\\n                    orientationOTBillRate = otBillRate * Number(dealsheet.DealSheetClient.billableOrientationHoursPercentageOfRate) / 100;\\n                    orientationDTPayRate = 2 * regPay;\\n                    if (placement.employmentType === \\\"PRN\\\") {\\n                        totalStipend = (totalStipend / 7).toFixed(2);\\n                    }\\n                    // if(dealsheet.DealSheetJob.jobState === \\\"California\\\"){\\n                    //   otChargePayRate = Number(dealsheet.payRate8) + Math.abs(regPay - chargePayRate)\\n                    //   dtChargePayRate = Number(dealsheet.payRate12) + Math.abs(regPay - chargePayRate)\\n                    //   dtHolidayPayRate = Number(dealsheet.payRate12)\\n                    //   otCallBackPayRate = Number(dealsheet.payRate8)\\n                    //   dtCallBackBillRate = 0\\n                    //   dtChargeBillRa