          "content": {
            "size": 280673,
            "mimeType": "application/json",
            "text": "{\"total\":54,\"start\":0,\"count\":54,\"data\":[{\"id\":1759,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"1218G-Support 108 Submission Reject Validations\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            init: function () {\\n                if (form.controls.status.value === 'Choose a rejection reason') {\\n                    form.isFormValid = false;\\n                    form.errorMessage = 'Select a Rejection Status';\\n                }\\n                return Promise.resolve();\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1694800738713},{\"id\":1763,\"action\":\"overview-field-modify\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"1218-su-9-disable-overview-fields\",\"page\":\"record\",\"enabled\":true,\"script\":\"// Support #9\\nfield.readOnly = true;\",\"sortOrder\":0,\"dateLastModified\":1694800784450},{\"id\":1764,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"1218-set-data-fields\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\r\\n            copyDataFields: [{ from: 'startDate', to: 'customDate3' }],\\r\\n            init: function () {\\r\\n                if (API.currentEntity === 'JobSubmission' && (API.pageContext === 'FastAdd' || API.pageContext === 'Record')) {\\r\\n                    controller.copyDataFields.forEach(function (element) {\\r\\n                        if (form.data[element.from] || form.data[element.from] === null) {\\r\\n                            form.data[element.to] = form.data[element.from];\\r\\n                        }\\r\\n                    });\\r\\n                }\\r\\n                return form;\\r\\n            },\\r\\n        };\\r\\n        return controller.init();\",\"sortOrder\":0,\"dateLastModified\":1694800904543},{\"id\":1765,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"70-candidate-check-DoNotSendMSP-field-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                var candidateID = '';\\r\\n                var SubmissionID = '';\\r\\n                var jobID = '';\\r\\n                candidateID = form.data.candidate.id;\\r\\n                SubmissionID = API.currentEntityId;\\r\\n                jobID = form.data.jobOrder.id;\\r\\n                if (API.currentEntityId === undefined || API.currentEntityId === '' || API.currentEntityId === null) {\\r\\n                    SubmissionID = 0;\\r\\n                }\\r\\n                return app.getJobSubmissionDetails(SubmissionID).then(function (results) {\\r\\n                    var customTextBlock4 = '';\\r\\n                    if (SubmissionID !== 0) {\\r\\n                        customTextBlock4 = results.customTextBlock4;\\r\\n                    }\\r\\n                    return app.getcandidateDetails(candidateID).then(function (result) {\\r\\n                        var arrayresult = result.filter(function (data) {\\r\\n                            return data === customTextBlock4;\\r\\n                        });\\r\\n                        if (arrayresult.length > 0) {\\r\\n                            form.isFormValid = false;\\r\\n                            form.errorMessage = 'Candidate is blacklisted';\\r\\n                            return 0;\\r\\n                        }\\r\\n                        return app.getJobDetails(jobID).then(function (jobdata) {\\r\\n                            var customText7 = jobdata.customText7;\\r\\n                            var Jobarrayresult = result.filter(function (data) {\\r\\n                                return data === customText7;\\r\\n                            });\\r\\n                            if (Jobarrayresult.length > 0) {\\r\\n                                form.isFormValid = false;\\r\\n                                form.errorMessage = 'Candidate cannot be submitted due to company blacklist';\\r\\n                            }\\r\\n                        });\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            getcandidateDetails: function (candidateID) {\\r\\n                var url = app.baseUrl + \\\"/search/Candidate?fields=id,customText29&query=id:\\\" + candidateID;\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0].customText29;\\r\\n                    if (finalresult === null || finalresult === '' || finalresult === undefined) {\\r\\n                        finalresult = [];\\r\\n                    }\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n            getJobSubmissionDetails: function (SubmissionID) {\\r\\n                var url = app.baseUrl + \\\"/query/JobSubmission?fields=id,customTextBlock4&where=id=\\\" + SubmissionID;\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n            getJobDetails: function (jobID) {\\r\\n                var url = app.baseUrl + \\\"/query/JobOrder?fields=id,customText7&where=id=\\\" + jobID;\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && form.isFormValid === true && API.pageContext === 'MoveToPlacement')\\r\\n            return app.init();\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1694800906413},{\"id\":1766,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"37-triggered-on-rate-card-update-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                var PlacementId = API.pageDK.config.entityId;\\r\\n                var changedEntityId = form.data.data.changedEntityId;\\r\\n                API.appBridge.httpGET(\\\"/query/PlacementRateCard?fields=id&where=id=\\\" + changedEntityId).then(function (data) {\\r\\n                    var placementRateCardId = data.data.data[0].id;\\r\\n                    API.appBridge.httpGET(\\\"/query/PlacementRateCardLineGroup?fields=placementRateCardLines&where=placementRateCard.id=\\\" + placementRateCardId + \\\" \\\\n          AND placementRateCardLines.earnCode.code='REG'\\\").then(function (result) {\\r\\n                        API.appBridge.httpPOST(\\\"entity/Placement/\\\" + PlacementId, {\\r\\n                            clientBillRate: result.data.data[0].placementRateCardLines.data[0].billRate,\\r\\n                            payRate: result.data.data[0].placementRateCardLines.data[0].payRate,\\r\\n                        }).then(function () {\\r\\n                            console.log('Update Done');\\r\\n                        });\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'PlacementRateCard')\\r\\n            return app.init();\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1694800908987},{\"id\":1767,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"72-candidate-status-check-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                var jobID = '';\\r\\n                var candidateID = '';\\r\\n                var customText1;\\r\\n                candidateID = form.data.candidate.id;\\r\\n                jobID = form.data.jobOrder.id;\\r\\n                return app.getJobDetails(jobID).then(function (results) {\\r\\n                    customText1 = results.clientCorporation.customText1;\\r\\n                    if (customText1 !== null && customText1 !== '' && customText1 !== undefined) {\\r\\n                        var arrayresultComp = customText1.filter(function (data) {\\r\\n                            return data === 'TS-Do Not Service';\\r\\n                        });\\r\\n                        if (arrayresultComp.length > 0) {\\r\\n                            form.isFormValid = false;\\r\\n                            form.errorMessage = 'Company brand status invalid';\\r\\n                        }\\r\\n                    }\\r\\n                    var clientCorporation = results.clientCorporation.name;\\r\\n                    return app.getDetails(candidateID).then(function (result) {\\r\\n                        var customText26 = result.customText26;\\r\\n                        if (customText26 !== null && customText26 !== '' && customText26 !== undefined) {\\r\\n                            var arrayresult = customText26.filter(function (data) {\\r\\n                                return data === clientCorporation;\\r\\n                            });\\r\\n                            if (arrayresult.length > 0) {\\r\\n                                form.isFormValid = false;\\r\\n                                form.errorMessage = 'Candidate is blacklisted';\\r\\n                            }\\r\\n                        }\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            getDetails: function (candidateID) {\\r\\n                var url = app.baseUrl + \\\"/search/Candidate?query=id:\\\" + candidateID + \\\"&fields=id,customText26\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n            getJobDetails: function (jobID) {\\r\\n                var url = app.baseUrl + \\\"/query/JobOrder?fields=id,clientCorporation(id,name,customText1)&where=id=\\\" + jobID;\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement')\\r\\n            return app.init();\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1694800911337},{\"id\":1768,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"53-Prevent-Submittal-for-Do-Not-Send-MSP-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                var candidateID = '';\\r\\n                var jobID = '';\\r\\n                if (API.currentEntityId === '' || API.currentEntityId == null || API.currentEntityId === undefined) {\\r\\n                    candidateID = form.controls.candidate.value[0].id;\\r\\n                    jobID = form.controls.jobOrder.value[0].id;\\r\\n                }\\r\\n                else {\\r\\n                    candidateID = form.controls.candidate.value.id;\\r\\n                    jobID = form.controls.jobOrder.value.id;\\r\\n                }\\r\\n                return app.getJobDetails(jobID).then(function (results) {\\r\\n                    var customText7 = results.customText7;\\r\\n                    return app.getDetails(candidateID).then(function (result) {\\r\\n                        var customText29 = result.customText29;\\r\\n                        if (form.isFormValid === true) {\\r\\n                            if (customText29 !== null && customText29 !== '' && customText29 !== undefined) {\\r\\n                                var arrayresult = customText29.filter(function (data) {\\r\\n                                    return data === customText7;\\r\\n                                });\\r\\n                                if (arrayresult.length > 0) {\\r\\n                                    form.isFormValid = false;\\r\\n                                    form.errorMessage = 'Cannot submit with a candidate opting out from MSP with the same value as 3rd Party Provider';\\r\\n                                }\\r\\n                                else {\\r\\n                                    form.isFormValid = true;\\r\\n                                    form.errorMessage = '';\\r\\n                                }\\r\\n                            }\\r\\n                            else {\\r\\n                                form.isFormValid = true;\\r\\n                                form.errorMessage = '';\\r\\n                            }\\r\\n                        }\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            getDetails: function (candidateID) {\\r\\n                var url = app.baseUrl + \\\"/search/Candidate?query=id:\\\" + candidateID + \\\"&fields=id,customText29\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n            getJobDetails: function (jobID) {\\r\\n                var url = app.baseUrl + \\\"/query/JobOrder?fields=id,customText7&where=id=\\\" + jobID;\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement')\\r\\n            return app.init();\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1694800924940},{\"id\":1770,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"1-checking-blacklist-candidate-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                var jobID = '';\\r\\n                var candidateID = '';\\r\\n                if (API.currentEntityId === '' || API.currentEntityId == null || API.currentEntityId === undefined) {\\r\\n                    candidateID = form.controls.candidate.value[0].id;\\r\\n                    jobID = form.controls.jobOrder.value[0].id;\\r\\n                }\\r\\n                else {\\r\\n                    candidateID = form.controls.candidate.value.id;\\r\\n                    jobID = form.controls.jobOrder.value.id;\\r\\n                }\\r\\n                return app.getJobDetails(jobID).then(function (results) {\\r\\n                    var clientCorporation = results.clientCorporation.name;\\r\\n                    return app.getDetails(candidateID).then(function (result) {\\r\\n                        var customText26 = result.customText26;\\r\\n                        if (customText26 !== null && customText26 !== '' && customText26 !== undefined) {\\r\\n                            var arrayresult = customText26.filter(function (data) {\\r\\n                                return data === clientCorporation;\\r\\n                            });\\r\\n                            if (arrayresult.length > 0) {\\r\\n                                form.isFormValid = false;\\r\\n                                form.errorMessage = 'Candidate is blacklisted';\\r\\n                            }\\r\\n                            else {\\r\\n                                form.isFormValid = true;\\r\\n                                form.errorMessage = '';\\r\\n                            }\\r\\n                        }\\r\\n                        else {\\r\\n                            form.isFormValid = true;\\r\\n                            form.errorMessage = '';\\r\\n                        }\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            getDetails: function (candidateID) {\\r\\n                var url = app.baseUrl + \\\"/search/Candidate?query=id:\\\" + candidateID + \\\"&fields=id,customText26\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n            getJobDetails: function (jobID) {\\r\\n                var url = app.baseUrl + \\\"/query/JobOrder?fields=id,clientCorporation&where=id=\\\" + jobID;\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement')\\r\\n            return app.init();\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1694800930020},{\"id\":1771,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"22-customText7-required-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                if (form.isFormValid === true) {\\r\\n                    form.isFormValid = false;\\r\\n                }\\r\\n                if (form.controls.customText2.value === '3rd Party') {\\r\\n                    if (form.controls.customText11.value === '') {\\r\\n                        form.isFormValid = false;\\r\\n                        form.errorMessage = '3rd party is required';\\r\\n                    }\\r\\n                    else if (form.controls.customText3.value === '') {\\r\\n                        form.isFormValid = false;\\r\\n                        form.errorMessage = 'Technology is required';\\r\\n                    }\\r\\n                    else {\\r\\n                        form.isFormValid = true;\\r\\n                        form.errorMessage = '';\\r\\n                    }\\r\\n                }\\r\\n                else {\\r\\n                    form.isFormValid = true;\\r\\n                    form.errorMessage = '';\\r\\n                }\\r\\n                return 0;\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'BillingProfile')\\r\\n            return app.init();\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1694800932430},{\"id\":1772,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"sync-facility-display-name-to-billing-profile-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var cch = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                cch.updateDisplayName();\\r\\n            },\\r\\n            updateDisplayName: function () {\\r\\n                var billingClientCorporationId = form.data.changedEntityId;\\r\\n                var FacilityDisplayName = form.controls.customText16.value;\\r\\n                var BillingProfileId = '';\\r\\n                var BillingFcName = '';\\r\\n                var billingLocation = '';\\r\\n                var url = cch.baseUrl + \\\"query/BillingProfile?fields=*&where=billingClientCorporation.id=\\\" + billingClientCorporationId;\\r\\n                API.http.get(url).toPromise().then(function (data) {\\r\\n                    data.data.forEach(function (billingData) {\\r\\n                        BillingProfileId = billingData.id;\\r\\n                        BillingFcName = billingData.customText1;\\r\\n                        billingLocation = billingData.billingLocation.id;\\r\\n                        if (BillingFcName !== FacilityDisplayName) {\\r\\n                            API.http.post(cch.baseUrl + \\\"entity/BillingProfile/\\\" + BillingProfileId, {\\r\\n                                customText1: FacilityDisplayName,\\r\\n                                versionID: billingData.versionID,\\r\\n                            }).toPromise().then(function () {\\r\\n                            });\\r\\n                        }\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'ClientCorporation' && form.data.changeType === 'UPDATE')\\r\\n            cch.init();\",\"sortOrder\":0,\"dateLastModified\":1694800938610},{\"id\":1773,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"47-create-location-from-address-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            init: function () {\\r\\n                return app.createLocation();\\r\\n            },\\r\\n            createLocation: function () {\\r\\n                var address = form.controls.address.value;\\r\\n                var stateIds = form.controls.address.config.state.pickerConfig.defaultOptions;\\r\\n                var stateID = stateIds.findIndex(function (item) {\\r\\n                    return item.value === address.state;\\r\\n                });\\r\\n                var clientCorporationId = form.data.changedEntityId;\\r\\n                API.appBridge.httpPUT('entity/Location', {\\r\\n                    address: {\\r\\n                        address1: address.address1,\\r\\n                        address2: address.address2,\\r\\n                        city: address.city,\\r\\n                        state: address.state,\\r\\n                        zip: address.zip,\\r\\n                        countryID: address.countryID,\\r\\n                        stateID: stateID,\\r\\n                    },\\r\\n                    title: 'Company Address',\\r\\n                    clientCorporation: {\\r\\n                        id: clientCorporationId,\\r\\n                    },\\r\\n                    effectiveDate: app.getTodayDate(),\\r\\n                    status: 'Active',\\r\\n                    declineToApplyTaxes: true,\\r\\n                    isBillTo: true,\\r\\n                    isWorkSite: true,\\r\\n                }).then(function () {\\r\\n                    console.log('Saved new location');\\r\\n                });\\r\\n            },\\r\\n            getTodayDate: function () {\\r\\n                var date = new Date().toJSON().slice(0, 10).split('-')\\r\\n                    .reverse();\\r\\n                return date[2] + \\\"-\\\" + date[1] + \\\"-\\\" + date[0];\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'ClientCorporation' && form.data.changeType === 'INSERT')\\r\\n            return app.init();\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1694800941483},{\"id\":1774,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"21-require-the-Union-Contract-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                if (form.controls.customText14.value === 'No') {\\r\\n                    if (form.controls.customDate2.value === '') {\\r\\n                        form.isFormValid = false;\\r\\n                        form.errorMessage = 'Please Enter Exp. Date';\\r\\n                    }\\r\\n                    else {\\r\\n                        form.isFormValid = true;\\r\\n                        form.errorMessage = '';\\r\\n                    }\\r\\n                }\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Candidate')\\r\\n            return app.init();\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1694800943947},{\"id\":1775,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"4-Not-Qualified-Reason-required-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                if (form.controls.status.value === 'Not Qualified') {\\r\\n                    if (form.controls.customText22.value === '') {\\r\\n                        form.isFormValid = false;\\r\\n                        form.errorMessage = 'Please Select Not Qualified Reason';\\r\\n                    }\\r\\n                    else {\\r\\n                        form.isFormValid = true;\\r\\n                        form.errorMessage = '';\\r\\n                    }\\r\\n                }\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Candidate')\\r\\n            return app.init();\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1694800949260},{\"id\":1791,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2256,\"firstName\":\"Leonardo\",\"lastName\":\"Salatino\"},\"name\":\"69-checking-blacklist-candidate-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                var jobID = '';\\r\\n                var candidateID = '';\\r\\n                var customText1;\\r\\n                candidateID = form.data.candidate.id;\\r\\n                jobID = form.data.jobOrder.id;\\r\\n                return app.getJobDetails(jobID).then(function (results) {\\r\\n                    customText1 = results.clientCorporation.customText1;\\r\\n                    if (customText1 !== null && customText1 !== '' && customText1 !== undefined) {\\r\\n                        var arrayresultComp = customText1.filter(function (data) {\\r\\n                            return data === 'TS-Do Not Service';\\r\\n                        });\\r\\n                        if (arrayresultComp.length > 0) {\\r\\n                            form.isFormValid = false;\\r\\n                            form.errorMessage = 'Company brand status invalid';\\r\\n                        }\\r\\n                    }\\r\\n                    var clientCorporation = results.clientCorporation.name;\\r\\n                    return app.getDetails(candidateID).then(function (result) {\\r\\n                        var customText26 = result.customText26;\\r\\n                        if (customText26 !== null && customText26 !== '' && customText26 !== undefined) {\\r\\n                            var arrayresult = customText26.filter(function (data) {\\r\\n                                return data === clientCorporation;\\r\\n                            });\\r\\n                            if (arrayresult.length > 0) {\\r\\n                                form.isFormValid = false;\\r\\n                                form.errorMessage = 'Candidate is blacklisted';\\r\\n                            }\\r\\n                        }\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            getDetails: function (candidateID) {\\r\\n                var url = app.baseUrl + \\\"/search/Candidate?query=id:\\\" + candidateID + \\\"&fields=id,customText26\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n            getJobDetails: function (jobID) {\\r\\n                var url = app.baseUrl + \\\"/query/JobOrder?fields=id,clientCorporation(id,name,customText1)&where=id=\\\" + jobID;\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement')\\r\\n            return app.init();\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1699483519070},{\"id\":1923,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":12559379,\"firstName\":\"IGH BTE\",\"lastName\":\"API\"},\"name\":\"merge-duplicate-matches-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            baseUrl: API.http.restURL,\\n            existingSubmissionError: 'There already exists a submission on this job with this candidate.',\\n            submissionFields: [],\\n            init: function () {\\n                // See if a jobSubmission exists with the same job and candidate.\\n                // If so, see what differences exist on the form\\n                // If any, merge them\\n                var candidates = form.controls.candidate.value;\\n                var jobs = form.controls.jobOrder.value;\\n                if (candidates && candidates.length > 0 && jobs && jobs.length > 0) {\\n                    var promises_1 = [];\\n                    jobs.forEach(function (job) {\\n                        candidates.forEach(function (candidate) {\\n                            promises_1.push(app.findExistingSubmission(candidate.id, job.id));\\n                        });\\n                    });\\n                    return Promise.all(promises_1).then(function (submissions) {\\n                        var updatePromises = [];\\n                        submissions.forEach(function (submission) {\\n                            var updateBody = app.makeSubmissionUpdateBody();\\n                            if (updateBody) {\\n                                updatePromises.push(app.makeSubmissionUpdates(submission[0].id, updateBody));\\n                            }\\n                        });\\n                        return Promise.all(updatePromises).then(function () {\\n                            return form;\\n                        });\\n                    });\\n                }\\n                return form;\\n            },\\n            makeSubmissionUpdateBody: function () {\\n                var submissionUpdateBody = {};\\n                var keysToIgnore = ['jobOrder', 'candidate', 'recipients', 'distributionLists', 'scheduleNextAction', 'sendingUser'];\\n                var dateKeys = ['startDate', 'endDate'];\\n                Object.keys(form.controls).forEach(function (key) {\\n                    if (form.controls[key].value) {\\n                        if (dateKeys.indexOf(key) > -1) {\\n                            submissionUpdateBody[key] = form.controls[key].value.getTime();\\n                        }\\n                        else if (keysToIgnore.indexOf(key) === -1) {\\n                            submissionUpdateBody[key] = form.controls[key].value;\\n                        }\\n                    }\\n                });\\n                return submissionUpdateBody;\\n            },\\n            makeSubmissionFields: function () {\\n                var submissionFields = Object.keys(form.controls);\\n                submissionFields.splice(submissionFields.indexOf('recipients'), 1);\\n                submissionFields.splice(submissionFields.indexOf('distributionLists'), 1);\\n                submissionFields.splice(submissionFields.indexOf('scheduleNextAction'), 1);\\n                return submissionFields;\\n            },\\n            makeSubmissionUpdates: function (submissionId, updateBody) {\\n                var url = app.baseUrl + \\\"entity/JobSubmission/\\\" + submissionId;\\n                return API.http.post(url, updateBody).toPromise().then(function (result) {\\n                    return Promise.resolve(result);\\n                });\\n            },\\n            findExistingSubmission: function (candidateId, jobId) {\\n                var submissionFields = app.makeSubmissionFields();\\n                var url = app.baseUrl + \\\"query/JobSubmission?where=candidate.id=\\\" + candidateId + \\\" AND jobOrder.id=\\\" + jobId + \\\"&fields=id\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n        };\\n        console.log('merge-duplicate');\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'FastAdd') {\\n            console.log('JobSubmission', API, form);\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1717099026363},{\"id\":2311,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":12559379,\"firstName\":\"IGH BTE\",\"lastName\":\"API\"},\"name\":\"544-populate-submissions-on-mass-add-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var transforms = {\\n            userToName: function (data, field) {\\n                return data[field.fromField].firstName + \\\" \\\" + data[field.fromField].lastName + \\\" | \\\" + data.id;\\n            },\\n            sliceString: function (data, field) {\\n                if (data[field.fromField]) {\\n                    var splitString = data[field.fromField].split('|');\\n                    return splitString[0].trim();\\n                }\\n                return null;\\n            },\\n        };\\n        var app = {\\n            baseUrl: API.http.restURL,\\n            jobFieldsToFlow: [\\n                { fromField: 'customText7', toField: 'customTextBlock4' },\\n                { fromField: 'owner', toField: 'customText19', transform: 'userToName' },\\n                { fromField: 'customText17', toField: 'customText7' },\\n                { fromField: 'correlatedCustomText5', toField: 'customText9' },\\n            ],\\n            init: function () {\\n                var jobPromises = [];\\n                var submissionPromises = [];\\n                form.data.forEach(function (submission) {\\n                    if (submission.changeType === 'INSERT') {\\n                        var id = submission.changedEntityId;\\n                        jobPromises.push(app.getJobsFromSubmissions(id));\\n                    }\\n                });\\n                return Promise.all(jobPromises).then(function (responses) {\\n                    var stateList = [];\\n                    responses.forEach(function (response) {\\n                        var state = response.jobOrder.address.state;\\n                        if (state.length > 2) {\\n                            stateList.push(\\\"name = '\\\" + state + \\\"'\\\");\\n                        }\\n                    });\\n                    return app.getStates(stateList).then(function (states) {\\n                        responses.forEach(function (response) {\\n                            var addressString = app.getAddressString(response.jobOrder.address, states);\\n                            var body = app.makeBody(addressString, response.jobOrder);\\n                            submissionPromises.push(app.updateSubmission(response.id, body));\\n                        });\\n                        return Promise.all(submissionPromises).then(function () {\\n                            return form;\\n                        });\\n                    });\\n                });\\n            },\\n            makeBody: function (addressString, jobOrder) {\\n                var body = {\\n                    customTextBlock3: addressString,\\n                };\\n                app.jobFieldsToFlow.forEach(function (field) {\\n                    if (field.transform) {\\n                        body[field.toField] = transforms[field.transform](jobOrder, field);\\n                    }\\n                    else {\\n                        body[field.toField] = jobOrder[field.fromField];\\n                    }\\n                });\\n                return body;\\n            },\\n            getAddressString: function (address, stateList) {\\n                var state = address.state ? address.state : null;\\n                if (state && state.length > 2) {\\n                    state = stateList.filter(function (stateFromList) {\\n                        return stateFromList.name === state;\\n                    });\\n                    if (state && state.length > 0) {\\n                        state = state[0].code;\\n                    }\\n                }\\n                var string = '';\\n                string = (address.address1) ? address.address1.trim() : '';\\n                string = (string !== '' && address.address2) ? string + \\\", \\\" + address.address2.trim() : ((address.address2) ? address.address2.trim() : string);\\n                string = (string !== '' && address.city) ? string + \\\", \\\" + address.city : ((address.city) ? address.city : string);\\n                string = (string !== '' && state) ? string + \\\", \\\" + state : ((state) ? state : string);\\n                string = (string !== '' && address.countryName) ? string + \\\", \\\" + address.countryName : ((address.countryName) ? address.countryName : string);\\n                string = (string !== '' && address.zip) ? string + \\\" \\\" + address.zip : ((address.zip) ? address.zip : string);\\n                return string;\\n            },\\n            getStates: function (stateStrings) {\\n                var where = \\\"country.id = 1 AND ((\\\" + stateStrings.join(') OR (') + \\\"))\\\";\\n                var url = app.baseUrl + \\\"/query/State?fields=id,code,name&where=\\\" + where;\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n            getJobsFromSubmissions: function (submissionId) {\\n                var jobFields = 'id,address,';\\n                jobFields += app.jobFieldsToFlow.map(function (field) {\\n                    return field.fromField;\\n                }).join(',');\\n                var url = app.baseUrl + \\\"/entity/JobSubmission/\\\" + submissionId + \\\"?fields=id,jobOrder(\\\" + jobFields + \\\")\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n            updateSubmission: function (submissionid, body) {\\n                var url = app.baseUrl + \\\"/entity/JobSubmission/\\\" + submissionid;\\n                return API.http.post(url, body).toPromise().then(function () {\\n                    return Promise.resolve();\\n                });\\n            },\\n        };\\n        console.log('populate address');\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1729188978450},{\"id\":2326,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zweli\",\"lastName\":\"Mphanza\"},\"name\":\"update-custom-date-on-status-change-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            init: function () {\\r\\n                if (!API.currentEntityId) {\\r\\n                    return Promise.resolve(form);\\r\\n                }\\r\\n                return new Promise(function (resolve, reject) {\\r\\n                    var status = form.controls.status;\\r\\n                    if (app.hasFieldChanged(status.key)) {\\r\\n                        if (status.value.toLowerCase() === 'did not start') {\\r\\n                            console.log('Field Changed to ', status);\\r\\n                            var changeObject = {\\r\\n                                id: API.currentEntityId,\\r\\n                                customDate1: app.getUTCDate().getTime(),\\r\\n                            };\\r\\n                            return app.commitChange(changeObject).then(function (i) {\\r\\n                                return resolve(i);\\r\\n                            }).catch(function (error) {\\r\\n                                return reject(error);\\r\\n                            });\\r\\n                        }\\r\\n                    }\\r\\n                    return resolve(form);\\r\\n                });\\r\\n            },\\r\\n            getUTCDate: function () {\\r\\n                var currentDate = new Date();\\r\\n                var utcDate = new Date(currentDate.getUTCFullYear(), currentDate.getUTCMonth(), currentDate.getUTCDate(), 0, 0, 0);\\r\\n                return utcDate;\\r\\n            },\\r\\n            hasFieldChanged: function (field) {\\r\\n                if (!form.controls[field]) {\\r\\n                    return false;\\r\\n                }\\r\\n                var control = form.controls[field];\\r\\n                return (!control.pristine)\\r\\n                    && (control.valueHistory.length > 1\\r\\n                        && control.valueHistory[0] !== control.valueHistory[control.valueHistory.length - 1]);\\r\\n            },\\r\\n            commitChange: function (changeObject) {\\r\\n                return new Promise(function (resolve) {\\r\\n                    var url = \\\"entity/Placement/\\\" + changeObject.id;\\r\\n                    API.appBridge.httpPOST(url, changeObject).then(function (result) {\\r\\n                        if (result.data.data) {\\r\\n                            resolve(result.data.data);\\r\\n                        }\\r\\n                        else {\\r\\n                            resolve(null);\\r\\n                        }\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Placement') {\\r\\n            console.log('update-custom-date-on-status-change-1218');\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve(form);\",\"sortOrder\":0,\"dateLastModified\":1731501874967},{\"id\":2336,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":18579477,\"firstName\":\"Mark\",\"lastName\":\"Crist\"},\"name\":\"77-checking-Company-brand-status-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            // +  Leonardo Ariel Salatino - 23-03-30\\r\\n            mode: '',\\r\\n            // -  Leonardo Ariel Salatino - 23-03-30\\r\\n            init: function () {\\r\\n                var jobID = '';\\r\\n                var customText1;\\r\\n                if (API.currentEntityId === '' || API.currentEntityId === null || API.currentEntityId === undefined) {\\r\\n                    jobID = form.controls.jobOrder.value[0].id;\\r\\n                    // +  Leonardo Ariel Salatino - 23-03-30\\r\\n                    app.mode = 'ADD';\\r\\n                    // -  Leonardo Ariel Salatino - 23-03-30\\r\\n                }\\r\\n                else {\\r\\n                    jobID = form.controls.jobOrder.value.id;\\r\\n                    // +  Leonardo Ariel Salatino - 23-03-30\\r\\n                    app.mode = 'EDIT';\\r\\n                    // -  Leonardo Ariel Salatino - 23-03-30\\r\\n                }\\r\\n                return app.getJobDetails(jobID).then(function (results) {\\r\\n                    customText1 = results.clientCorporation.customText1;\\r\\n                    if (customText1 !== null && customText1 !== '' && customText1 !== undefined) {\\r\\n                        var arrayresultComp = customText1.filter(function (data) {\\r\\n                            return data === 'TS-Do Not Service';\\r\\n                        });\\r\\n                        if (arrayresultComp.length > 0) {\\r\\n                            form.isFormValid = false;\\r\\n                            form.errorMessage = 'Company brand status invalid';\\r\\n                        }\\r\\n                    }\\r\\n                    // +  Leonardo Ariel Salatino - 23-03-30\\r\\n                    if (app.mode === 'ADD') {\\r\\n                        var jobStatus = results.status;\\r\\n                        // +  Leonardo Ariel Salatino - 23-07-04 - Support #223\\r\\n                        /* const jobIsOpen: boolean = results.isOpen;\\r\\n                        if (jobIsOpen === false || jobStatus === 'Closed' || jobStatus === 'Hold') {\\r\\n                          form.isFormValid = false;\\r\\n                          form.errorMessage = 'Job is Closed or on Hold';\\r\\n                        } */\\r\\n                        if (jobStatus !== 'Open') {\\r\\n                            form.isFormValid = false;\\r\\n                            form.errorMessage = 'Job must be Open to create new Matches';\\r\\n                        }\\r\\n                        // -  Leonardo Ariel Salatino - 23-07-04 - Support #223\\r\\n                    }\\r\\n                    // -  Leonardo Ariel Salatino - 23-03-30\\r\\n                });\\r\\n            },\\r\\n            getJobDetails: function (jobID) {\\r\\n                // +  Leonardo Ariel Salatino - 23-03-30\\r\\n                // const url = `${app.baseUrl}/query/JobOrder?fields=id,clientCorporation(id,name,customText1)&where=id=${jobID}`;\\r\\n                var url = app.baseUrl + \\\"/query/JobOrder?fields=id,isOpen,status,clientCorporation(id,name,customText1)&where=id=\\\" + jobID;\\r\\n                // -  Leonardo Ariel Salatino - 23-03-30\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.log(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement')\\r\\n            return app.init();\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1731946900890},{\"id\":2592,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":20172287,\"firstName\":\"interactionapiuser\",\"lastName\":\"ingenovisnp\"},\"name\":\"post-save-handler-job-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            ENRICH_FIELDS: [\\n                { from: 'clientAgreementPicker', to: 'clientAgreementPicker', transform: 'jobRateHandler' },\\n                { from: 'correlatedCustomFloat2', to: 'customInt5', transform: 'roundHandler' },\\n                { from: 'customFloat1', to: 'customInt7', transform: 'roundHandler' },\\n                { from: 'payRate', to: 'customInt4', transform: 'roundHandler' },\\n            ],\\n            customToId: function (changeObject, to, value) {\\n                if (value) {\\n                    changeObject[to] = { id: value.id };\\n                }\\n                Promise.resolve(true);\\n            },\\n            roundHandler: function (changeObject, to, value) {\\n                let roundedVal = null;\\n                if (value) {\\n                    roundedVal = Math.round(value);\\n                }\\n                changeObject[to] = roundedVal;\\n                return Promise.resolve(true);\\n            },\\n            jobRateHandler: function (changeObject, to, value) {\\n                console.log('jobRateHandler');\\n                console.log(changeObject, to, value);\\n                if (!value || !value.id) {\\n                    return Promise.resolve(false);\\n                }\\n                return app.getJobRate(changeObject.id).then((result) => {\\n                    if (result) {\\n                        return Promise.resolve(false);\\n                    }\\n                    return app.createJobRates(changeObject, to, value).then((created) => {\\n                        const cra = {\\n                            id: changeObject.id,\\n                            customText25: `${value.name} | ${value.id}`,\\n                        };\\n                        return app.commitChanges(cra).then(() => {\\n                            return Promise.resolve(created);\\n                        });\\n                    });\\n                });\\n            },\\n            createJobRates: function (changeObject, to, craValue) {\\n                const effectiveDate = (form.controls.startDate) ? form.controls.startDate.value : null;\\n                if (!effectiveDate) {\\n                    return Promise.resolve(false);\\n                }\\n                const effectiveDateStr = `${effectiveDate.getFullYear()}-${(`0${effectiveDate.getMonth() + 1}`).slice(-2)}-${(`0${effectiveDate.getDate()}`).slice(-2)}`;\\n                return app.getCRAData(craValue.id).then((result) => {\\n                    if (!result.clientCorporationRateAgreementCardLineGroups || result.clientCorporationRateAgreementCardLineGroups.total === 0) {\\n                        return Promise.resolve(false);\\n                    }\\n                    const jobOrderRateCardLineGroups = result.clientCorporationRateAgreementCardLineGroups.data.map((group) => {\\n                        return {\\n                            isBase: group.isBase,\\n                            earnCodeGroup: {\\n                                id: group.earnCodeGroup.id,\\n                            },\\n                            jobOrderRateCardLines: group.clientCorporationRateAgreementCardLines.data.map((line) => {\\n                                return {\\n                                    earnCode: {\\n                                        id: line.earnCode.id,\\n                                    },\\n                                    payRate: line.payRate,\\n                                    billRate: line.billRate,\\n                                    payMultiplier: line.payMultiplier,\\n                                    billMultiplier: line.billMultiplier,\\n                                    markupPercent: line.markupPercent,\\n                                    markupValue: line.markupValue,\\n                                };\\n                            }),\\n                        };\\n                    });\\n                    const changeRateObject = {\\n                        jobOrderRateCardLineGroups: jobOrderRateCardLineGroups,\\n                        jobPosting: {\\n                            id: changeObject.id,\\n                        },\\n                        effectiveDate: effectiveDateStr,\\n                    };\\n                    const url = `${API.http.restURL}entity/JobOrderRateCard`;\\n                    return API.http.put(url, changeRateObject).toPromise().then(() => {\\n                        return Promise.resolve(true);\\n                    });\\n                });\\n            },\\n            getJobRate: function (jobId) {\\n                const url = `${API.http.restURL}entity/JobOrder/${jobId}?fields=jobOrderRateCardID,customText25`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    return Promise.resolve(result.data.jobOrderRateCardID);\\n                });\\n            },\\n            getCRAData: function (craID) {\\n                const url = `${API.http.restURL}entity/ClientCorporationRateAgreementCard/${craID}?fields=clientCorporationRateAgreementCardLineGroups[100]`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n            commitChanges: function (changeObject) {\\n                const url = `${API.http.restURL}entity/JobOrder/${changeObject.id}`;\\n                return API.http.post(url, changeObject).toPromise();\\n            },\\n            init: function () {\\n                const entityId = form.data.changedEntityId;\\n                const changeObject = {\\n                    id: entityId,\\n                };\\n                const promises = [];\\n                let update = false;\\n                app.ENRICH_FIELDS.forEach((field) => {\\n                    if (form.controls[field.from]) {\\n                        if (field.transform) {\\n                            promises.push(app[field.transform](changeObject, field.to, form.controls[field.from].value));\\n                        }\\n                        else {\\n                            changeObject[field.to] = form.controls[field.from].value;\\n                            update = true;\\n                        }\\n                    }\\n                });\\n                return Promise.all(promises).then((jobChanges) => {\\n                    update = update || jobChanges.some((jobChange) => {\\n                        return jobChange;\\n                    });\\n                    if (update) {\\n                        return app.commitChanges(changeObject).then(() => {\\n                            return Promise.resolve(form);\\n                        });\\n                    }\\n                    return Promise.resolve(form);\\n                });\\n            },\\n        };\\n        if (API.currentEntity !== 'JobOrder') {\\n            return form;\\n        }\\n        console.log('JobOrder Entry');\\n        return app.init();\",\"sortOrder\":0,\"dateLastModified\":1777071233803},{\"id\":2601,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":20512841,\"firstName\":\"Truestaff NPE\",\"lastName\":\"Simplifi User\"},\"name\":\"S-set-tl-enabled-date-standard-pi\",\"page\":\"record\",\"enabled\":true,\"script\":\"const controller = {\\n  DATE_BEGIN: 'dateBegin',\\n  async httpGET(relativeUrl) {\\n    if (API.appBridge) {\\n      return API.appBridge.httpGET(relativeUrl).then((response) => {\\n        return response.data;\\n      });\\n    }\\n    return API.http.get(`${API.http.restURL}${relativeUrl}`).toPromise();\\n  },\\n  async httpPOST(relativeUrl, data) {\\n    if (API.appBridge) {\\n      return API.appBridge.httpPOST(relativeUrl, data).then((response) => {\\n        return response.data;\\n      });\\n    }\\n    return API.http.post(`${API.http.restURL}${relativeUrl}`, data).toPromise();\\n  },\\n  async init() {\\n    const dateBegin = await controller.getDateBegin();\\n    await controller.httpPOST(`entity/Placement/${controller.getPlacementId()}`, {\\n      timeAndExpense: {\\n        timeAndLaborEnabledDate: dateBegin,\\n      },\\n    });\\n    return form;\\n  },\\n  getPlacementId() {\\n    let submissionChanges = form.data[0];\\n    if (!Array.isArray(submissionChanges)) {\\n      // Only true on Submission -> Move To Placement.\\n      //  false on Job -> Add Placement\\n      submissionChanges = submissionChanges.data[0];\\n    }\\n    const placementChange = submissionChanges.find((c) => {\\n      return c.changedEntityType === 'Placement';\\n    });\\n    return placementChange.changedEntityId;\\n  },\\n  async getDateBegin() {\\n    const response = await controller.httpGET(`entity/Placement/${controller.getPlacementId()}?fields=dateBegin`);\\n    return response.data.dateBegin;\\n  },\\n};\\nif ((API.pageContext === 'MoveToPlacement' && API.currentEntity === 'JobSubmission') || (API.pageContext === 'FastAdd' && API.currentEntity === 'Placement')) {\\n  console.log('populate-time-and-labor-enablement-date-post');\\n  return controller.init();\\n}\\nreturn form;\",\"sortOrder\":0,\"dateLastModified\":1776967349067},{\"id\":2594,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":20172335,\"firstName\":\"Trustaff DealSheet\",\"lastName\":\"Admin NPE\"},\"name\":\"copy ds id to placement\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            dealsheetPathAtJobSubmission: \\\"customText11\\\",\\n            dealsheetPathAtPlacement: \\\"customText11\\\",\\n            getPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id + \\\"?fields=id,jobSubmission(customText11,customText8,customText10)\\\";\\n                    console.log(\\\"Newbury copy DS id to placement FI  getPlacement url\\\", url);\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            updatePlacementUsingLoggedInUser: function (id, body) {\\n                console.log(\\\"Newbury copy DS to placement: updatePlacement params\\\", id, body);\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id;\\n                    API.appBridge.httpPOST(url, body).then(function (result) {\\n                        resolve(result);\\n                    });\\n                });\\n            },\\n            getSubmission: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/JobSubmission/\\\" + id + \\\"?fields=id,customText6,customText8,customText11\\\";\\n                    console.log(\\\"Newbury copy DS id to placement FI  getSubmission url\\\", url);\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            updatePlacementFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    var query = {\\n                        query: {\\n                            type: 'updatePlacement',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"updatePlacementFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object updatePlacementFunc', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"updatePlacementFunc error\\\", error);\\n                        controller.updatePlacementUsingLoggedInUser(data.id, data.body).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            updatePlacement: function (id, body) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return controller.updatePlacementFunc({ id: id, body: body });\\n            },\\n            copyDealsheetIdToPlacement: function (id, submissionId) {\\n                return new Promise(function (resolve) {\\n                    controller.getSubmission(submissionId).then(function (jobSubmission) {\\n                        console.log(\\\"Newbury copy DS id to placement FI  placement\\\", jobSubmission);\\n                        if (jobSubmission[controller.dealsheetPathAtJobSubmission] && jobSubmission[controller.dealsheetPathAtJobSubmission].length) {\\n                            console.log(\\\"Newbury copy DS id to placement FI  DS ID\\\", jobSubmission[controller.dealsheetPathAtJobSubmission]);\\n                            controller.updatePlacement(id, { customText55: jobSubmission[controller.dealsheetPathAtJobSubmission] }).then(function () {\\n                                resolve();\\n                            });\\n                        }\\n                        else {\\n                            resolve();\\n                        }\\n                    });\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            var data;\\n            if (Array.isArray(form.data[0].data))\\n                data = form.data[0].data[0];\\n            else if (Array.isArray(form.data[0]))\\n                data = form.data[0];\\n            else\\n                data = form.data[1].data[0];\\n            var placementId = data.filter(function (item) { return item.changedEntityType === \\\"Placement\\\"; })[0].changedEntityId;\\n            var submissionId = data.filter(function (item) { return item.changedEntityType === \\\"JobSubmission\\\"; })[0].changedEntityId;\\n            console.log(\\\"Newbury MAK testing\\\", placementId, submissionId);\\n            if (placementId) {\\n                return controller.copyDealsheetIdToPlacement(placementId, submissionId);\\n            }\\n            else {\\n                return;\\n            }\\n        }\\n        else {\\n            return;\\n        }\",\"sortOrder\":1,\"dateLastModified\":1776673794470},{\"id\":2595,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":20172335,\"firstName\":\"Trustaff DealSheet\",\"lastName\":\"Admin NPE\"},\"name\":\"copy job submission status to ds\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            getSubmission: function (id) {\\n                var url = \\\"entity/JobSubmission/\\\" + id + \\\"?fields=id,customText11,status\\\";\\n                return API.appBridge.httpGET(url).then(function (response) {\\n                    return Promise.resolve(response.data.data);\\n                });\\n            },\\n            copyStatus: function (jobSubmission) {\\n                var url = \\\"https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1\\\";\\n                var query = {\\n                    auditData: {\\n                        userId: API.globals.user.userId\\n                    },\\n                    query: {\\n                        type: 'updateSubmission',\\n                        params: {\\n                            dealSheetId: jobSubmission.customText11,\\n                        },\\n                        data: {\\n                            jobSubmissionStatus: jobSubmission.status,\\n                            jobSubmissionId: jobSubmission.id\\n                        }\\n                    }\\n                };\\n                if (controller.isDuplicateSubmission()) {\\n                    return;\\n                }\\n                fetch(url, {\\n                    method: 'post',\\n                    body: JSON.stringify(query)\\n                }).then(function (response) {\\n                    return response.json();\\n                }).then(function (data) {\\n                    console.log('done updating');\\n                });\\n            },\\n            isDuplicateSubmission: function () {\\n                return form.data[0] && form.data[0].messages && form.data[0].messages.length > 0;\\n            },\\n            isDealSheet: function (submission) {\\n                return submission.customText11;\\n            },\\n            init: function () {\\n                console.log(\\\"Newbury  the form\\\", form);\\n                var contexts = ['ChangeStatus', '', 'FastAdd'];\\n                // @ts-ignore\\n                if (API.currentEntity === 'JobSubmission' && contexts.indexOf(API.pageContext) > -1) {\\n                    var submissionId_1 = (form.data && form.data.changedEntityId) || (form.data && form.data[0] && form.data[0].changedEntityId) || form.data.data[0].changedEntityId;\\n                    controller.getSubmission(submissionId_1).then(function (jobSubmission) {\\n                        if (controller.isDealSheet(jobSubmission)) {\\n                            console.log('isDealsheet');\\n                            controller.copyStatus(jobSubmission);\\n                        }\\n                        console.log('the form', form.data, form.controls);\\n                    });\\n                }\\n                else if (API.currentEntity === 'JobSubmission' && API.pageContext === \\\"MoveToPlacement\\\") {\\n                    var data;\\n                    if (Array.isArray(form.data[0].data))\\n                        data = form.data[0].data[0];\\n                    else if (Array.isArray(form.data[0]))\\n                        data = form.data[0];\\n                    else\\n                        data = form.data[1].data[0];\\n                    console.log(\\\"Newbury data\\\", data);\\n                    var submissionId;\\n                    if (data[0] && data[0].changedEntityType == \\\"JobSubmission\\\") {\\n                        submissionId = data[0].changedEntityId;\\n                    }\\n                    else if (data[1] && data[1].changedEntityType == \\\"JobSubmission\\\") {\\n                        submissionId = data[1].changedEntityId;\\n                    }\\n                    else if (data[2] && data[2].changedEntityType == \\\"JobSubmission\\\") {\\n                        submissionId = data[2].changedEntityId;\\n                    }\\n                    console.log(\\\"Newbury submissionId\\\", submissionId);\\n                    controller.getSubmission(submissionId).then(function (jobSubmission) {\\n                        if (controller.isDealSheet(jobSubmission)) {\\n                            console.log('isDealsheet');\\n                            controller.copyStatus(jobSubmission);\\n                        }\\n                        console.log('the form', form.data, form.controls);\\n                    });\\n                }\\n            }\\n        };\\n        controller.init();\",\"sortOrder\":1,\"dateLastModified\":1776673794503},{\"id\":2596,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":20172335,\"firstName\":\"Trustaff DealSheet\",\"lastName\":\"Admin NPE\"},\"name\":\"set ds status to final\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            getJobSubmission: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/JobSubmission/\\\" + id + \\\"?fields=id,customText11\\\";\\n                    console.log(\\\"Newbury DS SET TO FINAL getJobSubmission url\\\", url);\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            setDealSheetToFinal: function (id) {\\n                return new Promise(function (resolve) {\\n                    controller.getJobSubmission(API.currentEntityId).then(function (jobSubmission) {\\n                        console.log(\\\"Newbury DS SET TO FINAL jobSubmission\\\", jobSubmission);\\n                        if (jobSubmission.customText11 && jobSubmission.customText11.length) {\\n                            console.log(\\\"Newbury DS SET TO FINAL DS ID\\\", jobSubmission.customText11);\\n                            var url = 'https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                            var query = {\\n                                auditData: {\\n                                    userId: API.globals.user.userId\\n                                },\\n                                query: {\\n                                    type: 'setToFinal',\\n                                    params: {\\n                                        dealSheetId: jobSubmission.customText11,\\n                                    },\\n                                    data: {}\\n                                }\\n                            };\\n                            fetch(url, {\\n                                method: 'post',\\n                                body: JSON.stringify(query)\\n                            }).then(function (response) {\\n                                return response.json();\\n                            }).then(function (data) {\\n                                console.log('DS SET TO FINAL done updating');\\n                                resolve();\\n                            });\\n                        }\\n                        else {\\n                            resolve();\\n                        }\\n                    });\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            console.log(\\\"Newbury DS SET TO FINAL API\\\", API);\\n            console.log(\\\"Newbury PDS SET TO FINAL ID\\\", API.currentEntityId);\\n            console.log(\\\"Newbury DS SET TO FINAL form\\\", form);\\n            if (API.currentEntityId) {\\n                return controller.setDealSheetToFinal(API.currentEntityId);\\n            }\\n        }\\n        else {\\n            return;\\n        }\",\"sortOrder\":1,\"dateLastModified\":1776673794530},{\"id\":2597,\"action\":\"overview-field-modify\",\"modifyingUser\":{\"id\":20172335,\"firstName\":\"Trustaff DealSheet\",\"lastName\":\"Admin NPE\"},\"name\":\"redirect-to-ds\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            getDealsheet: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    var query = {\\n                        query: {\\n                            type: 'getMostIncrementedDs',\\n                            params: {\\n                                dealSheetId: id,\\n                            },\\n                            data: {}\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            },\\n            getPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id + \\\"?fields=id,jobOrder(id)\\\";\\n                    console.log(\\\"Newbury copy DS id to placement FI  getPlacement url\\\", url);\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            buildDealseheetUrl: function () {\\n                return new Promise(function (resolve) {\\n                    controller.getPlacement(API.currentEntityId).then(function (placement) {\\n                        var userId = API.globals.user.userId;\\n                        var corpId = API.globals.user.corporationId;\\n                        var plId = API.globals.user.privateLabelId;\\n                        var dealsheetId = data.customText55;\\n                        var entityID = placement.jobOrder.id;\\n                        controller.getDealsheet(dealsheetId).then(function (dealSheet) {\\n                            console.log(\\\"Newbury dealSheet\\\", dealSheet);\\n                            dealsheetId = dealSheet.id;\\n                            var baseUrl = \\\"https://dealsheet-ng-dev-trustaff.s3.amazonaws.com/index.html#/compare-deal-sheet?isComparable=y\\\";\\n                            var url = baseUrl + \\\"&dealSheetIdParam=\\\" + dealsheetId + \\\"&EntityType=JobOrder&EntityID=\\\" + entityID + \\\"&UserID=\\\" + userId + \\\"&CorporationID=\\\" + corpId + \\\"&PrivateLabelID=\\\" + plId;\\n                            console.log(\\\"Newbury adding on click function\\\", API, field, data, url);\\n                            field.onClick = function () {\\n                                var openedWindow = window.open(url);\\n                                openedWindow = window;\\n                            };\\n                            resolve();\\n                        });\\n                    });\\n                });\\n            },\\n        };\\n        if (field.name === 'customText55' && data.customText55 && API.currentEntity === \\\"Placement\\\") {\\n            console.log(\\\"Newbury opening DS \\\");\\n            return controller.buildDealseheetUrl();\\n        }\",\"sortOrder\":1,\"dateLastModified\":1776673794590},{\"id\":2598,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":20172335,\"firstName\":\"Trustaff DealSheet\",\"lastName\":\"Admin NPE\"},\"name\":\"Prevent Placement Creation for ds pending approval\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            allowedStatus: [\\\"Active\\\"],\\n            getSubmission: function (candidateId, jobOrderId) {\\n                var url = \\\"query/JobSubmission?where=candidate.id=\\\" + candidateId + \\\" AND jobOrder.id=\\\" + jobOrderId + \\\" AND isDeleted=false&fields=id,customText11,status\\\";\\n                return API.appBridge.httpGET(url).then(function (response) {\\n                    return Promise.resolve(response.data.data);\\n                });\\n            },\\n            getDealsheet: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    var query = {\\n                        query: {\\n                            type: 'getMostIncrementedDs',\\n                            params: {\\n                                dealSheetId: id,\\n                            },\\n                            data: {}\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            },\\n            checkDealsheetAndPreventForm: function (approvalRequested, approved, rejected) {\\n                var preventCreation = approvalRequested || (!approvalRequested && rejected);\\n                var messageStatus = approvalRequested ? \\\"pending managers approval\\\" : \\\"rejected\\\";\\n                if (preventCreation) {\\n                    var errorMessage = \\\"Deal Sheet is \\\" + messageStatus + \\\", placement can not be created\\\";\\n                    // controller.displayToastMessage(errorMessage)\\n                    form.isFormValid = false;\\n                    form.errorMessage = errorMessage;\\n                    return true;\\n                }\\n            },\\n            displayToastMessage: function (errorMessage) {\\n                API.displayToast({\\n                    message: errorMessage,\\n                    isCloseable: true,\\n                    theme: 'danger',\\n                    hideDelay: 6000,\\n                });\\n            },\\n            init: function () {\\n                return new Promise(function (resolve) {\\n                    var jobOrderId = form.data.jobOrder.id;\\n                    var candidateId = form.data.candidate.id;\\n                    if (jobOrderId && candidateId) {\\n                        controller.getSubmission(candidateId, jobOrderId).then(function (submission) {\\n                            var dealsheetId = submission.length ? submission[0].customText11 : null;\\n                            console.log(\\\"submission\\\", submission);\\n                            console.log(\\\"dealsheetId\\\", dealsheetId);\\n                            if (dealsheetId) {\\n                                controller.getDealsheet(dealsheetId).then(function (dealsheet) {\\n                                    if (dealsheet) {\\n                                        controller.checkDealsheetAndPreventForm(dealsheet.approvalRequested, dealsheet.approved, dealsheet.rejected);\\n                                        resolve();\\n                                    }\\n                                    else {\\n                                        resolve();\\n                                    }\\n                                });\\n                            }\\n                            else {\\n                                resolve();\\n                            }\\n                        });\\n                    }\\n                    else {\\n                        console.log(\\\"DOESN't HAVE COMPANY OR JOB ID\\\");\\n                        resolve();\\n                    }\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            console.log(\\\"Newbury Prevent Placement Creation\\\", form.data);\\n            return controller.init();\\n        }\",\"sortOrder\":1,\"dateLastModified\":1776673794610},{\"id\":2599,\"action\":\"tab-modify\",\"modifyingUser\":{\"id\":20172335,\"firstName\":\"Trustaff DealSheet\",\"lastName\":\"Admin NPE\"},\"name\":\"add count to dealsheet tab\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            dealSheetTabName: 'Deal Sheet',\\n            clientDomain: \\\"dev.trustaff.dl-sheet.com\\\",\\n            getDealSheetCount: function (id, entity) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"https://\\\" + controller.clientDomain + \\\"/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1\\\";\\n                    var whereObj = entity == 'Candidate' ? { \\\"DealSheetCandidate.bullhornCandidateId\\\": id } : { \\\"DealSheetJob.bullhornJobId\\\": id };\\n                    whereObj[\\\"status\\\"] = [\\\"Sent\\\", \\\"Final\\\", \\\"Draft\\\", \\\"Submitted\\\", \\\"Locked\\\"];\\n                    var query = {\\n                        \\\"query\\\": {\\n                            \\\"type\\\": \\\"getDealSheets\\\",\\n                            \\\"params\\\": {\\n                                \\\"where\\\": whereObj,\\n                                \\\"sort\\\": { \\\"updatedAt\\\": \\\"desc\\\" },\\n                                \\\"offset\\\": 0,\\n                                \\\"limit\\\": 10\\n                            }\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('ds data ==>', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            }\\n        };\\n        if ((API.currentEntity === 'Candidate' || API.currentEntity === 'JobOrder') && item.label === controller.dealSheetTabName) {\\n            var id_1 = API.currentEntityId;\\n            controller.getDealSheetCount(id_1, API.currentEntity).then(function (res) {\\n                console.log(\\\"for \\\" + API.currentEntity + \\\" with entity id \\\" + id_1 + \\\" res is ==>\\\", res);\\n                item.label = item.label + (\\\" (\\\" + res.parentLength + \\\")\\\");\\n            }).catch(function (err) {\\n                console.log('error=>', err);\\n            });\\n        }\",\"sortOrder\":1,\"dateLastModified\":1776673794633},{\"id\":2600,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":20172287,\"firstName\":\"interactionapiuser\",\"lastName\":\"ingenovisnp\"},\"name\":\"copy-review-notes-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            jobSubmission: 'JobSubmission',\\n            candidateFields: 'id,candidate',\\n            init: function () {\\n                console.log('copy-review-notes-1218');\\n                const entityId = app.getEntityId();\\n                if (!entityId) {\\n                    return Promise.resolve();\\n                }\\n                const reviewNotesCheckbox = form.controls.reviewNotesCheckbox.value;\\n                if (reviewNotesCheckbox === 'No' || !reviewNotesCheckbox) {\\n                    return Promise.resolve();\\n                }\\n                const comments = form.controls.comments.value;\\n                return app.getCandidateData(entityId).then((candidateData) => {\\n                    const changeObject = {\\n                        id: candidateData.id,\\n                        customTextBlock10: comments,\\n                    };\\n                    return app.commitChanges(changeObject).then(() => {\\n                        return Promise.resolve();\\n                    });\\n                }).catch((error) => {\\n                    console.error('Error getting candidate data', error);\\n                });\\n            },\\n            getEntityId: function () {\\n                let dataObj = null;\\n                if (form.data) {\\n                    if (form.data[0]) {\\n                        if (form.data[0].data) {\\n                            if (Array.isArray(form.data[0].data) && form.data[0].data.length > 0) {\\n                                dataObj = form.data[0].data[0];\\n                            }\\n                        }\\n                        else {\\n                            dataObj = form.data[0];\\n                        }\\n                    }\\n                    else if (Array.isArray(form.data.data) && form.data.data.length > 0) {\\n                        dataObj = form.data.data[0];\\n                    }\\n                }\\n                const entity = (Array.isArray(dataObj)) ? dataObj.find((element) => {\\n                    return element.changedEntityType === app.jobSubmission;\\n                }) : dataObj;\\n                return entity && entity.changedEntityId ? entity.changedEntityId : API.currentEntityId;\\n            },\\n            getCandidateData: function (submissionId) {\\n                const url = `${API.http.restURL}entity/${app.jobSubmission}/${submissionId}?fields=${app.candidateFields}`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    return Promise.resolve(result.data.candidate);\\n                }).catch((error) => {\\n                    console.error('Error getting candidate data', error);\\n                });\\n            },\\n            commitChanges: function (changeObject) {\\n                const url = `${API.http.restURL}entity/Candidate/${changeObject.id}`;\\n                return API.http.post(url, changeObject).toPromise().then((result) => {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n        };\\n        if (API.currentEntity === app.jobSubmission) {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":1,\"dateLastModified\":1776870174743},{\"id\":2402,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zweli\",\"lastName\":\"Mphanza\"},\"name\":\"update-candidate-working-brand-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            init: () => {\\n                const candidateId = form.data[1].changedEntityId;\\n                console.log('entityId', candidateId);\\n                if (!candidateId) {\\n                    return form;\\n                }\\n                const changeObject = {\\n                    id: candidateId,\\n                    customText17: null,\\n                };\\n                return app.getPlacementData().then((placementData) => {\\n                    if (placementData && placementData.correlatedCustomText3) {\\n                        changeObject.customText17 = placementData.correlatedCustomText3;\\n                    }\\n                    return app.commitChanges(changeObject).then(() => {\\n                        return Promise.resolve(form);\\n                    }).catch(() => {\\n                        console.warn('could not update candidate working brand');\\n                        return Promise.resolve(form);\\n                    });\\n                });\\n            },\\n            commitChanges: (changeObject) => {\\n                const url = `${API.http.restURL}entity/Candidate/${changeObject.id}`;\\n                return API.http.post(url, changeObject).toPromise();\\n            },\\n            getPlacementId: () => {\\n                const dataObj = (form.data[0].data) ? form.data[0].data[0] : form.data[0];\\n                const placementEntity = Array.isArray(dataObj) ? dataObj.find(element => element.changedEntityType === 'Placement') : null;\\n                if (!placementEntity) {\\n                    return null;\\n                }\\n                return placementEntity.changedEntityId;\\n            },\\n            getPlacementData: () => {\\n                const placementId = app.getPlacementId();\\n                if (!placementId) {\\n                    Promise.resolve();\\n                }\\n                const url = `${API.http.restURL}entity/Placement/${placementId}?fields=id,correlatedCustomText3`;\\n                return API.http.get(url).toPromise().then((response) => {\\n                    return Promise.resolve(response.data);\\n                });\\n            }\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\n            console.log('update-candidate-source-brand-on-placement-creation-1218');\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":1,\"dateLastModified\":1754656276693},{\"id\":2403,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zweli\",\"lastName\":\"Mphanza\"},\"name\":\"update-candidate-working-brand-on-status-change-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            statusField: 'status',\\n            init: () => {\\n                if (!API.currentEntityId) {\\n                    return Promise.resolve();\\n                }\\n                let candidateID;\\n                if (API &&\\n                    API.pageDK &&\\n                    API.pageDK.config &&\\n                    API.pageDK.config.record &&\\n                    API.pageDK.config.record.candidate &&\\n                    typeof API.pageDK.config.record.candidate.id !== \\\"undefined\\\") {\\n                    candidateID = API.pageDK.config.record.candidate.id;\\n                }\\n                if (!candidateID) {\\n                    return Promise.resolve();\\n                }\\n                return app.getPlacementData(candidateID).then((placementData) => {\\n                    const brand = app.getBrand(placementData);\\n                    if (!brand) {\\n                        return Promise.resolve(null);\\n                    }\\n                    return app.commitChanges({\\n                        id: candidateID,\\n                        customText17: brand,\\n                    });\\n                });\\n            },\\n            hasFieldChanged: (field) => {\\n                if (!field) {\\n                    return false;\\n                }\\n                return (!field.pristine)\\n                    && (field.valueHistory.length > 1\\n                        && field.valueHistory[0] !== field.valueHistory[field.valueHistory.length - 1]);\\n            },\\n            commitChanges: (changeObject) => {\\n                const url = `${API.http.restURL}entity/Candidate/${changeObject.id}`;\\n                return API.http.post(url, changeObject).toPromise().then(() => {\\n                    console.log('committed');\\n                    return Promise.resolve(null);\\n                }).catch(() => {\\n                    console.error('could not update working brand on candidate');\\n                    return Promise.resolve(null);\\n                });\\n            },\\n            getBrand: (data) => {\\n                if (!data || data.length === 0)\\n                    return null;\\n                if (data.length === 1) {\\n                    return data[0].correlatedCustomText3;\\n                }\\n                const latest = data[0];\\n                const status = form.controls[app.statusField];\\n                if (app.hasFieldChanged(status) && status.value === 'Approved' && latest.id === API.currentEntityId) {\\n                    return latest.correlatedCustomText3;\\n                }\\n                return null;\\n            },\\n            getPlacementData: (candidateID) => {\\n                const query = {\\n                    fields: 'id,status,correlatedCustomText3',\\n                    where: `candidate.id = ${candidateID}`,\\n                    sortBy: \\\"-dateBegin\\\",\\n                    count: 100\\n                };\\n                const url = `${API.http.restURL}query/Placement`;\\n                return API.http.post(url, query).toPromise().then((response) => {\\n                    return Promise.resolve(response.data);\\n                });\\n            }\\n        };\\n        if (API.currentEntity === 'Placement') {\\n            console.log('update-candidate-working-brand-on-status-change-1218');\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":1,\"dateLastModified\":1754662414173},{\"id\":1837,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2739806,\"firstName\":\"Phillip\",\"lastName\":\"Harrington TS npe2\"},\"name\":\"pre test\",\"page\":\"record\",\"enabled\":true,\"script\":\"console.log('web response pre test')\",\"sortOrder\":1,\"dateLastModified\":1715185748803},{\"id\":1838,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2739806,\"firstName\":\"Phillip\",\"lastName\":\"Harrington TS npe2\"},\"name\":\"post test\",\"page\":\"record\",\"enabled\":true,\"script\":\"console.log('web response post test')\",\"sortOrder\":1,\"dateLastModified\":1715185760547},{\"id\":2158,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2253,\"firstName\":\"Jamie\",\"lastName\":\"Stacey\"},\"name\":\"test\",\"page\":\"record\",\"enabled\":true,\"script\":\"console.log(API);\\nconsole.log(form);\\nconsole.log('job submission post save test for multiple matches')\",\"sortOrder\":1,\"dateLastModified\":1724939916137},{\"id\":1769,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":20172333,\"firstName\":\"Newbury\",\"lastName\":\"Admin User NPE\"},\"name\":\"3-candidate-status-check-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"        const controller = {\\n            baseUrl: API.http.restURL,\\n            INVALID_STATUSES: [\\n                'Clinical Review',\\n                'Not Qualified',\\n                'Inactive',\\n                'Terminated',\\n                'Deceased',\\n                'Do Not Contact',\\n                'Prospect',\\n                'New Lead',\\n            ],\\n            async init() {\\n                console.log('Initializing candidate submission status validation - NK');\\n                let candidateID = '';\\n                if (!API.currentEntityId) {\\n                    candidateID = form.controls.candidate.value[0].id;\\n                }\\n                else {\\n                    candidateID = form.controls.candidate.value.id;\\n                }\\n                const result = await controller.getCandidateDetails(candidateID);\\n                if (controller.INVALID_STATUSES.includes(result)) {\\n                    form.isFormValid = false;\\n                    form.errorMessage = 'Candidate status invalid';\\n                }\\n                return form;\\n            },\\n            async getCandidateDetails(candidateID) {\\n                console.log('NK - Getting candidate details for ID: ' + candidateID);\\n                const url = `${controller.baseUrl}/search/Candidate?fields=id,status&query=id:${candidateID}`;\\n                try {\\n                    const result = await API.http.get(url).toPromise();\\n                    return result.data[0].status;\\n                }\\n                catch (err) {\\n                    console.log(err);\\n                    throw err;\\n                }\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && form.isFormValid === true && API.pageContext !== 'MoveToPlacement') {\\n            return controller.init();\\n        }\\n        return Promise.resolve(form);\\n\",\"sortOrder\":1,\"dateLastModified\":1774049557627},{\"id\":2307,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":20172333,\"firstName\":\"Newbury\",\"lastName\":\"Admin User NPE\"},\"name\":\"738-prevent-duplicate-placement-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            baseUrl: API.http.restURL,\\n            existingSubmissionError: 'There already exists a placement on this job with this candidate.',\\n            submissionFields: [],\\n            init: function () {\\n                // See if a placement exists with the same job and candidate.\\n                // If so, prevent save\\n                var candidate = form.data.candidate;\\n                var job = form.data.jobOrder;\\n                if (candidate && job) {\\n                    var promises = [];\\n                    return app.findExistingPlacement(candidate.id, job.id).then(function (results) {\\n                        if (results.length > 0) {\\n                            form.isFormValid = false;\\n                            form.errorMessage = app.existingSubmissionError;\\n                        }\\n                        return form;\\n                    });\\n                    // return Promise.all(promises).then((placements) => {\\n                    //   placements.forEach((placementList) => {\\n                    //     if (placementList.length > 0) {\\n                    //       form.isFormValid = false;\\n                    //       form.errorMessage = app.existingSubmissionError;\\n                    //     }\\n                    //   });\\n                    //   return form;\\n                    // });\\n                }\\n                // if (candidates && candidates.length > 0 && jobs && jobs.length > 0) {\\n                //   const promises = [];\\n                //   jobs.forEach((job) => {\\n                //     candidates.forEach((candidate) => {\\n                //       promises.push(app.findExistingPlacement(candidate.id, job.id));\\n                //     });\\n                //   });\\n                //   return Promise.all(promises).then((placements) => {\\n                //     placements.forEach((placementList) => {\\n                //       if (placementList.length > 0) {\\n                //         form.isFormValid = false;\\n                //         form.errorMessage = app.existingSubmissionError;\\n                //       }\\n                //     });\\n                //     return form;\\n                //   });\\n                // }\\n                return form;\\n            },\\n            findExistingPlacement: function (candidateId, jobId) {\\n                var url = app.baseUrl + \\\"query/Placement?where=candidate.id=\\\" + candidateId + \\\" AND jobOrder.id=\\\" + jobId + \\\"&fields=id\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n        };\\n        console.log('prevent-duplicate');\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":2,\"dateLastModified\":1774049216020},{\"id\":2591,\"action\":\"overview-field-modify\",\"modifyingUser\":{\"id\":20172287,\"firstName\":\"interactionapiuser\",\"lastName\":\"ingenovisnp\"},\"name\":\"contract-created-toggle-1218_SOLEN-8182\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            toggleField: 'customFloat1',\\n            brandField: 'customText20',\\n            init() {\\n                // The toggle field is a float as you can see. This means if we were to display text on it, it would render as NaN.\\n                //  Instead, change the render type so we can display text.\\n                field.dataType = 'String';\\n                field.dataSpecialization = 'STRING';\\n                return app.getOpportunity().then(app.handleOpportunity);\\n            },\\n            handleOpportunity(entity) {\\n                const defaultValue = entity[app.toggleField] || 0;\\n                if (defaultValue === 1) {\\n                    data[app.toggleField] = 'Contract already Generated';\\n                }\\n                else {\\n                    data[app.toggleField] = 'Click here to Generate';\\n                    field.onClick = () => {\\n                        console.log('Opportunity - contract-created-toggle-1218', data, API);\\n                        API.appBridge.httpPOST(`entity/Opportunity/${API.currentEntityId}`, {\\n                            [app.toggleField]: 1,\\n                        }).then(() => {\\n                            data[app.toggleField] = 'Created. Reloading...';\\n                            field.className = '';\\n                            field.onClick = null;\\n                            API.appBridge.open({\\n                                type: 'record', entityType: 'Opportunity', entityId: API.currentEntityId,\\n                            });\\n                        });\\n                    };\\n                }\\n                return Promise.resolve(data);\\n            },\\n            // : Promise<{} | undefined>\\n            getOpportunity() {\\n                return API.appBridge.httpGET(`/entity/Opportunity/${API.currentEntityId}?fields=${app.brandField},${app.toggleField}`).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data;\\n                    }\\n                    return undefined;\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'Opportunity' && field.name === app.toggleField) {\\n            console.log('Opportunity - contract-created-toggle-1218', field, data, API);\\n            return app.init();\\n        }\\n        return Promise.resolve(data);\",\"sortOrder\":5,\"dateLastModified\":1776444591757},{\"id\":2018,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2256,\"firstName\":\"Leonardo\",\"lastName\":\"Salatino\"},\"name\":\"submission-offer-accepted-validations\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                if (form.controls.status.value === 'Offer Accepted') {\\r\\n                    if (API.pageContext === 'Record') {\\r\\n                        // JobSubmission page\\r\\n                        var assRec = form.controls.customText10 ? form.controls.customText10.value : null;\\r\\n                        var csm = form.controls.customText19 ? form.controls.customText19.value : null;\\r\\n                        var startDt = form.controls.startDate ? form.controls.startDate.value : null;\\r\\n                        var drugZip = form.controls.customTextBlock5 ? form.controls.customTextBlock5.value : null;\\r\\n                        var compDt = form.controls.customDate1 ? form.controls.customDate1.value : null;\\r\\n                        // + 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n                        // return app.validateFields(assRec, csm, startDt, drugZip, compDt);\\r\\n                        var endDt = form.controls.endDate ? form.controls.endDate.value : null;\\r\\n                        return app.validateFields(assRec, csm, startDt, drugZip, compDt, endDt);\\r\\n                        // - 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n                    }\\r\\n                    else {\\r\\n                        // MoveToConfirmed activity\\r\\n                        return app.getJobSubmissionDetails(API.currentEntityId).then(function (result) {\\r\\n                            var assRec = result.customText10;\\r\\n                            var csm = result.customText19;\\r\\n                            var startDt = result.startDate;\\r\\n                            var drugZip = result.customTextBlock5;\\r\\n                            var compDt = result.customDate1;\\r\\n                            // + 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n                            // return app.validateFields(assRec, csm, startDt, drugZip, compDt);\\r\\n                            var endDt = result.endDate;\\r\\n                            return app.validateFields(assRec, csm, startDt, drugZip, compDt, endDt);\\r\\n                            // - 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n                        });\\r\\n                    }\\r\\n                }\\r\\n                return Promise.resolve();\\r\\n            },\\r\\n            getJobSubmissionDetails: function (submissionID) {\\r\\n                // + 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n                // const url = `${app.baseUrl}/query/JobSubmission?fields=customText10,customText19,startDate,customDate1,customTextBlock5&where=id=${submissionID}`;\\r\\n                var url = app.baseUrl + \\\"/query/JobSubmission?fields=customText10,customText19,startDate,customDate1,customTextBlock5,endDate&where=id=\\\" + submissionID;\\r\\n                // - 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    var finalresult = result.data[0];\\r\\n                    return Promise.resolve(finalresult);\\r\\n                }, function (err) {\\r\\n                    console.error(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n            // + 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n            // validateFields: (assRec, csm, startDt, drugZip, compDt) => {\\r\\n            validateFields: function (assRec, csm, startDt, drugZip, compDt, endDt) {\\r\\n                // - 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n                // Assigned Recruiter\\r\\n                if (assRec === '' || assRec == null || assRec === undefined) {\\r\\n                    form.isFormValid = false;\\r\\n                    form.errorMessage = (form.controls.customText10 ? form.controls.customText10.label : 'Assigned Recruiter') + \\\" is Required to set an Offer Accepted\\\";\\r\\n                }\\r\\n                else {\\r\\n                    // CSM\\r\\n                    if (csm === '' || csm == null || csm === undefined) {\\r\\n                        form.isFormValid = false;\\r\\n                        form.errorMessage = (form.controls.customText19 ? form.controls.customText19.label : 'CSM') + \\\" is Required to set an Offer Accepted\\\";\\r\\n                    }\\r\\n                    else {\\r\\n                        // Start Date\\r\\n                        if (startDt === '' || startDt == null || startDt === undefined) {\\r\\n                            form.isFormValid = false;\\r\\n                            form.errorMessage = (form.controls.startDate ? form.controls.startDate.label : 'Start Date') + \\\" is Required to set an Offer Accepted\\\";\\r\\n                        }\\r\\n                        else {\\r\\n                            // Drug Test Zip Code\\r\\n                            if (drugZip === '' || drugZip == null || drugZip === undefined) {\\r\\n                                form.isFormValid = false;\\r\\n                                form.errorMessage = (form.controls.customTextBlock5 ? form.controls.customTextBlock5.label : 'Drug Test Zip Code') + \\\" is Required to set an Offer Accepted\\\";\\r\\n                            }\\r\\n                            else {\\r\\n                                // Compliance Due Date\\r\\n                                if (compDt === '' || compDt == null || compDt === undefined) {\\r\\n                                    form.isFormValid = false;\\r\\n                                    form.errorMessage = (form.controls.customDate1 ? form.controls.customDate1.label : 'Compliance Due Date') + \\\" is Required to set an Offer Accepted\\\";\\r\\n                                    // + 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n                                    // }\\r\\n                                }\\r\\n                                else {\\r\\n                                    // End Date\\r\\n                                    if (endDt === '' || endDt == null || endDt === undefined) {\\r\\n                                        form.isFormValid = false;\\r\\n                                        form.errorMessage = (form.controls.endDate ? form.controls.endDate.label : 'End Date') + \\\" is Required to set an Offer Accepted\\\";\\r\\n                                    }\\r\\n                                }\\r\\n                                // - 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n                            }\\r\\n                        }\\r\\n                    }\\r\\n                }\\r\\n            },\\r\\n        };\\r\\n        // + 1218 Global  -  Leonardo Ariel Salatino - 24-07-26 - Support #617\\r\\n        // Offer Accepted is now the Match status when the Placement is being created\\r\\n        // if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement') {\\r\\n        if (API.currentEntity === 'JobSubmission') {\\r\\n            // - 1218 Global  -  Leonardo Ariel Salatino - 24-07-26 - Support #617\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":5,\"dateLastModified\":1722005111340},{\"id\":2019,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":20517112,\"firstName\":\"Trustaff NPE\",\"lastName\":\"BH\"},\"name\":\"1218G. Submission Validations\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            // + 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n            // SUBMISSION_DETAILS_FIELDS: 'status',\\r\\n            SUBMISSION_DETAILS_FIELDS: 'status,customText10',\\r\\n            // - 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n            validateSubmission: function () {\\r\\n                return new Promise(function (resolve) {\\r\\n                    var submissionId = null;\\r\\n                    switch (API.pageContext) {\\r\\n                        case '': // Change Status\\r\\n                        case 'MoveToConfirmed':\\r\\n                        case 'MoveToInterviewing':\\r\\n                        case 'MoveToRejected':\\r\\n                        case 'MoveToClientSubmission': {\\r\\n                            submissionId = API.currentEntityId;\\r\\n                            break;\\r\\n                        }\\r\\n                        default: {\\r\\n                            var pageContextName = 'selected';\\r\\n                            if (API.pageContext[pageContextName]) {\\r\\n                                submissionId = API.pageContext[pageContextName][0].id;\\r\\n                            }\\r\\n                            break;\\r\\n                        }\\r\\n                    }\\r\\n                    if (submissionId !== undefined && submissionId !== null && submissionId !== '') {\\r\\n                        return app.getSubmissionDetails(submissionId).then(function (submission) {\\r\\n                            // + 1218 Global  -  Leonardo Ariel Salatino - 24-07-26 - Support #617\\r\\n                            // Offer Accepted is now the Match status when the Placement is being created\\r\\n                            // if (submission.status === 'Placed') {\\r\\n                            //     form.errorMessage = 'Placed Submissions cannot be moved';\\r\\n                            if (submission.status === 'Offer Accepted') {\\r\\n                                form.errorMessage = 'Offer Accepted Submissions cannot be moved';\\r\\n                                // - 1218 Global  -  Leonardo Ariel Salatino - 24-07-26 - Support #617\\r\\n                            }\\r\\n                            // + 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n                            if (submission.customText10 === null || submission.customText10 === undefined || !submission.customText10.includes('|')) {\\r\\n                                form.errorMessage = 'Assigned Recruiter must contain the character \\\"|\\\"';\\r\\n                            }\\r\\n                            // - 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\r\\n                            if (form.errorMessage) {\\r\\n                                form.isFormValid = false;\\r\\n                            }\\r\\n                            return resolve(form.errorMessage);\\r\\n                        });\\r\\n                    }\\r\\n                    return resolve(null);\\r\\n                });\\r\\n            },\\r\\n            getSubmissionDetails: function (ID) {\\r\\n                var url = app.baseUrl + \\\"/query/JobSubmission?fields=\\\" + app.SUBMISSION_DETAILS_FIELDS + \\\"&where=id=\\\" + ID;\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data[0]);\\r\\n                }, function (err) {\\r\\n                    console.error(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && form.isFormValid === true) {\\r\\n            if (API.pageContext !== 'MoveToPlacement') {\\r\\n                return app.validateSubmission();\\r\\n            }\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":10,\"dateLastModified\":1776303919367},{\"id\":2080,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zweli\",\"lastName\":\"Mphanza\"},\"name\":\"placement-validation-onapproval-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"// 1218 Global - 22/08/05 - Leonardo Ariel Salatino\\r\\n        // Placement validations\\r\\n        const app = {\\r\\n            placementId: API.currentEntityId,\\r\\n            statusToCheck: 'Approved',\\r\\n            errorMessage: '',\\r\\n            placementFieldsToCheck: [\\r\\n                'customText9',\\r\\n                'customText8',\\r\\n                'timeAndExpense.timeAndExpenseSource',\\r\\n                'approvingUserID',\\r\\n                'billingProfile',\\r\\n                // 'customText41',\\r\\n                'workWeekStart',\\r\\n                'timesheetCycle',\\r\\n                'location',\\r\\n                'timeAndExpense.employeeOtType',\\r\\n                'timeAndExpense.approvalMethod',\\r\\n                'timeAndExpense.timeAndExpenseBranch',\\r\\n                'timeAndExpense.rounding',\\r\\n                'timeAndExpense.inOutIndicator',\\r\\n                'employeeType',\\r\\n            ],\\r\\n            // Initialize\\r\\n            init: () => {\\r\\n                const placement = form.controls;\\r\\n                return app.validate(placement);\\r\\n            },\\r\\n            // Checks if we should run validations\\r\\n            shouldValidationsRun() {\\r\\n                const selectedStatus = form.controls.status.value;\\r\\n                return app.statusToCheck === selectedStatus;\\r\\n            },\\r\\n            // Get associated entities\\r\\n            getPlacementAssociations() {\\r\\n                const fields = 'id,candidate(id,address(address1,city,countryID,state,zip))';\\r\\n                const url = `entity/Placement/${API.currentEntityId}?fields=${fields}`;\\r\\n                return new Promise((resolve) => {\\r\\n                    API.appBridge.httpGET(url).then((result) => {\\r\\n                        if (result.data.data) {\\r\\n                            resolve(result.data.data);\\r\\n                        }\\r\\n                        else {\\r\\n                            resolve(null);\\r\\n                        }\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            // Run the validations\\r\\n            validate(placementForm) {\\r\\n                return app.getPlacementAssociations().then((placement) => {\\r\\n                    // Placement fields\\r\\n                    app.placementFieldsToCheck.forEach((field) => {\\r\\n                        if (placementForm[field]) {\\r\\n                            if (placementForm[field].value === null || placementForm[field].value === '') {\\r\\n                                app.errorMessage += `Please update ${placementForm[field].label}.\\\\n`;\\r\\n                            }\\r\\n                        }\\r\\n                    });\\r\\n                    if (app.errorMessage) {\\r\\n                        form.isFormValid = false;\\r\\n                        API.displayToast({\\r\\n                            title: 'Placement validations for BTE',\\r\\n                            icon: 'caution',\\r\\n                            theme: 'danger',\\r\\n                            position: 'fixedTop',\\r\\n                            hideDelay: 4000,\\r\\n                            message: app.errorMessage,\\r\\n                        });\\r\\n                        app.errorMessage = `PLACEMENT VALIDATION FOR BTE\\\\n${app.errorMessage}`;\\r\\n                        form.errorMessage = app.errorMessage;\\r\\n                    }\\r\\n                    return form;\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        console.log('approval validations');\\r\\n        if (API.currentEntity === 'Placement' && app.shouldValidationsRun()) {\\r\\n            return app.init();\\r\\n        }\\r\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1767733451873},{\"id\":2209,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":12559379,\"firstName\":\"IGH BTE\",\"lastName\":\"API\"},\"name\":\"prevent-duplicate-pcr-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            init: function () {\\r\\n                return app.findOtherPcrs().then(function (pcrList) {\\r\\n                    if (pcrList.length > 0) {\\r\\n                        form.isFormValid = false;\\r\\n                        form.errorMessage = 'There can not be more than one Change Request on this Placement.';\\r\\n                    }\\r\\n                });\\r\\n            },\\r\\n            findOtherPcrs: function () {\\r\\n                var placementId = form.data.placement.id;\\r\\n                var where = \\\"placement.id=\\\" + placementId + \\\" AND (requestStatus='Submitted' OR requestStatus='Revision Needed')\\\";\\r\\n                var url = \\\"query/PlacementChangeRequest?where=\\\" + where + \\\"&fields=id&count=1\\\";\\r\\n                return API.appBridge.httpGET(url).then(function (result) {\\r\\n                    return Promise.resolve(result.data.data);\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        console.log('prevent-duplicate-pcr');\\r\\n        if (API.currentEntity === 'PlacementChangeRequest' && API.pageContext === 'FastAdd') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1725551075837},{\"id\":2319,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zweli\",\"lastName\":\"Mphanza\"},\"name\":\"Placementdefaultsonadd\",\"page\":\"record\",\"enabled\":true,\"script\":\"const transformFuntions = {\\n            CustomPickerInternalRegex: /^.* \\\\| ([\\\\d]+)$/,\\n            toCustomPickerInternal: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (!fromValue) {\\n                    transformFuntions.setValue(mapItem.toField, changeObject, '');\\n                    return;\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, `${fromValue.firstName} ${fromValue.lastName} | ${fromValue.id}`);\\n            },\\n            fromCustomPickerInternal: (mapItem, data, changeObject) => {\\n                let value = '';\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (fromValue && transformFuntions.CustomPickerInternalRegex.test(fromValue)) {\\n                    value = fromValue.match(transformFuntions.CustomPickerInternalRegex)[1];\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, (value === '') ? '' : parseInt(value));\\n            },\\n            toCustomPickerSpecialty: (mapItem, data, changeObject) => {\\n                let value = '';\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (fromValue && fromValue.data && fromValue.data.length > 0) {\\n                    value = fromValue.data[0].name;\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, value);\\n            },\\n            addressToTextBox: (mapItem, data, changeObject) => {\\n                let value = '';\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (fromValue) {\\n                    const address = fromValue;\\n                    value = (address.address1) ? address.address1.trim() : '';\\n                    value = (value !== '' && address.address2) ? `${value}, ${address.address2.trim()}` : ((address.address2) ? address.address2.trim() : value);\\n                    value = (value !== '' && address.city) ? `${value}, ${address.city}` : ((address.city) ? address.city : value);\\n                    value = (value !== '' && address.stateName) ? `${value}, ${address.stateName}` : ((address.stateName) ? address.stateName : value);\\n                    value = (value !== '' && address.countryName) ? `${value}, ${address.countryName}` : ((address.countryName) ? address.countryName : value);\\n                    value = (value !== '' && address.zip) ? `${value} ${address.zip}` : ((address.zip) ? address.zip : value);\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, value);\\n            },\\n            stringToInt: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (!fromValue || fromValue === '') {\\n                    return;\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, parseInt(fromValue));\\n            },\\n            setDate: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (!fromValue || fromValue === '') {\\n                    return;\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, fromValue);\\n            },\\n            setUTCDate: (mapItem, data, changeObject) => {\\n                const originalDate = transformFuntions.getValue(mapItem, data);\\n                console.log('originalDate', originalDate);\\n                if (!originalDate)\\n                    return;\\n                const date = new Date(originalDate);\\n                const utcMidnight = Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate());\\n                const modifiedDate = utcMidnight + (12 * 60 * 60 * 1000);\\n                console.log('modifiedDate', modifiedDate);\\n                transformFuntions.setValue(mapItem.toField, changeObject, modifiedDate);\\n            },\\n            setCredentialingDepartment: (mapItem, data, changeObject) => {\\n                console.log('setCredentialingDepartment');\\n                if (API.globals && API.globals.user && API.globals.user.departmentName) {\\n                    const departmentMap = {\\n                        Fastaff: 'FS',\\n                        Trustaff: 'TTN',\\n                        USN: 'USN',\\n                        Springboard: 'SPR',\\n                        Vital: 'VITAL',\\n                        HCS: 'HCS',\\n                    };\\n                    transformFuntions.setValue(mapItem.toField, changeObject, departmentMap[API.globals.user.departmentName]);\\n                }\\n            },\\n            getValue: (item, data) => {\\n                if (!item.entity) {\\n                    return data[item.fromField];\\n                }\\n                const entityArr = item.entity.split('.');\\n                let retVal = data[entityArr[0]];\\n                if (retVal && entityArr.length > 1) {\\n                    retVal = retVal[entityArr[1]];\\n                }\\n                return (retVal) ? retVal[item.fromField] : null;\\n            },\\n            setValue: (tofield, changeObject, value) => {\\n                const toFieldArr = tofield.split('.');\\n                let i = 0;\\n                let co = changeObject;\\n                for (i; i < toFieldArr.length - 1; i += 1) {\\n                    if (!co[toFieldArr[i]]) {\\n                        co[toFieldArr[i]] = {};\\n                    }\\n                    co = co[toFieldArr[i]];\\n                }\\n                co[toFieldArr[toFieldArr.length - 1]] = value;\\n            },\\n            categoriesToWorkdayProduct: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                const jsonMap = [{\\n                        output: 'ALLI',\\n                        categories: [\\n                            'Allied - Cardiopulmonary',\\n                            'Allied - General',\\n                            'Allied - Laboratory',\\n                            'Allied - Leadership',\\n                            'Allied - Pharmacy',\\n                            'Allied - Radiology',\\n                            'Allied - Therapy',\\n                        ],\\n                    }, {\\n                        output: 'MEDL',\\n                        categories: [\\n                            'Nursing - APRN',\\n                            'Nursing - Leadership',\\n                            'Nursing - LPN',\\n                            'Nursing - RN',\\n                        ],\\n                    }, {\\n                        output: 'DOCS',\\n                        categories: [\\n                            'Physician - Cardiac Surgeon',\\n                            'Physician - Electrophysiologist',\\n                            'Physician - Interventional Cardiologist',\\n                            'Physician - Invasive Cardiologist',\\n                            'Physician - Non-Invasive Cardiologist',\\n                        ],\\n                    }];\\n                const url = `${API.http.restURL}entity/JobOrder/${fromValue}?fields=categories`;\\n                return API.http.get(url).toPromise().then((response) => {\\n                    const categories = response.data.categories;\\n                    if (!categories || !categories.data || !Array.isArray(categories.data) || categories.data.length === 0) {\\n                        return Promise.resolve(null);\\n                    }\\n                    const result = jsonMap.filter((x) => {\\n                        return x.categories.includes(categories.data[0].name);\\n                    });\\n                    if (result && result.length > 0) {\\n                        transformFuntions.setValue(mapItem.toField, changeObject, result[0].output);\\n                    }\\n                    return Promise.resolve(null);\\n                });\\n            },\\n            // +  Leonardo Ariel Salatino - 23-05-15 - Support #17\\n            specialtiesToText: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                const url = `${API.http.restURL}entity/JobOrder/${fromValue}?fields=specialties`;\\n                return API.http.get(url).toPromise().then((response) => {\\n                    const specialties = response.data.specialties;\\n                    if (!specialties || !specialties.data || !Array.isArray(specialties.data) || specialties.data.length === 0) {\\n                        return Promise.resolve(null);\\n                    }\\n                    const placSpec = [];\\n                    specialties.data.forEach((spec) => {\\n                        placSpec.push(spec.name);\\n                    });\\n                    if (placSpec && placSpec.length > 0) {\\n                        transformFuntions.setValue(mapItem.toField, changeObject, placSpec.join(';'));\\n                    }\\n                    return Promise.resolve(null);\\n                });\\n            },\\n            // -  Leonardo Ariel Salatino - 23-05-15 - Support #17\\n            // + David Adams - 8-1-2023 - Support #111\\n            toTimeAndExpenseSource: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                let outputValue = fromValue;\\n                if (!fromValue || fromValue === '') {\\n                    return;\\n                }\\n                if (fromValue === '3rd Party') {\\n                    outputValue = 'V';\\n                }\\n                else if (fromValue === 'Direct') {\\n                    outputValue = 'W';\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, outputValue);\\n            },\\n            // - David Adams - 8-1-2023 - Support #111\\n            // + David Adams - 8-3-2023 - Support #187\\n            toPlacementAddress: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                let outputValue = '';\\n                if (!fromValue || fromValue === '') {\\n                    return;\\n                }\\n                outputValue = `${fromValue.address1} ${fromValue.address2} ${fromValue.city}, ${fromValue.state}, ${fromValue.zip}, ${fromValue.countryCode}`;\\n                transformFuntions.setValue(mapItem.toField, changeObject, outputValue);\\n            },\\n            // - David Adams - 8-3-2023 - Support #187\\n            // +  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n            doNothing: (mapItem, data, changeObject) => {\\n                // Used to load the field value in the API request\\n            },\\n            overrideTimeAndExpenseBranch: (mapItem, data, changeObject) => {\\n                // If ITO then override the branch to ITO, otherwise use value from Billing Profile as usual\\n                const itoBrandName = 'ITO';\\n                let outputValue = null;\\n                if (data.jobOrder.correlatedCustomText3 === itoBrandName) {\\n                    outputValue = itoBrandName;\\n                }\\n                else {\\n                    outputValue = transformFuntions.getValue(mapItem, data);\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, outputValue);\\n            },\\n            // -  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n            addressPullState: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (!fromValue || fromValue === '') {\\n                    return;\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, fromValue.state);\\n            },\\n        };\\n        const app = {\\n            FlowDownConfig: {\\n                flowFromEntity: 'Placement',\\n                fieldMap: [\\n                    // +  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n                    {\\n                        toField: 'correlatedCustomText3', fromField: 'correlatedCustomText3', entity: 'jobOrder', transform: 'doNothing',\\n                    },\\n                    // -  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n                    { toField: 'customText44', fromField: 'customText19', entity: 'jobSubmission' },\\n                    { toField: 'customText35', fromField: 'customText19', entity: 'jobOrder' },\\n                    { toField: 'customText36', fromField: 'customText21', entity: 'jobOrder' },\\n                    {\\n                        toField: 'customText14', fromField: 'id', entity: 'jobOrder', transform: 'categoriesToWorkdayProduct',\\n                    },\\n                    { toField: 'customText38', fromField: 'customText21', entity: 'jobSubmission' },\\n                    {\\n                        toField: 'workWeekStart', fromField: 'customText22', entity: 'jobOrder', transform: 'stringToInt',\\n                    },\\n                    { toField: 'customText33', fromField: 'customTextBlock4', entity: 'jobSubmission' },\\n                    { toField: 'customText41', fromField: 'customText23', entity: 'jobOrder' },\\n                    { toField: 'customText39', fromField: 'customText6', entity: 'jobSubmission' },\\n                    { toField: 'bonusPackage', fromField: 'bonusPackage', entity: 'jobOrder' },\\n                    { toField: 'customInt1', fromField: 'customInt1', entity: 'jobOrder' },\\n                    // +  Leonardo Ariel Salatino - 24-03-08 - Support #382\\n                    // { toField: 'customText29', fromField: 'customText17', entity: 'jobOrder' },\\n                    { toField: 'customText29', fromField: 'customText7', entity: 'jobSubmission' },\\n                    // -  Leonardo Ariel Salatino - 24-03-08 - Support #382\\n                    { toField: 'customText31', fromField: 'customText16', entity: 'jobOrder' },\\n                    { toField: 'customText37', fromField: 'customText20', entity: 'jobSubmission' },\\n                    { toField: 'customText60', fromField: 'customText24', entity: 'jobSubmission' },\\n                    { toField: 'customText34', fromField: 'customText25', entity: 'jobSubmission' },\\n                    { toField: 'customText43', fromField: 'customText10', entity: 'jobSubmission' },\\n                    { toField: 'customText13', fromField: 'customText13', entity: 'jobSubmission' },\\n                    { toField: 'customText51', fromField: 'customTextBlock5', entity: 'jobSubmission' },\\n                    // +  Leonardo Ariel Salatino - 24-07-15 - Support #663\\n                    // +  Leonardo Ariel Salatino - 24-10-10 - Support #829\\n                    // Re enabled the removed code from #663\\n                    {\\n                        toField: 'dateBegin', fromField: 'startDate', entity: 'jobSubmission', transform: 'setDate',\\n                    },\\n                    // -  Leonardo Ariel Salatino - 24-10-10 - Support #829\\n                    // -  Leonardo Ariel Salatino - 24-07-15 - Support #663\\n                    // +  Leonardo Ariel Salatino - 23-08-23 - Support #208\\n                    // {\\n                    //   toField: 'customDate1', fromField: 'startDate', entity: 'jobSubmission', transform: 'setDate',\\n                    // },\\n                    // -  Leonardo Ariel Salatino - 23-08-23 - Support #208\\n                    // +  Leonardo Ariel Salatino - 24-07-15 - Support #663\\n                    // +  Leonardo Ariel Salatino - 24-10-10 - Support #829\\n                    // Re enabled the removed code from #663\\n                    {\\n                        toField: 'dateEnd', fromField: 'endDate', entity: 'jobSubmission', transform: 'setDate',\\n                    },\\n                    // -  Leonardo Ariel Salatino - 24-10-10 - Support #829\\n                    // -  Leonardo Ariel Salatino - 24-07-15 - Support #663\\n                    // +  Leonardo Ariel Salatino - 23-08-23 - Support #208\\n                    // {\\n                    //   toField: 'customDate2', fromField: 'endDate', entity: 'jobSubmission', transform: 'setDate',\\n                    // },\\n                    // -  Leonardo Ariel Salatino - 23-08-23 - Support #208\\n                    {\\n                        toField: 'customText42', fromField: 'sendingUser', entity: 'jobSubmission', transform: 'toCustomPickerInternal',\\n                    },\\n                    // +  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n                    // { toField: 'timeAndExpense.timeAndExpenseBranch', fromField: 'customText1', entity: 'jobOrder.billingProfile' },\\n                    {\\n                        toField: 'timeAndExpense.timeAndExpenseBranch', fromField: 'customText1', entity: 'jobOrder.billingProfile', transform: 'overrideTimeAndExpenseBranch',\\n                    },\\n                    // -  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n                    // +  Leonardo Ariel Salatino - 23-05-15 - Support #17\\n                    {\\n                        toField: 'customTextBlock10', fromField: 'id', entity: 'jobOrder', transform: 'specialtiesToText',\\n                    },\\n                    // -  Leonardo Ariel Salatino - 23-05-15 - Support #17\\n                    // +  Leonardo Ariel Salatino - 23-06-23 - Support #172\\n                    // { toField: 'customText8', fromField: 'customText8', entity: 'jobOrder.billingProfile' },\\n                    // -  Leonardo Ariel Salatino - 23-06-23 - Support #172\\n                    // + David Adams - 8-1-2023 - Support #111\\n                    {\\n                        toField: 'timeAndExpense.timeAndExpenseSource', fromField: 'customText2', entity: 'jobOrder.billingProfile', transform: 'toTimeAndExpenseSource',\\n                    },\\n                    // - David Adams - 8-1-2023 - Support #111\\n                    // +  David Adams - 08/23/23 - Support #187\\n                    {\\n                        toField: 'customTextBlock6', fromField: 'address', entity: 'jobOrder.clientCorporation', transform: 'toPlacementAddress',\\n                    },\\n                    // -  David Adams - 08/23/23 - Support #187\\n                    // +  David Adams - 08/23/23 - Support #182\\n                    {\\n                        toField: 'customDate4', fromField: 'customDate1', entity: 'jobSubmission', transform: 'setUTCDate',\\n                    },\\n                    // -  David Adams - 08/23/23 - Support #182\\n                    {\\n                        toField: 'customText30', fromField: 'address', entity: 'jobOrder.location', transform: 'addressPullState',\\n                    },\\n                    { toField: 'customText56', fromField: 'customText5', entity: 'jobOrder' },\\n                    { toField: 'customText57', fromField: 'customText6', entity: 'jobOrder' },\\n                    {\\n                        toField: 'customText56', fromField: 'customText5', entity: 'jobOrder',\\n                    },\\n                ],\\n            },\\n            init: () => {\\n                console.log('Entering Placementdefaultsonadd');\\n                const entityId = (form.data[0].data) ? form.data[0].data[0][0].changedEntityId : form.data[0][0].changedEntityId;\\n                if (!entityId) {\\n                    return form;\\n                }\\n                const changeObject = {\\n                    id: entityId,\\n                };\\n                return app.getFlowDownData(entityId).then((data) => {\\n                    const promises = app.setFlowDownData(data, changeObject);\\n                    return Promise.all(promises).then(() => {\\n                        return app.commitChanges(changeObject).then(() => {\\n                            console.log('Leaving Placementdefaultsonadd');\\n                            return Promise.resolve(form);\\n                        });\\n                    });\\n                });\\n            },\\n            commitChanges: (changeObject) => {\\n                const url = `${API.http.restURL}entity/Placement/${changeObject.id}`;\\n                return API.http.post(url, changeObject).toPromise();\\n            },\\n            getFlowDownData(entity) {\\n                if (!entity) {\\n                    return Promise.resolve(null);\\n                }\\n                const fields = {};\\n                app.FlowDownConfig.fieldMap.forEach((field) => {\\n                    const entityName = (field.entity) ? field.entity : 'PARENT';\\n                    if (fields[entityName]) {\\n                        fields[entityName].push(field.fromField);\\n                    }\\n                    else {\\n                        fields[entityName] = [field.fromField];\\n                    }\\n                });\\n                const efields = {};\\n                let fieldStr = '';\\n                Object.keys(fields).forEach((key) => {\\n                    const uFields = fields[key].sort().filter((el, i, a) => {\\n                        return !i || el !== a[i - 1];\\n                    });\\n                    const keyArr = key.split('.');\\n                    if (!efields[keyArr[0]]) {\\n                        efields[keyArr[0]] = [];\\n                    }\\n                    if (keyArr.length > 1) {\\n                        efields[keyArr[0]].push(`${keyArr[1]}(${uFields.join(',')})`);\\n                    }\\n                    else {\\n                        efields[keyArr[0]].push(...uFields);\\n                    }\\n                });\\n                Object.keys(efields).forEach((key) => {\\n                    fieldStr = (fieldStr !== '') ? `${fieldStr},` : '';\\n                    if (key === 'PARENT') {\\n                        fieldStr = `${fieldStr}${efields[key].join(',')}`;\\n                    }\\n                    else {\\n                        fieldStr = `${fieldStr}${key}(${efields[key].join(',')})`;\\n                    }\\n                });\\n                const url = `${API.http.restURL}entity/${app.FlowDownConfig.flowFromEntity}/${entity}?fields=${fieldStr}`;\\n                return API.http.get(url).toPromise().then((response) => {\\n                    return Promise.resolve(response.data);\\n                });\\n            },\\n            setFlowDownData: (data, changeObject) => {\\n                const promises = [];\\n                if (!data) {\\n                    return promises;\\n                }\\n                app.FlowDownConfig.fieldMap.forEach((item) => {\\n                    if (!item.transform) {\\n                        const fromValue = transformFuntions.getValue(item, data);\\n                        transformFuntions.setValue(item.toField, changeObject, (fromValue) || '');\\n                        return;\\n                    }\\n                    promises.push(transformFuntions[item.transform](item, data, changeObject));\\n                });\\n                return promises;\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1771354701373},{\"id\":2398,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19668073,\"firstName\":\"Keith\",\"lastName\":\"Daulton NPE2\"},\"name\":\"credential-details-flowdown-placement-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            entity: 'Placement',\\n            entityId: API.currentEntityId,\\n            fieldEntity: 'ClientCorporationCustomObjectInstance4',\\n            field: 'textBlock1',\\n            flowdownField: 'correlatedCustomTextBlock2',\\n            getFormControlValue: (field) => {\\n                if (!form.controls[field]) {\\n                    return null;\\n                }\\n                return form.controls[field].value;\\n            },\\n            init: () => {\\n                return app.getCompany().then((id) => {\\n                    if (!id) {\\n                        return;\\n                    }\\n                    // eslint-disable-next-line consistent-return\\n                    return app.getFirstCompanyCustomObject(id).then((value) => {\\n                        return app.updatePlacement(app.entityId, value);\\n                    });\\n                });\\n            },\\n            getCompany: () => {\\n                return API.appBridge.httpGET(`entity/${app.entity}/${app.entityId}?fields=clientCorporation(id)`).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data.clientCorporation.id;\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            getFirstCompanyCustomObject: (id) => {\\n                const url = `query/${app.fieldEntity}?fields=id,${app.field}&where=clientCorporation.id=${id}`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    if (result.data && result.data.data && result.data.data.length > 0) {\\n                        return result.data.data[0][app.field];\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            updatePlacement: (id, value) => {\\n                const url = `entity/Placement/${id}`;\\n                return API.appBridge.httpPOST(url, {\\n                    [app.flowdownField]: value,\\n                }).then(() => {\\n                    return Promise.resolve();\\n                });\\n            },\\n        };\\n        console.log('credential-details-flowdown-placement-1218', API.currentEntity, app.entity, app.entityId);\\n        if (API.currentEntity === app.entity) {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1753385194857},{\"id\":2399,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19668073,\"firstName\":\"Keith\",\"lastName\":\"Daulton NPE2\"},\"name\":\"credential-details-flowdown-custom-object-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            entity: 'ClientCorporationCustomObjectInstance4',\\n            entityId: API.currentEntityId,\\n            field: 'textBlock1',\\n            flowdownField: 'correlatedCustomTextBlock2',\\n            getFormControlValue: (field) => {\\n                if (!form.controls[field]) {\\n                    return null;\\n                }\\n                return form.controls[field].value;\\n            },\\n            init: () => {\\n                // get the company from the custom object\\n                // find all the placements and jobs that match the company\\n                // update the `flowdownField` in each placement and job with the value from the custom object `field`\\n                return app.getCompany().then((companyId) => {\\n                    if (!companyId) {\\n                        return;\\n                    }\\n                    const promises = Promise.all([\\n                        app.findPlacements(companyId),\\n                        app.findJobOrders(companyId),\\n                    ]);\\n                    // eslint-disable-next-line consistent-return\\n                    return promises.then((results) => {\\n                        const placements = results[0];\\n                        const jobOrders = results[1];\\n                        const value = app.getFormControlValue(app.field);\\n                        const placementPromises = placements.map((id) => {\\n                            return app.updatePlacement(id, value);\\n                        });\\n                        const jobOrderPromises = jobOrders.map((id) => {\\n                            return app.updateJobOrder(id, value);\\n                        });\\n                        return Promise.all([\\n                            ...placementPromises,\\n                            ...jobOrderPromises,\\n                        ]);\\n                    });\\n                });\\n            },\\n            getCompany: () => {\\n                return API.appBridge.httpGET(`entity/${app.entity}/${app.entityId}?fields=clientCorporation(id)`).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data.clientCorporation.id;\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            findPlacements: (id) => {\\n                const url = `query/Placement?fields=id&where=clientCorporation.id=${id}`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data.map((placement) => {\\n                            return placement.id;\\n                        });\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            findJobOrders: (id) => {\\n                const url = `query/JobOrder?fields=id&where=clientCorporation.id=${id}`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data.map((jobOrder) => {\\n                            return jobOrder.id;\\n                        });\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            updatePlacement: (id, value) => {\\n                const url = `entity/Placement/${id}`;\\n                return API.appBridge.httpPOST(url, {\\n                    [app.flowdownField]: value,\\n                }).then(() => {\\n                    return Promise.resolve();\\n                });\\n            },\\n            updateJobOrder: (id, value) => {\\n                const url = `entity/JobOrder/${id}`;\\n                return API.appBridge.httpPOST(url, {\\n                    [app.flowdownField]: value,\\n                }).then(() => {\\n                    return Promise.resolve();\\n                });\\n            },\\n        };\\n        console.log('credential-details-flowdown-custom-object-1218', API.currentEntity, app.entity);\\n        if (API.currentEntity === app.entity) {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1753382074753},{\"id\":2400,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19668073,\"firstName\":\"Keith\",\"lastName\":\"Daulton NPE2\"},\"name\":\"credential-details-flowdown-job-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            entity: 'JobOrder',\\n            entityId: form.data.changedEntityId,\\n            fieldEntity: 'ClientCorporationCustomObjectInstance4',\\n            field: 'textBlock1',\\n            flowdownField: 'correlatedCustomTextBlock2',\\n            getFormControlValue: (field) => {\\n                if (!form.controls[field]) {\\n                    return null;\\n                }\\n                return form.controls[field].value;\\n            },\\n            init: () => {\\n                return app.getCompany().then((id) => {\\n                    if (!id) {\\n                        return;\\n                    }\\n                    // eslint-disable-next-line consistent-return\\n                    return app.getFirstCompanyCustomObject(id).then((value) => {\\n                        return app.updateJobOrder(app.entityId, value);\\n                    });\\n                });\\n            },\\n            getCompany: () => {\\n                return API.appBridge.httpGET(`entity/${app.entity}/${app.entityId}?fields=clientCorporation(id)`).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data.clientCorporation.id;\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            getFirstCompanyCustomObject: (id) => {\\n                const url = `query/${app.fieldEntity}?fields=id,${app.field}&where=clientCorporation.id=${id}`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    if (result.data && result.data.data && result.data.data.length > 0) {\\n                        return result.data.data[0][app.field];\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            updateJobOrder: (id, value) => {\\n                const url = `entity/JobOrder/${id}`;\\n                return API.appBridge.httpPOST(url, {\\n                    [app.flowdownField]: value,\\n                }).then(() => {\\n                    return Promise.resolve();\\n                });\\n            },\\n        };\\n        console.log('credential-details-flowdown-job-1218', API.currentEntity, app.entity, app.entityId);\\n        if (API.currentEntity === app.entity) {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1753385587750},{\"id\":2401,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19668073,\"firstName\":\"Keith\",\"lastName\":\"Daulton NPE2\"},\"name\":\"add-credential-fields-from-placement-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            entityId: API.currentEntityId,\\n            entity: 'PlacementCertification',\\n            init: () => {\\n                return Promise.resolve();\\n            },\\n        };\\n        console.log('add-credential-fields-from-placement-1218', API.currentEntity, app.entity, form);\\n        if (API.currentEntity === app.entity) {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":10,\"dateLastModified\":1753848809847},{\"id\":1807,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2256,\"firstName\":\"Leonardo\",\"lastName\":\"Salatino\"},\"name\":\"1218G-Permissions Validation\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            BH1RecruiterUserType: '149897',\\r\\n            init: function () {\\r\\n                return new Promise(function (resolve) {\\r\\n                    if (!app.BH1RecruiterUserType || app.BH1RecruiterUserType.indexOf(API.globals.user.userTypeId.toString()) > -1) {\\r\\n                        form.errorMessage = 'Recruiters don\\\\'t have permission to save Company records';\\r\\n                    }\\r\\n                    if (form.errorMessage) {\\r\\n                        form.isFormValid = false;\\r\\n                    }\\r\\n                    return resolve(form.errorMessage);\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'ClientCorporation') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve(null);\",\"sortOrder\":10,\"dateLastModified\":1700522758087},{\"id\":2555,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zweli\",\"lastName\":\"Mphanza\"},\"name\":\"prevent-job-brand-mismatch-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            init: () => {\\n                const jobOrder = form.controls;\\n                const jobBrand = jobOrder.correlatedCustomText3.value;\\n                console.log('jobBrand', jobBrand);\\n                if (form.data && form.data.billingProfile && form.data.billingProfile.id) {\\n                    return app.getBillingProfile(form.data.billingProfile.id).then((billingProfile) => {\\n                        const billingProfileBrand = billingProfile.customText10;\\n                        if (billingProfileBrand !== jobBrand) {\\n                            form.isFormValid = false;\\n                            form.errorMessage = 'Job Brand does not match the Billing Profile brand';\\n                        }\\n                        return form;\\n                    });\\n                }\\n                return form;\\n            },\\n            getBillingProfile: (id) => {\\n                const url = `entity/BillingProfile/${id}?fields=id,customText10`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data;\\n                    }\\n                    return undefined;\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobOrder' && API.pageContext === 'FastAdd') {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1770623502887},{\"id\":2405,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zweli\",\"lastName\":\"Mphanza\"},\"name\":\"prevent-placement-creation-if-deal-sheet-missing-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"console.log('prevent-placement-creation-if-deal-sheet-missing-1218');\\n        const app = {\\n            dealSheetIDField: 'customText11',\\n            errorMsg: '\\\\nDeal Sheet ID missing; Submit Deal Sheet to link first and then create Placement. \\\\n',\\n            init: () => {\\n                console.log('prevent-placement-creation-if-deal-sheet-missing-1218');\\n                const submissionID = API.currentEntityId;\\n                if (!submissionID) {\\n                    return Promise.resolve(form);\\n                }\\n                return app.getSubmissionData(submissionID).then((data) => {\\n                    const dealSheetID = data.customText11;\\n                    const brand = data.customText17;\\n                    if (!dealSheetID && brand !== 'USN') {\\n                        if (form.errorMessage) {\\n                            form.errorMessage += app.errorMsg;\\n                        }\\n                        else {\\n                            form.errorMessage = app.errorMsg;\\n                        }\\n                        form.isFormValid = false;\\n                    }\\n                    return Promise.resolve(form);\\n                });\\n            },\\n            getSubmissionData: (submissionID) => {\\n                const url = `${API.http.restURL}entity/JobSubmission/${submissionID}?fields=id,customText11,customText17`;\\n                return API.http.get(url).toPromise().then((response) => {\\n                    return Promise.resolve(response.data);\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1756986468663},{\"id\":2593,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":20172335,\"firstName\":\"Trustaff DealSheet\",\"lastName\":\"Admin NPE\"},\"name\":\"copy ds data to placement\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            dealsheetPathAtPlacement: \\\"customText55\\\",\\n            clientName: \\\"Trustaff\\\",\\n            coInstance: \\\"2\\\",\\n            getPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id + \\\"?fields=id,employmentType,customText55,dateBegin,jobOrder(id,billingProfile(id),customInt1,correlatedCustomInt3,customFloat3,customText5,correlatedCustomFloat3,correlatedCustomFloat2),clientCorporation(customFloat2)\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getBillingCustomObject: function (jobId) {\\n                var url = \\\"query/JobOrderCustomObjectInstance\\\" + controller.coInstance + \\\"?where=jobOrder.id=\\\" + jobId + \\\"&fields=text1,text4,float1,float2,float3,float4,float5,float6,float7,float8,float9&count=500\\\"; // should never reach that count amount so no need for any recursive calls with more data\\n                return new Promise(function (resolve) {\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getJob: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/JobOrder/\\\" + id + \\\"?fields=id,skills,categories,customInt1\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getCurrentVersionUsingLoggedInUser: function (mainVerionId, versionDate) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return new Promise(function (resolve) {\\n                    var url = \\\"/entity/PlacementRateCard/\\\" + mainVerionId + \\\"?effectiveOn=\\\" + versionDate + \\\"&fields=id,placementRateCardLineGroups[200]\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getBasicVersionIdsUsingLoggedInUser: function (placementId, placementRateCardStatus) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"query/PlacementRateCard?where=placement.id=\\\" + placementId + \\\"&&fields=id,versions,placementRateCardStatusLookup(id,label)\\\";\\n                    API.appBridge.httpGET(url).then(function (response) {\\n                        console.log(\\\"responseresponseresponseresponse\\\", response);\\n                        console.log(\\\"placementRateCardStatus\\\", placementRateCardStatus);\\n                        if (response.data.data.length && response.data.data[0].placementRateCardStatusLookup.id !== placementRateCardStatus.id) {\\n                            API.appBridge.httpPOST(\\\"entity/PlacementRateCard/\\\" + response.data.data[0].id, {\\n                                placementRateCardStatusLookup: { id: placementRateCardStatus.id }\\n                            }).then(function (res2) {\\n                                resolve(response.data.data);\\n                            });\\n                        }\\n                        else {\\n                            resolve(response.data.data);\\n                        }\\n                    });\\n                });\\n            },\\n            updateExisitngPlacementRateCardUsingLoggedInUser: function (rate, mainVerionId) {\\n                console.log(\\\"updatedVersion\\\", rate);\\n                return new Promise(function (resolve) {\\n                    var url = \\\"/entity/PlacementRateCard/\\\" + mainVerionId;\\n                    API.appBridge.httpPOST(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            insertNewVersionUsingLoggedInUser: function (rate, mainVerionId) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"/entity/PlacementRateCard/\\\" + mainVerionId;\\n                    API.appBridge.httpPOST(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            saveRateBH1UsingLoggedInUser: function (rate) {\\n                console.log(\\\"Newbury copy DS to placement: saveRateBH1UsingLoggedInUser\\\");\\n                return new Promise(function (resolve) {\\n                    var url = '/entity/PlacementRateCard';\\n                    API.appBridge.httpPUT(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            getCurrentVersionFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    var query = {\\n                        query: {\\n                            type: 'getCurrentVersion',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"getCurrentVersionFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object getCurrentVersion', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"getCurrentVersionFunc error\\\", error);\\n                        controller.getCurrentVersionUsingLoggedInUser(data.mainVerionId, data.versionDate).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            getBasicVersionIdsFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    var query = {\\n                        query: {\\n                            type: 'getBasicVersionIds',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"getBasicVersionIdsFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object getBasicVersionIds', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"getBasicVersionIdsFunc error\\\", error);\\n                        controller.getBasicVersionIdsUsingLoggedInUser(data.placementId, data.placementRateCardStatus).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            updateExisitngPlacementRateCardFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    var query = {\\n                        query: {\\n                            type: 'updateExisitngPlacementRateCard',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"updateExisitngPlacementRateCardFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object updateExisitngPlacementRateCard', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"updateExisitngPlacementRateCardFunc error\\\", error);\\n                        controller.updateExisitngPlacementRateCardUsingLoggedInUser(data.rate, data.mainVerionId).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            insertNewVersionFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    var query = {\\n                        query: {\\n                            type: 'insertNewVersion',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"insertNewVersionFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object insertNewVersion', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"insertNewVersionFunc error\\\", error);\\n                        controller.insertNewVersionUsingLoggedInUser(data.rate, data.mainVerionId).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            saveRateBH1Func: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    var query = {\\n                        query: {\\n                            type: 'saveRateBH1',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"saveRateBH1Func response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object saveRateBH1', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"saveRateBH1Func error\\\", error);\\n                        controller.saveRateBH1UsingLoggedInUser(data.rate).then(function () { resolve(); });\\n                    });\\n                });\\n            },\\n            getDealsheet: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    var query = {\\n                        query: {\\n                            type: 'getMostIncrementedDs',\\n                            params: {\\n                                dealSheetId: id,\\n                            },\\n                            data: {}\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            },\\n            getBillingTerm: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"https://dev.trustaff.dl-sheet.com/billingTermsIntegration/getProfile/\\\" + id + \\\"?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1\\\";\\n                    fetch(url, {\\n                        method: 'get',\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('getBillingTerm ', data);\\n                        resolve(data);\\n                    });\\n                });\\n            },\\n            getHealthBenefitsRecords: function () {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/healthBenefits/healthBenefits/read?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    fetch(url, {\\n                        method: 'get',\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: healthBenefits', data);\\n                        resolve(data);\\n                    });\\n                });\\n            },\\n            mapBillRatesToObject: function (job, jobCo) {\\n                console.log(\\\"Newbury jobCo\\\", jobCo);\\n                var jobSpeciality = job.skills && job.skills.data && job.skills.data.length ? job.skills.data[0].name : \\\"\\\";\\n                var jobProfession = job.categories && job.categories.data && job.categories.data.length ? job.categories.data[0].name : \\\"\\\";\\n                var billRateObject, onCallRate, onCallRateObject, chargeRate, chargeRatebject, rate8Object, rate12Object, rate40Object, rate48Object, billRatebject, holidayRatebject, callBackRatebject, rate8, rate12, rate40, rate48, billRate, hoildayRate, callBackRate;\\n                if (controller.clientName == \\\"TaleMed\\\" || controller.clientName == \\\"HAN\\\") {\\n                    billRatebject = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float1 && item.float1 > 0; });\\n                    rate8Object = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float3 && item.float3 > 0; });\\n                    rate12Object = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float5 && item.float5 > 0; });\\n                    rate40Object = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float2 && item.float2 > 0; });\\n                    rate48Object = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float4 && item.float4 > 0; });\\n                    holidayRatebject = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float6 && item.float6 > 0; });\\n                    callBackRatebject = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float8 && item.float8 > 0; });\\n                    chargeRatebject = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float9 && item.float9 > 0; });\\n                    onCallRateObject = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float7 && item.float7 > 0; });\\n                    billRate = billRatebject ? billRatebject.float1 : 0;\\n                    rate8 = rate8Object ? rate8Object.float3 : 0;\\n                    rate12 = rate12Object ? rate12Object.float5 : 0;\\n                    rate40 = rate40Object ? rate40Object.float2 : 0;\\n                    rate48 = rate48Object ? rate48Object.float4 : 0;\\n                    hoildayRate = holidayRatebject ? holidayRatebject.float6 : 0;\\n                    callBackRate = callBackRatebject ? callBackRatebject.float8 : 0;\\n                    chargeRate = chargeRatebject ? chargeRatebject.float9 : 0;\\n                    onCallRate = onCallRateObject ? onCallRateObject.float7 : 0;\\n                }\\n                else {\\n                    billRateObject = jobCo.find(function (item) { return item.text1 === \\\"Bill Rate $\\\"; });\\n                    rate8Object = jobCo.find(function (item) { return item.text1 === \\\">8 Bill Rate\\\"; });\\n                    rate12Object = jobCo.find(function (item) { return item.text1 === \\\">12 Bill Rate\\\"; });\\n                    rate40Object = jobCo.find(function (item) { return item.text1 === \\\">40 Bill Rate\\\"; });\\n                    rate48Object = jobCo.find(function (item) { return item.text1 === \\\">48 Bill Rate\\\"; });\\n                    holidayRatebject = jobCo.find(function (item) { return item.text1 === \\\"Holiday Bill Rate\\\"; });\\n                    callBackRatebject = jobCo.find(function (item) { return item.text1 === \\\"Call Back Bill Rate\\\"; });\\n                    onCallRateObject = jobCo.find(function (item) { return item.text1 === \\\"On-Call Bill Rate\\\"; });\\n                    chargeRatebject = jobCo.find(function (item) { return item.text1 === \\\"Charge Rate\\\"; });\\n                    rate8 = rate8Object ? rate8Object.float1 : 0;\\n                    rate12 = rate12Object ? rate12Object.float1 : 0;\\n                    rate40 = rate40Object ? rate40Object.float1 : 0;\\n                    rate48 = rate48Object ? rate48Object.float1 : 0;\\n                    hoildayRate = holidayRatebject ? holidayRatebject.float1 : 0;\\n                    callBackRate = callBackRatebject ? callBackRatebject.float1 : 0;\\n                    chargeRate = chargeRatebject ? chargeRatebject.float1 : 0;\\n                    onCallRate = onCallRateObject ? onCallRateObject.float1 : 0;\\n                    billRate = billRateObject ? billRateObject.float1 : 0;\\n                }\\n                console.log(\\\"Newbury chargeRate\\\", chargeRate);\\n                billRateObject = {\\n                    billRate: billRate,\\n                    rate8: rate8,\\n                    rate12: rate12,\\n                    rate40: rate40,\\n                    rate48: rate48,\\n                    hoildayRate: hoildayRate,\\n                    callBackRate: callBackRate,\\n                    chargeRate: chargeRate,\\n                    onCallRate: onCallRate\\n                };\\n                return billRateObject;\\n            },\\n            updatePlacementUsingLoggedInUser: function (id, body) {\\n                console.log(\\\"Newbury copy DS to placement: updatePlacement params\\\", id, body);\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id;\\n                    API.appBridge.httpPOST(url, body).then(function (result) {\\n                        resolve(result);\\n                    });\\n                });\\n            },\\n            updatePlacementFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=XIgOK0HKzXc9hsDPHkrD7GygsrpJQhD1';\\n                    var query = {\\n                        query: {\\n                            type: 'updatePlacement',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"updatePlacementFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object updatePlacementFunc', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"updatePlacementFunc error\\\", error);\\n                        controller.updatePlacementUsingLoggedInUser(data.id, data.body).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            updatePlacement: function (id, body) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return controller.updatePlacementFunc({ id: id, body: body });\\n            },\\n            addRateObjects: function (dealsheet, placement) {\\n                return new Promise(function (resolve) {\\n                    console.log(\\\"Newbury copy DS to placement: rates\\\", dealsheet);\\n                    var otBillRate8, otBillRate12, otBillRate40, otBillRate48;\\n                    otBillRate8 = dealsheet.DealSheetClient.billableOT === \\\"Over 8\\\" ? dealsheet.DealSheetJob.otBillRate : 0;\\n                    otBillRate12 = dealsheet.DealSheetClient.billableOT === \\\"Over 12\\\" ? dealsheet.DealSheetJob.otBillRate : 0;\\n                    otBillRate40 = dealsheet.DealSheetClient.billableOT === \\\"Over 40\\\" ? dealsheet.DealSheetJob.otBillRate : 0;\\n                    otBillRate48 = dealsheet.DealSheetClient.billableOT === \\\"Over 48\\\" ? dealsheet.DealSheetJob.otBillRate : 0;\\n                    var rates = [\\n                        {\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\"Regular Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"Yes\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.regularPay || 0,\\n                            float2: dealsheet.DealSheetJob.billRate || 0 // job rates\\n                        },\\n                        {\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\"On-Call Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.onCallPayRate || 0,\\n                            float2: dealsheet.DealSheetJob.onCallBillRate || 0 // job rates\\n                        },\\n                        {\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\"Call Back Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.callBackPayRate || 0,\\n                            float2: dealsheet.DealSheetJob.callBackBillRate || 0 // job rates\\n                        },\\n                        {\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\"Holiday Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.hourlyPayRate || 0,\\n                            float2: dealsheet.DealSheetJob.holidayBill || 0 // job rates\\n                        },\\n                        {\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\"Charge Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.chargeBack || 0,\\n                            float2: dealsheet.DealSheetJob.chargeBillRate || 0 // job rates\\n                        }\\n                    ];\\n                    if (dealsheet.payRate8 && dealsheet.payRate8.length) {\\n                        rates.push({\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\">8 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate8 || 0,\\n                            float2: otBillRate8 || 0 // job rates\\n                        });\\n                    }\\n                    if (dealsheet.payRate12 && dealsheet.payRate12.length) {\\n                        rates.push({\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\">12 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate12 || 0,\\n                            float2: otBillRate12 || 0 // job rates\\n                        });\\n                    }\\n                    if (dealsheet.payRate40 && dealsheet.payRate40.length) {\\n                        rates.push({\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\">40 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate40 || 0,\\n                            float2: otBillRate40 || 0 // job rates\\n                        });\\n                    }\\n                    if (dealsheet.payRate3740 && dealsheet.payRate3740.length) {\\n                        rates.push({\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\"37-40 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate3740 || 0,\\n                            float2: dealsheet.DealSheetJob.billRate || 0 // job rates\\n                        });\\n                    }\\n                    if (dealsheet.payRate48 && dealsheet.payRate48.length) {\\n                        rates.push({\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\">48 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate48 || 0,\\n                            float2: otBillRate8 || 0 // job rates\\n                        });\\n                    }\\n                    var promiseArr = [];\\n                    rates.forEach(function (element, index) {\\n                        promiseArr.push(controller.saveRate(element, placement.id));\\n                    });\\n                    console.log(\\\"Newbury copy DS to placement: rates\\\", rates);\\n                    Promise.all(promiseArr).then(function () {\\n                        console.log(\\\"Newbury copy DS to placement: saving rates done\\\");\\n                        resolve();\\n                    });\\n                });\\n            },\\n            getCurrentVersion: function (mainVerionId, versionDate) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return controller.getCurrentVersionFunc({ mainVerionId: mainVerionId, versionDate: versionDate });\\n            },\\n            getBasicVersionIds: function (placementId, placementRateCardStatus) {\\n                return controller.getBasicVersionIdsFunc({ placementId: placementId, placementRateCardStatus: placementRateCardStatus });\\n            },\\n            updateExisitngPlacementRateCard: function (rate, mainVerionId) {\\n                console.log(\\\"updatedVersion\\\", rate);\\n                return controller.updateExisitngPlacementRateCardFunc({ rate: rate, mainVerionId: mainVerionId });\\n            },\\n            insertNewVersion: function (rate, mainVerionId) {\\n                return controller.insertNewVersionFunc({ rate: rate, mainVerionId: mainVerionId });\\n            },\\n            saveRateBH1: function (rate) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return controller.saveRateBH1Func({ rate: rate });\\n            },\\n            saveRate: function (rate, id) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return new Promise(function (resolve) {\\n                    rate.placement = { id: id };\\n                    var url = '/entity/PlacementCustomObjectInstance1';\\n                    API.appBridge.httpPUT(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            getEarnCodes: function () {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"query/EarnCode?where=id>0\\\" + \\\"&fields=id,title,code,earnCodeGroup&count=500\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        if (API.appBridge)\\n                            resolve(result.data.data);\\n                        else\\n                            resolve(result.data);\\n                    });\\n                });\\n            },\\n            mapEarnCodeArrToObj: function (earnCodes) {\\n                var earnCodesObj = {};\\n                earnCodes.forEach(function (item) {\\n                    earnCodesObj[item.code] = item;\\n                });\\n                return earnCodesObj;\\n            },\\n            getDTBillRateModifier: function (billingTerm) {\\n                var multipler = billingTerm.dt_multiplier;\\n                var addOn = billingTerm.dt_add_on;\\n                if (multipler && addOn) {\\n                    multipler = 1;\\n                    addOn = 0;\\n                }\\n                var modifier = multipler ? \\\"*\\\" + multipler : addOn ? \\\"+\\\" + addOn : \\\"*1\\\";\\n                return modifier;\\n            },\\n            getOTBillRateModifier: function (billingTerm) {\\n                var multipler = billingTerm.ot_multiplier;\\n                var addOn = billingTerm.ot_add_on;\\n                if (multipler && addOn) {\\n                    multipler = 1;\\n                    addOn = 0;\\n                }\\n                var modifier = multipler ? \\\"*\\\" + multipler : addOn ? \\\"+\\\" + addOn : \\\"*1\\\";\\n                return modifier;\\n            },\\n            getHolidayCallBackModifier: function (billingTerm, multiplier, addon) {\\n                if ((multiplier && addon) || (!multiplier && !addon)) {\\n                    var modifier = controller.getOTBillRateModifier(billingTerm);\\n                    return modifier;\\n                }\\n                if (multiplier) {\\n                    return \\\"*\\\" + multiplier;\\n                }\\n                if (addon) {\\n                    return \\\"+\\\" + addon;\\n                }\\n            },\\n            calculateRate: function (baseRate, modifier) {\\n                console.log('baseRate', baseRate, 'mod', modifier);\\n                var rateOperator, rateFactor;\\n                if (modifier && modifier.length && modifier[0] != \\\"*\\\" && modifier[0] != \\\"+\\\") {\\n                    rateOperator = '*';\\n                    rateFactor = modifier;\\n                }\\n                else {\\n                    modifier = modifier || '';\\n                    rateOperator = modifier[0] || '*';\\n                    rateFactor = modifier.slice(1) || '1';\\n                }\\n                var rate = 0;\\n                if (rateOperator === \\\"*\\\") {\\n                    rate = Number(baseRate) * Number(rateFactor);\\n                }\\n                else {\\n                    rate = Number(baseRate) + Number(rateFactor);\\n                }\\n                return rate;\\n            },\\n            calculateAdditionalCostRate: function (dealsheetData, item) {\\n                var amount;\\n                var shifts = dealsheetData.DealSheetJob.shifts;\\n                if (item.frequency === \\\"One-time\\\") {\\n                    if (item.calculation === \\\"$\\\") {\\n                        amount = Number(item.defaultAmount);\\n                    }\\n                    else {\\n                        if (item.calcAppliesTo !== \\\"Taxable Wages\\\") {\\n                            amount =\\n                                (Number(item.defaultAmount) * dealsheetData.assignmentRevenueAmount) / 100;\\n                        }\\n                        else {\\n                            amount =\\n                                (Number(item.defaultAmount) * dealsheetData.taxableWagesAmount) / 100;\\n                        }\\n                    }\\n                }\\n                else if (item.frequency == \\\"Weekly\\\") {\\n                    amount =\\n                        Number(item.defaultAmount) *\\n                            dealsheetData.DealSheetJob.contractLengthWeeks;\\n                }\\n                else if (item.frequency == \\\"Monthly\\\") {\\n                    amount =\\n                        (Number(item.defaultAmount) *\\n                            dealsheetData.DealSheetJob.contractLengthWeeks) /\\n                            4.34;\\n                }\\n                else if (item.frequency == \\\"Hourly\\\") {\\n                    amount =\\n                        Number(item.defaultAmount) * dealsheetData.totalPayableHours;\\n                }\\n                else if (item.frequency == \\\"Per Shift\\\") {\\n                    amount =\\n                        Number(item.defaultAmount) *\\n                            dealsheetData.DealSheetJob.contractLengthWeeks *\\n                            shifts;\\n                }\\n                return amount;\\n            },\\n            buildRateObjectBH1: function (dealsheet, earnCodes, placement, otPayRate, dtPayRate, placementRateCardStatus, advancedStateIndex, billingTerm) {\\n                return new Promise(function (resolve) {\\n                    console.log(\\\"Newbury copy DS to placement: buildRateObjectBH1 params\\\", dealsheet);\\n                    var otBillRate, dtBillRate, regPay, regBillRate, onCallPayRate, onCallBillRate, chargePayRate, chargeBillRate, holidayPayRate, holidayBillRate, callBackPayRate, callBackBillRate, totalStipend, totalStipendPerShift, totalLodgigPerShift, totalMiPerShift, orientationBillRate, calculatedDtBillRate, otChargePayRate, dtChargePayRate, otCallBackBillRate, dtCallBackBillRate, dtChargeBillRate, otHolidayBillRate, dtHolidayBillRate, otChargeBillRate, otHolidayPayRate, dtHolidayPayRate, otCallBackPayRate, dtCallBackePayRate, doubleTimeBillRateFromBillingTerm, originalOTBillRate, orientationOTPayRate, orientationDTPayRate, orientationOTBillRate, nonOrientationOTPayRate, nonOrientationDTPayRate, prepFeeRate, otChargeHoliday, dtChargeHoliday;\\n                    var stateSickCodeMapping = {\\n                        \\\"California\\\": \\\"CAS\\\",\\n                        \\\"Colorado\\\": \\\"COS\\\",\\n                        \\\"New York\\\": \\\"NYS\\\",\\n                        \\\"Arizona\\\": \\\"AZ\\\",\\n                        \\\"Washington\\\": \\\"WA\\\",\\n                        \\\"Connecticut\\\": \\\"CT\\\",\\n                        \\\"District Of Columbia\\\": \\\"DC\\\",\\n                        \\\"Maryland\\\": \\\"MD\\\",\\n                        \\\"Massachusetts\\\": \\\"MA\\\",\\n                        \\\"New Jersey\\\": \\\"NJ\\\",\\n                        \\\"Oregon\\\": \\\"OR\\\",\\n                        \\\"Rhode Island\\\": \\\"RI\\\",\\n                        \\\"Vermont\\\": \\\"VT\\\",\\n                        \\\"Michigan\\\": \\\"MIS\\\",\\n                        \\\"Maine\\\": \\\"MES\\\",\\n                        \\\"Nevada\\\": \\\"NV\\\",\\n                        \\\"New Mexico\\\": \\\"NMX\\\"\\n                    };\\n                    var sickCode = stateSickCodeMapping[dealsheet.DealSheetJob.jobState];\\n                    onCallBillRate = dealsheet.DealSheetJob.onCallBillRate || 0;\\n                    chargeBillRate = dealsheet.DealSheetJob.chargeBillRate || 0;\\n                    holidayBillRate = dealsheet.DealSheetJob.holidayBill || 0;\\n                    callBackBillRate = dealsheet.DealSheetJob.callBackBillRate || 0;\\n                    onCallPayRate = Number(dealsheet.onCallPayRate) || 0;\\n                    chargePayRate = Number(dealsheet.chargePay) || 0;\\n                    holidayPayRate = Number(dealsheet.hourlyPayRate) || 0;\\n                    callBackPayRate = Number(dealsheet.callBackPayRate) || 0;\\n                    otBillRate = Number(dealsheet.DealSheetJob.otBillRate) || 0;\\n                    originalOTBillRate = Number(dealsheet.DealSheetJob.otBillRate) || 0;\\n                    regPay = Number(dealsheet.regularPay) || 0;\\n                    regBillRate = Number(dealsheet.DealSheetJob.billRate) || 0;\\n                    totalStipend = Number(dealsheet.miWeekly) + Number(dealsheet.lodgingWeekly);\\n                    totalStipendPerShift = (totalStipend / dealsheet.DealSheetJob.shifts).toFixed(2);\\n                    totalLodgigPerShift = (Number(dealsheet.lodgingWeekly) / dealsheet.DealSheetJob.shifts).toFixed(2);\\n                    totalMiPerShift = (Number(dealsheet.miWeekly) / dealsheet.DealSheetJob.shifts).toFixed(2);\\n                    var holidayMultiplier = billingTerm.hl_multiplier;\\n                    var holidayAddOn = billingTerm.hl_add_on;\\n                    var dividedBy = 7;\\n                    dtBillRate = 0;\\n                    otChargeHoliday = controller.calculateRate(chargeBillRate, controller.getHolidayCallBackModifier(billingTerm, holidayMultiplier, holidayAddOn)); // need to be handled.\\n                    dtChargeHoliday = controller.calculateRate(chargeBillRate, controller.getHolidayCallBackModifier(billingTerm, holidayMultiplier, holidayAddOn)); // need to be handled.\\n                    dealsheet.DealSheetAdditionalCosts.forEach(function (item) {\\n                        if (item.label === \\\"Prep Fee\\\")\\n                            prepFeeRate = item.totalCost || controller.calculateAdditionalCostRate(dealsheet, item) || 0;\\n                    });\\n                    if (dealsheet.DealSheetJob.jobState === \\\"Colorado\\\") {\\n                        if (dealsheet.DealSheetClient.billableOT !== \\\"Over 12\\\") {\\n                            otBillRate = regBillRate;\\n                        }\\n                    }\\n                    if (dealsheet.DealSheetJob.jobState === \\\"Alaska\\\" || dealsheet.DealSheetJob.jobState === \\\"California\\\") {\\n                        if (dealsheet.DealSheetClient.billableOT !== \\\"Over 8\\\") {\\n                            otBillRate = regBillRate;\\n                        }\\n                    }\\n                    var doubleTimeModifier = controller.getDTBillRateModifier(billingTerm);\\n                    doubleTimeBillRateFromBillingTerm = controller.calculateRate(regBillRate, doubleTimeModifier);\\n                    cal