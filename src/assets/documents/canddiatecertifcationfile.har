            "mimeType": "application/json",
            "text": "{\n  \"MAPPED_ENTITY_CONFIGURATION\": {\n    \"DIRTY_FORM_WARNING\": \"The details form is not saved and this preview will only show results from the last saved data\",\n    \"FIELD_LABELS\": {\n      \"MAPPED_NAME\": \"Name\",\n      \"URL\": \"Url\",\n      \"URL_TOOLTIP\": \"(optional) This url will automatically replace any parameters from your mapped results.\\n\\nExample:\\n`query/~W4?fields=*&where=person.id={param1} AND firstName={param2}\\n\\nAvailable Parameters: \\n{actualParameters}\",\n      \"CONSTANT\": \"Constant\",\n      \"ORIGINAL_FIELD_MAP_STACK\": \"Mapping\",\n      \"EMPTY_STATE\": \"There are no fields...\",\n      \"ADD\": \"Add Field\",\n      \"SEARCH_PLACEHOLDER\": \"Search...\",\n      \"TYPE\": \"Type\",\n      \"TYPES\": {\n        \"TEXT\": \"Text\",\n        \"MAP\": \"Map\"\n      },\n      \"CONSTANT_TOOLTIP\": \"This value of this field will be output directly as it is typed (as a string)\"\n    },\n    \"PREVIEW_LABELS\": {\n      \"ID\": \"Entity Id\",\n      \"WHERE\": \"Where Query\",\n      \"SEARCH\": \"Search Query\",\n      \"NO_RESULTS\": \"No Entity Found\"\n    }\n  },\n  \"BTE\": {\n    \"LIST_SUMMARY\": {\n      \"TIMESHEET_COUNT\": \"{entityTitleTimesheet} Count\",\n      \"HOURS_WORKED\": \"Worked Hours\",\n      \"NON_WORKED_HOURS\": \"Non-Worked Hours\",\n      \"TOTAL_HOURS\": \"Total Hours\",\n      \"TOTAL_UNITS\": \"Total Units\",\n      \"TOTAL_AMOUNT\": \"Total Amount\"\n    },\n    \"SUBMIT_AND_APPROVE_MODAL_TITLE\": \"Submit and approve ALL {entityTitleTimesheet} entries?\",\n    \"SUBMIT_AND_APPROVE_MODAL_SUBHEADER\": \"All entries on this {entityTitleTimesheet} will be submitted and approved, not just your changes.\",\n    \"PROXY\": \"Proxy\",\n    \"PAY_ONLY\": \" - Pay Only\",\n    \"BILL_ONLY\": \" - Bill Only\",\n    \"SHIFT_EARNCODES\": \"Map {entityTitleEarnCodeMany}\",\n    \"ADD_SHIFT_EARNCODE\": \"Add Mapping\",\n    \"CHANGE_EARN_CODE_LEVEL_TOGGLE\": \"Changing the earn co