lates\",\n    \"ERROR_MESSAGE_1\": \"It seems something is amiss.\",\n    \"ERROR_MESSAGE_2\": \"Sorry, it seems that we are having some difficulty retrieving data.\",\n    \"ERROR_MESSAGE_3\": \"Check your internet connection or try reloading the page.\",\n    \"ORGANIZE\": \"ORGANIZE\",\n    \"NEW\": \"NEW\"\n  },\n  \"TEARSHEET\": {\n    \"TITLE\": \"{entityTitleShortListMany}\",\n    \"EXISTING\": \"Existing {entityTitleShortList}\",\n    \"NEW\": \"New {entityTitleShortList}\",\n    \"ADD_EXISTING_SUCCESS\": \"This {Entity} has been successfully added to the selected {entityTitleShortList}.\",\n    \"ADD_MULTIPLE_EXISTING_SUCCESS\": \"{count} {EntityPlural} has been added to the selected {entityTitleShortListMany}\",\n    \"ADD_EXISTING_FAILURE\": \"An error occurred while adding this {Entity} to the selected {entityTitleShortList}!\",\n    \"ADD_NEW_SUCCESS\": \"A new {entityTitleShortList} has been successfully created with this {Entity}.\",\n    \"ADD_MULTIPLE_NEW_SUCCESS\": \"{count} {EntityPlural} has been added to the selected {entityTitleShortListMany}\",\n    \"ADD_NEW_FAILURE\": \"An error occurred while creating this the {entityTitleShortList}!\",\n    \"ADD_ATTEMPT_FAILURE\": \"An error occurred while attempting to add {EntityPlural} to {entityTitleShortList}!\",\n    \"MANAGE_EXISTING_SUCCESS\": \"This {Entity}'s {entityTitleShortList}(s) have been successfully updated.\",\n    \"NAME\": \"{entityTitleShortList} name\",\n    \"PUBLIC\": \"Public\",\n    \"PRIVATE\": \"Private\",\n    \"ADD_TO\": \"Add To\",\n    \"USERS\": \"Users\",\n    \"RECORDS\": \"Records\",\n    \"DUPLICATE_MESSAGE\": \"You already have a {entityTitleShortList} named \\\"{Name}\\\".\\nPlease enter another name for the new {entityTitleShortList}.\",\n    \"VISIBILITY\": \"Visibility\",\n    \"ERROR_MESSAGE_1\": \"It seems something is amiss.\",\n    \"ERROR_MESSAGE_2\": \"Sorry, it seems that we are having some difficulty retrieving data.\",\n    \"ERROR_MESSAGE_3\": \"Check y