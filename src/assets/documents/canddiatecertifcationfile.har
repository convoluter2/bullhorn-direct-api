ere are no bill rules associated with this version\",\n    \"ASSIGN_RULES\": \"Assign {entityTitleTimeLaborEvalRuleMany}\",\n    \"PAY_RULESET_SAVE_SUCCESSFUL\": \"Pay {entityTitleTimeLaborEvalRuleMany} saved successfully.\",\n    \"BILL_RULESET_SAVE_SUCCESSFUL\": \"Bill {entityTitleTimeLaborEvalRuleMany} saved successfully.\",\n    \"SELECT_RULE\": \"Select a {entityTitleTimeLaborEvalRule}\",\n    \"EDIT_HISTORY\": {\n      \"RULES_ADDED\": \"{entityTitleTimeLaborEvalRuleMany} Added\",\n      \"RULES_REMOVED\": \"{entityTitleTimeLaborEvalRuleMany} Removed\",\n      \"VERSION_FIELD_CHANGES\": \"Version Field Changes\",\n      \"EFFECTIVE_DATE\": \"Effective Date\"\n    },\n    \"DID_NOT_WORK_MODAL\": {\n      \"HEADER\": \"This {entityTitleTimesheet} is currently marked as Did Not Work. Adding entries will change the status.\",\n      \"SUBHEADER\": \"Do you wish to continue?\"\n    },\n    \"APPROVAL_REMINDER_MODAL\": {\n      \"SUBMIT\": \"Send Reminder(s)\",\n      \"SEND_REMINDER\": {\n        \"other\": {\n          \"1\": \"An approval reminder will be sent for the selected {entityTitleTimesheet}.\",\n          \"many\": \"Approval reminders will be sent for the selected {entityTitleTimesheetMany}.\"\n        }\n      },\n      \"SEND_SOME_HEADER\": {\n        \"other\": {\n          \"1\": \"An approval reminder cannot be sent for {quantity} {entityTitleTimesheet}. Do you wish to continue?\",\n          \"many\": \"An approval reminder cannot be sent for {quantity} {entityTitleTimesheetMany}. Do you wish to continue?\"\n        }\n      },\n      \"NONE_ELIGIBLE\": {\n        \"other\": {\n          \"1\": \"An approval reminder cannot be sent for the selected {entityTitleTimesheet}.\",\n          \"many\": \"Approval reminders cannot be sent for the selected {entityTitleTimesheetMany}.\"\n        }\n      },\n      \"SOME_ELIGIBLE_TEXT\": \"Approval reminders can only be sent for {entityTitleTimesheetMany} in a Submitted {statusLabel}.\",\n      \"SOME_ELIGIBLE_TEXT2\": \"For eligible {entityTitleTimesheetMany}, only one message will be sent per approver.\",\n      \"NONE_ELIGIBLE_TEXT\": \"Approval reminders can only be sent for {entityTitleTimesheetMany} in a Submitted {statusLabel}. Please review your selections and try again.\",\n      \"CONTINUE\": \"Only one message will be sent per approver.\",\n      \"APPROVE_BUTTON\": \"Yes, Approve\",\n      \"STATUS\": \"Status\"\n    },\n    \"APPROVE_TIMESHEET_MODAL\": {\n      \"ACTION_APPROVE_TIMESHEETS\": \"This action will approve {numTimesheets} {entityTitleTimesheetMany}.\",\n      \"APPROVE_SOME_HEADER\": \"Unable to approve {quantity} of {total} {entityTitleTimesheetMany}\",\n      \"APPROVE_NOT_ELIGIBLE_TEXT\": \"Only {entityTitleTimesheetMany} in a {statusLabel} of Submitted can be approved. Timesheets with a Source of BTE cannot be approved.\",\n      \"APPROVE_SOME_TEXT2\": \"Do you still want to approve the remaining {entityTitleTimesheetMany} that are ready for approval?\",\n      \"NONE_ELIGIBLE\": \"None of the selected {entityTitleTimesheetMany} are eligible for approval.\",\n      \"CONTINUE\": \"Do you wish to continue?\",\n      \"APPROVE_BUTTON\": \"Yes, Approve\",\n      \"STATUS\": \"Status\"\n    },\n    \"REJECT_TIMESHEET_MODAL\": {\n      \"REJECTING_TIMESHEET\": \"Rejecting {entityTitleTimesheet}?\",\n      \"ACTION_RETURN_TIMESHEET\": \"This action will return the {entityTitleTimesheet} to the {entityTitleCandidate} for revision.\",\n      \"REJECTION_REASON\": \"Rejection Reason\",\n      \"TIMESHEET_REJECTED\": \"{entityTitleTimesheet} {timesheetId} for {candidateName} | {jobTitle} has been successfully rejected.\"\n    },\n    \"TIMESHEET\": \"{entityTitleTimesheet}\",\n    \"TIMESHEETS\": \"{entityTitleTimesheetMany}\",\n    \"EMPTY_TIMESHEET\": \"This list currently has no {entityTitleTimesheetNone} added.\",\n    \"EMPTY_TIMESHEET_ENTRY\": \"This {entityTitleTimesheet} has no entries.\",\n    \"DID_NOT_WORK_TIMESHEET_TABLE\": \"This {entityTitleTimesheet} has been marked as did not work.\",\n    \"ADD_ENTRIES\": \"Add Entries\",\n    \"ADJUSTMENTS_ACTIVE\": \"You are now editing time entries. Saving your changes will cause the related pay and bill transactions to recalculate.\",\n    \"TIMESHEET_EDIT_DISABLE_MESSAGE\": \"This {entityTitleTimesheet:format:lowercase} cannot be edited because it contains overrides.\",\n    \"TIMESHEET_EDIT_CLOCK_SAVED_DISABLE_MESSAGE\": \"Clock time cannot be edited in the ATS. You may still edit the entries by selecting the \\\"View/Edit {entityTitleTimesheet}\\\" option in the Actions menu and navigating to BTE\",\n    \"TIMESHEET_ENTRY_EDIT_DISABLED\": {\n      \"DISPUTED_ADJUSTMENT\": \"This entry cannot be edited or deleted in the ATS because it contains a dispute. To make changes, select the \\\"View/Edit {entityTitleTimesheet}\\\" option in the Actions menu to navigate to BTE.\",\n      \"SYSTEM\": \"This entry is system-generated and cannot be edited or deleted in the ATS. To make changes, select the “View/Edit Timesheet” option in the Actions menu to navigate to BTE.\",\n      \"CUSTOM_RATE\": \"The earn code for this entry uses a custom rate that cannot be edited or deleted in the ATS. To make changes, select the “View/Edit Timesheet” option in the Actions menu to navigate to BTE.\",\n      \"SAVED\": \"Saved time cannot be edited in the ATS. You may still edit the entries by selecting the \\\"View/Edit {entityTitleTimesheet}\\\" option in the actions menu and navigating to BTE\",\n      \"REJECTED\": \"Rejected time cannot be edited in the ATS. You may still edit the entries by selecting the \\\"View/Edit {entityTitleTimesheet}\\\" option in the actions menu and navigating to BTE\"\n    },\n    \"TIMESHEET_PERIOD\": \"Timesheet period\",\n    \"APPROVE_TIMESHEET\": \"Approve {entityTitleTimesheet}\",\n    \"TIMESHEET_APPROVED\": \"{entityTitleTimesheet} {timesheetId} has been successfully approved.\",\n    \"TIMESHEETS_APPROVED\": {\n      \"other\": {\n    