T\": \"This list currently has no {entityTitleExpenseSheetNone} added\",\n    \"EXPENSE_SHEET_ENTRY\": \"{entityTitleExpenseSheetEntry}\",\n    \"EXPENSE_SHEET_ENTRIES\": \"{entityTitleExpenseSheetEntryMany}\",\n    \"EMPTY_EXPENSE_SHEET_ENTRIES\": \"This list currently has no {entityTitleExpenseSheetEntryNone} added\",\n    \"LINE_ITEMS\": \"Line Items\",\n    \"HOLIDAY_TITLE\": \"Edit {entityTitleHoliday} - {holidayLabel}\",\n    \"VIEW_HOLIDAY_TITLE\": \"{entityTitleHoliday} - {holidayLabel}\",\n    \"HOLIDAY_OCCURRENCES\": \"{entityTitleHolidayInstanceMany}\",\n    \"NO_INSTANCES_TO_DISPLAY\": \"No {entityTitleHolidayInstanceMany} to display\",\n    \"OCCURRENCE_NO\": \"No.\",\n    \"IS_ALL_DAY\": \"Is All Day?\",\n    \"DURATION\": \"Duration\",\n    \"ALL_DAY\": \"All Day\",\n    \"START\": \"Start\",\n    \"END\": \"End\",\n    \"SHOW_PAST_OCCURRENCES\": \"Show Past {entityTitleHolidayInstanceMany}\",\n    \"HIDE_PAST_OCCURRENCES\": \"Hide Past {entityTitleHolidayInstanceMany}\",\n    \"RECURRENCE_PATTERN\": \"Recurrence Pattern\",\n    \"ADD_OCCURRENCE\": \"Add {entityTitleHolidayInstance}\",\n    \"HOLIDAY_CATEGORY_NONE\": \"None\",\n    \"HOLIDAY_PICKER_QUICK_SELECT\": \"Quick Select\",\n    \"ADD_CALENDAR\": \"Add {entityTitleCalendar}\",\n    \"EDIT_CALENDAR\": \"Edit {entityTitleCalendar}\",\n    \"NO_CALENDARS\": \"This list currently has no {entityTitleCalendarMany} added.\",\n    \"CUSTOM\": \"Custom\",\n    \"DUPLICATE_CYCLE_PATTERN\": \"A {entityTitleCalendar} with this frequency pattern already exists.\",\n    \"SHOW_PAST_CALENDAR_INSTANCES\": \"Show Past {entityTitleCalendarInstanceMany}\",\n    \"HIDE_PAST_CALENDAR_INSTANCES\": \"Hide Past {entityTitleCalendarInstanceMany}\",\n    \"CYCLE_START\": \"{entityTitleCalendarInstance} Start\",\n    \"CYCLE_END\": \"{entityTitleCalendarInstance} End\",\n    \"NO_CYCLES_TO_DISPLAY\": \"No {entityTitleCalendarInstanceMany} to display\",\n    \"NO_CYCLES_TO_DISPLAY_DESC\": \"Select {entityTitleCalendar} criteria to preview {entityTitleCalendarInstanceMany}\",\n    \"CURRENT\": \"current\",\n    \"SUMMARY_BLOCKS\": {\n      \"PAY_AMOUNT\": \"Gross Pay Amount\",\n      \"BILL_AMOUNT\": \"Gross Bill Amount\",\n      \"TOTAL_TRANSACTIONS\": \"Total Transactions\",\n      \"FAILED_TO_EXPORT\": \"Failed to Export\"\n    },\n    \"ADJUSTMENTS_SUCCESS\": \"Edits to the {entityTitleTimesheet} have successfully saved. Pay and bill transactions will now recalculate.\",\n    \"DID_NOT_WORK_ADJUSTMENTS_SUCCESS\": \"{entityTitleTimesheet} set as Did Not Work successfully.\",\n    \"UNSET_DID_NOT_WORK_ADJUSTMENTS_SUCCESS\": \"Did Not Work has been unset from {entityTitleTimesheet} successfully.\",\n    \"STATE\": \"{total} State\",\n    \"STATES\": \"{total} States\",\n    \"VIEW_ISSUES\": \"View {entityTitleIssueMany}\",\n    \"WORK_FROM_HOME\": \"Work From Home (WFH)\",\n    \"WORK_FROM_HOME_RECALC_SUCCESS\": \"The {entityTitleTimesheet} has recalculated based on these changes\",\n    \"WORK_FROM_HOME_CONFIRMATION_WHEN_WORKING_FROM_HOME\": \"You should only make this change if this {entityTitleCandidate} works from home.\",\n    \"WORK_FROM_HOME_CONFIRMATION_WHEN_NOT_WORKING_FROM_HOME\": \"You should only make this change if this {entityTitleCandidate} does NOT work from home.\",\n    \"WORK_FROM_HOME_CONFIRMATION_DESCRIPTION\": \"This change will only apply to this {entityTitleTimesheet}. To apply this change to future {entityTitleTimesheetMany}, you must edit the Work From Home setting on the placement.\",\n    \"WORK_FROM_HOME_CONFIRMATION_BUTTON\": \"Continue & Recalculate\",\n    \"WORK_FROM_HOME_SAVE_ERROR\": \"Work From Home evaluation changes failed to save\",\n    \"WORK_FROM_HOME_RECALC_ERROR\": \"This {entityTitleTimesheet:format:lowercase} was unable to be recalculated. Please recalculate this {entityTitleTimesheet:format:lowercase} in Bullhorn Time & Expense\",\n    \"WORK_FROM_HOME_FIELD_DESCRIPTION\": \"If Time & Labor is enabled and Yes is selected, the Pay/Bill Rules assigned to the {entityTitlePlacement} will use the state from the {entityTitleCandidate}’s Address to calculate overtime. Enabling this setting will NOT recalculate existing {entityTitleTimesheetMany:format:lowercase}.\",\n    \"ERROR_MESSAGES\": {\n      \"PROCESSING_ERROR\": \"Processing Error(s)\",\n      \"TIMESHEET_WARNING_TITLE\": \"This {entityTitleTimesheet:format:lowercase} has not been processed\",\n      \"WORK_FROM_HOME_PROCESSING_ISSUE\": \"The hours for this {entityTitleTimesheet:format:lowercase} have not been evaluated because the {entityTitlePlacement} is set to Work from Home but the state of the {entityTitleCandidate}'s home address is missing. To evaluate this {entityTitleTimesheet:format:lowercase} correctly, select a state from the Work From Home Evaluation State field in the {entityTitleTimesheet:format:lowercase} header and then update the state in the {entityTitleCandidate}'s record to prevent this issue from occurring in the future.\",\n      \"WORK_FROM_HOME_WARNING\": \"The {entityTitleCandidate} associated with this {entityTitleTimesheet} is designated as Work from Home, but is missing a {entityTitleLocation}. Please add a {entityTitleLocation} to the {entityTitleCandidate}'s information to avoid potential processing errors. View {entityTitleIssue} for more details.\",\n      \"GENERIC_ISSUE_TEXT\": \"Review Potential {entityTitleIssueMany}\",\n      \"GENERIC_TIMESHEET_ISSUE_TEXT\": \"This {entityTitleTimesheet:format:lowercase} is experiencing issues that may affect pay and bill transactions.\",\n      \"EXPENSE_SHEET_WARNING_TITLE\": \"This {entityTitleExpenseSheet:format:lowercase} has not been processed\",\n      \"WARNING_MESSAGE\": \"Processing is pending. Refresh the page to view updates.\",\n      \"WARNING_INACTIVE_EARN_CODES\": \"Inactive {entityTitleEarnCode}(s)\",\n      \"WARNING_INACTIVE_EARN_CODES_MESSAGE_1\": \"The {entityTitleEarnCode}(s) \\\"\",\n      \"WARNING_INACTIVE_EARN_CODES_MESSAGE_2\": \"\\\" for this rule is/are inactive.\",\n      \"WARNING_INACTIVE_EARN_CODES_MESSAGE_3\": \"Any new changes to this rule cannot be saved until all earn codes are active.\",\n      \"APPROVAL_REMINDER_ERROR_SOME\": \"Some approval reminders could not be sent\",\n      \"APPROVAL_REMINDER_ERROR_ALL\": \"Approval reminders could not be sent\",\n      \"APPROVAL_REMINDER_ERROR_DETAIL\": \"This may be due to either a technical error or missing information in Bullhorn Time & Expense.\",\n      \"ADJUSTMENTS_ERROR_TITLE\": \"Adjustment Failed to Save\",\n      \"ADJUSTMENTS_ERROR_TEXT\": \"A system error occurred while saving this adjustment. This may mean that some or all of the proposed changes failed to save. Please review the {entityTitleTimesheet} and re-enter any adjustments as necessary.\",\n      \"ADJUSTMENTS_VERSION_CONFLICT_ERROR_TITLE\": \"{entityTitleTimesheet} adjustment could not be saved\",\n      \"ADJUSTMENTS_VERSION_CONFLICT_ERROR_TEXT\": \"This {entityTitleTimesheet:format:lowercase} either has an open dispute or has been modified since you began making an adjustment. Please resolve any disputes in Bullhorn Time & Expense (if any) and then refresh the {entityTitleTimesheet:format:lowercase} before re-entering your changes.\",\n      \"ADJUSTMENTS_UNAUTHORIZED_ERROR_TITLE\": \"Adjustment Failed to Save\",\n      \"ADJUSTMENTS_UNAUTHORIZED_ERROR_TEXT\": \"A system error occurred while saving this adjustment (client corp is unauthorized). Please try again. If the problem persists, contact Bullhorn Support.\",\n      \"TIMESHEET_REJECTED_TITLE\": \"{entityTitleTimesheet} was rejected by {rejectorName}\",\n      \"TIMESHEET_REJECTED_MESSAGE\": \"Comment: {comment}.\",\n      \"TIMESHEET_REJECTED_MESSAGE_NO_COMMENT\": \"No comment was left.\",\n      \"TIMESHEET_UNKNOWN_REJECTOR_NAME\": \"Unknown User\",\n      \"FIELD_INTERACTIONS\": {\n        \"REQUIRED_FIELD\": \"This field is required.\",\n        \"QUANTITY_MESSAGE\": \"Quantity must be greater than zero.\",\n        \"STARTED_AT_ERROR_MESSAGE\": \"In Punch cannot be after Out Punch.\",\n        \"ENDED_AT_ERROR_MESSAGE\": \"Out Punch cannot be before In Punch.\",\n        \"SAME_DATETIME_ERROR_MESSAGE\": \"In and Out times cannot be the same.\",\n        \"ADJUSTMENTS_WORKED_HOURS_CANNOT_OVERLAP_ERROR_MESSAGE\": \"Worked hours cannot overlap with other worked hours.\",\n        \"ADJUSTMENTS_NON_WORKED_HOURS_SAME_CODE_CANNOT_OVERLAP_ERROR_MESSAGE\": \"Non-worked hours with the same earn code cannot overlap.\"\n      }\n    },\n    \"NO_UPCOMING_HOLIDAY_INSTANCES\": \"None Upcoming\",\n    \"VIEW_EDIT_TIMESHEET_MODAL\": {\n      \"PRIMARY\": \"Viewing or editing a {entityTitleTimesheet} will launch Bullhorn Time & Expense in a new window.\",\n      \"SECONDARY\": \"Do you wish to continue?\",\n      \"ERROR\": {\n        \"TITLE\": \"Oops! Something went wrong.\",\n        \"MESSAGE_DEFAULT\": \"If the problem persists, please contact Bullhorn Support.\",\n        \"MESSAGE_441\": \"You are not currently set up in BTE, please contact support.\",\n        \"MESSAGE_442\": \"We're sorry - we can't get you to BTE from here. Please contact support.\"\n      }\n    },\n    \"SSO_ERROR_MODAL\": {\n      \"PRIMARY\":\" The Allow Proxy setting is not enabled\",\n      \"SECONDARY\": \"This may mean that you either don't have an account set up in BTE or have not been enabled for proxy access. Contact your system administrator for assistance.\",\n      \"BUTTON\": \"OKAY, GOT IT\"\n    },\n    \"RULE_DESCRIPTIONS\": {\n      \"DAILY_DT_THRESHOLD\": {\n        \"template\": \"When a time reporter reports time under earn codes {sourceEarnCodes} and the sum of hours is greater than {threshold} hours in a day, then all hours in excess of {threshold} are attributed under {targetEarnCode}.\"\n      },\n      \"DAILY_MIN_WAGE_BASIS_THRESHOLD\": {\n        \"template\": \"When a time reporter reports time under earn codes {sourceEarnCodes}, and the sum of hours whose Pay Rate is below the minimum wage premium of {minWagePremiumAmount} is greater than {threshold} hours in a day, then all hours in excess of {threshold} are attributed under {targetEarnCode}.\"\n      },\n      \"DAILY_OT_THRESHOLD\": {\n        \"template\": \"When a time reporter reports time under earn codes {sourceEarnCodes} and the sum of hours is greater than {threshold} hours in a day, then all hours in excess of {threshold} are attributed under {targetEarnCode}.\"\n      },\n      \"DAILY_THRESHOLD\": {\n        \"templateParts\": {\n          \"first\": \"When a time reporter reports time under {source} and the sum of hours is greater than {threshold{ctr}} hours in a day, then all hours after {threshold{ctr}} are attributed to {target}\",\n          \"repeating\": \" until the sum of hours is greater than {threshold{ctr}}. <br><br>Hours after {threshold{ctr}} are attributed to {target}\",\n          \"last\": \".\"\n        },\n        \"tags\": {\n          \"source\": {\n            \"_key\": \"{earnCodeLevel}\",\n            \"1\": \"the earn code(s) {sourceEarnCodes}\",\n            \"2\": \"any {sourceEarnCodes} earn code\"\n          },\n          \"target\": {\n            \"_key\": \"{earnCodeLevel}\",\n            \"1\": \"{thresholdTargetEarnCode{ctr}}\",\n            \"2\": \"the corresponding {thresholdTargetEarnCode{ctr}} earn code\"\n          }\n        }\n      },\n      \"DAYS_OF_wEEK_PREMIUM\": {\n        \"template\": \"For every hour or unit recorded against earn code {sourceEarnCodes} on any of these days of week: {daysOfWeek}, transform these hours into {targetEarnCode}.\"\n      },\n      \"EXEMPT\": {\n        \"template\": \"If any labor hours were reported during a period under earn codes {sourceEarnCodes}, the Candidate is paid 40 hours of {targetEarnCode} regardless of number of hours reported; never more or less than 40.\"\n      },\n      \"FLSA_ADJUSTMENT\": {\n        \"template\": \"The FLSA Weighted Average Rate calculation evaluates whether any adjusting transactions are required to account for Overtime or Double Time when:<ul><li>Hours have been reported against multiple different Regular rates in a period</li><li>A Non Discretionary Bonus has been applied to a date in the period</li></ul>There are {flsaHoursCount} earn codes that contribute to Hours calculation, {flsaDollarsCount} that contribute to Dollars calculations, and {flsaPremiumCount} that contribute to Premium calculation.\"\n      },\n      \"FLSA_FLAT_STYLE_ADJUSTMENT\": {\n        \"template\": \"<p>Using the FLSA flat bonus calculation for all hours attributed to {sourceEarnCodes}, evaluate whether any adjusting attributions are required for Overtime or Double Time due to a flat bonus applicable date range impacting the period.</p><p>If adjusting attributions are required:</p><ol><li>For every hour that was previously attributed to Overtime earn code {overtimeEarnCodes}, attribute an hour of FLSA Overtime adjustment under earn code {flsaOvertimeAdjustmentEarnCode} using the Overtime adjustment rate determined by the FLSA calculation;</li><li>For every hour that was previously attributed to Double Time earn code {doubleTimeEarnCodes}, attribute an hour of FLSA Double Time adjustment under earn code {flsaDoubleTimeAdjustmentEarnCode}, using the Double Time adjustment rate determined by the FLSA calculation;</li><li>{isGeneratingNegativeAdjustments} generate adjusting attributions if the FLSA calculated rate is lower than what was already attributed; in other words, if the adjusting attribution would be negative in value. (Opting to discard negative adjustments is more generous to the employee.)</li><ol>\"\n      },\n      \"GUARANTEED_HOURS\": {\n        \"template\": \"The employee is guaranteed to be paid {guaranteedHours} hours{one} per pay period. If the reported hours under earn code(s) {sourceEarnCodes} are less than {guaranteedHours}{two}, the difference will be paid as {targetEarnCode}{three}.\",\n        \"tags\": {\n          \"one\": {\n            \"_key\": \"{frequency}\",\n            \"1\": \"\",\n            \"2\": \" daily {numberOfDays} days\",\n            \"7\": \" daily for any day worked\"\n          },\n          \"two\": {\n            \"_key\": \"{frequency}\",\n            \"1\": \"\",\n            \"2\": \" per day\",\n            \"7\": \" on a worked day\"\n          },\n          \"three\": {\n            \"_key\": \"{frequency}\",\n            \"1\": \"\",\n            \"2\": \" up to {numberOfDays} days per pay period. The employee is not required to work in order to be paid\",\n            \"7\": \"\"\n          }\n        }\n      },\n      \"LOW_CENSUS\": {\n        \"template\": \"When a time reporter enters time under the earn code(s) {sourceEarnCodes}, attribute up to {threshold} hours under the earn code {targetEarnCode1} {one} <br><br>Hours in excess of {threshold} hours are attributed to {targetEarnCode2}.\",\n        \"tags\": {\n          \"one\": {\n            \"_key\": \"{frequency}\",\n            \"3\": \"on a {frequency} basis.\",\n            \"4\": \"on a {frequency} basis.\",\n            \"6\": \"for the {frequency}.\"\n          }\n        }\n      },\n      \"MEAL_PENALTY\": {\n        \"template\": \"Attribute {penaltyQuantity} unit(s) of Meal Penalty on each day where... <ul><li>a break of at least {requiredBreakDuration} hours was not taken after working {maxHoursBeforeFirstBreak} hours, unless break was not waived up to {waiveFirstBreakHours} hours</li><li>a second break of at least {requiredBreakDuration} hours was not taken after working {maxHoursBeforeSecondBreak} hours, unless break was not waived up to {waiveSecondBreakHours} hours</li></ul><i>(Hours reported under {sourceEarnCodes} will be used for determining hours worked.)</i><p>First meal {canWaiveFirstBreak} waived.</p><p>Second meal {canWaiveSecondBreak} waived.</p><p>Earn code {mealMissedEarnCode} will be used for missing meal<p><p>Earn code {mealShortEarnCode} will be used for short meal<p><p>Earn code {mealLateEarnCode} will be used for late meal<p><p>Earn code {mealSecondEarnCode} will be used for second meal<p>.\"\n      },\n      \"NONSCHEDULED_WORKDAY\": {\n        \"template\": \"When a time reporter reports time under earn code(s) {sourceEarnCodes}, and they work on an unscheduled worked day of {daysOfWeek}, attribute hours up to {threshold} hours under earn code {targetEarnCode1}, while hours after {threshold} hours on an unscheduled day are attributed under earn code {targetEarnCode2}.\"\n      },\n      \"ORIENTATION\": {\n        \"templateParts\": {\n          \"first\": \"When a time reporter reports time under the earn code(s) {sourceEarnCodes}, then the first {threshold{ctr}} hours get attributed to {thresholdTargetEarnCode{ctr}}.\",\n          \"repeating\": \" <br><br>The next {threshold{ctr}} hours will be attributed to {thresholdTargetEarnCode{ctr}}.\",\n          \"last\": \" <br><br>Any remaining hours will be attributed to original {sourceEarnCodes}.\"\n        }\n      },\n      \"PAID_STRAIGHT_TIME\": {\n        \"template\": \"All reported hours are paid as {targetEarnCode} regardless of how many were reported under earn code {sourceEarnCodes}.\"\n      },\n      \"PERIOD_BASED_RATE\": {\n        \"template\": \"If any number of hours were recorded under earn codes {sourceEarnCodes} during the current processing period, generate {targetQuantity} attribution unit(s) of earn code {targetEarnCode}.\"\n      },\n      \"PERIOD_THRESHOLD\": {\n        \"templateParts\": {\n          \"first\": \"When a time reporter reports time under {source} and the sum of hours is greater than {threshold{ctr}} hours in a period, then all hours after {threshold{ctr}} are attributed to {target}\",\n          \"repeating\": \" until the sum of hours is greater than {threshold{ctr}}. <br><br>Hours after {threshold{ctr}} are attributed to {target}\",\n          \"last\": \".\"\n        },\n        \"tags\": {\n          \"source\": {\n            \"_key\": \"{earnCodeLevel}\",\n            \"1\": \"the earn code(s) {sourceEarnCodes}\",\n            \"2\": \"any {sourceEarnCodes} earn code\"\n          },\n          \"target\": {\n            \"_key\": \"{earnCodeLevel}\",\n            \"1\": \"{thresholdTargetEarnCode{ctr}}\",\n            \"2\": \"the corresponding {thresholdTargetEarnCode{ctr}} earn code\"\n          }\n        }\n      },\n      \"SEVENTH_DAY_THRESHOLD\": {\n        \"template\": \"When a time reporter works seven consecutive days and reports time under {source} in a given workweek, the first 8.0 hours worked on the seventh day are attributed {target1}, while hours worked on the seventh day in excess of 8.0 are attributed {target2}.{minimumHours}\",\n        \"tags\": {\n          \"source\": {\n            \"_key\": \"{earnCodeLevel}\",\n            \"1\": \"earn codes {sourceEarnCodes}\",\n            \"2\": \"any {sourceEarnCodes} earn code\"\n          },\n          \"target1\": {\n            \"_key\": \"{earnCodeLevel}\",\n            \"1\": \"under earn code {targetEarnCode1}\",\n            \"2\": \"to the corresponding {targetEarnCode1} earn code\"\n          },\n          \"target2\": {\n            \"_key\": \"{earnCodeLevel}\",\n            \"1\": \"under earn code {targetEarnCode2}\",\n            \"2\": \"to the corresponding {targetEarnCode2} earn code\"\n          },\n          \"minimumHours\": {\n            \"_key\": \"{minimumHoursWorked}\",\n            \"exists\": \"<br><br>To be eligible, the time reporter must have worked a minimum of {minimumHoursWorked} hours during the seven consecutive day period.\"\n          }\n        }\n      },\n      \"SUNDAY_PREMIUM_EXCL\": {\n        \"template\": \"When a time reporter reports time under earn codes {sourceEarnCodes} and the sum of hours between Monday and Saturday equals or exceeds {threshold}, then all hours on Sunday are attributed under {targetEarnCode}.\"\n      },\n      \"SUNDAY_PREMIUM_INCL\": {\n        \"template\": \"When a time reporter reports time under earn codes {sourceEarnCodes} and the sum of hours between Monday and Sunday is greater than {threshold}, then all hours on Sunday in excess of {threshold} are attributed under {targetEarnCode}.\"\n      },\n      \"SURPLUS_AT_MATCH_RATE\": {\n        \"template\": \"For every hour or unit entered against {sourceEarnCodes}, but which was not attributed to {excludeEarnCodes}, generate 1 attribution unit of each earn code in the {targetEarnCodes} using the rate defined on the Placement for that earn code.\"\n      },\n      \"SURPLUS_AT_PERCENT\": {\n        \"template\": \"For every hour or unit entered against earn codes {sourceEarnCodes}, but which was not attributed to {excludeEarnCodes}, generate 1 attribution unit of each earnCode in the {targetEarnCodes} using a rate of {multiplier} times the rate on the source earn code.\"\n      },\n      \"SURPLUS_AT_PERCENT_WITH_MULTIPLE_ATTRIBUTION_RATES\": {\n        \"template\": \"For every hour or unit entered against or calculated by {sourceEarnCodes}, but which was not attributed to {excludeEarnCodes}, generate 1 attribution unit of each earn code in the {targetEarnCodes} using a rate of {multiplier} times the rate on the source earn code.\"\n      },\n      \"WEIGHTED_AVERAGE_OT\": {\n        \"template\": \"The Weighted Average Overtime calculation evaluates whether any adjusting transactions are required to account for Overtime.<br><br>When a time reporter has worked greater than 40 hours, Overtime will be calculated at a rate that is equal to the weighted average of the first 40 hours worked, multiplied by 1.5. If an adjusting entry is needed, the difference will be attributed to {targetEarnCode}.<br><br>There are {flsaHoursCount} earn codes that contribute to this calculation.\"\n      },\n      \"WORKED_HOLIDAY\": {\n        \"template\": \"When an employee enters time against the earn code(s) {sourceEarnCodes} {holidayEvaluationMethod} time period associated with {holidayNames} holiday(s) selected, then all hours are attributed under {targetEarnCode}.\",\n        \"tags\": {\n          \"holidayEvaluationMethod\": {\n            \"_key\": \"{holidayEvaluationMethod}\",\n            \"1\": \"during an <b>&lt;Exact&gt;</b>\",\n            \"2\": \"and the <b>&lt;Start Time&gt;</b> falls within a\",\n            \"3\": \"and the <b>&lt;Majority&gt;</b> of the time falls within a\"\n          }\n        }\n      },\n      \"WORKED_HOLIDAY_THRESHOLD\": {\n        \"templateParts\": {\n          \"first\": \"When a time reporter reports time under the earn code(s) {sourceEarnCodes} {holidayEvaluationMethod} time period associated with the {holidayNames} holiday(s) selected and the sum of hours is greater than {threshold{ctr}}, hours after {threshold{ctr}} are attributed to {thresholdTargetEarnCode{ctr}}\",\n          \"repeating\": \"<br><br>Hours after {threshold{ctr}} are attributed to {thresholdTargetEarnCode{ctr}}\",\n          \"last\": \".\"\n        },\n        \"tags\": {\n          \"holidayEvaluationMethod\": {\n            \"_key\": \"{holidayEvaluationMethod}\",\n            \"1\": \"during an <b>&lt;Exact&gt;</b>\",\n            \"2\": \"and the <b>&lt;Start Time&gt;</b> falls within a\",\n            \"3\": \"and the <b>&lt;Majority&gt;</b> of the time falls within a\"\n          }\n        }\n      }\n    },\n    \"TRANSACTIONS\": {\n      \"ONLY_SHOW_IF_ACTIVE_ON_RATE_CARD\": \"Show Active on {entityTitlePlacementRateCard}\"\n    },\n    \"REFRESH\": \"Refresh\"\n  },\n  \"CM\": {\n    \"LIST_SUMMARY\": {\n      \"APPLY_FILTER_TIP\": \"Apply a filter to view subtotals.\",\n      \"FILTERED_LABEL\": \"Filtered\",\n      \"ERROR_TITLE\": \"Unable to load summary data\",\n      \"ERROR_MESSAGE\": \"There was a problem refreshing the subtotals. The {entityTitle} below are unaffected and up to date.\",\n      \"COUNT\": \"Count\",\n      \"TOTAL\": \"Total\",\n      \"AMOUNT_PAID\": \"Amount Paid\",\n      \"OUTSTANDING_BALANCE\": \"Outstanding Balance\",\n      \"CHARGES\": \"Charges\",\n      \"QUANTITY\": \"Quantity\",\n      \"NON_EXPORTED\": \"Non-exported\",\n      \"EXPORTED\": \"Exported\",\n      \"INVOICED\": \"Invoiced\",\n      \"NOT_INVOICED\": \"Not Invoiced\",\n      \"UNIQUE_CANDIDATES\": \"Unique Candidates\",\n      \"TOTAL_TRANSACTIONS\": \"Total Transactions\",\n      \"COMPLETED\": \"Completed\",\n      \"FAILED\": \"Failed to Export\"\n    },\n    \"TABLE\": {\n      \"ONLY_SOME_SELECTED\": \"All {numRecords} matching records on this page are selected.\",\n      \"SELECT_ALL_MATCHING_RECORDS\": \"Select all {numRecords} matching records.\",\n      \"MASS_ACTION_DISABLED_TOOLTIP\": \"This action can only be performed for items displayed on the current page, not all selected. Consider adjusting the number of items per page.\",\n      \"ALL_MATCHING_RECORDS_SELECTED\": \"All {numRecords} matching records are selected.\",\n      \"CLEAR_SELECTION\": \"Clear Selection.\",\n      \"NO_MORE_RECORDS\": \"No more records. Click previous to go back.\",\n      \"STILL_LOADING\": \"This page is still loading\",\n      \"TRY_AGAIN\": \"Would you like to refresh the page and try again?\"\n    },\n    \"CRF\": {\n      \"EDIT\": \"Edit {entityTitleCustomerRequiredFieldMeta}\",\n      \"ADD\": \"Add {entityTitleCustomerRequiredFieldMeta}\",\n      \"META\": \"CUSTOMER REQUIRED FIELD\",\n      \"LABEL\": \"Label\",\n      \"OPTION_VALUE\": \"VALUE NAME\",\n      \"FIELD_START_DATE\": \"Field Start Date\",\n      \"FIELD_END_DATE\": \"Field End Date\",\n      \"TEXT_AND_ABBREVIATION\": \"Customer Required Fields (CRFs)\",\n      \"FIELDS_SELECTED\": \"Fields Selected\",\n      \"OPTION\": {\n        \"OPTION\": \"Option\",\n        \"ADD\": \"Add {entityTitleCustomerRequiredFieldOption}\",\n        \"EMPTY_MESSAGE\": \"You do not have any {entityTitleCustomerRequiredFieldOptionMany} on this record yet.\",\n        \"DEFAULT_LABEL\": \"Customer Required Field Option\"\n      }\n    },\n    \"PO\": {\n      \"EDIT\": \"Edit {entityTitlePurchaseOrder}\",\n      \"ADD\": \"Add {entityTitlePurchaseOrder}\"\n    },\n    \"ACCOUNTING_PERIOD_HINT\": \"If no Accounting Period Day is set, transactions will not be stamped with an accounting period date.\",\n    \"DEFAULT_ROLL_FORWARD_HINT\": \"Your default roll forward settings above will apply to all transactions unless you create specific exceptions.\",\n    \"PAY_EXPORT_HINT\": \"Select which employee payment types can be exported to Payroll or Accounts Payable. Employee payment types not selected for either export won't be included when exporting charges. \\n\\n If no employee payment types are configured, all charges will be included during export.\",\n    \"PAY_EXPORT_NO_CONFIGS\": \"No pay exports configured.\",\n    \"PAY_EXPORT_NO_EMPLOYEE_TYPES_SELECTED\": \"Select Employee Payment Type\",\n    \"ENTITY_SAVE_SUCCESS\": \"This {entityType} has been successfully saved.\",\n    \"CREDIT_TITLE\": \"Related Invoice\",\n    \"CREDIT_MESSAGE\": \"This credit memo was created from an existing {entityTitleInvoiceStatement} on {dateAdded:date} by {firstName} {lastName}.\",\n    \"VIEW_INVOICE\": \"View Invoice {id}.\",\n    \"VIEW_INVOICE_ERROR\": \"Error loading Invoice ID: {invoiceId}\",\n    \"VIEW_INVOICE_IN_PROGRESS\": \"PDF creation already in progress for Invoice ID: {invoiceId}\",\n    \"VIEW_CREDIT_MEMO\": \"View Credit Memo {id}.\",\n    \"INVOICE_CREDITED\": \"{entityTitleInvoiceStatement} credited\",\n    \"INVOICE_CREDITED_AND_REINSTATED\": \"{entityTitleInvoiceStatement} credited and Reinstated\",\n    \"INVOICE_CREDITED_MESSAGE\": \"This {entityTitleInvoiceStatement} was credited on {dateAdded:date} by {firstName} {lastName}.\",\n    \"INVOICE_CREDITED_AND_REINSTATE_MESSAGE\": \"This {entityTitleInvoiceStatement} was credited on {dateAdded:date} by {firstName} {lastName} and its charges were reinstated to the {entityTitleBillableCharge} list.\",\n    \"ADD_JOB_CODE\": \"Add {entityTit