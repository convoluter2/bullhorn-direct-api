n            \"LABEL\": \"Length\",\n            \"PLACEHOLDER\": \"Select Length\"\n          },\n          \"LANGUAGE\": {\n            \"LABEL\": \"Language\",\n            \"PLACEHOLDER\": \"Select Language\"\n          },\n          \"CREATIVITY\": {\n            \"LABEL\": \"Creativity\",\n            \"PLACEHOLDER\": \"Select Creativity Level\"\n          },\n          \"CUSTOM_ACTION\": {\n            \"LABEL\": \"Custom Action\"\n          },\n          \"META_DATA\": {\n            \"LABEL\": \"Additional Data\",\n            \"PLACEHOLDER\": \"Select additional data\"\n          },\n          \"ENTITY_DATA_PICKER\": {\n            \"LABEL\": \"{entityTitle} Data\"\n          },\n          \"DATA_POINT_PICKER\": {\n            \"PLACEHOLDER\": \"Type to add data points\"\n          },\n          \"COLUMN_LABEL\": {\n            \"DEFAULT\": \"Default\",\n            \"DATA_POINT\": \"Data Point\"\n          }\n        },\n        \"DELETE_PROMPT\": \"Delete Prompt\",\n        \"LABELS\": {\n          \"PITCH_JOB_TO_CANDIDATE\": \"Pitch {entityTitleJobOrder} to {entityTitleCandidate}\",\n          \"SCREENING_QUESTIONS\": \"Create Screening Questions\",\n          \"SUMMARIZE_PROFILE\": \"Summarize {entityTitleCandidate} Profile\",\n          \"CHECKIN_MESSAGE\": \"Draft a Check-in Message\",\n          \"CLIENT_PITCH\": \"Create a {entityTitleClientContact} Pitch\",\n          \"REJECTION_MESSAGE\": \"Write a Rejection Message\",\n          \"IMPROVE_RESUME\": \"Improve {entityTitleCandidate} Resume\",\n          \"CREATE_PUBLIC_JOB_DESCRIPTION\": \"Create a Public {entityTitleJobOrder} Description\",\n          \"SCREENING_QUESTIONS_JOB\": \"Create Screening Questions\",\n          \"PITCH_CANDIDATE_FOR_JOB\": \"Pitch {entityTitleCandidate} for a {entityTitleJobOrder}\",\n          \"IMPROVE_JOB_DESCRIPTION\": \"Improve {entityTitleJobOrder} Description\",\n          \"INTERVIEW_PREP\": \"Create Interview Prep Tips\",\n          \"EXTRACT_LAST_JOB_TITLE\"