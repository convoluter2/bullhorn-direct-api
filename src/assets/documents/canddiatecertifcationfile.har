earch is owned by another user. Edits cannot be made.\",\n    \"ERRORS\": {\n      \"TITLE_REQUIRED\": \"Search title required\",\n      \"SOURCE_SELECTION_REQUIRED\": \"At least one source required\",\n      \"NLQS_ERROR\": \"There was an issue parsing your query. Please try again.\"\n    },\n    \"RELEVANCY\": {\n      \"HEADER_TEXT\": {\n        \"EXCELLENT\": \"{firstName} is an Excellent Match for\",\n        \"STRONG\": \"{firstName} is a Strong Match for\",\n        \"GOOD\": \"{firstName} is a Good Match for\",\n        \"PARTIAL\": \"{firstName} is a Partial Match for\",\n        \"LIMITED\": \"{firstName} is a Limited Match for\"\n      },\n      \"MATCH\": {\n        \"EXACT\": \"Exact Match\",\n        \"SIMILAR\": \"Similar Match\",\n        \"EXCELLENT\": \"Excellent Match\",\n        \"STRONG\": \"Strong Match\",\n        \"GOOD\": \"Good Match\",\n        \"PARTIAL\": \"Partial Match\",\n        \"LIMITED\": \"Limited Match\",\n        \"NO_MATCH\": \"No Match\"\n      },\n      \"EXACT_SKILL_MATCHES\": \"Exact Skill Matches\",\n      \"SIMILAR_SKILLS\": \"Similar Skills\",\n      \"MISSING_SKILLS\": \"Missing Skills\",\n      \"SIMILAR_TO\": \"Similar to\",\n      \"NO_DIRECT_MATCHING_SKILLS\": \"No direct matching skills were found in the resume.\",\n      \"NO_DIRECT_MATCHING_SKILLS_PLACEMENT\": \"No direct matches found, but the score is based on successful placement patterns with similar {entityTitleCandidate} skill profiles.\",\n      \"NO_JOB_TITLE_FOUND\": \"No {entityTitleJobOrder} title found, but the score is based on successful placement patterns with similar {entityTitleCandidate} profiles.\"\n    }\n  },\n  \"ATTACH_FILE\": {\n    \"DRAG_DROP\": \"Drag & Drop file(s) here to upload\",\n    \"TITLE\": \"Attach File\",\n    \"FILE\": \"File\",\n    \"FILE_NAME\": \"File Name\",\n    \"ATTACH_FILE_TO\": \"Attach File To\",\n    \"SELECT_A_RECORD\": \"Select a record\",\n    \"ATTACH_HINT\": \"You can attach a file to a {entityTitleClientCo