re the chips that appear in the left hand column of the {entityTitleCandidate} view of the scheduler\",\n    \"COMMUNICATION_METHOD_EMAIL\": \"Email\",\n    \"COMMUNICATION_METHOD_SMS\": \"SMS/Texting\",\n    \"COMPANY_CHIP\": \"Company Chip\",\n    \"COMPANY_CHIP_TIP\": \"{entityTitleClientCorporation} Resource Chips are the chips that appear in the left hand column of the {entityTitleClientCorporation} view of the scheduler\",\n    \"DURATION_TOOLTIP\": \"This is the default shift duration that will be used in determining Candidate Availability if a Shift Assignment has no specified End Time\",\n    \"EDIT_SHIFT_TYPE\": \"Edit Shift Type\",\n    \"FILL_RATIO\": {\n      \"UNFILLED\": \"Unfilled\",\n      \"PARTIALLY_FILLED\": \"Partially Filled\",\n      \"FILLED\": \"Filled\"\n    },\n    \"JOB_CHIP\": \"Job Chip\",\n    \"JOB_CHIP_TIP\": \"{entityTitleJobOrder} Resource Chips are the chips that appear in the left hand column of the {entityTitleJobOrder} view of the scheduler\",\n    \"JOB_SHIFT_CHIP_TIP\": \"{entityTitleJobShift} Chips are the chips that appear on the calendar of the {entityTitleClientCorporation} and {entityTitleJobOrder} views of the scheduler\",\n    \"JOB_SHIFT_CHIP\": \"Job Shift Chip\",\n    \"KEY\": \"Key\",\n    \"LOGO\": \"Logo\",\n    \"LOGO_TOOLTIP\": \"Only JPEG and SVG files are supported. Dimensions must be between 00 x 00 and 00 x 00\",\n    \"LOGO_ERROR\": \"Logo is either uploaded by a file manually or uploaded by url but not both. Please remove one.\",\n    \"MESSAGING\": \"Messaging\",\n    \"PREFERRED_SENDER\": \"Preferred Sender\",\n    \"PREFERRED_TOOLTIP\": \"This is the sender that the {entityTitleCandidate} will receive messaging from and have access to through the 'Contact Us' links\",\n    \"RESOURCE_CHIP\": \"Resource Chip\",\n    \"RESOURCE_TIPWELL\": \"Drag and drop to add and re-order fields in the Resource Chips\",\n    \"SCHEDULER_CONFIG\": \"Scheduler Configuration\",\n    \"SHIFT_CHIP\": \"Shift Chip\",\n    \"SHIFT_ASSIGNMENT_CHIP\": \"Shift Assignment Chip\",\n    \"SHIFT_ASSIGNMENT_CHIP_TIP\": \"{entityTitleJobShiftAssignment} Chips are the chips that appear on the calendar of the {entityTitleCandidate} view of the scheduler\",\n    \"STATUS_AVAILABLE\": \"Available\",\n    \"STATUS_UNAVAILABLE\": \"Unavailable\",\n    \"STATUS_PLACED\": \"Placed\",\n    \"STATUS_UNSPECIFIED\": \"Unspecified\",\n    \"STATUS_PREFERRED\": \"Preferred\",\n    \"STATUS_NOT_PREFERRED\": \"Not Preferred\",\n    \"SHIFT_LIST\": \"Shift List\",\n    \"SHIFT_TYPE_TOOLTIP\": \"Shift Types are the timeslots used for Shift Preferences & Availability. Creating more than 5 Shift Types will negatively impact the Candidate View.\",\n    \"SHIFT_TYPE_DUPLICATE\": \"A Shift Type with this start and end time already exists. Please edit shift times and try again.\",\n    \"SHIFT_TYPE_LEGEND\": \"Select an icon that best indicates the Shift Type you are creating.\",\n    \"SHIFT_SETTINGS\": \"Shift Settings\",\n    \"SHIFT_SETTING_SAVE_SUCCESS\": \"{entityTitleShiftSettingMany} have been successfully saved\",\n    \"SHIFT_TIMES\": \"Shift Times\",\n    \"SHIFT_TYPES\": \"Shift Types\",\n    \"UPLOAD_BY_URL\": \"Upload by URL:\",\n    \"USE_DEFAULT_EMAIL\": \"Use Default Email\",\n    \"MODALS\": {\n      \"EDIT_JOB_SHIFT_ASSIGNMENT_TITLE\": \"Edit {entityTitleJobShiftAssignmentMany}\",\n      \"EDIT_ASSIGNMENTS_TIP\": \"You are editing {assignmentCount} {entityTitleJobShiftAssignmentMany}. Any saved changes will affect all selected items.\",\n      \"MASS_EDIT_INITIATED\": \"This can take up to a few minutes to update the {entityTitleJobShiftAssignmentMany}.\",\n      \"MASS_EDIT_INITIATED_TITLE\": \"Mass edit for {entityTitleJobShiftAssignmentMany} has been initiated\",\n      \"MASS_EDIT_BOTH_SCHEDULED_TIMES_REQUIRED\": \"Both Start and End Times are required to update.\"\n    }\n  },\n  \"SHIFT_POSITIONS\": {\n    \"ADD\": \"Add {entityTitleShiftPosition}\",\n    \"ADD_SAVED_MESSAGE\": \"{entityTitleShiftPosition} has been successfully added.\",\n    \"COPY_SHIFT_POSITION\": \"Copy {entityTitleShiftPosition}\",\n    \"COPY_TO_ANOTHER_COMPANY\": \"Copy To Another {entityTitleClientCorporation}\",\n    \"COPY\": \"Copy\",\n    \"EDIT_SAVED_MESSAGE\": \"{entityTitleShiftPosition} has been successfully edited.\",\n    \"DELETED_MESSAGE\": \"{entityTitleShiftPosition} has been successfully deleted.\",\n    \"COPY_SAVED_MESSAGE\": \"{entityTitleShiftPosition} has been successfully copied.\",\n    \"EDIT\": \"Edit {entityTitleShiftPosition}\",\n    \"EMPTY_MESSAGE\": \"You do not have any {entityTitleShiftPositionMany} on this record yet.\",\n    \"TIPWELL_MESSAGE\": \"Rename the {entityTitleShiftPosition} to prevent duplicate copies with the same name.\"\n  },\n  \"SHIFT_DEFINITIONS\": {\n    \"ADD\": \"Add {entityTitleShift}\",\n    \"ADD_SAVED_MESSAGE\": \"{entityTitleShift} has been successfully added.\",\n    \"EDIT_SAVED_MESSAGE\": \"{entityTitleShift} has been successfully edited.\",\n    \"DELETED_MESSAGE\": \"{entityTitleShift} has been successfully deleted.\",\n    \"EDIT\": \"Edit {entityTitleShift}\",\n    \"EMPTY_MESSAGE\": \"You do not have any {entityTitleShiftMany} on this record yet.\",\n    \"TIME_WARNING\": \"Due to a needed product change, your Shift Definition start time and/or end time may be inaccurate. Please check against your Shift time to ensure you have the most accurate time for your Shift\",\n    \"ERRORS\": {\n      \"ASSIGNED_TO_PLACEMENT\": \"This {entityTitleShift} could not be EDITED\"\n    },\n    \"ACCRUEOT_MISMATCH\": \"One or more of the mappings below combines a Source or Target {entityTitleEarnCode} that accrues overtime with an {entityTitleEarnCode} that does not. If intentional, you may continue with these selections.\",\n    \"ACCRUEOT_MISMATCH_CONFIRMATION_TEXT1\": \"This {entityTitleShift} definition contains mappings that combine a Source or Target {entityTitleEarnCode} that accrues overtime with an {entityTitleEarnCode} that does not.\",\n    \"ACCRUEOT_MISMATCH_CONFIRMATION_TEXT2\": \"If intentional, you may continue with these selections.\",\n    \"ACCRUEOT_MISMATCH_CONFIRMATION_BUTTON\": \"Continue Anyway\",\n    \"UNIT_RATETYPE_MISMATCH_COMBINED\": \"For {entityTitleShift} Rate Types that are Combined, it is recommended that mappings use Target Earn Codes that are hours-based. Make sure to include any new Target {entityTitleEarnCode} in the appropriate Rate Cards. If the chosen Target {entityTitleEarnCodeMany} are intentional, you may continue with these selections.\",\n    \"UNIT_RATETYPE_MISMATCH_DIFFERENTIAL\": \"For {entityTitleShift} Rate Types that are Differential, it is recommended that mappings use Target Earn Codes that are units-based. Make sure to include any new Target {entityTitleEarnCode} in the appropriate Rate Cards. If the chosen Target {entityTitleEarnCodeMany} are intentional, you may continue with these selections.\",\n    \"RATE_TYPE_MODAL_HEADER\": \"This action will only impact future {entityTitleShift} Definitions that are added.\",\n    \"RATE_TYPE_MODAL_SUBHEADER\": \"Existing {entityTitleShift} definitions will not update.\",\n    \"RATE_TYPE_MODAL_CONTINUE\": \"Continue\",\n    \"SHIFT_TYPE_SAVE_SUCCESS\": \"Changes to {entityTitleShift} Rate Type have successfully saved.\",\n    \"CONFIRM_UPDATE_SHIFT_SET_HEADER\": \"This action will update the {entityTitlePlacement} {entityTitleShift} Set associated with this {entityTitleShift} Definition.\",\n    \"CONFIRM_UPDATE_SHIFT_SET_SUBHEADER\": \"{entityTitleTimesheet}s on those {entityTitlePlacement}s will not automatically recalculate, but WILL update if they are reprocessed.\",\n    \"CONFIRM_UPDATE_SHIFT_SET_CONTINUE\": \"Continue\",\n    \"HOURS_RECOMMENDED\": \"Hours based earn codes are recommended \",\n    \"HOURS_RECOMMENDED2\": \"when {entityTitleShift} Rate Type is Combined\",\n    \"UNITS_RECOMMENDED\": \"Unit based earn codes are recommended \",\n    \"UNITS_RECOMMENDED2\": \"when {entityTitleShift} Rate Type is Differential\",\n    \"IS_ACTIVE_CHANGE_MODAL_TO_INACTIVE_HEADER\": \"Make {entityTitleShift} Inactive?\",\n    \"IS_ACTIVE_CHANGE_MODAL_TO_INACTIVE_DESCRIPTION\": \"This action will prevent the {entityTitleShift} from being assigned to future records. The {entityTitleShift} will continue to be applied on {entityTitlePlacementMany} where it was previously assigned.\",\n    \"CONFIRM_CHANGE\": \"Continue\",\n    \"IS_ACTIVE_CHANGE_MODAL_TO_ACTIVE_HEADER\": \"Activate {entityTitleShift}?\",\n    \"IS_ACTIVE_CHANGE_MODAL_TO_ACTIVE_DESCRIPTION\": \"Once activated, the {entityTitleShift} will be eligible for assignment on a record.\"\n  },\n  \"SHIFT_IDENTIFICATIONS\": {\n    \"ASSIGN_SHIFT_DEFINITION\": \"Assign {entityTitleShiftMany}\",\n    \"SHIFT_DEFINITION_TEMPLATES\": \"{entityTitleShift} Templates\",\n    \"SHIFT_DEFINITIONS\": \"{entityTitleShiftMany}\",\n    \"ASSIGN\": \"Assign\",\n    \"SHIFT_DEFINITIONS_TOOLTIP\": \"Only active {entityTitleShiftMany} from this {entityTitleShift} Template are displayed below\",\n    \"SELECT_SHIFT_DEFINITION\": \"Select a {entityTitleShift}\",\n    \"WEEK\": \"Week\",\n    \"OVERLAPPED_SHIFTS_TIP\": \"Some of your {entityTitleShiftMany} may be overlapping and accounting for the same time period.\",\n    \"NO_DAYS_SELECTED\": \"No days selected\",\n    \"NO_SHIFT_DEFINITIONS_FOR_VERSION\": \"There are no {entityTitleShiftMany} associated with this version\",\n    \"PLACEMENT_SHIFT_SET_SAVE_SUCCESSFUL\": \"{entityTitleShiftMany} saved successfully.\",\n    \"UPDATE_CURRENT_SET_WARNING\": \"You are about to change the {entityTitleShiftMany} which are ACTIVELY assigned to this {entityTitlePlacement} instead of a new version. This could negatively impact any time already entered and processed associated with this {entityTitleJobShift}.\"\n  },\n  \"SHIFT_ADMIN\": {\n    \"DRAG_HINT\": \"Drag field here...\",\n    \"DRAG_HINT_PLURAL\": \"Drag fields here...\",\n    \"INVALID_FOOTER_FIELD\": \"This field is only a