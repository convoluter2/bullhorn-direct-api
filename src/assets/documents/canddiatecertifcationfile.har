EvalRule} Name\",\n    \"RULE_DESCRIPTION\": \"Description\",\n    \"RULE_TYPE\": \"{entityTitleTimeLaborEvalRule} Type\",\n    \"RULE_PREVIEW\": \"{entityTitleTimeLaborEvalRule} Preview (READ ONLY)\",\n    \"COMBINE_CRITERIA\": \"Combine Criteria\",\n    \"APPLICABLE_STATES\": \"Applicable States\",\n    \"APPLICABLE_PROVINCES\": \"Applicable Provinces\",\n    \"SOURCE_EARN_CODE\": \"Source Earn Code\",\n    \"SOURCE_EARN_CODE_GROUP\": \"Source {entityTitleEarnCodeGroup}\",\n    \"THRESHOLDS\": \"Target Thresholds\",\n    \"AFTER\": \"After\",\n    \"FIRST\": \"First\",\n    \"NEXT\": \"Next\",\n    \"NUMBER_OF_HOURS\": \"No. of Hours\",\n    \"FLSA_TYPE\": \"FLSA Type\",\n    \"ALLOW_NEGATIVE_ADJUSTMENTS\": \"Allow Negative Adjustments?\",\n    \"FLSA_ELIGIBLE_SOURCE_EARN_CODES\": \"FLSA - Eligible Source Earn Codes\",\n    \"WEIGHTED_AVERAGE_OVERTIME_SOURCE_EARN_CODES\": \"Weighted Average Overtime - Eligible Source Earn Codes\",\n    \"HOURS\": \"Hours\",\n    \"DOLLARS\": \"Dollars\",\n    \"PREMIUM\": \"Premium\",\n    \"THRESHOLD\": \"Threshold\",\n    \"ADD_THRESHOLD\": \"Add Threshold\",\n    \"ADD_EARN_CODE\": \"Add {entityTitleEarnCode}\",\n    \"ADD_ALL_EARN_CODES\": \"Add All {entityTitleEarnCodeMany}\",\n    \"TARGET_EARN_CODE\": \"Target Earn Code\",\n    \"TARGET_EARN_CODE_GROUP\": \"Target {entityTitleEarnCodeGroup}\",\n    \"USED_ON_RULE_TEMPLATES\": \"Used on {entityTitleTimeLaborEvalRuleTemplateMany}\",\n    \"TIME_AND_LABOR_RULES_DETAIL\": \"{entityTitleTimeLaborEvalRule} Details\",\n    \"RULES\": \"{entityTitleTimeLaborEvalRuleMany}\",\n    \"RULE_TEMPLATE\": \"{entityTitleTimeLaborEvalRuleTemplate}\",\n    \"RULE_TEMPLATES\": \"{entityTitleTimeLaborEvalRuleTemplateMany}\",\n    \"GENERAL_INFORMATION\": \"General Information\",\n    \"RULE_TYPE_INFORMATION\": \"{entityTitleTimeLaborEvalRule} Type Information\",\n    \"SELECT_RULE_TYPE_TIP\": \"Select a {entityTitleTimeLaborEvalRule} Type to preview additional fields.\",\n    \"SELECT_RULE_TYPE