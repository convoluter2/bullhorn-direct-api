 \"Selected Columns\",\n  \"RESET\": \"Reset\",\n  \"LAYOUTS\": \"Layouts\",\n  \"LAYOUT_NAME\": \"Layout Name\",\n  \"REQUIRED_COLUMN_SELECTION\": \"This is a required selected column\",\n  \"CREATE_UNBILLED_REVENUE_DISTRIBUTIONS_MODAL\": {\n    \"CREATE_CONFIRMATION_WARNING\": {\n      \"other\": {\n        \"1\": \"Are you sure you want to create a distribution batch for the selected {entityTitleBillableCharge}?\",\n        \"many\": \"Are you sure you want to create a distribution batch for the selected {entityTitleBillableChargeMany}?\"\n      }\n    },\n    \"UNABLE_TO_CREATE\": {\n      \"other\": {\n        \"0\": \"Unable to Create a Distribution Batch.\",\n        \"1\": \"1 selected {entityTitleBillableCharge} is already associated with a distribution batch and will not be altered.\",\n        \"many\": \"{quantity:number} selected {entityTitleBillableChargeMany} are already associated with distribution batches and will not be altered.\"\n      }\n    },\n    \"UNABLE_TO_CREATE_DESCRIPTION\": {\n      \"other\": {\n        \"0\": \"A {entityTitleBillableCharge} must not have a distribution batch associated to create unbilled revenue distributions.\",\n        \"1\": \"Do you want to proceed with the remaining {entityTitleBillableCharge}?\",\n        \"many\": \"Do you want to proceed with the remaining {quantity:number} {entityTitleBillableChargeMany}?\"\n      }\n    },\n    \"UNABLE_TO_CREATE_NONE_DESCRIPTION\": {\n      \"other\": {\n        \"0\": \"Unable to Create a Distribution Batch.\",\n        \"1\": \"A {entityTitleBillableCharge} must not have a distribution batch associated to create unbilled revenue distributions.\",\n        \"many\": \"{entityTitleBillableChargeMany} must not have a distribution batch associated to create unbilled revenue distributions.\"\n      }\n    }\n  },\n  \"EXPORT_UNBILLED_REVENUE_DISTRIBUTIONS_MODAL\": {\n    \"EXPORT_CONFIRMATION_WARNING\": {\n      \"other\": {\n        \"1\": \"Are you sure you want to export the selected {entityTitleBillableCharge}?\",\n        \"many\": \"Are you sure you want to export the selected {entityTitleBillableChargeMany}?\"\n      }\n    },\n    \"EXPORT_SOME\": {\n      \"other\": {\n        \"1\": \"1 {entityTitleBillableCharge} will be exported.\",\n        \"many\": \"{quantity:number} {entityTitleBillableChargeMany} will be exported.\"\n      }\n    },\n    \"EXPORT_SOME_DESCRIPTION\": {\n      \"other\": {\n        \"1\": \"The remaining {entityTitleBillableCharge} selected must be in Ready to Export or Export Failed status to be exported.\",\n        \"many\": \"The remaining {entityTitleBillableChargeMany} selected must be in Ready to Export or Export Failed status to be exported.\"\n      }\n    },\n    \"UNABLE_TO_EXPORT\": {\n      \"other\": {\n        \"1\": \"Unable to Export {entityTitleBillableCharge}.\",\n        \"many\": \"Unable to Export {entityTitleBillableChargeMany}.\"\n      }\n    },\n    \"UNABLE_TO_EXPORT_DESCRIPTION\": {\n      \"other\": {\n        \"1\": \"The {entityTitleBillableCharge} selected must be in Ready to Export or Export Failed status to be exported.\",\n        \"many\": \"The {entityTitleBillableChargeMany} selected must be in Ready to Export or Export Failed status to be exported.\"\n      }\n    }\n  },\n  \"RESYNC_TO_INVOICE_TERMS_MODAL\": {\n    \"BUTTON_LABEL\": \"Resync\",\n    \"CONFIRMATION_HEADER\": \"Resync {entityTitlePayBillCycle} to {entityTitleInvoiceTerm}\",\n    \"CONFIRMATION_TEXT\": {\n      \"other\": {\n        \"1\": \"The selected {entityTitleBillableCharge} will be resynced to its associated {entityTitleInvoiceTerm}\",\n        \"many\": \"The selected {entityTitleBillableChargeMany} will be resynced to their associated {entityTitleInvoiceTermMany}\"\n      }\n    },\n    \"SOME_MATCH_HEADER\": {\n      \"other\": {\n        \"1\": \"1 {entityTitleBillableCharge} currently in processing\",\n        \"many\": \"{quantity:number} {entityTitleBillableChargeMany} currently in processing\"\n      }\n    },\n    \"SOME_MATCH_TEXT\": {\n      \"other\": {\n        \"1\": \"Do you want to resync the remaining {entityTitleBillableCharge}?\",\n        \"many\": \"Do you want to resync the remaining {entityTitleBillableChargeMany}?\"\n      }\n    },\n    \"NONE_HEADER\": {\n      \"other\": {\n        \"1\": \"The selected {entityTitleBillableCharge} is currently in processing and can't be resynced at this time\",\n        \"many\": \"All selected {entityTitleBillableChargeMany} are currently in processing and can't be resynced at this time\"\n      }\n    },\n    \"INFO_TEXT\": \"Charges already in processing will not be added to the queue\"\n  },\n  \"RESYNC_FAILED_BILLABLE_CHARGES_MODAL\": {\n    \"BUTTON_LABEL\": \"Resync\",\n    \"CONFIRMATION_HEADER\": {\n      \"other\": {\n        \"1\": \"Resync Failed {entityTitleBillableCharge}\",\n        \"many\": \"Resync Failed {entityTitleBillableChargeMany}\"\n      }\n    },\n    \"CONFIRMATION_TEXT\": {\n      \"other\": {\n        \"1\": \"The selected {entityTitleBillableCharge} that is in a processing failed status will be resynced based on their original sync request\",\n        \"many\": \"The selected {entityTitleBillableChargeMany} that are in a processing failed status will be resynced based on their original sync request\"\n      }\n    },\n    \"SOME_MATCH_HEADER\": {\n      \"other\": {\n        \"1\": \"1 {entityTitleBillableCharge} not in processing failed status\",\n        \"many\": \"{quantity:number} {entityTitleBillableChargeMany} not in processing failed status\"\n      }\n    },\n    \"SOME_MATCH_TEXT\": {\n      \"other\": {\n        \"1\": \"Do you want to resync the remaining failed {entityTitleBillableCharge}?\",\n        \"many\": \"Do you want to resync the remaining failed {entityTitleBillableChargeMany}?\"\n      }\n    },\n    \"NONE_HEADER\": {\n      \"other\": {\n        \"1\": \"The selected {entityTitleBillableCharge} is not in processing failed status and can't be resynced at this time\",\n        \"many\": \"All selected {entityTitleBillableChargeMany} are not in processing failed status and can't be resynced at this time\"\n      }\n    },\n    \"INFO_TEXT\": \"Charges not in processing failed status will not be added to the queue\"\n  },\n  \"CHANGE_ACCOUNTING_PERIOD_MODAL\": {\n    \"ALL_MATCH_HEADER\": \"This action will update the Accounting Periods on the transactions of the selected {entityTitleMany}\",\n    \"ALL_MATCH_TEXT\": \"To continue, please select what date you would like to update and select which date you would like to assign as the new accounting period.\",\n    \"CURRENT_ACCOUNTING_PERIOD\": \"Current Accounting Period\",\n    \"NEW_ACCOUNTING_PERIOD\": \"New Accounting Period\",\n    \"CONFIRM_CHANGE_ACCOUNTING_PERIOD_ONE\": \"Are you sure that you want to change the Accounting Period on the transactions associated with this {entityTitleOne}?\",\n    \"CONFIRM_CHANGE_ACCOUNTING_PERIOD_MANY\": \"Are you sure that you want to change the Accounting Period on the transactions associated with these {billableChargeCount} {entityTitleMany}?\",\n    \"CHANGE_ACCOUNTING_PERIOD_SUCCESS\": \"The Accounting Periods on {entityTitleOne} Transactions have been successfully updated\"\n  },\n  \"MANAGE_INVOICING_HOLD_MODAL\": {\n    \"ALL_MATCH_HEADER\": {\n      \"other\": {\n        \"1\": \"This action will update the Invoicing Hold on the selected {entityTitleBillableCharge}.\",\n        \"many\": \"This action will update the Invoicing Hold on the selected {entityTitleBillableChargeMany}.\"\n      }\n    },\n    \"ALL_MATCH_TEXT\": \"If you leave a field empty, any previously saved values will be cleared.\",\n    \"MANAGE_INVOICING_HOLD_SUCCESS\": \"Invoicing Hold Successfully Updated\"\n  },\n  \"CANDIDATE_CONNECT\": {\n    \"NOT_SENT\": \"Not Invited\",\n    \"BLOCKED_MESSAGE\": \"The Candidate Portal Account for this record has been blocked. The Candidate will no longer be allowed to login and existing sessio