          "cookies": [],
          "content": {
            "size": 282759,
            "mimeType": "application/json",
            "text": "{\"total\":47,\"start\":0,\"count\":47,\"data\":[{\"id\":4006,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"4-Not-Qualified-Reason-required-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            init: () => {\\n                if (form.controls.status.value === 'Not Qualified') {\\n                    if (form.controls.customText22.value === '') {\\n                        form.isFormValid = false;\\n                        form.errorMessage = 'Please Select Not Qualified Reason';\\n                    }\\n                    else {\\n                        form.isFormValid = true;\\n                        form.errorMessage = '';\\n                    }\\n                }\\n            },\\n        };\\n        if (API.currentEntity === 'Candidate')\\n            return app.init();\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1757419237207},{\"id\":4014,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"69-checking-blacklist-candidate-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            init: () => {\\n                let jobID = '';\\n                let candidateID = '';\\n                let customText1;\\n                candidateID = form.data.candidate.id;\\n                jobID = form.data.jobOrder.id;\\n                return app.getJobDetails(jobID).then((results) => {\\n                    customText1 = results.clientCorporation.customText1;\\n                    if (customText1 !== null && customText1 !== '' && customText1 !== undefined) {\\n                        const arrayresultComp = customText1.filter((data) => {\\n                            return data === 'TS-Do Not Service';\\n                        });\\n                        if (arrayresultComp.length > 0) {\\n                            form.isFormValid = false;\\n                            form.errorMessage = 'Company brand status invalid';\\n                        }\\n                    }\\n                    const clientCorporation = results.clientCorporation.name;\\n                    return app.getDetails(candidateID).then((result) => {\\n                        const customText26 = result.customText26;\\n                        if (customText26 !== null && customText26 !== '' && customText26 !== undefined) {\\n                            const arrayresult = customText26.filter((data) => {\\n                                return data === clientCorporation;\\n                            });\\n                            if (arrayresult.length > 0) {\\n                                form.isFormValid = false;\\n                                form.errorMessage = 'Candidate is blacklisted';\\n                            }\\n                        }\\n                    });\\n                });\\n            },\\n            getDetails: (candidateID) => {\\n                const url = `${app.baseUrl}/search/Candidate?query=id:${candidateID}&fields=id,customText26`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    const finalresult = result.data[0];\\n                    return Promise.resolve(finalresult);\\n                }, (err) => {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n            getJobDetails: (jobID) => {\\n                const url = `${app.baseUrl}/query/JobOrder?fields=id,clientCorporation(id,name,customText1)&where=id=${jobID}`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    const finalresult = result.data[0];\\n                    return Promise.resolve(finalresult);\\n                }, (err) => {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement')\\n            return app.init();\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1757419237217},{\"id\":4016,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"37-triggered-on-rate-card-update-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            init: () => {\\n                const PlacementId = API.pageDK.config.entityId;\\n                const changedEntityId = form.data.data.changedEntityId;\\n                API.appBridge.httpGET(`/query/PlacementRateCard?fields=id&where=id=${changedEntityId}`).then((data) => {\\n                    const placementRateCardId = data.data.data[0].id;\\n                    API.appBridge.httpGET(`/query/PlacementRateCardLineGroup?fields=placementRateCardLines&where=placementRateCard.id=${placementRateCardId} \\n          AND placementRateCardLines.earnCode.code='REG'`).then((result) => {\\n                        API.appBridge.httpPOST(`entity/Placement/${PlacementId}`, {\\n                            clientBillRate: result.data.data[0].placementRateCardLines.data[0].billRate,\\n                            payRate: result.data.data[0].placementRateCardLines.data[0].payRate,\\n                        }).then(() => {\\n                            console.log('Update Done');\\n                        });\\n                    });\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'PlacementRateCard')\\n            return app.init();\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1757419237247},{\"id\":4041,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"merge-duplicate-matches-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            existingSubmissionError: 'There already exists a submission on this job with this candidate.',\\n            submissionFields: [],\\n            init: () => {\\n                // See if a jobSubmission exists with the same job and candidate.\\n                // If so, see what differences exist on the form\\n                // If any, merge them\\n                const candidates = form.controls.candidate.value;\\n                const jobs = form.controls.jobOrder.value;\\n                if (candidates && candidates.length > 0 && jobs && jobs.length > 0) {\\n                    const promises = [];\\n                    jobs.forEach((job) => {\\n                        candidates.forEach((candidate) => {\\n                            promises.push(app.findExistingSubmission(candidate.id, job.id));\\n                        });\\n                    });\\n                    return Promise.all(promises).then((submissions) => {\\n                        const updatePromises = [];\\n                        submissions.forEach((submission) => {\\n                            const updateBody = app.makeSubmissionUpdateBody();\\n                            if (updateBody) {\\n                                updatePromises.push(app.makeSubmissionUpdates(submission[0].id, updateBody));\\n                            }\\n                        });\\n                        return Promise.all(updatePromises).then(() => {\\n                            return form;\\n                        });\\n                    });\\n                }\\n                return form;\\n            },\\n            makeSubmissionUpdateBody: () => {\\n                const submissionUpdateBody = {};\\n                const keysToIgnore = ['jobOrder', 'candidate', 'recipients', 'distributionLists', 'scheduleNextAction', 'sendingUser'];\\n                const dateKeys = ['startDate', 'endDate'];\\n                Object.keys(form.controls).forEach((key) => {\\n                    if (form.controls[key].value) {\\n                        if (dateKeys.indexOf(key) > -1) {\\n                            submissionUpdateBody[key] = form.controls[key].value.getTime();\\n                        }\\n                        else if (keysToIgnore.indexOf(key) === -1) {\\n                            submissionUpdateBody[key] = form.controls[key].value;\\n                        }\\n                    }\\n                });\\n                return submissionUpdateBody;\\n            },\\n            makeSubmissionFields: () => {\\n                const submissionFields = Object.keys(form.controls);\\n                submissionFields.splice(submissionFields.indexOf('recipients'), 1);\\n                submissionFields.splice(submissionFields.indexOf('distributionLists'), 1);\\n                submissionFields.splice(submissionFields.indexOf('scheduleNextAction'), 1);\\n                return submissionFields;\\n            },\\n            makeSubmissionUpdates: (submissionId, updateBody) => {\\n                const url = `${app.baseUrl}entity/JobSubmission/${submissionId}`;\\n                return API.http.post(url, updateBody).toPromise().then((result) => {\\n                    return Promise.resolve(result);\\n                });\\n            },\\n            findExistingSubmission: (candidateId, jobId) => {\\n                const submissionFields = app.makeSubmissionFields();\\n                const url = `${app.baseUrl}query/JobSubmission?where=candidate.id=${candidateId} AND jobOrder.id=${jobId}&fields=id`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n        };\\n        console.log('merge-duplicate');\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'FastAdd') {\\n            console.log('JobSubmission', API, form);\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1757419237237},{\"id\":4208,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"544-populate-submissions-on-mass-add-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const transforms = {\\n            userToName: (data, field) => {\\n                return `${data[field.fromField].firstName} ${data[field.fromField].lastName} | ${data.id}`;\\n            },\\n            sliceString: (data, field) => {\\n                if (data[field.fromField]) {\\n                    const splitString = data[field.fromField].split('|');\\n                    return splitString[0].trim();\\n                }\\n                return null;\\n            },\\n        };\\n        const app = {\\n            baseUrl: API.http.restURL,\\n            jobFieldsToFlow: [\\n                { fromField: 'customText7', toField: 'customTextBlock4' },\\n                { fromField: 'owner', toField: 'customText19', transform: 'userToName' },\\n                { fromField: 'customText17', toField: 'customText7' },\\n                { fromField: 'correlatedCustomText5', toField: 'customText9' },\\n            ],\\n            init: () => {\\n                const jobPromises = [];\\n                const submissionPromises = [];\\n                form.data.forEach((submission) => {\\n                    if (submission.changeType === 'INSERT') {\\n                        const id = submission.changedEntityId;\\n                        jobPromises.push(app.getJobsFromSubmissions(id));\\n                    }\\n                });\\n                return Promise.all(jobPromises).then((responses) => {\\n                    responses.forEach((response) => {\\n                        const addressString = app.getAddressString(response.jobOrder.address);\\n                        const body = app.makeBody(addressString, response.jobOrder);\\n                        submissionPromises.push(app.updateSubmission(response.id, body));\\n                    });\\n                    return Promise.all(submissionPromises).then(() => {\\n                        return form;\\n                    });\\n                });\\n            },\\n            makeBody: (addressString, jobOrder) => {\\n                const body = {\\n                    customTextBlock3: addressString,\\n                };\\n                app.jobFieldsToFlow.forEach((field) => {\\n                    if (field.transform) {\\n                        body[field.toField] = transforms[field.transform](jobOrder, field);\\n                    }\\n                    else {\\n                        body[field.toField] = jobOrder[field.fromField];\\n                    }\\n                });\\n                return body;\\n            },\\n            getAddressString: (address) => {\\n                let string = '';\\n                string = (address.address1) ? address.address1.trim() : '';\\n                string = (string !== '' && address.address2) ? `${string}, ${address.address2.trim()}` : ((address.address2) ? address.address2.trim() : string);\\n                string = (string !== '' && address.city) ? `${string}, ${address.city}` : ((address.city) ? address.city : string);\\n                string = (string !== '' && address.state) ? `${string}, ${address.state}` : ((address.state) ? address.state : string);\\n                string = (string !== '' && address.countryName) ? `${string}, ${address.countryName}` : ((address.countryName) ? address.countryName : string);\\n                string = (string !== '' && address.zip) ? `${string} ${address.zip}` : ((address.zip) ? address.zip : string);\\n                return string;\\n            },\\n            getJobsFromSubmissions: (submissionId) => {\\n                let jobFields = 'id,address,';\\n                jobFields += app.jobFieldsToFlow.map((field) => {\\n                    return field.fromField;\\n                }).join(',');\\n                const url = `${app.baseUrl}/entity/JobSubmission/${submissionId}?fields=id,jobOrder(${jobFields})`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n            updateSubmission: (submissionid, body) => {\\n                const url = `${app.baseUrl}/entity/JobSubmission/${submissionid}`;\\n                return API.http.post(url, body).toPromise().then(() => {\\n                    return Promise.resolve();\\n                });\\n            },\\n        };\\n        console.log('populate on mass add');\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1757419237240},{\"id\":4237,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":4,\"firstName\":\"VMS Sync\",\"lastName\":\"API User\"},\"name\":\"738-prevent-duplicate-placement-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            baseUrl: API.http.restURL,\\n            existingSubmissionError: 'There already exists a placement on this job with this candidate.',\\n            submissionFields: [],\\n            init: function () {\\n                // See if a placement exists with the same job and candidate.\\n                // If so, prevent save\\n                var candidate = form.data.candidate;\\n                var job = form.data.jobOrder;\\n                if (candidate && job) {\\n                    var promises = [];\\n                    return app.findExistingPlacement(candidate.id, job.id).then(function (results) {\\n                        if (results.length > 0) {\\n                            form.isFormValid = false;\\n                            form.errorMessage = app.existingSubmissionError;\\n                        }\\n                        return form;\\n                    });\\n                }\\n                return form;\\n            },\\n            findExistingPlacement: function (candidateId, jobId) {\\n                var url = app.baseUrl + \\\"query/Placement?where=candidate.id=\\\" + candidateId + \\\" AND jobOrder.id=\\\" + jobId + \\\"&fields=id\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n        };\\n        console.log('prevent-duplicate');\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1729536563677},{\"id\":4239,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":4,\"firstName\":\"VMS Sync\",\"lastName\":\"API User\"},\"name\":\"update-custom-date-on-status-change-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            init: function () {\\r\\n                if (!API.currentEntityId) {\\r\\n                    return Promise.resolve(form);\\r\\n                }\\r\\n                return new Promise(function (resolve, reject) {\\r\\n                    var status = form.controls.status;\\r\\n                    if (app.hasFieldChanged(status.key)) {\\r\\n                        if (status.value.toLowerCase() === 'did not start') {\\r\\n                            console.log('Field Changed to ', status);\\r\\n                            var changeObject = {\\r\\n                                id: API.currentEntityId,\\r\\n                                customDate1: app.getUTCDate().getTime(),\\r\\n                            };\\r\\n                            return app.commitChange(changeObject).then(function (i) {\\r\\n                                return resolve(i);\\r\\n                            }).catch(function (error) {\\r\\n                                return reject(error);\\r\\n                            });\\r\\n                        }\\r\\n                    }\\r\\n                    return resolve(form);\\r\\n                });\\r\\n            },\\r\\n            getUTCDate: function () {\\r\\n                var currentDate = new Date();\\r\\n                var utcDate = new Date(currentDate.getUTCFullYear(), currentDate.getUTCMonth(), currentDate.getUTCDate(), 0, 0, 0);\\r\\n                return utcDate;\\r\\n            },\\r\\n            hasFieldChanged: function (field) {\\r\\n                if (!form.controls[field]) {\\r\\n                    return false;\\r\\n                }\\r\\n                var control = form.controls[field];\\r\\n                return (!control.pristine)\\r\\n                    && (control.valueHistory.length > 1\\r\\n                        && control.valueHistory[0] !== control.valueHistory[control.valueHistory.length - 1]);\\r\\n            },\\r\\n            commitChange: function (changeObject) {\\r\\n                return new Promise(function (resolve) {\\r\\n                    var url = \\\"entity/Placement/\\\" + changeObject.id;\\r\\n                    API.appBridge.httpPOST(url, changeObject).then(function (result) {\\r\\n                        if (result.data.data) {\\r\\n                            resolve(result.data.data);\\r\\n                        }\\r\\n                        else {\\r\\n                            resolve(null);\\r\\n                        }\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Placement') {\\r\\n            console.log('update-custom-date-on-status-change-1218');\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve(form);\",\"sortOrder\":0,\"dateLastModified\":1731684016013},{\"id\":4498,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":18813622,\"firstName\":\"interactionapiuser.ingenovis\",\"lastName\":\"ingenovishealth\"},\"name\":\"post-save-handler-job-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            ENRICH_FIELDS: [\\n                { from: 'clientAgreementPicker', to: 'clientAgreementPicker', transform: 'jobRateHandler' },\\n                { from: 'correlatedCustomFloat2', to: 'customInt5', transform: 'roundHandler' },\\n                // 06074427: Removed total weekly package manipulation\\n                // { from: 'customFloat1', to: 'customInt7', transform: 'roundHandler' },\\n                { from: 'payRate', to: 'customInt4', transform: 'roundHandler' },\\n            ],\\n            customToId: function (changeObject, to, value) {\\n                if (value) {\\n                    changeObject[to] = { id: value.id };\\n                }\\n                Promise.resolve(true);\\n            },\\n            roundHandler: function (changeObject, to, value) {\\n                let roundedVal = null;\\n                if (value) {\\n                    roundedVal = Math.round(value);\\n                }\\n                changeObject[to] = roundedVal;\\n                return Promise.resolve(true);\\n            },\\n            jobRateHandler: function (changeObject, to, value) {\\n                console.log('jobRateHandler');\\n                console.log(changeObject, to, value);\\n                if (!value || !value.id) {\\n                    return Promise.resolve(false);\\n                }\\n                return app.getJobRate(changeObject.id).then((result) => {\\n                    if (result) {\\n                        return Promise.resolve(false);\\n                    }\\n                    return app.createJobRates(changeObject, to, value).then((created) => {\\n                        const cra = {\\n                            id: changeObject.id,\\n                            customText25: `${value.name} | ${value.id}`,\\n                        };\\n                        return app.commitChanges(cra).then(() => {\\n                            return Promise.resolve(created);\\n                        });\\n                    });\\n                });\\n            },\\n            createJobRates: function (changeObject, to, craValue) {\\n                const effectiveDate = (form.controls.startDate) ? form.controls.startDate.value : null;\\n                if (!effectiveDate) {\\n                    return Promise.resolve(false);\\n                }\\n                const effectiveDateStr = `${effectiveDate.getFullYear()}-${(`0${effectiveDate.getMonth() + 1}`).slice(-2)}-${(`0${effectiveDate.getDate()}`).slice(-2)}`;\\n                return app.getCRAData(craValue.id).then((result) => {\\n                    if (!result.clientCorporationRateAgreementCardLineGroups || result.clientCorporationRateAgreementCardLineGroups.total === 0) {\\n                        return Promise.resolve(false);\\n                    }\\n                    const jobOrderRateCardLineGroups = result.clientCorporationRateAgreementCardLineGroups.data.map((group) => {\\n                        return {\\n                            isBase: group.isBase,\\n                            earnCodeGroup: {\\n                                id: group.earnCodeGroup.id,\\n                            },\\n                            jobOrderRateCardLines: group.clientCorporationRateAgreementCardLines.data.map((line) => {\\n                                return {\\n                                    earnCode: {\\n                                        id: line.earnCode.id,\\n                                    },\\n                                    payRate: line.payRate,\\n                                    billRate: line.billRate,\\n                                    payMultiplier: line.payMultiplier,\\n                                    billMultiplier: line.billMultiplier,\\n                                    markupPercent: line.markupPercent,\\n                                    markupValue: line.markupValue,\\n                                };\\n                            }),\\n                        };\\n                    });\\n                    const changeRateObject = {\\n                        jobOrderRateCardLineGroups: jobOrderRateCardLineGroups,\\n                        jobPosting: {\\n                            id: changeObject.id,\\n                        },\\n                        effectiveDate: effectiveDateStr,\\n                    };\\n                    const url = `${API.http.restURL}entity/JobOrderRateCard`;\\n                    return API.http.put(url, changeRateObject).toPromise().then(() => {\\n                        return Promise.resolve(true);\\n                    });\\n                });\\n            },\\n            getJobRate: function (jobId) {\\n                const url = `${API.http.restURL}entity/JobOrder/${jobId}?fields=jobOrderRateCardID,customText25`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    return Promise.resolve(result.data.jobOrderRateCardID);\\n                });\\n            },\\n            getCRAData: function (craID) {\\n                const url = `${API.http.restURL}entity/ClientCorporationRateAgreementCard/${craID}?fields=clientCorporationRateAgreementCardLineGroups[100]`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n            commitChanges: function (changeObject) {\\n                const url = `${API.http.restURL}entity/JobOrder/${changeObject.id}`;\\n                return API.http.post(url, changeObject).toPromise();\\n            },\\n            init: function () {\\n                const entityId = form.data.changedEntityId;\\n                const changeObject = {\\n                    id: entityId,\\n                };\\n                const promises = [];\\n                let update = false;\\n                app.ENRICH_FIELDS.forEach((field) => {\\n                    if (form.controls[field.from]) {\\n                        if (field.transform) {\\n                            promises.push(app[field.transform](changeObject, field.to, form.controls[field.from].value));\\n                        }\\n                        else {\\n                            changeObject[field.to] = form.controls[field.from].value;\\n                            update = true;\\n                        }\\n                    }\\n                });\\n                return Promise.all(promises).then((jobChanges) => {\\n                    update = update || jobChanges.some((jobChange) => {\\n                        return jobChange;\\n                    });\\n                    if (update) {\\n                        return app.commitChanges(changeObject).then(() => {\\n                            return Promise.resolve(form);\\n                        });\\n                    }\\n                    return Promise.resolve(form);\\n                });\\n            },\\n        };\\n        if (API.currentEntity !== 'JobOrder') {\\n            return form;\\n        }\\n        console.log('JobOrder Entry');\\n        return app.init();\",\"sortOrder\":0,\"dateLastModified\":1782984890930},{\"id\":4504,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":18813622,\"firstName\":\"interactionapiuser.ingenovis\",\"lastName\":\"ingenovishealth\"},\"name\":\"strike-notice-recieved-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            jobOrderId: form.data.changedEntityId,\\n            init: function () {\\n                console.log('strike-notice-recieved', API, form);\\n                const newOpportunityId = (form.controls.customText35.value === '') ? null : form.controls.customText35.value;\\n                const changeObject = {};\\n                return app.getJobOrderData().then((jobOrderData) => {\\n                    const existingOppId = (jobOrderData.opportunity) ? jobOrderData.opportunity.id : null;\\n                    if (String(existingOppId) !== String(newOpportunityId)) {\\n                        if (!newOpportunityId) {\\n                            changeObject.customText35 = String(existingOppId);\\n                            if (jobOrderData.opportunity.type === 'Project' && jobOrderData.opportunity.customText3 === 'Active Job Action') {\\n                                changeObject.startDate = jobOrderData.opportunity.estimatedStartDate;\\n                                changeObject.dateEnd = jobOrderData.opportunity.estimatedEndDate;\\n                                changeObject.customDate3 = jobOrderData.opportunity.customDate2;\\n                                changeObject.durationWeeks = jobOrderData.opportunity.estimatedDuration;\\n                                changeObject.hoursPerWeek = jobOrderData.opportunity.estimatedHoursPerWeek;\\n                            }\\n                            return app.commitChanges(changeObject);\\n                        }\\n                        return app.getOpportunityData(newOpportunityId).then((oppData) => {\\n                            changeObject.opportunity = { id: oppData.id };\\n                            if (oppData.type === 'Project' && oppData.customText3 === 'Active Job Action') {\\n                                changeObject.startDate = oppData.estimatedStartDate;\\n                                changeObject.dateEnd = oppData.estimatedEndDate;\\n                                changeObject.customDate3 = oppData.customDate2;\\n                                changeObject.durationWeeks = oppData.estimatedDuration;\\n                                changeObject.hoursPerWeek = oppData.estimatedHoursPerWeek;\\n                            }\\n                            return app.commitChanges(changeObject);\\n                        });\\n                    }\\n                    return Promise.resolve();\\n                });\\n            },\\n            getOpportunityData: function (oppId) {\\n                const fields = 'customText3,customDate2,estimatedStartDate,estimatedEndDate,estimatedDuration,estimatedHoursPerWeek,type,id';\\n                return API.appBridge.httpGET(`/entity/Opportunity/${oppId}?fields=${fields}`).then((result) => {\\n                    return Promise.resolve(result.data.data);\\n                });\\n            },\\n            getJobOrderData: function () {\\n                const fields = 'opportunity(customText3,customDate2,estimatedStartDate,estimatedEndDate,estimatedDuration,estimatedHoursPerWeek,type,id)';\\n                return API.appBridge.httpGET(`/entity/JobOrder/${app.jobOrderId}?fields=${fields}`).then((result) => {\\n                    return Promise.resolve(result.data.data);\\n                });\\n            },\\n            commitChanges: function (changeObject) {\\n                return API.appBridge.httpPOST(`/entity/JobOrder/${app.jobOrderId}`, changeObject).then(() => {\\n                    return Promise.resolve();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobOrder') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1782984890957},{\"id\":4505,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":18813622,\"firstName\":\"interactionapiuser.ingenovis\",\"lastName\":\"ingenovishealth\"},\"name\":\"1-checking-blacklist-candidate-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            init: () => {\\n                const isMassUpdate = API.pageContext === '';\\n                if (isMassUpdate && API.currentEntityId) {\\n                    return app.validateMultipleSubmissions();\\n                }\\n                return app.validateSingleSubmission();\\n            },\\n            validateMultipleSubmissions: () => {\\n                const entityIds = API.currentEntityId.split(',').map((id) => {\\n                    return id.trim();\\n                });\\n                const validationPromises = entityIds.map((submissionId) => {\\n                    return app.validateSubmissionById(submissionId);\\n                });\\n                return Promise.all(validationPromises).then((results) => {\\n                    const hasBlacklisted = results.some((isBlacklisted) => {\\n                        return isBlacklisted;\\n                    });\\n                    if (hasBlacklisted) {\\n                        form.isFormValid = false;\\n                        form.errorMessage = 'One or more candidates are blacklisted';\\n                    }\\n                    return form;\\n                });\\n            },\\n            validateSubmissionById: (submissionId) => {\\n                const submissionUrl = `${app.baseUrl}/entity/JobSubmission/${submissionId}?fields=id,candidate,jobOrder`;\\n                return API.http.get(submissionUrl).toPromise().then((submissionResult) => {\\n                    const candidateID = submissionResult.data.candidate.id;\\n                    const jobID = submissionResult.data.jobOrder.id;\\n                    return app.getJobDetails(jobID).then((results) => {\\n                        const clientCorporation = results.clientCorporation.name;\\n                        return app.getDetails(candidateID).then((result) => {\\n                            const customText26 = result.customText26;\\n                            if (customText26 !== null && customText26 !== '' && customText26 !== undefined) {\\n                                const arrayresult = customText26.filter((data) => {\\n                                    return data === clientCorporation;\\n                                });\\n                                return arrayresult.length > 0;\\n                            }\\n                            return false;\\n                        });\\n                    });\\n                }).catch((err) => {\\n                    console.log('Error validating submission:', err);\\n                    return false;\\n                });\\n            },\\n            validateSingleSubmission: () => {\\n                let jobID = '';\\n                let candidateID = '';\\n                if (API.currentEntityId === '' || API.currentEntityId == null || API.currentEntityId === undefined) {\\n                    candidateID = form.controls.candidate.value[0].id;\\n                    jobID = form.controls.jobOrder.value[0].id;\\n                }\\n                else {\\n                    candidateID = form.controls.candidate.value.id;\\n                    jobID = form.controls.jobOrder.value.id;\\n                }\\n                return app.getJobDetails(jobID).then((results) => {\\n                    const clientCorporation = results.clientCorporation.name;\\n                    return app.getDetails(candidateID).then((result) => {\\n                        const customText26 = result.customText26;\\n                        if (customText26 !== null && customText26 !== '' && customText26 !== undefined) {\\n                            const arrayresult = customText26.filter((data) => {\\n                                return data === clientCorporation;\\n                            });\\n                            if (arrayresult.length > 0) {\\n                                form.isFormValid = false;\\n                                form.errorMessage = 'Candidate is blacklisted';\\n                            }\\n                            else {\\n                                form.isFormValid = true;\\n                                form.errorMessage = '';\\n                            }\\n                        }\\n                        else {\\n                            form.isFormValid = true;\\n                            form.errorMessage = '';\\n                        }\\n                    });\\n                });\\n            },\\n            getDetails: (candidateID) => {\\n                const url = `${app.baseUrl}/search/Candidate?query=id:${candidateID}&fields=id,customText26`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    const finalresult = result.data[0];\\n                    return Promise.resolve(finalresult);\\n                }, (err) => {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n            getJobDetails: (jobID) => {\\n                const url = `${app.baseUrl}/query/JobOrder?fields=id,clientCorporation&where=id=${jobID}`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    const finalresult = result.data[0];\\n                    return Promise.resolve(finalresult);\\n                }, (err) => {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement')\\n            return app.init();\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1782984891000},{\"id\":4500,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":18813622,\"firstName\":\"interactionapiuser.ingenovis\",\"lastName\":\"ingenovishealth\"},\"name\":\"53-Prevent-Submittal-for-Do-Not-Send-MSP-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            init: () => {\\n                const isMassUpdate = API.pageContext === '';\\n                if (isMassUpdate && API.currentEntityId) {\\n                    return app.validateMultipleSubmissions();\\n                }\\n                return app.validateSingleSubmission();\\n            },\\n            validateMultipleSubmissions: () => {\\n                const entityIds = API.currentEntityId.split(',').map((id) => {\\n                    return id.trim();\\n                });\\n                const validationPromises = entityIds.map((submissionId) => {\\n                    return app.validateSubmissionById(submissionId);\\n                });\\n                return Promise.all(validationPromises).then((results) => {\\n                    const hasOptedOut = results.some((isOptedOut) => {\\n                        return isOptedOut;\\n                    });\\n                    if (hasOptedOut) {\\n                        form.isFormValid = false;\\n                        form.errorMessage = 'Cannot submit with a candidate opting out from MSP with the same value as 3rd Party Provider';\\n                    }\\n                    return form;\\n                });\\n            },\\n            validateSubmissionById: (submissionId) => {\\n                const submissionUrl = `${app.baseUrl}/entity/JobSubmission/${submissionId}?fields=id,candidate,jobOrder`;\\n                return API.http.get(submissionUrl).toPromise().then((submissionResult) => {\\n                    const candidateID = submissionResult.data.candidate.id;\\n                    const jobID = submissionResult.data.jobOrder.id;\\n                    return app.getJobDetails(jobID).then((results) => {\\n                        const customText7 = results.customText7;\\n                        return app.getDetails(candidateID).then((result) => {\\n                            const customText29 = result.customText29;\\n                            if (customText29 !== null && customText29 !== '' && customText29 !== undefined) {\\n                                const arrayresult = customText29.filter((data) => {\\n                                    return data === customText7;\\n                                });\\n                                return arrayresult.length > 0;\\n                            }\\n                            return false;\\n                        });\\n                    });\\n                }).catch((err) => {\\n                    console.log('Error validating submission:', err);\\n                    return false;\\n                });\\n            },\\n            validateSingleSubmission: () => {\\n                let candidateID = '';\\n                let jobID = '';\\n                if (API.currentEntityId === '' || API.currentEntityId == null || API.currentEntityId === undefined) {\\n                    candidateID = form.controls.candidate.value[0].id;\\n                    jobID = form.controls.jobOrder.value[0].id;\\n                }\\n                else {\\n                    candidateID = form.controls.candidate.value.id;\\n                    jobID = form.controls.jobOrder.value.id;\\n                }\\n                return app.getJobDetails(jobID).then((results) => {\\n                    const customText7 = results.customText7;\\n                    return app.getDetails(candidateID).then((result) => {\\n                        const customText29 = result.customText29;\\n                        if (form.isFormValid === true) {\\n                            if (customText29 !== null && customText29 !== '' && customText29 !== undefined) {\\n                                const arrayresult = customText29.filter((data) => {\\n                                    return data === customText7;\\n                                });\\n                                if (arrayresult.length > 0) {\\n                                    form.isFormValid = false;\\n                                    form.errorMessage = 'Cannot submit with a candidate opting out from MSP with the same value as 3rd Party Provider';\\n                                }\\n                                else {\\n                                    form.isFormValid = true;\\n                                    form.errorMessage = '';\\n                                }\\n                            }\\n                            else {\\n                                form.isFormValid = true;\\n                                form.errorMessage = '';\\n                            }\\n                        }\\n                    });\\n                });\\n            },\\n            getDetails: (candidateID) => {\\n                const url = `${app.baseUrl}/search/Candidate?query=id:${candidateID}&fields=id,customText29`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    const finalresult = result.data[0];\\n                    return Promise.resolve(finalresult);\\n                }, (err) => {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n            getJobDetails: (jobID) => {\\n                const url = `${app.baseUrl}/query/JobOrder?fields=id,customText7&where=id=${jobID}`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    const finalresult = result.data[0];\\n                    return Promise.resolve(finalresult);\\n                }, (err) => {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement')\\n            return app.init();\\n        return Promise.resolve();\",\"sortOrder\":1,\"dateLastModified\":1782984890930},{\"id\":4502,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":18813622,\"firstName\":\"interactionapiuser.ingenovis\",\"lastName\":\"ingenovishealth\"},\"name\":\"copy-review-notes-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var _a, _b;\\n        const app = {\\n            jobSubmission: 'JobSubmission',\\n            candidateFields: 'id,candidate',\\n            init: function () {\\n                console.log('copy-review-notes-1218');\\n                const isMassUpdate = API.pageContext === '';\\n                if (isMassUpdate && API.currentEntityId) {\\n                    return app.processMultipleSubmissions();\\n                }\\n                return app.processSingleSubmission();\\n            },\\n            processMultipleSubmissions: function () {\\n                var _a, _b;\\n                console.log('copy-review-notes-1218: Processing mass update');\\n                const entityIds = API.currentEntityId.split(',').map((id) => {\\n                    return id.trim();\\n                });\\n                const reviewNotesCheckbox = (_a = form.controls.reviewNotesCheckbox) === null || _a === void 0 ? void 0 : _a.value;\\n                if (reviewNotesCheckbox === 'No' || !reviewNotesCheckbox) {\\n                    return Promise.resolve();\\n                }\\n                const comments = (_b = form.controls.comments) === null || _b === void 0 ? void 0 : _b.value;\\n                if (!comments) {\\n                    return Promise.resolve();\\n                }\\n                const promises = entityIds.map((entityId) => {\\n                    return app.getCandidateData(entityId).then((candidateData) => {\\n                        const changeObject = {\\n                            id: candidateData.id,\\n                            customTextBlock10: comments,\\n                        };\\n                        return app.commitChanges(changeObject);\\n                    }).catch((error) => {\\n                        console.error(`Error processing submission ${entityId}:`, error);\\n                        return undefined;\\n                    });\\n                });\\n                return Promise.all(promises).then(() => {\\n                    return Promise.resolve();\\n                });\\n            },\\n            processSingleSubmission: function () {\\n                var _a, _b;\\n                const entityId = app.getEntityId();\\n                if (!entityId) {\\n                    return Promise.resolve();\\n                }\\n                const reviewNotesCheckbox = (_a = form.controls.reviewNotesCheckbox) === null || _a === void 0 ? void 0 : _a.value;\\n                if (reviewNotesCheckbox === 'No' || !reviewNotesCheckbox) {\\n                    return Promise.resolve();\\n                }\\n                const comments = (_b = form.controls.comments) === null || _b === void 0 ? void 0 : _b.value;\\n                if (!comments) {\\n                    return Promise.resolve();\\n                }\\n                return app.getCandidateData(entityId).then((candidateData) => {\\n                    const changeObject = {\\n                        id: candidateData.id,\\n                        customTextBlock10: comments,\\n                    };\\n                    return app.commitChanges(changeObject).then(() => {\\n                        return Promise.resolve();\\n                    });\\n                }).catch((error) => {\\n                    console.error('Error getting candidate data', error);\\n                });\\n            },\\n            getEntityId: function () {\\n                let dataObj = null;\\n                if (form.data) {\\n                    if (form.data[0]) {\\n                        if (form.data[0].data) {\\n                            if (Array.isArray(form.data[0].data) && form.data[0].data.length > 0) {\\n                                dataObj = form.data[0].data[0];\\n                            }\\n                        }\\n                        else {\\n                            dataObj = form.data[0];\\n                        }\\n                    }\\n                    else if (Array.isArray(form.data.data) && form.data.data.length > 0) {\\n                        dataObj = form.data.data[0];\\n                    }\\n                }\\n                const entity = (Array.isArray(dataObj)) ? dataObj.find((element) => {\\n                    return element.changedEntityType === app.jobSubmission;\\n                }) : dataObj;\\n                return entity && entity.changedEntityId ? entity.changedEntityId : API.currentEntityId;\\n            },\\n            getCandidateData: function (submissionId) {\\n                const url = `${API.http.restURL}entity/${app.jobSubmission}/${submissionId}?fields=${app.candidateFields}`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    return Promise.resolve(result.data.candidate);\\n                }).catch((error) => {\\n                    console.error('Error getting candidate data', error);\\n                });\\n            },\\n            commitChanges: function (changeObject) {\\n                const url = `${API.http.restURL}entity/Candidate/${changeObject.id}`;\\n                return API.http.post(url, changeObject).toPromise().then((result) => {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n        };\\n        const TRUSTAFF_PL_IDS = ['38303'];\\n        const currentPlId = (_b = (_a = API.globals) === null || _a === void 0 ? void 0 : _a.user) === null || _b === void 0 ? void 0 : _b.privateLabelId;\\n        if (TRUSTAFF_PL_IDS.includes(currentPlId)) {\\n            return Promise.resolve();\\n        }\\n        if (API.currentEntity === app.jobSubmission) {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":1,\"dateLastModified\":1782984890937},{\"id\":4462,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":18917127,\"firstName\":\"Trustaff Deal Sheet\",\"lastName\":\"Admin PROD\"},\"name\":\"Prevent Placement Creation for ds pending approval\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            allowedStatus: [\\\"Active\\\"],\\n            getSubmission: function (candidateId, jobOrderId) {\\n                var url = \\\"query/JobSubmission?where=candidate.id=\\\" + candidateId + \\\" AND jobOrder.id=\\\" + jobOrderId + \\\" AND isDeleted=false&fields=id,customText11,status\\\";\\n                return API.appBridge.httpGET(url).then(function (response) {\\n                    return Promise.resolve(response.data.data);\\n                });\\n            },\\n            getDealsheet: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    var query = {\\n                        query: {\\n                            type: 'getMostIncrementedDs',\\n                            params: {\\n                                dealSheetId: id,\\n                            },\\n                            data: {}\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            },\\n            checkDealsheetAndPreventForm: function (approvalRequested, approved, rejected) {\\n                var preventCreation = approvalRequested || (!approvalRequested && rejected);\\n                var messageStatus = approvalRequested ? \\\"pending managers approval\\\" : \\\"rejected\\\";\\n                if (preventCreation) {\\n                    var errorMessage = \\\"Deal Sheet is \\\" + messageStatus + \\\", placement can not be created\\\";\\n                    // controller.displayToastMessage(errorMessage)\\n                    form.isFormValid = false;\\n                    form.errorMessage = errorMessage;\\n                    return true;\\n                }\\n            },\\n            displayToastMessage: function (errorMessage) {\\n                API.displayToast({\\n                    message: errorMessage,\\n                    isCloseable: true,\\n                    theme: 'danger',\\n                    hideDelay: 6000,\\n                });\\n            },\\n            init: function () {\\n                return new Promise(function (resolve) {\\n                    var jobOrderId = form.data.jobOrder.id;\\n                    var candidateId = form.data.candidate.id;\\n                    if (jobOrderId && candidateId) {\\n                        controller.getSubmission(candidateId, jobOrderId).then(function (submission) {\\n                            var dealsheetId = submission.length ? submission[0].customText11 : null;\\n                            console.log(\\\"submission\\\", submission);\\n                            console.log(\\\"dealsheetId\\\", dealsheetId);\\n                            if (dealsheetId) {\\n                                controller.getDealsheet(dealsheetId).then(function (dealsheet) {\\n                                    controller.checkDealsheetAndPreventForm(dealsheet.approvalRequested, dealsheet.approved, dealsheet.rejected);\\n                                    resolve();\\n                                });\\n                            }\\n                            else {\\n                                resolve();\\n                            }\\n                        });\\n                    }\\n                    else {\\n                        console.log(\\\"DOESN't HAVE COMPANY OR JOB ID\\\");\\n                        resolve();\\n                    }\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            console.log(\\\"Newbury Prevent Placement Creation\\\", form.data);\\n            return controller.init();\\n        }\",\"sortOrder\":1,\"dateLastModified\":1782461271070},{\"id\":4464,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":18917127,\"firstName\":\"Trustaff Deal Sheet\",\"lastName\":\"Admin PROD\"},\"name\":\"copy ds id to placement\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            dealsheetPathAtJobSubmission: \\\"customText11\\\",\\n            dealsheetPathAtPlacement: \\\"customText11\\\",\\n            getPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id + \\\"?fields=id,jobSubmission(customText11,customText8,customText10)\\\";\\n                    console.log(\\\"Newbury copy DS id to placement FI  getPlacement url\\\", url);\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            updatePlacementUsingLoggedInUser: function (id, body) {\\n                console.log(\\\"Newbury copy DS to placement: updatePlacement params\\\", id, body);\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id;\\n                    API.appBridge.httpPOST(url, body).then(function (result) {\\n                        resolve(result);\\n                    });\\n                });\\n            },\\n            updatePlacementFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    var query = {\\n                        query: {\\n                            type: 'updatePlacement',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"updatePlacementFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object updatePlacementFunc', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"updatePlacementFunc error\\\", error);\\n                        controller.updatePlacementUsingLoggedInUser(data.id, data.body).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            updatePlacement: function (id, body) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return controller.updatePlacementFunc({ id: id, body: body });\\n            },\\n            copyDealsheetIdToPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    controller.getPlacement(id).then(function (placement) {\\n                        console.log(\\\"Newbury copy DS id to placement FI  placement\\\", placement);\\n                        if (placement.jobSubmission[controller.dealsheetPathAtJobSubmission] && placement.jobSubmission[controller.dealsheetPathAtJobSubmission].length) {\\n                            console.log(\\\"Newbury copy DS id to placement FI  DS ID\\\", placement.jobSubmission[controller.dealsheetPathAtJobSubmission]);\\n                            controller.updatePlacement(id, { customText55: placement.jobSubmission[controller.dealsheetPathAtJobSubmission] }).then(function () {\\n                                resolve();\\n                            });\\n                        }\\n                        else {\\n                            resolve();\\n                        }\\n                    });\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            var data;\\n            if (Array.isArray(form.data[0].data))\\n                data = form.data[0].data[0];\\n            else if (Array.isArray(form.data[0]))\\n                data = form.data[0];\\n            else\\n                data = form.data[1].data[0];\\n            var placementId = data.filter(function (item) { return item.changedEntityType === \\\"Placement\\\"; })[0].changedEntityId;\\n            console.log(\\\"Newbury MAK testing\\\", placementId);\\n            if (placementId) {\\n                return controller.copyDealsheetIdToPlacement(placementId);\\n            }\\n            else {\\n                return;\\n            }\\n        }\\n        else {\\n            return;\\n        }\",\"sortOrder\":1,\"dateLastModified\":1782461271153},{\"id\":4465,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":18917127,\"firstName\":\"Trustaff Deal Sheet\",\"lastName\":\"Admin PROD\"},\"name\":\"copy job submission status to ds\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            getSubmission: function (id) {\\n                var url = \\\"entity/JobSubmission/\\\" + id + \\\"?fields=id,customText11,status\\\";\\n                return API.appBridge.httpGET(url).then(function (response) {\\n                    return Promise.resolve(response.data.data);\\n                });\\n            },\\n            copyStatus: function (jobSubmission) {\\n                var url = \\\"https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH\\\";\\n                var query = {\\n                    auditData: {\\n                        userId: API.globals.user.userId\\n                    },\\n                    query: {\\n                        type: 'updateSubmission',\\n                        params: {\\n                            dealSheetId: jobSubmission.customText11,\\n                        },\\n                        data: {\\n                            jobSubmissionStatus: jobSubmission.status,\\n                            jobSubmissionId: jobSubmission.id\\n                        }\\n                    }\\n                };\\n                if (controller.isDuplicateSubmission()) {\\n                    return;\\n                }\\n                fetch(url, {\\n                    method: 'post',\\n                    body: JSON.stringify(query)\\n                }).then(function (response) {\\n                    return response.json();\\n                }).then(function (data) {\\n                    console.log('done updating');\\n                });\\n            },\\n            isDuplicateSubmission: function () {\\n                return form.data[0] && form.data[0].messages && form.data[0].messages.length > 0;\\n            },\\n            isDealSheet: function (submission) {\\n                return submission.customText11;\\n            },\\n            init: function () {\\n                console.log(\\\"Newbury  the form\\\", form);\\n                var contexts = ['ChangeStatus', '', 'FastAdd'];\\n                // @ts-ignore\\n                if (API.currentEntity === 'JobSubmission' && contexts.indexOf(API.pageContext) > -1) {\\n                    var submissionId_1 = (form.data && form.data.changedEntityId) || (form.data && form.data[0] && form.data[0].changedEntityId) || form.data.data[0].changedEntityId;\\n                    controller.getSubmission(submissionId_1).then(function (jobSubmission) {\\n                        if (controller.isDealSheet(jobSubmission)) {\\n                            console.log('isDealsheet');\\n                            controller.copyStatus(jobSubmission);\\n                        }\\n                        console.log('the form', form.data, form.controls);\\n                    });\\n                }\\n                else if (API.currentEntity === 'JobSubmission' && API.pageContext === \\\"MoveToPlacement\\\") {\\n                    var data;\\n                    if (Array.isArray(form.data[0].data))\\n                        data = form.data[0].data[0];\\n                    else if (Array.isArray(form.data[0]))\\n                        data = form.data[0];\\n                    else\\n                        data = form.data[1].data[0];\\n                    console.log(\\\"Newbury data\\\", data);\\n                    var submissionId;\\n                    if (data[0] && data[0].changedEntityType == \\\"JobSubmission\\\") {\\n                        submissionId = data[0].changedEntityId;\\n                    }\\n                    else if (data[1] && data[1].changedEntityType == \\\"JobSubmission\\\") {\\n                        submissionId = data[1].changedEntityId;\\n                    }\\n                    else if (data[2] && data[2].changedEntityType == \\\"JobSubmission\\\") {\\n                        submissionId = data[2].changedEntityId;\\n                    }\\n                    console.log(\\\"Newbury submissionId\\\", submissionId);\\n                    controller.getSubmission(submissionId).then(function (jobSubmission) {\\n                        if (controller.isDealSheet(jobSubmission)) {\\n                            console.log('isDealsheet');\\n                            controller.copyStatus(jobSubmission);\\n                        }\\n                        console.log('the form', form.data, form.controls);\\n                    });\\n                }\\n            }\\n        };\\n        controller.init();\",\"sortOrder\":1,\"dateLastModified\":1782461271187},{\"id\":4466,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":18917127,\"firstName\":\"Trustaff Deal Sheet\",\"lastName\":\"Admin PROD\"},\"name\":\"set ds status to final\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            getJobSubmission: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/JobSubmission/\\\" + id + \\\"?fields=id,customText11\\\";\\n                    console.log(\\\"Newbury DS SET TO FINAL getJobSubmission url\\\", url);\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            setDealSheetToFinal: function (id) {\\n                return new Promise(function (resolve) {\\n                    controller.getJobSubmission(API.currentEntityId).then(function (jobSubmission) {\\n                        console.log(\\\"Newbury DS SET TO FINAL jobSubmission\\\", jobSubmission);\\n                        if (jobSubmission.customText11 && jobSubmission.customText11.length) {\\n                            console.log(\\\"Newbury DS SET TO FINAL DS ID\\\", jobSubmission.customText11);\\n                            var url = 'https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                            var query = {\\n                                auditData: {\\n                                    userId: API.globals.user.userId\\n                                },\\n                                query: {\\n                                    type: 'setToFinal',\\n                                    params: {\\n                                        dealSheetId: jobSubmission.customText11,\\n                                    },\\n                                    data: {}\\n                                }\\n                            };\\n                            fetch(url, {\\n                                method: 'post',\\n                                body: JSON.stringify(query)\\n                            }).then(function (response) {\\n                                return response.json();\\n                            }).then(function (data) {\\n                                console.log('DS SET TO FINAL done updating');\\n                                resolve();\\n                            });\\n                        }\\n                        else {\\n                            resolve();\\n                        }\\n                    });\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            console.log(\\\"Newbury DS SET TO FINAL API\\\", API);\\n            console.log(\\\"Newbury PDS SET TO FINAL ID\\\", API.currentEntityId);\\n            console.log(\\\"Newbury DS SET TO FINAL form\\\", form);\\n            if (API.currentEntityId) {\\n                return controller.setDealSheetToFinal(API.currentEntityId);\\n            }\\n        }\\n        else {\\n            return;\\n        }\",\"sortOrder\":1,\"dateLastModified\":1782461271213},{\"id\":4467,\"action\":\"overview-field-modify\",\"modifyingUser\":{\"id\":18917127,\"firstName\":\"Trustaff Deal Sheet\",\"lastName\":\"Admin PROD\"},\"name\":\"redirect-to-ds\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            getDealsheet: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    var query = {\\n                        query: {\\n                            type: 'getMostIncrementedDs',\\n                            params: {\\n                                dealSheetId: id,\\n                            },\\n                            data: {}\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            },\\n            getPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id + \\\"?fields=id,jobOrder(id)\\\";\\n                    console.log(\\\"Newbury copy DS id to placement FI  getPlacement url\\\", url);\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            buildDealseheetUrl: function () {\\n                return new Promise(function (resolve) {\\n                    controller.getPlacement(API.currentEntityId).then(function (placement) {\\n                        var userId = API.globals.user.userId;\\n                        var corpId = API.globals.user.corporationId;\\n                        var plId = API.globals.user.privateLabelId;\\n                        var dealsheetId = data.customText55;\\n                        var entityID = placement.jobOrder.id;\\n                        controller.getDealsheet(dealsheetId).then(function (dealSheet) {\\n                            console.log(\\\"Newbury dealSheet\\\", dealSheet);\\n                            dealsheetId = dealSheet.id;\\n                            var baseUrl = \\\"https://dealsheet-ng-prod-trustaff.s3.amazonaws.com/index.html#/compare-deal-sheet?isComparable=y\\\";\\n                            var url = baseUrl + \\\"&dealSheetIdParam=\\\" + dealsheetId + \\\"&EntityType=JobOrder&EntityID=\\\" + entityID + \\\"&UserID=\\\" + userId + \\\"&CorporationID=\\\" + corpId + \\\"&PrivateLabelID=\\\" + plId;\\n                            console.log(\\\"Newbury adding on click function\\\", API, field, data, url);\\n                            field.onClick = function () {\\n                                var openedWindow = window.open(url);\\n                                openedWindow = window;\\n                            };\\n                            resolve();\\n                        });\\n                    });\\n                });\\n            },\\n        };\\n        if (field.name === 'customText55' && data.customText55 && API.currentEntity === \\\"Placement\\\") {\\n            console.log(\\\"Newbury opening DS \\\");\\n            return controller.buildDealseheetUrl();\\n        }\",\"sortOrder\":1,\"dateLastModified\":1782461271240},{\"id\":4468,\"action\":\"tab-modify\",\"modifyingUser\":{\"id\":18917127,\"firstName\":\"Trustaff Deal Sheet\",\"lastName\":\"Admin PROD\"},\"name\":\"add count to dealsheet tab\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            dealSheetTabName: 'Deal Sheet',\\n            clientDomain: \\\"prod.trustaff.dl-sheet.com\\\",\\n            getDealSheetCount: function (id, entity) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"https://\\\" + controller.clientDomain + \\\"/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH\\\";\\n                    var whereObj = entity == 'Candidate' ? { \\\"DealSheetCandidate.bullhornCandidateId\\\": id } : { \\\"DealSheetJob.bullhornJobId\\\": id };\\n                    whereObj[\\\"status\\\"] = [\\\"Sent\\\", \\\"Final\\\", \\\"Draft\\\", \\\"Submitted\\\", \\\"Locked\\\"];\\n                    var query = {\\n                        \\\"query\\\": {\\n                            \\\"type\\\": \\\"getDealSheets\\\",\\n                            \\\"params\\\": {\\n                                \\\"where\\\": whereObj,\\n                                \\\"sort\\\": { \\\"updatedAt\\\": \\\"desc\\\" },\\n                                \\\"offset\\\": 0,\\n                                \\\"limit\\\": 10\\n                            }\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('ds data ==>', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            }\\n        };\\n        if ((API.currentEntity === 'Candidate' || API.currentEntity === 'JobOrder') && item.label === controller.dealSheetTabName) {\\n            var id_1 = API.currentEntityId;\\n            controller.getDealSheetCount(id_1, API.currentEntity).then(function (res) {\\n                console.log(\\\"for \\\" + API.currentEntity + \\\" with entity id \\\" + id_1 + \\\" res is ==>\\\", res);\\n                item.label = item.label + (\\\" (\\\" + res.parentLength + \\\")\\\");\\n            }).catch(function (err) {\\n                console.log('error=>', err);\\n            });\\n        }\",\"sortOrder\":1,\"dateLastModified\":1782461271267},{\"id\":4019,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"1218-set-data-fields\",\"page\":\"record\",\"enabled\":true,\"script\":\"const controller = {\\n            copyDataFields: [{ from: 'startDate', to: 'customDate3' }],\\n            init: () => {\\n                if (API.currentEntity === 'JobSubmission' && (API.pageContext === 'FastAdd' || API.pageContext === 'Record')) {\\n                    controller.copyDataFields.forEach((element) => {\\n                        if (form.data[element.from] || form.data[element.from] === null) {\\n                            form.data[element.to] = form.data[element.from];\\n                        }\\n                    });\\n                }\\n                return form;\\n            },\\n        };\\n        return controller.init();\",\"sortOrder\":1,\"dateLastModified\":1757419237193},{\"id\":4007,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"21-require-the-Union-Contract-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            init: () => {\\n                if (form.controls.customText14.value === 'No') {\\n                    if (form.controls.customDate2.value === '') {\\n                        form.isFormValid = false;\\n                        form.errorMessage = 'Please Enter Exp. Date';\\n                    }\\n                    else {\\n                        form.isFormValid = true;\\n                        form.errorMessage = '';\\n                    }\\n                }\\n            },\\n        };\\n        if (API.currentEntity === 'Candidate')\\n            return app.init();\\n        return Promise.resolve();\",\"sortOrder\":1,\"dateLastModified\":1757419237143},{\"id\":4008,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"47-create-location-from-address-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            init: () => {\\n                return app.createLocation();\\n            },\\n            createLocation: () => {\\n                const address = form.controls.address.value;\\n                const stateIds = form.controls.address.config.state.pickerConfig.defaultOptions;\\n                const stateID = stateIds.findIndex((item) => {\\n                    return item.value === address.state;\\n                });\\n                const clientCorporationId = form.data.changedEntityId;\\n                API.appBridge.httpPUT('entity/Location', {\\n                    address: {\\n                        address1: address.address1,\\n                        address2: address.address2,\\n                        city: address.city,\\n                        state: address.state,\\n                        zip: address.zip,\\n                        countryID: address.countryID,\\n                        stateID: stateID,\\n                    },\\n                    title: 'Company Address',\\n                    clientCorporation: {\\n                        id: clientCorporationId,\\n                    },\\n                    effectiveDate: app.getTodayDate(),\\n                    status: 'Active',\\n                    declineToApplyTaxes: true,\\n                    isBillTo: true,\\n                    isWorkSite: true,\\n                }).then(() => {\\n                    console.log('Saved new location');\\n                });\\n            },\\n            getTodayDate: () => {\\n                const date = new Date().toJSON().slice(0, 10).split('-')\\n                    .reverse();\\n                return `${date[2]}-${date[1]}-${date[0]}`;\\n            },\\n        };\\n        if (API.currentEntity === 'ClientCorporation' && form.data.changeType === 'INSERT')\\n            return app.init();\\n        return Promise.resolve();\",\"sortOrder\":1,\"dateLastModified\":1757419237190},{\"id\":4009,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"sync-facility-display-name-to-billing-profile-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const cch = {\\n            baseUrl: API.http.restURL,\\n            init: () => {\\n                cch.updateDisplayName();\\n            },\\n            updateDisplayName: () => {\\n                const billingClientCorporationId = form.data.changedEntityId;\\n                const FacilityDisplayName = form.controls.customText16.value;\\n                let BillingProfileId = '';\\n                let BillingFcName = '';\\n                let billingLocation = '';\\n                const url = `${cch.baseUrl}query/BillingProfile?fields=*&where=billingClientCorporation.id=${billingClientCorporationId}`;\\n                API.http.get(url).toPromise().then((data) => {\\n                    data.data.forEach((billingData) => {\\n                        BillingProfileId = billingData.id;\\n                        BillingFcName = billingData.customText1;\\n                        billingLocation = billingData.billingLocation.id;\\n                        if (BillingFcName !== FacilityDisplayName) {\\n                            API.http.post(`${cch.baseUrl}entity/BillingProfile/${BillingProfileId}`, {\\n                                customText1: FacilityDisplayName,\\n                                versionID: billingData.versionID,\\n                            }).toPromise().then(() => {\\n                            });\\n                        }\\n                    });\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'ClientCorporation' && form.data.changeType === 'UPDATE')\\n            cch.init();\",\"sortOrder\":1,\"dateLastModified\":1757419237240},{\"id\":4010,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"22-customText7-required-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            init: () => {\\n                if (form.isFormValid === true) {\\n                    form.isFormValid = false;\\n                }\\n                if (form.controls.customText2.value === '3rd Party') {\\n                    if (form.controls.customText11.value === '') {\\n                        form.isFormValid = false;\\n                        form.errorMessage = '3rd party is required';\\n                    }\\n                    else if (form.controls.customText3.value === '') {\\n                        form.isFormValid = false;\\n                        form.errorMessage = 'Technology is required';\\n                    }\\n                    else {\\n                        form.isFormValid = true;\\n                        form.errorMessage = '';\\n                    }\\n                }\\n                else {\\n                    form.isFormValid = true;\\n                    form.errorMessage = '';\\n                }\\n                return 0;\\n            },\\n        };\\n        if (API.currentEntity === 'BillingProfile')\\n            return app.init();\\n        return Promise.resolve();\",\"sortOrder\":1,\"dateLastModified\":1757419237143},{\"id\":4017,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"70-candidate-check-DoNotSendMSP-field-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            init: () => {\\n                let candidateID = '';\\n                let SubmissionID = '';\\n                let jobID = '';\\n                candidateID = form.data.candidate.id;\\n                SubmissionID = API.currentEntityId;\\n                jobID = form.data.jobOrder.id;\\n                if (API.currentEntityId === undefined || API.currentEntityId === '' || API.currentEntityId === null) {\\n                    SubmissionID = 0;\\n                }\\n                return app.getJobSubmissionDetails(SubmissionID).then((results) => {\\n                    let customTextBlock4 = '';\\n                    if (SubmissionID !== 0) {\\n                        customTextBlock4 = results.customTextBlock4;\\n                    }\\n                    return app.getcandidateDetails(candidateID).then((result) => {\\n                        const arrayresult = result.filter((data) => {\\n                            return data === customTextBlock4;\\n                        });\\n                        if (arrayresult.length > 0) {\\n                            form.isFormValid = false;\\n                            form.errorMessage = 'Candidate is blacklisted';\\n                            return 0;\\n                        }\\n                        return app.getJobDetails(jobID).then((jobdata) => {\\n                            const customText7 = jobdata.customText7;\\n                            const Jobarrayresult = result.filter((data) => {\\n                                return data === customText7;\\n                            });\\n                            if (Jobarrayresult.length > 0) {\\n                                form.isFormValid = false;\\n                                form.errorMessage = 'Candidate cannot be submitted due to company blacklist';\\n                            }\\n                        });\\n                    });\\n                });\\n            },\\n            getcandidateDetails: (candidateID) => {\\n                const url = `${app.baseUrl}/search/Candidate?fields=id,customText29&query=id:${candidateID}`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    let finalresult = result.data[0].customText29;\\n                    if (finalresult === null || finalresult === '' || finalresult === undefined) {\\n                        finalresult = [];\\n                    }\\n                    return Promise.resolve(finalresult);\\n                }, (err) => {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n            getJobSubmissionDetails: (SubmissionID) => {\\n                const url = `${app.baseUrl}/query/JobSubmission?fields=id,customTextBlock4&where=id=${SubmissionID}`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    const finalresult = result.data[0];\\n                    return Promise.resolve(finalresult);\\n                }, (err) => {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n            getJobDetails: (jobID) => {\\n                const url = `${app.baseUrl}/query/JobOrder?fields=id,customText7&where=id=${jobID}`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    const finalresult = result.data[0];\\n                    return Promise.resolve(finalresult);\\n                }, (err) => {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && form.isFormValid === true && API.pageContext === 'MoveToPlacement')\\n            return app.init();\\n        return Promise.resolve();\",\"sortOrder\":3,\"dateLastModified\":1757419237317},{\"id\":4501,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":18813622,\"firstName\":\"interactionapiuser.ingenovis\",\"lastName\":\"ingenovishealth\"},\"name\":\"3-candidate-status-check-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const controller = {\\n            baseUrl: API.http.restURL,\\n            INVALID_STATUSES: [\\n                'Clinical Review',\\n                'Not Qualified',\\n                'Terminated',\\n                'Deceased',\\n            ],\\n            async init() {\\n                console.log('Initializing candidate submission status validation - NK');\\n                const isMassUpdate = API.pageContext === '';\\n                if (isMassUpdate && API.currentEntityId) {\\n                    return controller.validateMultipleSubmissions();\\n                }\\n                return controller.validateSingleSubmission();\\n            },\\n            async validateMultipleSubmissions() {\\n                console.log('NK - Processing mass status update for JobSubmissions');\\n                const entityIds = API.currentEntityId.split(',').map((id) => {\\n                    return id.trim();\\n                });\\n                const validationResults = await Promise.all(entityIds.map((entityId) => {\\n                    return controller.validateSubmissionById(entityId);\\n                }));\\n                const hasInvalidSubmission = validationResults.some((isValid) => {\\n                    return !isValid;\\n                });\\n                if (hasInvalidSubmission) {\\n                    form.isFormValid = false;\\n                    form.errorMessage = 'One or more candidates have invalid status';\\n                }\\n                return form;\\n            },\\n            async validateSingleSubmission() {\\n                let candidateID = '';\\n                if (!API.currentEntityId) {\\n                    candidateID = form.controls.candidate.value[0].id;\\n                }\\n                else {\\n                    candidateID = form.controls.candidate.value.id;\\n                }\\n                const result = await controller.getCandidateDetails(candidateID);\\n                if (controller.INVALID_STATUSES.includes(result)) {\\n                    form.isFormValid = false;\\n                    form.errorMessage = 'Candidate status invalid';\\n                }\\n                return form;\\n            },\\n            async validateSubmissionById(submissionId) {\\n                console.log(`NK - Validating submission ID: ${submissionId}`);\\n                const submissionUrl = `${controller.baseUrl}/entity/JobSubmission/${submissionId}?fields=id,candidate`;\\n                try {\\n                    const submissionResult = await API.http.get(submissionUrl).toPromise();\\n                    const candidateId = submissionResult.data.candidate.id;\\n                    const candidateStatus = await controller.getCandidateDetails(candidateId);\\n                    return !controller.INVALID_STATUSES.includes(candidateStatus);\\n                }\\n                catch (err) {\\n                    console.log('NK - Error validating submission:', err);\\n                    return false;\\n                }\\n            },\\n            async getCandidateDetails(candidateID) {\\n                console.log(`NK - Getting candidate details for ID: ${candidateID}`);\\n                const url = `${controller.baseUrl}/search/Candidate?fields=id,status&query=id:${candidateID}`;\\n                try {\\n                    const result = await API.http.get(url).toPromise();\\n                    return result.data[0].status;\\n                }\\n                catch (err) {\\n                    console.log(err);\\n                    throw err;\\n                }\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && form.isFormValid === true && API.pageContext !== 'MoveToPlacement') {\\n            return controller.init();\\n        }\\n        return Promise.resolve(form);\",\"sortOrder\":3,\"dateLastModified\":1782984890933},{\"id\":4499,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":18813622,\"firstName\":\"interactionapiuser.ingenovis\",\"lastName\":\"ingenovishealth\"},\"name\":\"submission-offer-accepted-validations\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            init: () => {\\n                if (form.controls.status.value === 'Offer Accepted') {\\n                    if (API.pageContext === 'Record') {\\n                        const assRec = form.controls.customText10 ? form.controls.customText10.value : null;\\n                        const csm = form.controls.customText19 ? form.controls.customText19.value : null;\\n                        const startDt = form.controls.startDate ? form.controls.startDate.value : null;\\n                        const compDt = form.controls.customDate1 ? form.controls.customDate1.value : null;\\n                        const endDt = form.controls.endDate ? form.controls.endDate.value : null;\\n                        return app.validateFields(assRec, csm, startDt, compDt, endDt);\\n                    }\\n                    return app.getJobSubmissionDetails(API.currentEntityId).then((result) => {\\n                        const assRec = result.customText10;\\n                        const csm = result.customText19;\\n                        const startDt = result.startDate;\\n                        const compDt = result.customDate1;\\n                        const endDt = result.endDate;\\n                        return app.validateFields(assRec, csm, startDt, compDt, endDt);\\n                    });\\n                }\\n                return Promise.resolve();\\n            },\\n            getJobSubmissionDetails: (submissionID) => {\\n                const url = `/entity/JobSubmission/${submissionID}?fields=customText10,customText19,startDate,customDate1,endDate`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    const finalresult = result.data.data;\\n                    return Promise.resolve(finalresult);\\n                }, (err) => {\\n                    console.error(err);\\n                    return Promise.reject();\\n                });\\n            },\\n            validateFields: (assRec, csm, startDt, compDt, endDt) => {\\n                if (assRec === '' || assRec == null || assRec === undefined) {\\n                    form.isFormValid = false;\\n                    form.errorMessage = `${form.controls.customText10 ? form.controls.customText10.label : 'Assigned Recruiter'} is Required to set an Offer Accepted`;\\n                }\\n                else if (csm === '' || csm == null || csm === undefined) {\\n                    form.isFormValid = false;\\n                    form.errorMessage = `${form.controls.customText19 ? form.controls.customText19.label : 'CSM'} is Required to set an Offer Accepted`;\\n                }\\n                else if (startDt === '' || startDt == null || startDt === undefined) {\\n                    form.isFormValid = false;\\n                    form.errorMessage = `${form.controls.startDate ? form.controls.startDate.label : 'Start Date'} is Required to set an Offer Accepted`;\\n                }\\n                else if (compDt === '' || compDt == null || compDt === undefined) {\\n                    form.isFormValid = false;\\n                    form.errorMessage = `${form.controls.customDate1 ? form.controls.customDate1.label : 'Compliance Due Date'} is Required to set an Offer Accepted`;\\n                }\\n                else if (endDt === '' || endDt == null || endDt === undefined) {\\n                    form.isFormValid = false;\\n                    form.errorMessage = `${form.controls.endDate ? form.controls.endDate.label : 'End Date'} is Required to set an Offer Accepted`;\\n                }\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission') {\\n            console.log('submission-offer-accepted-validations');\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":5,\"dateLastModified\":1782984890927},{\"id\":4015,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"72-candidate-status-check-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            init: () => {\\n                let candidateID = '';\\n                candidateID = form.data.candidate.id;\\n                return app.getcandidateDetails(candidateID).then((result) => {\\n                    if (result === 'Clinical Review' || result === 'Not Qualified' || result === 'Inactive'\\n                        || result === 'Terminated' || result === 'Deceased' || result === 'Do Not Contact') {\\n                        form.isFormValid = false;\\n                        form.errorMessage = 'Candidate status invalid';\\n                    }\\n                });\\n            },\\n            getcandidateDetails: (candidateID) => {\\n                const url = `${app.baseUrl}/search/Candidate?fields=id,status&query=id:${candidateID}`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    const finalresult = result.data[0].status;\\n                    return Promise.resolve(finalresult);\\n                }, (err) => {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement')\\n            return app.init();\\n        return Promise.resolve();\",\"sortOrder\":5,\"dateLastModified\":1757419237317},{\"id\":4029,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2256,\"firstName\":\"Leonardo\",\"lastName\":\"Salatino\"},\"name\":\"1218G-Support 108 Submission Reject Validations\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            init: function () {\\n                if (form.controls.status.value === 'Choose a rejection reason') {\\n                    form.isFormValid = false;\\n                    form.errorMessage = 'Select a Rejection Status';\\n                }\\n                return Promise.resolve();\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":5,\"dateLastModified\":1688769638290},{\"id\":4021,\"action\":\"overview-field-modify\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"1218-su-9-disable-overview-fields\",\"page\":\"record\",\"enabled\":true,\"script\":\"// Support #9\\n        field.readOnly = true;\",\"sortOrder\":10,\"dateLastModified\":1757419237147},{\"id\":4137,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2256,\"firstName\":\"Leonardo\",\"lastName\":\"Salatino\"},\"name\":\"placement-validation-onapproval-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"// 1218 Global - 22/08/05 - Leonardo Ariel Salatino\\r\\n        // Placement validations\\r\\n        const app = {\\r\\n            placementId: API.currentEntityId,\\r\\n            statusToCheck: 'Approved',\\r\\n            errorMessage: '',\\r\\n            placementFieldsToCheck: [\\r\\n                'customText9',\\r\\n                'customText8',\\r\\n                'timeAndExpense.timeAndExpenseSource',\\r\\n                'approvingUserID',\\r\\n                'billingProfile',\\r\\n                // 'customText41',\\r\\n                'workWeekStart',\\r\\n                'timesheetCycle',\\r\\n                'location',\\r\\n                'timeAndExpense.employeeOtType',\\r\\n                'timeAndExpense.approvalMethod',\\r\\n                'timeAndExpense.timeAndExpenseBranch',\\r\\n                'timeAndExpense.rounding',\\r\\n                'timeAndExpense.inOutIndicator',\\r\\n                'employeeType',\\r\\n            ],\\r\\n            // Initialize\\r\\n            init: () => {\\r\\n                const placement = form.controls;\\r\\n                return app.validate(placement);\\r\\n            },\\r\\n            // Checks if we should run validations\\r\\n            shouldValidationsRun() {\\r\\n                const selectedStatus = form.controls.status.value;\\r\\n                return app.statusToCheck === selectedStatus;\\r\\n            },\\r\\n            // Get associated entities\\r\\n            getPlacementAssociations() {\\r\\n                const fields = 'id,candidate(id,address(address1,city,countryID,state,zip))';\\r\\n                const url = `entity/Placement/${API.currentEntityId}?fields=${fields}`;\\r\\n                return new Promise((resolve) => {\\r\\n                    API.appBridge.httpGET(url).then((result) => {\\r\\n                        if (result.data.data) {\\r\\n                            resolve(result.data.data);\\r\\n                        }\\r\\n                        else {\\r\\n                            resolve(null);\\r\\n                        }\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            // Run the validations\\r\\n            validate(placementForm) {\\r\\n                return app.getPlacementAssociations().then((placement) => {\\r\\n                    // Placement fields\\r\\n                    app.placementFieldsToCheck.forEach((field) => {\\r\\n                        if (placementForm[field]) {\\r\\n                            if (placementForm[field].value === null || placementForm[field].value === '') {\\r\\n                                app.errorMessage += `Please update ${placementForm[field].label}.\\\\n`;\\r\\n                            }\\r\\n                        }\\r\\n                    });\\r\\n                    if (app.errorMessage) {\\r\\n                        form.isFormValid = false;\\r\\n                        API.displayToast({\\r\\n                            title: 'Placement validations for BTE',\\r\\n                            icon: 'caution',\\r\\n                            theme: 'danger',\\r\\n                            position: 'fixedTop',\\r\\n                            hideDelay: 4000,\\r\\n                            message: app.errorMessage,\\r\\n                        });\\r\\n                        app.errorMessage = `PLACEMENT VALIDATION FOR BTE\\\\n${app.errorMessage}`;\\r\\n                        form.errorMessage = app.errorMessage;\\r\\n                    }\\r\\n                    return form;\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        console.log('approval validations');\\r\\n        if (API.currentEntity === 'Placement' && app.shouldValidationsRun()) {\\r\\n            return app.init();\\r\\n        }\\r\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1767792883450},{\"id\":4036,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"1218G-Permissions Validation\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            BH1RecruiterUserType: '123525',\\n            init() {\\n                return new Promise((resolve) => {\\n                    if (!app.BH1RecruiterUserType || app.BH1RecruiterUserType.indexOf(API.globals.user.userTypeId.toString()) > -1) {\\n                        form.errorMessage = 'Recruiters don\\\\'t have permission to save Company records';\\n                    }\\n                    if (form.errorMessage) {\\n                        form.isFormValid = false;\\n                    }\\n                    return resolve(form.errorMessage);\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'ClientCorporation') {\\n            return app.init();\\n        }\\n        return Promise.resolve(null);\",\"sortOrder\":10,\"dateLastModified\":1757419237210},{\"id\":4463,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":18917127,\"firstName\":\"Trustaff Deal Sheet\",\"lastName\":\"Admin PROD\"},\"name\":\"copy ds data to placement\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            dealsheetPathAtPlacement: \\\"customText55\\\",\\n            clientName: \\\"Trustaff\\\",\\n            coInstance: \\\"2\\\",\\n            getPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id + \\\"?fields=id,employmentType,customText55,dateBegin,jobOrder(id,billingProfile(id),correlatedCustomInt3,customFloat3,customText5,correlatedCustomFloat3,correlatedCustomFloat2),clientCorporation(customFloat2)\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getBillingCustomObject: function (jobId) {\\n                var url = \\\"query/JobOrderCustomObjectInstance\\\" + controller.coInstance + \\\"?where=jobOrder.id=\\\" + jobId + \\\"&fields=text1,text4,float1,float2,float3,float4,float5,float6,float7,float8,float9&count=500\\\"; // should never reach that count amount so no need for any recursive calls with more data\\n                return new Promise(function (resolve) {\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getJob: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/JobOrder/\\\" + id + \\\"?fields=id,skills,categories,correlatedCustomFloat3\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getCurrentVersionUsingLoggedInUser: function (mainVerionId, versionDate) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return new Promise(function (resolve) {\\n                    var url = \\\"/entity/PlacementRateCard/\\\" + mainVerionId + \\\"?effectiveOn=\\\" + versionDate + \\\"&fields=id,placementRateCardLineGroups[200]\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getBasicVersionIdsUsingLoggedInUser: function (placementId, placementRateCardStatus) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"query/PlacementRateCard?where=placement.id=\\\" + placementId + \\\"&&fields=id,versions,placementRateCardStatusLookup(id,label)\\\";\\n                    API.appBridge.httpGET(url).then(function (response) {\\n                        console.log(\\\"responseresponseresponseresponse\\\", response);\\n                        console.log(\\\"placementRateCardStatus\\\", placementRateCardStatus);\\n                        if (response.data.data.length && response.data.data[0].placementRateCardStatusLookup.id !== placementRateCardStatus.id) {\\n                            API.appBridge.httpPOST(\\\"entity/PlacementRateCard/\\\" + response.data.data[0].id, {\\n                                placementRateCardStatusLookup: { id: placementRateCardStatus.id }\\n                            }).then(function (res2) {\\n                                resolve(response.data.data);\\n                            });\\n                        }\\n                        else {\\n                            resolve(response.data.data);\\n                        }\\n                    });\\n                });\\n            },\\n            updateExisitngPlacementRateCardUsingLoggedInUser: function (rate, mainVerionId) {\\n                console.log(\\\"updatedVersion\\\", rate);\\n                return new Promise(function (resolve) {\\n                    var url = \\\"/entity/PlacementRateCard/\\\" + mainVerionId;\\n                    API.appBridge.httpPOST(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            insertNewVersionUsingLoggedInUser: function (rate, mainVerionId) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"/entity/PlacementRateCard/\\\" + mainVerionId;\\n                    API.appBridge.httpPOST(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            saveRateBH1UsingLoggedInUser: function (rate) {\\n                console.log(\\\"Newbury copy DS to placement: saveRateBH1UsingLoggedInUser\\\");\\n                return new Promise(function (resolve) {\\n                    var url = '/entity/PlacementRateCard';\\n                    API.appBridge.httpPUT(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            getCurrentVersionFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    var query = {\\n                        query: {\\n                            type: 'getCurrentVersion',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"getCurrentVersionFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object getCurrentVersion', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"getCurrentVersionFunc error\\\", error);\\n                        controller.getCurrentVersionUsingLoggedInUser(data.mainVerionId, data.versionDate).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            getBasicVersionIdsFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    var query = {\\n                        query: {\\n                            type: 'getBasicVersionIds',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"getBasicVersionIdsFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object getBasicVersionIds', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"getBasicVersionIdsFunc error\\\", error);\\n                        controller.getBasicVersionIdsUsingLoggedInUser(data.placementId, data.placementRateCardStatus).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            updateExisitngPlacementRateCardFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    var query = {\\n                        query: {\\n                            type: 'updateExisitngPlacementRateCard',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"updateExisitngPlacementRateCardFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object updateExisitngPlacementRateCard', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"updateExisitngPlacementRateCardFunc error\\\", error);\\n                        controller.updateExisitngPlacementRateCardUsingLoggedInUser(data.rate, data.mainVerionId).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            insertNewVersionFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    var query = {\\n                        query: {\\n                            type: 'insertNewVersion',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"insertNewVersionFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object insertNewVersion', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"insertNewVersionFunc error\\\", error);\\n                        controller.insertNewVersionUsingLoggedInUser(data.rate, data.mainVerionId).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            saveRateBH1Func: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    var query = {\\n                        query: {\\n                            type: 'saveRateBH1',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"saveRateBH1Func response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object saveRateBH1', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"saveRateBH1Func error\\\", error);\\n                        controller.saveRateBH1UsingLoggedInUser(data.rate).then(function () { resolve(); });\\n                    });\\n                });\\n            },\\n            getDealsheet: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    var query = {\\n                        query: {\\n                            type: 'getMostIncrementedDs',\\n                            params: {\\n                                dealSheetId: id,\\n                            },\\n                            data: {}\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            },\\n            getBillingTerm: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"https://prod.trustaff.dl-sheet.com/billingTermsIntegration/getProfile/\\\" + id + \\\"?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH\\\";\\n                    fetch(url, {\\n                        method: 'get',\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('getBillingTerm ', data);\\n                        resolve(data);\\n                    });\\n                });\\n            },\\n            getHealthBenefitsRecords: function () {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/healthBenefits/healthBenefits/read?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    fetch(url, {\\n                        method: 'get',\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: healthBenefits', data);\\n                        resolve(data);\\n                    });\\n                });\\n            },\\n            mapBillRatesToObject: function (job, jobCo) {\\n                console.log(\\\"Newbury jobCo\\\", jobCo);\\n                var jobSpeciality = job.skills && job.skills.data && job.skills.data.length ? job.skills.data[0].name : \\\"\\\";\\n                var jobProfession = job.categories && job.categories.data && job.categories.data.length ? job.categories.data[0].name : \\\"\\\";\\n                var billRateObject, onCallRate, onCallRateObject, chargeRate, chargeRatebject, rate8Object, rate12Object, rate40Object, rate48Object, billRatebject, holidayRatebject, callBackRatebject, rate8, rate12, rate40, rate48, billRate, hoildayRate, callBackRate;\\n                if (controller.clientName == \\\"TaleMed\\\" || controller.clientName == \\\"HAN\\\") {\\n                    billRatebject = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float1 && item.float1 > 0; });\\n                    rat