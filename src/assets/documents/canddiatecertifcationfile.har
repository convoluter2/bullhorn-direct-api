ching {jobMany}.\",\n      \"SECONDARY_JOB\": \"Add a {description} or file attachments to this record to find matching {candidateMany}.\"\n    }\n  },\n  \"GLOBAL_ERRORS\": {\n    \"UNEXPECTED\": \"Sorry, it looks like we're having a technical difficulty. If this persists please contact Customer Support.\",\n    \"REQUIRED_FIELDS\": \"Oops, it looks like you are missing one or more required fields\",\n    \"DUPLICATE_VALUE\": \"You can only have one {entityName} record with that {fieldName}.\"\n  },\n  \"CONVERT_MODAL\": {\n    \"CONVERT_LEAD\": \"Convert {entityTitleLead}\",\n    \"CONVERTING_TO\": \"Converting To\",\n    \"CONVERT_TO_NEW_CANDIDATE\": \"Convert to new {entityTitleCandidate}\",\n    \"ASSOCIATE_TO_COMPANY\": \"Associate to {entityTitleClientCorporation}\",\n    \"ASSOCIATE_TO_CONTACT\": \"Associate to {entityTitleClientContact}\",\n    \"CREATE_NEW_OPPORTUNITY\": \"Create new {entityTitleOpportunity}\",\n    \"MUST_BE_NEW_CONTACT\": \"Must create a new {entityTitleClientContact} when converting to a new {entityTitleClientCorporation}.\",\n    \"ALREADY_CONVERTED\": \"This {entityTitleLead} has been converted.\",\n    \"ALREADY_CONVERTED_TO\": \"This {entityTitleLead} has been converted to \",\n    \"CREATE_OPPORTUNITY\": \"Would you like to create a new {entityTitleOpportunity}?\"\n  },\n  \"CUSTOM_OBJECT\": {\n    \"DELETE_CONFIRM\": \"Are you sure you want to delete this\",\n    \"EDIT_HISTORY\": {\n      \"FIELD\": \"Field\",\n      \"EDIT_BY\": \"Edit by\",\n      \"EMPTY_STATE\": \"There have been no edits made to this \"\n    }\n  },\n  \"FIELD_INTERACTIONS\": {\n    \"VALUE_UPDATED\": \"The value of {label} has been updated.\",\n    \"VALUE_RESET\": \"The value of {label} has been reset to {date}.\",\n    \"PLACEMENT_DATE_EFFECTED\": \"You have entered a date that precedes the previous value. This will affect previously calculated pay rates.\",\n    \"VALUE_UPDATE_AND_READONLY\": \"Selecting a location will override the address field and wil