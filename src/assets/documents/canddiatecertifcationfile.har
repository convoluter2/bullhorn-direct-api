ATE\": \"Write a message pitching a {entityTitleJobOrder} to the {entityTitleCandidate} ({entityTitleCandidate})\",\n          \"SCREENING_QUESTIONS\": \"Write screening questions for the {entityTitleCandidate} ({entityTitleCandidate})\",\n          \"SUMMARIZE_PROFILE\": \"Summarize the {entityTitleCandidate}'s profile ({entityTitleCandidate})\",\n          \"CHECKIN_MESSAGE\": \"Write a check-in message for the {entityTitleCandidate} ({entityTitleCandidate})\",\n          \"CLIENT_PITCH\": \"Write a pitch for the {entityTitleCandidate} ({entityTitleCandidate})\",\n          \"REJECTION_MESSAGE\": \"Write a rejection letter ({entityTitleCandidate})\",\n          \"IMPROVE_RESUME\": \"Improve the {entityTitleCandidate}'s resume ({entityTitleCandidate})\",\n          \"EXTRACT_LAST_JOB_TITLE\": \"Extract last job title for {entityTitleCandidate} ({entityTitleCandidate})\",\n          \"CREATE_PUBLIC_JOB_DESCRIPTION\": \"Write a public job description for {entityTitleJobOrder} ({entityTitleJobOrder})\",\n          \"SCREENING_QUESTIONS_JOB\": \"Write screening questions for the {entityTitleJobOrder} ({entityTitleJobOrder})\",\n          \"PITCH_CANDIDATE_FOR_JOB\": \"Write a message pitching a {entityTitleCandidate} for a {entityTitleJobOrder} ({entityTitleJobOrder})\",\n          \"IMPROVE_JOB_DESCRIPTION\": \"Improve {entityTitleJobOrder}'s description ({entityTitleJobOrder})\",\n          \"INTERVIEW_PREP\": \"Write interview prep tips for {entityTitleJobOrder} ({entityTitleJobOrder})\",\n          \"ASK_ABOUT_HIRING_PLANS\": \"Write a message to {entityTitleClientContact} about their upcoming hiring plans ({entityTitleClientContact})\",\n          \"CLARIFY_JOB_REQUIREMENTS\": \"Write a message to {entityTitleClientContact} to clarify job requirements for {entityTitleJobOrder} ({entityTitleClientContact})\",\n          \"PITCH_CANDIDATE_TO_CONTACT\": \"Write a message pitching a {entityTitleCandidate} to the {entityTitleClientContact} ({entityTitleClientContact})\