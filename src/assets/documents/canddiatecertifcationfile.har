      billRate: billRate,\\n                    rate8: rate8,\\n                    rate12: rate12,\\n                    rate40: rate40,\\n                    rate48: rate48,\\n                    hoildayRate: hoildayRate,\\n                    callBackRate: callBackRate,\\n                    chargeRate: chargeRate,\\n                    onCallRate: onCallRate\\n                };\\n                return billRateObject;\\n            },\\n            updatePlacementUsingLoggedInUser: function (id, body) {\\n                console.log(\\\"Newbury copy DS to placement: updatePlacement params\\\", id, body);\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id;\\n                    API.appBridge.httpPOST(url, body).then(function (result) {\\n                        resolve(result);\\n                    });\\n                });\\n            },\\n            updatePlacementFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    var query = {\\n                        query: {\\n                            type: 'updatePlacement',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"updatePlacementFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object updatePlacementFunc', data);\\n    