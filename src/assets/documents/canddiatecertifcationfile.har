                      text2: \\\">12 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate12 || 0,\\n                            float2: otBillRate12 || 0 // job rates\\n                        });\\n                    }\\n                    if (dealsheet.payRate40 && dealsheet.payRate40.length) {\\n                        rates.push({\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\">40 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate40 || 0,\\n                            float2: otBillRate40 || 0 // job rates\\n                        });\\n                    }\\n                    if (dealsheet.payRate3740 && dealsheet.payRate3740.length) {\\n                        rates.push({\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\"37-40 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate3740 || 0,\\n                            float2: dealsheet.DealSheetJob.billRate || 0 // job rates\\n                        });\\n                    }\\n                    if (dealsheet.payRate48 && dealsheet.payRate48.length) {\\n                        rates.push({\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\">48 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate48 || 0,\\n                            float2: otBillRate8 || 0 // job rates\\n                        });\\n                    }\\n                    var promiseArr = [];\\n                    rates.forEach(function (element, index) {\\n                        promiseArr.push(controller.saveRate(element, placement.id));\\n                    });\\n                    console.log(\\\"Newbury copy DS to placement: rates\\\", rates);\\n                    Promise.all(promiseArr).then(function () {\\n                        console.log(\\\"Newbury copy DS to placement: saving rates done\\\");\\n                        resolve();\\n                    });\\n                });\\n            },\\n            getCurrentVersion: function (mainVerionId, versionDate) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return controller.getCurrentVersionFunc({ mainVerionId: mainVerionId, versionDate: versionDate });\\n            },\\n            getBasicVersionIds: function (placementId, placementRateCardStatus) {\\n                return controller.getBasicVersionIdsFunc({ placementId: placementId, placementRateCardStatus: placementRateCardStatus });\\n            },\\n            updateExisitngPlacementRateCard: function (rate, mainVerionId) {\\n                console.log(\\\"updatedVersion\\\", rate);\\n                return controller.updateExisitngPlacementRateCardFunc({ rate: rate, mainVerionId: mainVerionId });\\n            },\\n            insertNewVersion: function (rate, mainVerionId) {\\n                return controller.insertNewVersionFunc({ rate: rate, mainVerionId: mainVerionId });\\n            },\\n            saveRateBH1: function (rate) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return controller.saveRateBH1Func({ rate: rate });\\n            },\\n            saveRate: function (rate, id) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return new Promise(function (resolve) {\\n                    rate.placement = { id: id };\\n                    var url = '/entity/PlacementCustomObjectInstance1';\\n                    API.appBridge.httpPUT(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            getEarnCodes: function () {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"query/EarnCode?where=id>0\\\" + \\\"&fields=id,title,code,earnCodeGroup&count=500\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        if (API.appBridge)\\n                            resolve(result.data.data);\\n                        else\\n                            resolve(result.data);\\n                    });\\n                });\\n            },\\n            mapEarnCodeArrToObj: function (earnCodes) {\\n                var earnCodesObj = {};\\n                earnCodes.forEach(function (item) {\\n                    earnCodesObj[item.code] = item;\\n                });\\n                return earnCodesObj;\\n            },\\n            getDTBillRateModifier: function (billingTerm) {\\n                var multipler = billingTerm.dt_multiplier;\\n                var addOn = billingTerm.dt_add_on;\\n                if (multipler && addOn) {\\n                    multipler = 1;\\n                    addOn = 0;\\n                }\\n                var modifier = multipler ? \\\"*\\\" + multipler : addOn ? \\\"+\\\" + addOn : \\\"*1\\\";\\n                return modifier;\\n            },\\n            getOTBillRateModifier: function (billingTerm) {\\n                var multipler = billingTerm.ot_multiplier;\\n                var addOn = billingTerm.ot_add_on;\\n                if (multipler && addOn) {\\n                    multipler = 1;\\n                    addOn = 0;\\n                }\\n                var modifier = multipler ? \\\"*\\\" + multipler : addOn ? \\\"+\\\" + addOn : \\\"*1\\\";\\n                return modifier;\\n            },\\n            getHolidayCallBackModifier: function (billingTerm, multiplier, addon) {\\n                if ((multiplier && addon) || (!multiplier && !addon)) {\\n                    var modifier = controller.getOTBillRateModifier(billingTerm);\\n                    return modifier;\\n                }\\n                if (multiplier) {\\n                    return \\\"*\\\" + multiplier;\\n                }\\n                if (addon) {\\n                    return \\\"+\\\" + addon;\\n                }\\n            },\\n            calculateRate: function (baseRate, modifier) {\\n                console.log('baseRate', baseRate, 'mod', modifier);\\n                var rateOperator, rateFactor;\\n                if (modifier && modifier.length && modifier[0] != \\\"*\\\" && modifier[0] != \\\"+\\\") {\\n                    rateOperator = '*';\\n                    rateFactor = modifier;\\n                }\\n                else {\\n                    modifier = modifier || '';\\n                    rateOperator = modifier[0] || '*';\\n                    rateFactor = modifier.slice(1) || '1';\\n                }\\n                var rate = 0;\\n                if (rateOperator === \\\"*\\\") {\\n                    rate = Number(baseRate) * Number(rateFactor);\\n                }\\n                else {\\n                    rate = Number(baseRate) + Number(rateFactor);\\n                }\\n                return rate;\\n            },\\n            calculateAdditionalCostRate: function (dealsheetData, item) {\\n                var amount;\\n                var shifts = dealsheetData.DealSheetJob.shifts;\\n                if (item.frequency === \\\"One-time\\\") {\\n                    if (item.calculation === \\\"$\\\") {\\n                        amount = Number(item.defaultAmount);\\n                    }\\n                    else {\\n                        if (item.calcAppliesTo !== \\\"Taxable Wages\\\") {\\n                            amount =\\n                                (Number(item.defaultAmount) * dealsheetData.assignmentRevenueAmount) / 100;\\n                        }\\n                        else {\\n                            amount =\\n                                (Number(item.defaultAmount) * dealsheetData.taxableWagesAmount) / 100;\\n                        }\\n                    }\\n                }\\n                else if (item.frequency == \\\"Weekly\\\") {\\n                    amount =\\n                        Number(item.defaultAmount) *\\n                            dealsheetData.DealSheetJob.contractLengthWeeks;\\n                }\\n                else if (item.frequency == \\\"Monthly\\\") {\\n                    amount =\\n                        (Number(item.defaultAmount) *\\n                            dealsheetData.DealSheetJob.contractLengthWeeks) /\\n                            4.34;\\n                }\\n                else if (item.frequency == \\\"Hourly\\\") {\\n                    amount =\\n                        Number(item.defaultAmount) * dealsheetData.totalPayableHours;\\n                }\\n                else if (item.frequency == \\\"Per Shift\\\") {\\n                    amount =\\n                        Number(item.defaultAmount) *\\n                            dealsheetData.DealSheetJob.contractLengthWeeks *\\n                            shifts;\\n                }\\n                return amount;\\n            },\\n            buildRateObjectBH1: function (dealsheet, earnCodes, placement, otPayRate, dtPayRate, placementRateCardStatus, advancedStateIndex, billingTerm) {\\n                return new Promise(function (resolve) {\\n                    console.log(\\\"Newbury copy DS to placement: buildRateObjectBH1 params\\\", dealsheet);\\n                    var otBillRate, dtBillRate, regPay, regBillRate, onCallPayRate, onCallBillRate, chargePayRate, chargeBillRate, holidayPayRate, holidayBillRate, callBackPayRate, callBackBillRate, totalStipend, totalStipendPerShift, totalLodgigPerShift, totalMiPerShift, orientationBillRate, calculatedDtBillRate, otChargePayRate, dtChargePayRate, otCallBackBillRate, dtCallBackBillRate, dtChargeBillRate, otHolidayBillRate, dtHolidayBillRate, otChargeBillRate, otHolidayPayRate, dtHolidayPayRate, otCallBackPayRate, dtCallBackePayRate, doubleTimeBillRateFromBillingTerm, originalOTBillRate, orientationOTPayRate, orientationDTPayRate, orientationOTBillRate, nonOrientationOTPayRate, nonOrientationDTPayRate, prepFeeRate, otChargeHoliday, dtChargeHoliday;\\n                    var stateSickCodeMapping = {\\n                        \\\"California\\\": \\\"CAS\\\",\\n                        \\\"Colorado\\\": \\\"COS\\\",\\n                        \\\"New York\\\": \\\"NYS\\\",\\n                        \\\"Arizona\\\": \\\"AZ\\\",\\n                        \\\"Washington\\\": \\\"WA\\\",\\n                        \\\"Connecticut\\\": \\\"CT\\\",\\n             