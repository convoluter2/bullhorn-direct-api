AK\": \"Max Hours Before First Break\",\n    \"MAX_HOURS_BEFORE_SECOND_BREAK\": \"Max Hours Before Second Break\",\n    \"WAIVE_FIRST_BREAK_HOURS\": \"Waive First Break Hours\",\n    \"CAN_WAIVE_FIRST_BREAK\": \"Can Waive First Break\",\n    \"WAIVE_SECOND_BREAK_HOURS\": \"Waive Second Break Hours\",\n    \"CAN_WAIVE_SECOND_BREAK\": \"Can Waive Second Break\",\n    \"MIN_WAGE_PREMIUM_AMOUNT\": \"Min Wage Premium Amount\",\n    \"DAYS_OF_WEEK\": \"Days of Week\",\n    \"TARGET_QUANTITY\": \"Target Quantity\",\n    \"MULTIPLIER\": \"Multiplier\",\n    \"TARGET_EARN_CODES\": \"Target Earn Codes\",\n    \"TARGET_EARN_CODE1\": \"Target Earn Code1\",\n    \"TARGET_EARN_CODE2\": \"Target Earn Code2\",\n    \"MINIMUM_HOURS_WORKED\": \"Minimum Hours Worked\",\n    \"LOW_CENSUS_TARGET_EARN_CODE1\": \"Target Earn Code (Before threshold)\",\n    \"LOW_CENSUS_TARGET_EARN_CODE2\": \"Target Earn Code (After threshold)\",\n    \"FLSA_OVERTIME_ADJUSTMENT_EARN_CODE\": \"FLSA Overtime Adjustment Earn Code\",\n    \"FLSA_DOUBLETIME_ADJUSTMENT_EARN_CODE\": \"FLSA Doubletime Adjustment Earn Code\",\n    \"MEAL_MISSED_EARN_CODE\": \"Meal Missed Earn Code\",\n    \"MEAL_SHORT_EARN_CODE\": \"Meal Short Earn Code\",\n    \"MEAL_LATE_EARN_CODE\": \"Meal Late Earn Code\",\n    \"MEAL_SECOND_EARN_CODE\": \"Meal Second Earn Code\",\n    \"HOLIDAYS\": \"{entityTitleHolidayMany}\",\n    \"IS_GENERATING_NEGATIVE_ADJUSTMENTS\": \"Is Generating Negative Adjustments\",\n    \"GUARANTEED_HOURS_PER_DAY\": \"Hours per Day\",\n    \"SCHEDULE_BASED\": \"Schedule Based\",\n    \"GUARANTEED_HOURS_PER_PERIOD\": \"Hours per Period\",\n    \"FIELD_MUST_BE_GREATER_THAN_ZERO\": \"Quantity must be greater than zero\",\n    \"FIELD_MUST_BE_LESS_THAN\": \"Quantity must be less than {value}\",\n    \"FIELD_MUST_BE_GREATER_THAN_OR_EQUAL_TO_ZERO\": \"{field:format:uppercase} must be greater than or equal to zero\",\n    \"MAKE_HOLIDAY_ACTIVE\": \"Activate {entityTitleHoliday}?\",\n    \"MAKE_HOLIDAY_ACTIVE_DESCRIPTION\