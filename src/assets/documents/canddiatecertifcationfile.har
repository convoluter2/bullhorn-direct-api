\"LABEL\": \"Default Copywriter\",\n            \"PROMPT\": \"This role imitates a professional copywriter. This role helps to create compelling and accurate job descriptions, candidate summaries, and other recruitment-related content.\"\n          },\n          \"DEFAULT_TRANSLATOR\": {\n            \"LABEL\": \"Default Translator\",\n            \"PROMPT\": \"This role helps to translate text from one language to another while preserving important details, proper grammar, and correct punctuation.\"\n          },\n          \"DEFAULT_HIRING_MANAGER\": {\n            \"LABEL\": \"Default Hiring Manager\",\n            \"PROMPT\": \"This role imitates a hiring manager. This role helps to ensure that the best candidates are selected to fill job openings.\"\n          },\n          \"DEFAULT_SUBJECT_MATTER_EXPERT\": {\n            \"LABEL\": \"Default Subject Matter Expert\",\n            \"PROMPT\": \"This role imitates a subject matter expert. This role helps to provide insight, guidance, and expertise on topics.\"\n          },\n          \"DEFAULT_HR_BUSINESS_PARTNER\": {\n            \"LABEL\": \"Default HR Business Partner\",\n            \"PROMPT\": \"This role imitates an HR business partner. It helps to provide strategic HR support, advises on HR policies, and collaborates with leadership on workforce planning and talent management.\"\n          },\n          \"DEFAULT_DATA_EXTRACTOR\": {\n            \"LABEL\": \"Default Data Extractor\",\n            \"PROMPT\": \"This role helps to extract specific points from a record.\"\n          }\n        },\n        \"DESCRIPTION\": \"Description\",\n        \"MODAL\": {\n          \"HEADER\": \"Add Role\",\n          \"DESCRIPTION_PLACEHOLDER\": \"You are an employee of Acme Staffing, a staffing agency with over 20 years of experience filling permanent and temporary roles in technical fields.\"\n        },\n        \"NON_IDEAL_STATE\": {\n          \"TITLE\": \"{productNameCopilot} {tabName} could not be loaded\",\n          \"DESCRIPTION\": \"Please try again or contact Bullhorn Support\"\n        },\n        \"ROLES\": \"Roles\",\n        \"ROLES_TOOLTIP\": \"Roles tell the LLM which type of person it should be writing as and help create more realistic output. Default Roles are provided by Bullhorn and cannot be modified or deleted. You may also add your own custom roles.\",\n        \"TITLE\": \"Title\"\n      },\n      \"ERROR\": {\n        \"CALL_TO_LLM_TIMEOUT\": \"The response from LLM has timed out. Please try again.\",\n        \"CANNOT_CONNECT\": \"The LLM endpoint could not be reached. Please try again.\",\n        \"CANNOT_CONSTRUCT_REQUEST\": \"The following fields may contain invalid characters: {invalidFields}.\",\n        \"COPILOT_ERROR\": \"There was an issue with your request. Please try again later or contact Bullhorn Support.\",\n        \"INCOMPLETE_COPILOT_CONFIG\": \"Required LLM configuration fields are missing. Please contact your Bullhorn Administrator.\",\n        \"INVALID_API_KEY\": \"The {invalidFields} provided is incorrect.\",\n        \"PROMPT_DATA_TRUNCATED\": \"The request has exceeded the max token limit. Historical conversation context or additional prompt data may have been truncated.\",\n        \"PROMPT_DATA_AND_RESPONSE_TRUNCATED\": \"The request has exceeded the max token limit. Historical conversation context or additional prompt data may have been truncated. The response has exceeded your LLM's token limit and has been truncated.\",\n        \"INVALID_CONFIG_FIELDS\": \"The following fields may contain invalid characters: {invalidFields}.\",\n        \"INVALID_MODEL\": \"The {invalidFields} provided is incorrect.\",\n        \"LLM_RATE_LIMIT_REACHED\": \"You have exceeded the usage limits of your LLM subscription. Please try again later or contact your Bullhorn Administrator.\",\n        \"TOKEN_LIMIT_REACHED\": \"You have exceeded the usage limits of your LLM subscription. Please try again later or contact your Bullhorn Administrator.\",\n        \"TOKEN_LIMIT_EXCEEDED\": \"You have exceeded the usage limits of your LLM subscription. Please try again later or contact your Bullhorn Administrator.\"\n      },\n      \"NON_IDEAL_STATE\": {\n        \"TITLE\": \"{productNameCopilot} {tabName} could not be loaded\",\n        \"DESCRIPTION\": \"Please try again or contact Bullhorn Support\"\n      },\n      \"PROMPT_LIST\": {\n        \"PROMPT\": \"Prompt\",\n        \"PRIMARY_ENTITY\": \"Primary Entity\",\n        \"SECONDARY_ENTITY\": \"Secondary Entity\",\n        \"ROLE\": \"Role\",\n        \"TASK\": \"Task\",\n        \"TONE\": \"Tone\",\n        \"LENGTH\": \"Length\",\n        \"ADD_PROMPT\": \"Add Prompt\",\n        \"ENTITY\": {\n          \"CANDIDATE\": \"{entityTitleCandidate}\",\n          \"JOB_ORDER\": \"{entityTitleJobOrder}\",\n          \"CLIENT_CONTACT\": \"{entityTitleClientContact}\"\n        },\n        \"LOCATION\": {\n          \"HEADER_TEXT\": \"Location\",\n          \"MAIN\": \"{productNameCopilot} Card\",\n          \"ADDITIONAL\": \"{productNameCopilot} Card - More Prompts\",\n          \"AUTOMATION\": \"Automation\"\n        },\n        \"ENABLED_DISABLED\": {\n          \"HEADER_TEXT\": \"Enabled/Disabled\",\n          \"ENABLED\": \"Enabled\",\n          \"DISABLED\": \"Disabled\"\n        },\n        \"TYPE\": {\n          \"HEADER_TEXT\": \"Type\",\n          \"DEFAULT\": \"Default\",\n          \"CUSTOM\": \"Custom\"\n        }\n      },\n      \"PROMPT_ADD_EDIT\": {\n        \"ADDITIONAL_DATA\": {\n          \"NOTES_SETTINGS\": \"Notes Settings\",\n          \"NUM_NOTES\": \"Number of Notes\",\n          \"NOTE_ACTIONS_FILTER\": \"Note Actions Filter\",\n          \"NOTE_ACTIONS_FILTER_PLACEHOLDER\": \"Note Actions Filter\",\n          \"NOTE_CONTENT_FILTER\": \"Note Content Filter\",\n          \"NOTE_CONTENT_FILTER_PLACEHOLDER\": \"Note Content Filter\",\n          \"EMAIL_SETTINGS\": \"Email Settings\",\n          \"NUM_EMAILS\": \"Number of Emails\",\n        