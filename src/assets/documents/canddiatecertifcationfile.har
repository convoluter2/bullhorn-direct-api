eObject = {\\n                        placement: { id: placement.id },\\n                        placementRateCardLineGroups: placementRateCardLineGroups,\\n                        effectiveDate: rateEffectiveDate\\n                    };\\n                    console.log(\\\"Newbury copy DS to placement: rateObject\\\", rateObject);\\n                    var placementRateCardLineGroupsAsObject = {};\\n                    var placementRateCardLinesAsObject = {};\\n                    placementRateCardLineGroups.forEach(function (item) {\\n                        placementRateCardLineGroupsAsObject[item.earnCodeGroup.id] = item;\\n                        item.placementRateCardLines.forEach(function (placementRateCardLine) {\\n                            placementRateCardLinesAsObject[placementRateCardLine.earnCode.id] = placementRateCardLine;\\n                        });\\n                    });\\n                    console.log(\\\"placementRateCardLinesAsObject\\\", placementRateCardLinesAsObject);\\n                    console.log(\\\"placementRateCardLineGroupsAsObject\\\", placementRateCardLineGroupsAsObject);\\n                    controller.getBasicVersionIds(placement.id, placementRateCardStatus).then(function (existingPlacementRateCard) {\\n                        console.log(\\\"existingPlacementRateCard\\\", existingPlacementRateCard);\\n                        if (existingPlacementRateCard.length) {\\n                            var item_1 = existingPlacementRateCard[0].versions.data.find(function (item) {\\n                                var date1 = new Date(item.effectiveDate + \\\"T12:00\\\");\\n                                var date2 = effectiveDate;\\n                                // const date2 = new Date(rateEffectiveDate  + \\\"T12:00\\\")\\n                                return date1.getFullYear() === date2.getFullYear() && date1.getMonth() === date2.getMonth() && date1.getDate() === date2.getDate();\\n                            });\\n                            if (item_1) {\\n                                console.log(\\\"UPDATING EXISTING VERSION\\\");\\n                                controller.getCurrentVersion(existingPlacementRateCard[0].id, item_1.effectiveDate).then(function (version) {\\n                                    var updatedVersion = {\\n                                        id: existingPlacementRateCard[0].id,\\n                                        placement: { id: placement.id },\\n                                        placementRateCardLineGroups: [],\\n                                        versionID: item_1.id,\\n                                    };\\n                                    var existingLineGroups = [];\\n                                    console.log(\\\"version\\\", version);\\n                                    console.log(\\\"placementRateCardLineGroupsAsObject\\\", placementRateCardLineGroupsAsObject);\\n                                    console.log(\\\"placementRateCardLinesAsObject\\\", placementRateCardLinesAsObject);\\n                                    version.placementRateCardLineGroups.data.forEach(function (placementRateCardLineGroup) {\\n                                        existingLineGroups.push(placementRateCardLineGroup.earnCodeGroup.id);\\n                                        if (placementRateCardLineGroupsAsObject[placementRateCardLineGroup.earnCodeGroup.id]) {\\n                                            console.log(\\\"OUR GROUP EXISITS GROUP\\\");\\n                                            placementRateCardLineGroup.placementRateCardLines.data.forEach(function (placementRateCardLine) {\\n                                                var newItemData = placementRateCardLinesAsObject[placementRateCardLine.earnCode.id];\\n                                                placementRateCardLine.alias = newItemData.alias;\\n                                                placementRateCardLine.payRate = newItemData.payRate;\\n                                                placementRateCardLine.billRate = newItemData.billRate;\\n                                                placementRateCardLine.customFloat1 = newItemData.customFloat1;\\n                                            });\\n                                            console.log(\\\"placementRateCardLineGroup.id\\\", placementRateCardLineGroup.id);\\n                                            updatedVersion.placementRateCardLineGroups.push({\\n                                                id: placementRateCardLineGroup.id,\\n                                                earnCodeGroup: { id: placementRateCardLineGroup.earnCodeGroup.id },\\n                                                isBase: placementRateCardLineGroup.isBase,\\n                                                placementRateCardLines: placementRateCardLineGroup.placementRateCardLines.data.map(function (item) {\\n                                                    return {\\n                                                        alias: item.alias,\\n                                                        billRate: item.billRate,\\n                                                        earnCode: { id: item.earnCode.id },\\n                                                        id: item.id,\\n                                                        payRate: item.payRate,\\n                                                        customFloat1: item.customFloat1\\n                                                    };\\n                                                }),\\n                                            });\\n                                        }\\n                                        else {\\n                                            console.log(\\\"GROUP DOESNT USED FOR DS\\\");\\n                                            updatedVersion.placementRateCardLineGroups.push({\\n                                                id: placementRateCardLineGroup.id,\\n                                                earnCodeGroup: { id: placementRateCardLineGroup.earnCodeGroup.id },\\n                                                isBase: placementRateCardLineGroup.isBase,\\n                                                placementRateCardLines: placementRateCardLineGroup.placementRateCardLines.data.map(function (item) {\\n                                                    return {\\n                                                        alias: item.alias,\\n                                                        billMultiplier: item.billMultiplier,\\n                                                        billRate: item.billRate,\\n                                                        earnCode: { id: item.earnCode.id },\\n                                                        id: item.id,\\n                                                        markupPercent: item.markupPercent,\\n                                                        markupValue: item.markupValue,\\n                                                        payMultiplier: item.payMultiplier,\\n                                                        payRate: item.payRate,\\n                                                        customFloat1: item.customFloat1\\n                                                    };\\n                                                }),\\n                                            });\\n                                        }\\n                                    });\\n                                    var newGroups = placementRateCardLineGroups.filter(function (item) { return existingLineGroups.indexOf(item.earnCodeGroup.id) === -1; });\\n                                    updatedVersion.placementRateCardLineGroups = updatedVersion.placementRateCardLineGroups.concat(newGroups);\\n                                    updatedVersion.placementRateCardLineGroups = updatedVersion.placementRateCardLineGroups.filter(function (item) { return !earnCodesToBeRemoved[item.earnCodeGroup.id]; });\\n                                    controller.updateExisitngPlacementRateCard(updatedVersion, existingPlacementRateCard[0].id).then(function () {\\n                                        console.log(\\\"Newbury copy DS to placement: saving rates done\\\");\\n                                        resolve();\\n                                    });\\n                                });\\n                            }\\n                            else {\\n                                console.log(\\\"INSERTING NEW VERSION\\\");\\n                                controller.insertNewVersion(rateObject, existingPlacementRateCard[0].id).then(function () {\\n                                    console.log(\\\"Newbury copy DS to placement: saving rates done\\\");\\n                                    resolve();\\n                                });\\n                            }\\n                        }\\n                        else {\\n                            console.log(\\\"add NEW RECORD\\\");\\n                            controller.saveRateBH1(rateObject).then(function () {\\n                                console.log(\\\"Newbury copy DS to placement: saving rates done\\\");\\n                                resolve();\\n                            });\\n                        }\\n                    });\\n                    // controller.saveRateBH1(rateObject).then(function(){\\n                    //     console.log(\\\"Newbury copy DS to placement: saving rates done\\\")\\n                    //     resolve()\\n                    // })\\n                });\\n            },\\n            getHighLevelSettings: function () {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://prod.trustaff.dl-sheet.com/highLevelSettings/highLevelSettings/read?apiKey=ukhPhZVFimGGOvRgSKfLAy5CMCBh2sOH';\\n                    fetch(url, {\\n                        method: 'get',\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: highLevelSettings', data);\\n                        resolve(data);\\n                    });\\n                });\\n            },\\n            getPlacementRateCardStatus: function () {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"query/PlacementRateCardStatusLookup?where=id>0\\\" + \\\"&fields=id,label&count=500\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        if (API.appBridge)\\n                            resolve(result.data.data);\\n                        else\\n                            resolve(result.data);\\n                    });\\n                });\\n            },\\n            copyDealsheetDataToPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    controller.getPlacement(id).then(function (placement) {\\n                        console.log(\\\"Newbury copy DS to placement: placement Object\\\", placement);\\n                        if (placement[controller.dealsheetPathAtPlacement] && placement[controller.dealsheetPathAtPlacement].length) {\\n                            Promise.all([\\n                                controller.getJob(placement.jobOrder.id),\\n                                controller.getDealsheet(placement[controller.dealsheetPathAtPlacement]),\\n                                controller.getHealthBenefitsRecords(),\\n                                controller.getEarnCodes(),\\n                                controller.getHighLevelSettings(),\\n                                controller.getPlacementRateCardStatus(),\\n                                controller.getBillingTerm(placement.jobOrder.billingProfile.id)\\n                            ]).then(function (data) {\\n                                console.log(\\\"Newbury copy DS to placement: data\\\", data);\\n                                var job = data[0];\\n                                var dealsheet = data[1];\\n                                var healthBenefits = data[2];\\n                                var earnCodes = data[3];\\n                                var highLevelSettings = data[4];\\n                                var placementStatus = data[5];\\n                                var billingTerm = data[6];\\n                                var placementRateCardStatus = placementStatus.find(function (item) { return item.label === \\\"Active\\\"; });\\n                                var customText9;\\n                                console.log(\\\"placementRateCardStatus\\\", placementRateCardStatus);\\n                                var overTimePayRate, doubleTimeRate;\\n                                var advancedOtStatesIndex = highLevelSettings.findIndex(function (item) { return item.role === \\\"Advanced OT Rates Apply\\\"; });\\n                                var advancedStates = highLevelSettings[advancedOtStatesIndex];\\n                                advancedStates = advancedStates.field.split(\\\",\\\");\\n                                var advancedStateIndex = advancedStates.indexOf(dealsheet.DealSheetJob.jobState);\\n                                var billableOT = dealsheet.DealSheetClient.billableOT || \\\"\\\";\\n                                billableOT = billableOT.split(\\\" \\\")[1];\\n                                billableOT = billableOT === \\\"36\\\" ? \\\"3640\\\" : billableOT;\\n                                // if(dealsheet.DealSheetJob.division != \\\"Fastaff\\\"){\\n                                //   billableOT = \\\"40\\\"\\n                                // }\\n                                overTimePayRate = advancedStateIndex > -1 ? Number(dealsheet.payRate8) || 0 : Number(dealsheet[\\\"payRate40\\\"]) || 0;\\n                                doubleTimeRate = advancedStateIndex > -1 ? Number(dealsheet.payRate12) || 0 : 0;\\n                                if (dealsheet.DealSheetJob.jobState === \\\"Colorado\\\") {\\n                                    overTimePayRate = dealsheet.payRate12;\\n                                    doubleTimeRate = 0;\\n                                }\\n                                if (dealsheet.DealSheetJob.jobState === \\\"Alaska\\\") {\\n                                    doubleTimeRate = 0;\\n                                }\\n                                // if(dealsheet.DealSheetJob.division === \\\"Fastaff\\\" && advancedStateIndex === -1){\\n                                //   doubleTimeRate = 2 * dealsheet.regularPay\\n                                // }\\n                                if (dealsheet.taxedPerDiem) {\\n                                    customText9 = \\\"36 Hour Weekly Bonus\\\";\\n                                }\\n                                else if (placement.employmentType !== \\\"PRN\\\") {\\n                                    if (+dealsheet.DealSheetJob.shifts === 3) {\\n                                        customText9 = \\\"3 Scheduled Shifts per Week\\\";\\n                                    }\\n                                    else if (+dealsheet.DealSheetJob.shifts === 4) {\\n                                        customText9 = \\\"4 Scheduled Shifts per Week\\\";\\n                                    }\\n                                    else if (+dealsheet.DealSheetJob.shifts === 5) {\\n                                        customText9 = \\\"5 Scheduled Shifts per Week\\\";\\n                                    }\\n                                }\\n                                else {\\n                                    customText9 = \\\"PRN Days Worked\\\";\\n                                }\\n                                dealsheet.benefits = dealsheet.benefits && dealsheet.benefits.length ? dealsheet.benefits.split(\\\",\\\") : [];\\n                                var selectedBenefits = healthBenefits.filter(function (item) {\\n                                    return dealsheet.benefits.indexOf(item.fieldId.toString()) > -1;\\n                                });\\n                                console.log(\\\"Newbury copy DS to placement: selectedBenefits\\\", selectedBenefits);\\n                                var body = {\\n                                    dateBegin: new Date(dealsheet.DealSheetCandidate.startDate).setHours(12),\\n                                    dateEnd: new Date(dealsheet.DealSheetCandidate.endDate).setHours(12),\\n                                    durationWeeks: dealsheet.DealSheetJob.contractLengthWeeks,\\n                                    correlatedCustomInt1: parseInt(dealsheet.DealSheetJob.shifts),\\n                                    clientBillRate: dealsheet.DealSheetJob.billRate,\\n                                    customInt2: parseInt(dealsheet.DealSheetClient.nonBillableOrientationHours),\\n                                    customFloat1: dealsheet.DealSheetClient.vmsFeePercentage,\\n                                    customTextBlock3: dealsheet.DealSheetClient.cancellationPolicy,\\n                                    customTextBlock4: dealsheet.DealSheetClient.exhibiteAndRiderNotes,\\n                                    correlatedCustomFloat3: dealsheet.DealSheetJob.guaranteedScheduledHours,\\n                                    customText13: dealsheet.DealSheetCandidate.approvedTimeOff,\\n                                };\\n                                if (customText9) {\\n                                    body.customText9 = customText9;\\n                                }\\n                                if (API.globals.user.stopUpdatingStartAndEndDate) {\\n                                    delete body.dateBegin;\\n                                    delete body.dateEnd;\\n                                    delete body.customText9;\\n                                }\\n                                controller.updatePlacement(id, body).then(function (result) {\\n                                    console.log(\\\"Newbury copy DS to placement: save placement result\\\", result);\\n                                    // controller.addRateObjects(dealsheet,placement).then(function(result2){\\n                                    controller.buildRateObjectBH1(dealsheet, earnCodes, placement, overTimePayRate, doubleTimeRate, placementRateCardStatus, advancedStateIndex, billingTerm).then(function (result3) {\\n                                        resolve();\\n                                    });\\n                                    // })\\n                                });\\n                            });\\n                        }\\n                        else {\\n                            resolve();\\n                        }\\n                    });\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            console.log(\\\"Newbury copy DS to placement: API\\\", API);\\n            console.log(\\\"Newbury copy DS to placement: form\\\", form);\\n            var data;\\n            if (Array.isArray(form.data[0].data))\\n                data = form.data[0].data[0];\\n            else if (Array.isArray(form.data[0]))\\n                data = form.data[0];\\n            else\\n                data = form.data[1].data[0];\\n            var placementId = data.filter(function (item) { return item.changedEntityType === \\\"Placement\\\"; })[0].changedEntityId;\\n            console.log(\\\"Newbury copy DS to placement: placementId\\\", placementId);\\n            if (placementId) {\\n                return controller.copyDealsheetDataToPlacement(placementId);\\n            }\\n        }\\n        else {\\n            return;\\n        }\",\"sortOrder\":10,\"dateLastModified\":1782461271107},{\"id\":4273,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"prevent-placement-creation-if-deal-sheet-missing-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"console.log('prevent-placement-creation-if-deal-sheet-missing-1218');\\n        const app = {\\n            dealSheetIDField: 'customText11',\\n            errorMsg: '\\\\nDeal Sheet ID missing; Submit Deal Sheet to link first and then create Placement. \\\\n',\\n            init: () => {\\n                console.log('prevent-placement-creation-if-deal-sheet-missing-1218');\\n                const submissionID = API.currentEntityId;\\n                if (!submissionID) {\\n                    return Promise.resolve(form);\\n                }\\n                return app.getSubmissionData(submissionID).then((data) => {\\n                    const dealSheetID = data.customText11;\\n                    const brand = data.customText17;\\n                    if (!dealSheetID && brand !== 'USN') {\\n                        if (form.errorMessage) {\\n                            form.errorMessage += app.errorMsg;\\n                        }\\n                        else {\\n                            form.errorMessage = app.errorMsg;\\n                        }\\n                        form.isFormValid = false;\\n                    }\\n                    return Promise.resolve(form);\\n                });\\n            },\\n            getSubmissionData: (submissionID) => {\\n                const url = `${API.http.restURL}entity/JobSubmission/${submissionID}?fields=id,customText11,customText17`;\\n                return API.http.get(url).toPromise().then((response) => {\\n                    return Promise.resolve(response.data);\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1757419237193},{\"id\":4275,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19668074,\"firstName\":\"Keith\",\"lastName\":\"Daulton2\"},\"name\":\"credential-details-flowdown-custom-object-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            entity: 'ClientCorporationCustomObjectInstance4',\\n            entityId: API.currentEntityId,\\n            field: 'textBlock1',\\n            flowdownField: 'correlatedCustomTextBlock2',\\n            getFormControlValue: (field) => {\\n                if (!form.controls[field]) {\\n                    return null;\\n                }\\n                return form.controls[field].value;\\n            },\\n            init: () => {\\n                // get the company from the custom object\\n                // find all the placements and jobs that match the company\\n                // update the `flowdownField` in each placement and job with the value from the custom object `field`\\n                return app.getCompany().then((companyId) => {\\n                    if (!companyId) {\\n                        return;\\n                    }\\n                    const promises = Promise.all([\\n                        app.findPlacements(companyId),\\n                        app.findJobOrders(companyId),\\n                    ]);\\n                    // eslint-disable-next-line consistent-return\\n                    return promises.then((results) => {\\n                        const placements = results[0];\\n                        const jobOrders = results[1];\\n                        const value = app.getFormControlValue(app.field);\\n                        const placementPromises = placements.map((id) => {\\n                            return app.updatePlacement(id, value);\\n                        });\\n                        const jobOrderPromises = jobOrders.map((id) => {\\n                            return app.updateJobOrder(id, value);\\n                        });\\n                        return Promise.all([\\n                            ...placementPromises,\\n                            ...jobOrderPromises,\\n                        ]);\\n                    });\\n                });\\n            },\\n            getCompany: () => {\\n                return API.appBridge.httpGET(`entity/${app.entity}/${app.entityId}?fields=clientCorporation(id)`).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data.clientCorporation.id;\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            findPlacements: (id) => {\\n                const url = `query/Placement?fields=id&where=clientCorporation.id=${id}`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data.map((placement) => {\\n                            return placement.id;\\n                        });\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            findJobOrders: (id) => {\\n                const url = `query/JobOrder?fields=id&where=clientCorporation.id=${id}`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data.map((jobOrder) => {\\n                            return jobOrder.id;\\n                        });\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            updatePlacement: (id, value) => {\\n                const url = `entity/Placement/${id}`;\\n                return API.appBridge.httpPOST(url, {\\n                    [app.flowdownField]: value,\\n                }).then(() => {\\n                    return Promise.resolve();\\n                });\\n            },\\n            updateJobOrder: (id, value) => {\\n                const url = `entity/JobOrder/${id}`;\\n                return API.appBridge.httpPOST(url, {\\n                    [app.flowdownField]: value,\\n                }).then(() => {\\n                    return Promise.resolve();\\n                });\\n            },\\n        };\\n        console.log('credential-details-flowdown-custom-object-1218', API.currentEntity, app.entity);\\n        if (API.currentEntity === app.entity) {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1757989025053},{\"id\":4276,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19668074,\"firstName\":\"Keith\",\"lastName\":\"Daulton2\"},\"name\":\"credential-details-flowdown-placement-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            entity: 'Placement',\\n            entityId: API.currentEntityId,\\n            fieldEntity: 'ClientCorporationCustomObjectInstance4',\\n            field: 'textBlock1',\\n            flowdownField: 'correlatedCustomTextBlock2',\\n            getFormControlValue: (field) => {\\n                if (!form.controls[field]) {\\n                    return null;\\n                }\\n                return form.controls[field].value;\\n            },\\n            init: () => {\\n                return app.getCompany().then((id) => {\\n                    if (!id) {\\n                        return;\\n                    }\\n                    // eslint-disable-next-line consistent-return\\n                    return app.getFirstCompanyCustomObject(id).then((value) => {\\n                        return app.updatePlacement(app.entityId, value);\\n                    });\\n                });\\n            },\\n            getCompany: () => {\\n                return API.appBridge.httpGET(`entity/${app.entity}/${app.entityId}?fields=clientCorporation(id)`).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data.clientCorporation.id;\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            getFirstCompanyCustomObject: (id) => {\\n                const url = `query/${app.fieldEntity}?fields=id,${app.field}&where=clientCorporation.id=${id}`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    if (result.data && result.data.data && result.data.data.length > 0) {\\n                        return result.data.data[0][app.field];\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            updatePlacement: (id, value) => {\\n                const url = `entity/Placement/${id}`;\\n                return API.appBridge.httpPOST(url, {\\n                    [app.flowdownField]: value,\\n                }).then(() => {\\n                    return Promise.resolve();\\n                });\\n            },\\n        };\\n        console.log('credential-details-flowdown-placement-1218', API.currentEntity, app.entity, app.entityId);\\n        if (API.currentEntity === app.entity) {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1757989025053},{\"id\":4277,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19668074,\"firstName\":\"Keith\",\"lastName\":\"Daulton2\"},\"name\":\"credential-details-flowdown-job-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            entity: 'JobOrder',\\n            entityId: form.data.changedEntityId,\\n            fieldEntity: 'ClientCorporationCustomObjectInstance4',\\n            field: 'textBlock1',\\n            flowdownField: 'correlatedCustomTextBlock2',\\n            getFormControlValue: (field) => {\\n                if (!form.controls[field]) {\\n                    return null;\\n                }\\n                return form.controls[field].value;\\n            },\\n            init: () => {\\n                return app.getCompany().then((id) => {\\n                    if (!id) {\\n                        return;\\n                    }\\n                    // eslint-disable-next-line consistent-return\\n                    return app.getFirstCompanyCustomObject(id).then((value) => {\\n                        return app.updateJobOrder(app.entityId, value);\\n                    });\\n                });\\n            },\\n            getCompany: () => {\\n                return API.appBridge.httpGET(`entity/${app.entity}/${app.entityId}?fields=clientCorporation(id)`).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data.clientCorporation.id;\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            getFirstCompanyCustomObject: (id) => {\\n                const url = `query/${app.fieldEntity}?fields=id,${app.field}&where=clientCorporation.id=${id}`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    if (result.data && result.data.data && result.data.data.length > 0) {\\n                        return result.data.data[0][app.field];\\n                    }\\n                    return undefined;\\n                });\\n            },\\n            updateJobOrder: (id, value) => {\\n                const url = `entity/JobOrder/${id}`;\\n                return API.appBridge.httpPOST(url, {\\n                    [app.flowdownField]: value,\\n                }).then(() => {\\n                    return Promise.resolve();\\n                });\\n            },\\n        };\\n        console.log('credential-details-flowdown-job-1218', API.currentEntity, app.entity, app.entityId);\\n        if (API.currentEntity === app.entity) {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1757989025057},{\"id\":4506,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":18813622,\"firstName\":\"interactionapiuser.ingenovis\",\"lastName\":\"ingenovishealth\"},\"name\":\"Placementdefaultsonadd_SOLEN-8919\",\"page\":\"record\",\"enabled\":true,\"script\":\"const transformFuntions = {\\n            CustomPickerInternalRegex: /^.* \\\\| ([\\\\d]+)$/,\\n            toCustomPickerInternal: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (!fromValue) {\\n                    transformFuntions.setValue(mapItem.toField, changeObject, '');\\n                    return;\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, `${fromValue.firstName} ${fromValue.lastName} | ${fromValue.id}`);\\n            },\\n            fromCustomPickerInternal: (mapItem, data, changeObject) => {\\n                let value = '';\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (fromValue && transformFuntions.CustomPickerInternalRegex.test(fromValue)) {\\n                    value = fromValue.match(transformFuntions.CustomPickerInternalRegex)[1];\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, (value === '') ? '' : parseInt(value));\\n            },\\n            toCustomPickerSpecialty: (mapItem, data, changeObject) => {\\n                let value = '';\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (fromValue && fromValue.data && fromValue.data.length > 0) {\\n                    value = fromValue.data[0].name;\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, value);\\n            },\\n            addressToTextBox: (mapItem, data, changeObject) => {\\n                let value = '';\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (fromValue) {\\n                    const address = fromValue;\\n                    const parts = [];\\n                    if (address.address1) {\\n                        parts.push(address.address1.trim());\\n                    }\\n                    if (address.address2) {\\n                        parts.push(address.address2.trim());\\n                    }\\n                    if (address.city) {\\n                        parts.push(address.city);\\n                    }\\n                    if (address.stateName) {\\n                        parts.push(address.stateName);\\n                    }\\n                    if (address.countryName) {\\n                        parts.push(address.countryName);\\n                    }\\n                    value = parts.join(', ');\\n                    if (address.zip) {\\n                        value = value ? `${value} ${address.zip}` : address.zip;\\n                    }\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, value);\\n            },\\n            stringToInt: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (!fromValue || fromValue === '') {\\n                    return;\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, parseInt(fromValue));\\n            },\\n            setDate: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (!fromValue || fromValue === '') {\\n                    return;\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, fromValue);\\n            },\\n            setUTCDate: (mapItem, data, changeObject) => {\\n                const originalDate = transformFuntions.getValue(mapItem, data);\\n                console.log('originalDate', originalDate);\\n                if (!originalDate) {\\n                    return;\\n                }\\n                const date = new Date(originalDate);\\n                const utcMidnight = Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate());\\n                const modifiedDate = utcMidnight + (12 * 60 * 60 * 1000);\\n                console.log('modifiedDate', modifiedDate);\\n                transformFuntions.setValue(mapItem.toField, changeObject, modifiedDate);\\n            },\\n            setCredentialingDepartment: (mapItem, data, changeObject) => {\\n                console.log('setCredentialingDepartment');\\n                if (API.globals && API.globals.user && API.globals.user.departmentName) {\\n                    const departmentMap = {\\n                        Fastaff: 'FS',\\n                        Trustaff: 'TTN',\\n                        USN: 'USN',\\n                        Springboard: 'SPR',\\n                        Vital: 'VITAL',\\n                        HCS: 'HCS',\\n                    };\\n                    transformFuntions.setValue(mapItem.toField, changeObject, departmentMap[API.globals.user.departmentName]);\\n                }\\n            },\\n            getValue: (item, data) => {\\n                if (!item.entity) {\\n                    return data[item.fromField];\\n                }\\n                const entityArr = item.entity.split('.');\\n                let retVal = data[entityArr[0]];\\n                if (retVal && entityArr.length > 1) {\\n                    retVal = retVal[entityArr[1]];\\n                }\\n                return (retVal) ? retVal[item.fromField] : null;\\n            },\\n            setValue: (tofield, changeObject, value) => {\\n                const toFieldArr = tofield.split('.');\\n                let i = 0;\\n                let co = changeObject;\\n                for (i; i < toFieldArr.length - 1; i += 1) {\\n                    if (!co[toFieldArr[i]]) {\\n                        co[toFieldArr[i]] = {};\\n                    }\\n                    co = co[toFieldArr[i]];\\n                }\\n                co[toFieldArr[toFieldArr.length - 1]] = value;\\n            },\\n            categoriesToWorkdayProduct: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                const jsonMap = [{\\n                        output: 'ALLI',\\n                        categories: [\\n                            'Allied - Cardiopulmonary',\\n                            'Allied - General',\\n                            'Allied - Laboratory',\\n                            'Allied - Leadership',\\n                            'Allied - Pharmacy',\\n                            'Allied - Radiology',\\n                            'Allied - Therapy',\\n                        ],\\n                    }, {\\n                        output: 'MEDL',\\n                        categories: [\\n                            'Nursing - APRN',\\n                            'Nursing - Leadership',\\n                            'Nursing - LPN',\\n                            'Nursing - RN',\\n                        ],\\n                    }, {\\n                        output: 'DOCS',\\n                        categories: [\\n                            'Physician - Cardiac Surgeon',\\n                            'Physician - Electrophysiologist',\\n                            'Physician - Interventional Cardiologist',\\n                            'Physician - Invasive Cardiologist',\\n                            'Physician - Non-Invasive Cardiologist',\\n                        ],\\n                    }];\\n                const url = `${API.http.restURL}entity/JobOrder/${fromValue}?fields=categories`;\\n                return API.http.get(url).toPromise().then((response) => {\\n                    const categories = response.data.categories;\\n                    if (!categories || !categories.data || !Array.isArray(categories.data) || categories.data.length === 0) {\\n                        return Promise.resolve(null);\\n                    }\\n                    const result = jsonMap.filter((x) => {\\n                        return x.categories.includes(categories.data[0].name);\\n                    });\\n                    if (result && result.length > 0) {\\n                        transformFuntions.setValue(mapItem.toField, changeObject, result[0].output);\\n                    }\\n                    return Promise.resolve(null);\\n                });\\n            },\\n            // +  Leonardo Ariel Salatino - 23-05-15 - Support #17\\n            specialtiesToText: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                const url = `${API.http.restURL}entity/JobOrder/${fromValue}?fields=specialties`;\\n                return API.http.get(url).toPromise().then((response) => {\\n                    const specialties = response.data.specialties;\\n                    if (!specialties || !specialties.data || !Array.isArray(specialties.data) || specialties.data.length === 0) {\\n                        return Promise.resolve(null);\\n                    }\\n                    const placSpec = [];\\n                    specialties.data.forEach((spec) => {\\n                        placSpec.push(spec.name);\\n                    });\\n                    if (placSpec && placSpec.length > 0) {\\n                        transformFuntions.setValue(mapItem.toField, changeObject, placSpec.join(';'));\\n                    }\\n                    return Promise.resolve(null);\\n                });\\n            },\\n            // -  Leonardo Ariel Salatino - 23-05-15 - Support #17\\n            // + David Adams - 8-1-2023 - Support #111\\n            toTimeAndExpenseSource: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                let outputValue = fromValue;\\n                if (!fromValue || fromValue === '') {\\n                    return;\\n                }\\n                if (fromValue === '3rd Party') {\\n                    outputValue = 'V';\\n                }\\n                else if (fromValue === 'Direct') {\\n                    outputValue = 'W';\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, outputValue);\\n            },\\n            // - David Adams - 8-1-2023 - Support #111\\n            // + David Adams - 8-3-2023 - Support #187\\n            toPlacementAddress: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                let outputValue = '';\\n                if (!fromValue || fromValue === '') {\\n                    return;\\n                }\\n                outputValue = `${fromValue.address1} ${fromValue.address2} ${fromValue.city}, ${fromValue.state}, ${fromValue.zip}, ${fromValue.countryCode}`;\\n                transformFuntions.setValue(mapItem.toField, changeObject, outputValue);\\n            },\\n            // - David Adams - 8-3-2023 - Support #187\\n            // +  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n            doNothing: (mapItem, data, changeObject) => {\\n                // Used to load the field value in the API request\\n            },\\n            overrideTimeAndExpenseBranch: (mapItem, data, changeObject) => {\\n                // If ITO then override the branch to ITO, otherwise use value from Billing Profile as usual\\n                const itoBrandName = 'ITO';\\n                let outputValue = null;\\n                if (data.jobOrder.correlatedCustomText3 === itoBrandName) {\\n                    outputValue = itoBrandName;\\n                }\\n                else {\\n                    outputValue = transformFuntions.getValue(mapItem, data);\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, outputValue);\\n            },\\n            // -  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n            addressPullState: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (!fromValue || fromValue === '') {\\n                    return;\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, fromValue.state);\\n            },\\n            copyRoundingRule: (mapItem, data, changeObject) => {\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\n                if (!fromValue || fromValue === '') {\\n                    return;\\n                }\\n                transformFuntions.setValue(mapItem.toField, changeObject, fromValue);\\n            },\\n        };\\n        const app = {\\n            FlowDownConfig: {\\n                flowFromEntity: 'Placement',\\n                fieldMap: [\\n                    // +  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n                    {\\n                        toField: 'correlatedCustomText3',\\n                        fromField: 'correlatedCustomText3',\\n                        entity: 'jobOrder',\\n                        transform: 'doNothing',\\n                    },\\n                    // -  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n                    {\\n                        toField: 'customText44',\\n                        fromField: 'customText19',\\n                        entity: 'jobSubmission',\\n                    },\\n                    {\\n                        toField: 'customText35',\\n                        fromField: 'customText19',\\n                        entity: 'jobOrder',\\n                    },\\n                    {\\n                        toField: 'customText36',\\n                        fromField: 'customText21',\\n                        entity: 'jobOrder',\\n                    },\\n                    {\\n                        toField: 'customText14',\\n                        fromField: 'id',\\n                        entity: 'jobOrder',\\n                        transform: 'categoriesToWorkdayProduct',\\n                    },\\n                    {\\n                        toField: 'customText38',\\n                        fromField: 'customText21',\\n                        entity: 'jobSubmission',\\n                    },\\n                    {\\n                        toField: 'workWeekStart',\\n                        fromField: 'customText22',\\n                        entity: 'jobOrder',\\n                        transform: 'stringToInt',\\n                    },\\n                    {\\n                        toField: 'customText33',\\n                        fromField: 'customTextBlock4',\\n                        entity: 'jobSubmission',\\n                    },\\n                    {\\n                        toField: 'customText41',\\n                        fromField: 'customText23',\\n                        entity: 'jobOrder',\\n                    },\\n                    {\\n                        toField: 'customText39',\\n                        fromField: 'customText6',\\n                        entity: 'jobSubmission',\\n                    },\\n                    {\\n                        toField: 'bonusPackage',\\n                        fromField: 'bonusPackage',\\n                        entity: 'jobOrder',\\n                    },\\n                    {\\n                        toField: 'customInt1',\\n                        fromField: 'customInt1',\\n                        entity: 'jobOrder',\\n                    },\\n                    // +  Leonardo Ariel Salatino - 24-03-08 - Support #382\\n                    // { toField: 'customText29', fromField: 'customText17', entity: 'jobOrder' },\\n                    {\\n                        toField: 'customText29',\\n                        fromField: 'customText7',\\n                        entity: 'jobSubmission',\\n                    },\\n                    // -  Leonardo Ariel Salatino - 24-03-08 - Support #382\\n                    {\\n                        toField: 'customText31',\\n                        fromField: 'customText16',\\n                        entity: 'jobOrder',\\n                    },\\n                    {\\n                        toField: 'customText37',\\n                        fromField: 'customText20',\\n                        entity: 'jobSubmission',\\n                    },\\n                    {\\n                        toField: 'customText60',\\n                        fromField: 'customText24',\\n                        entity: 'jobSubmission',\\n                    },\\n                    {\\n                        toField: 'customText34',\\n                        fromField: 'customText25',\\n                        entity: 'jobSubmission',\\n                    },\\n                    {\\n                        toField: 'customText43',\\n                        fromField: 'customText10',\\n                        entity: 'jobSubmission',\\n                    },\\n                    {\\n                        toField: 'customText13',\\n                        fromField: 'customText13',\\n                        entity: 'jobSubmission',\\n                    },\\n                    {\\n                        toField: 'customText51',\\n                        fromField: 'customTextBlock5',\\n                        entity: 'jobSubmission',\\n                    },\\n                    // +  Leonardo Ariel Salatino - 24-07-15 - Support #663\\n                    // +  Leonardo Ariel Salatino - 24-10-10 - Support #829\\n                    // Re enabled the removed code from #663\\n                    {\\n                        toField: 'dateBegin',\\n                        fromField: 'startDate',\\n                        entity: 'jobSubmission',\\n                        transform: 'setDate',\\n                    },\\n                    // -  Leonardo Ariel Salatino - 24-10-10 - Support #829\\n                    // -  Leonardo Ariel Salatino - 24-07-15 - Support #663\\n                    // +  Leonardo Ariel Salatino - 23-08-23 - Support #208\\n                    // {\\n                    //   toField: 'customDate1', fromField: 'startDate', entity: 'jobSubmission', transform: 'setDate',\\n                    // },\\n                    // -  Leonardo Ariel Salatino - 23-08-23 - Support #208\\n                    // +  Leonardo Ariel Salatino - 24-07-15 - Support #663\\n                    // +  Leonardo Ariel Salatino - 24-10-10 - Support #829\\n                    // Re enabled the removed code from #663\\n                    {\\n                        toField: 'dateEnd',\\n                        fromField: 'endDate',\\n                        entity: 'jobSubmission',\\n                        transform: 'setDate',\\n                    },\\n                    // -  Leonardo Ariel Salatino - 24-10-10 - Support #829\\n                    // -  Leonardo Ariel Salatino - 24-07-15 - Support #663\\n                    // +  Leonardo Ariel Salatino - 23-08-23 - Support #208\\n                    // {\\n                    //   toField: 'customDate2', fromField: 'endDate', entity: 'jobSubmission', transform: 'setDate',\\n                    // },\\n                    // -  Leonardo Ariel Salatino - 23-08-23 - Support #208\\n                    {\\n                        toField: 'customText42',\\n                        fromField: 'sendingUser',\\n                        entity: 'jobSubmission',\\n                        transform: 'toCustomPickerInternal',\\n                    },\\n                    // +  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n                    {\\n                        toField: 'timeAndExpense.timeAndExpenseBranch',\\n                        fromField: 'customText16',\\n                        entity: 'jobOrder.billingProfile',\\n                        transform: 'overrideTimeAndExpenseBranch',\\n                    },\\n                    // +  SOLEN-8919 - Re-point T&E Branch source to customText16 and add Rounding Rule flowdown\\n                    {\\n                        toField: 'timeAndExpense.rounding',\\n                        fromField: 'customText17',\\n                        entity: 'jobOrder.billingProfile',\\n                        transform: 'copyRoundingRule',\\n                    },\\n                    // -  SOLEN-8919\\n                    // -  1218 Global - Leonardo Ariel Salatino - 25-02-26 - Support #955\\n                    // +  Leonardo Ariel Salatino - 23-05-15 - Support #17\\n                    {\\n                        toField: 'customTextBlock10',\\n                        fromField: 'id',\\n                        entity: 'jobOrder',\\n                        transform: 'specialtiesToText',\\n                    },\\n                    // -  Leonardo Ariel Salatino - 23-05-15 - Support #17\\n                    // +  Leonardo Ariel Salatino - 23-06-23 - Support #172\\n                    // { toField: 'customText8', fromField: 'customText8', entity: 'jobOrder.billingProfile' },\\n                    // -  Leonardo Ariel Salatino - 23-06-23 - Support #172\\n                    // + David Adams - 8-1-2023 - Support #111\\n                    {\\n                        toField: 'timeAndExpense.timeAndExpenseSource',\\n                        fromField: 'customText2',\\n                        entity: 'jobOrder.billingProfile',\\n                        transform: 'toTimeAndExpenseSource',\\n                    },\\n                    // - David Adams - 8-1-2023 - Support #111\\n                    // +  David Adams - 08/23/23 - Support #187\\n                    {\\n                        toField: 'customTextBlock6',\\n                        fromField: 'address',\\n                        entity: 'jobOrder.clientCorporation',\\n                        transform: 'toPlacementAddress',\\n                    },\\n                    // -  David Adams - 08/23/23 - Support #187\\n                    // +  David Adams - 08/23/23 - Support #182\\n                    {\\n                        toField: 'customDate4',\\n                        fromField: 'customDate1',\\n                        entity: 'jobSubmission',\\n                        transform: 'setUTCDate',\\n                    },\\n                    // -  David Adams - 08/23/23 - Support #182\\n                    {\\n                        toField: 'customText30',\\n                        fromField: 'address',\\n                        entity: 'jobOrder.location',\\n                        transform: 'addressPullState',\\n                    },\\n                    {\\n                        toField: 'customText56',\\n                        fromField: 'customText5',\\n                        entity: 'jobOrder',\\n                    },\\n                    {\\n                        toField: 'customText57',\\n                        fromField: 'customText6',\\n                        entity: 'jobOrder',\\n                    },\\n                    {\\n                        toField: 'customText56',\\n                        fromField: 'customText5',\\n                        entity: 'jobOrder',\\n                    },\\n                ],\\n            },\\n            init: () => {\\n                console.log('Entering Placementdefaultsonadd');\\n                const changedEntities = (form.data[0].data) ? form.data[0].data[0] : form.data[0];\\n                const placementChange = changedEntities.find((el) => el.changedEntityType === 'Placement');\\n                const entityId = placementChange ? placementChange.changedEntityId : null;\\n                if (!entityId) {\\n                    return form;\\n                }\\n                const changeObject = {\\n                    id: entityId,\\n                };\\n                return app.getFlowDownData(entityId).then((data) => {\\n                    const promises = app.setFlowDownData(data, changeObject);\\n                    return Promise.all(promises).then(() => {\\n                        return app.commitChanges(changeObject).then(() => {\\n                            console.log('Leaving Placementdefaultsonadd');\\n                            return Promise.resolve(form);\\n                        });\\n                    });\\n                });\\n            },\\n            commitChanges: (changeObject) => {\\n                const url = `${API.http.restURL}entity/Placement/${changeObject.id}`;\\n                return API.http.post(url, changeObject).toPromise();\\n            },\\n            getFlowDownData(entity) {\\n                if (!entity) {\\n                    return Promise.resolve(null);\\n                }\\n                const fields = {};\\n                app.FlowDownConfig.fieldMap.forEach((field) => {\\n                    const entityName = (field.entity) ? field.entity : 'PARENT';\\n                    if (fields[entityName]) {\\n                        fields[entityName].push(field.fromField);\\n                    }\\n                    else {\\n                        fields[entityName] = [field.fromField];\\n                    }\\n                });\\n                const efields = {};\\n                let fieldStr = '';\\n                Object.keys(fields).forEach((key) => {\\n                    const uFields = fields[key].sort().filter((el, i, a) => {\\n                        return !i || el !== a[i - 1];\\n                    });\\n                    const keyArr = key.split('.');\\n                    if (!efields[keyArr[0]]) {\\n                        efields[keyArr[0]] = [];\\n                    }\\n                    if (keyArr.length > 1) {\\n                        efields[keyArr[0]].push(`${keyArr[1]}(${uFields.join(',')})`);\\n                    }\\n                    else {\\n                        efields[keyArr[0]].push(...uFields);\\n                    }\\n                });\\n                Object.keys(efields).forEach((key) => {\\n                    fieldStr = (fieldStr !== '') ? `${fieldStr},` : '';\\n                    if (key === 'PARENT') {\\n                        fieldStr = `${fieldStr}${efields[key].join(',')}`;\\n                    }\\n                    else {\\n                        fieldStr = `${fieldStr}${key}(${efields[key].join(',')})`;\\n                    }\\n                });\\n                const url = `${API.http.restURL}entity/${app.FlowDownConfig.flowFromEntity}/${entity}?fields=${fieldStr}`;\\n                return API.http.get(url).toPromise().then((response) => {\\n                    return Promise.resolve(response.data);\\n                });\\n            },\\n            setFlowDownData: (data, changeObject) => {\\n                const promises = [];\\n                if (!data) {\\n                    return promises;\\n                }\\n                app.FlowDownConfig.fieldMap.forEach((item) => {\\n                    if (!item.transform) {\\n                        const fromValue = transformFuntions.getValue(item, data);\\n                        transformFuntions.setValue(item.toField, changeObject, (fromValue) || '');\\n                        return;\\n                    }\\n                    promises.push(transformFuntions[item.transform](item, data, changeObject));\\n                });\\n                return promises;\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1782984891030},{\"id\":4503,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":18813622,\"firstName\":\"interactionapiuser.ingenovis\",\"lastName\":\"ingenovishealth\"},\"name\":\"1218G. Submission Validations\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            // + 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\n            // SUBMISSION_DETAILS_FIELDS: 'status',\\n            SUBMISSION_DETAILS_FIELDS: 'status,customText10',\\n            // - 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\n            validateSubmission() {\\n                return new Promise((resolve) => {\\n                    let submissionId = null;\\n                    const isMassUpdate = API.pageContext === '';\\n                    switch (API.pageContext) {\\n                        case '': // Change Status (Mass Update)\\n                        case 'MoveToConfirmed':\\n                        case 'MoveToInterviewing':\\n                        case 'MoveToRejected':\\n                        case 'MoveToClientSubmission': {\\n                            submissionId = API.currentEntityId;\\n                            break;\\n                        }\\n                        default: {\\n                            const pageContextName = 'selected';\\n                            if (API.pageContext[pageContextName]) {\\n                                submissionId = API.pageContext[pageContextName][0].id;\\n                            }\\n                            break;\\n                        }\\n                    }\\n                    if (submissionId !== undefined && submissionId !== null && submissionId !== '') {\\n                        if (isMassUpdate) {\\n                            const entityIds = submissionId.split(',').map((id) => {\\n                                return id.trim();\\n                            });\\n                            const validationPromises = entityIds.map((id) => {\\n                                return app.getSubmissionDetails(id);\\n                            });\\n                            return Promise.all(validationPromises).then((submissions) => {\\n                                const hasOfferAccepted = submissions.some((submission) => {\\n                                    return submission.status === 'Offer Accepted';\\n                                });\\n                                if (hasOfferAccepted) {\\n                                    form.isFormValid = false;\\n                                    form.errorMessage = 'One or more Offer Accepted Submissions cannot be moved';\\n                                }\\n                                return resolve(form.errorMessage);\\n                            }).catch((err) => {\\n                                console.error('Error validating submissions:', err);\\n                                return resolve(null);\\n                            });\\n                        }\\n                        return app.getSubmissionDetails(submissionId).then((submission) => {\\n                            // + 1218 Global  -  Leonardo Ariel Salatino - 24-07-26 - Support #617\\n                            // Offer Accepted is now the Match status when the Placement is being created\\n                            // if (submission.status === 'Placed') {\\n                            //     form.errorMessage = 'Placed Submissions cannot be moved';\\n                            if (submission.status === 'Offer Accepted') {\\n                                form.errorMessage = 'Offer Accepted Submissions cannot be moved';\\n                                // - 1218 Global  -  Leonardo Ariel Salatino - 24-07-26 - Support #617\\n                            }\\n                            // - 1218 Global  -  Leonardo Ariel Salatino - 23-07-18 - Support #209\\n                            if (form.errorMessage) {\\n                                form.isFormValid = false;\\n                            }\\n                            return resolve(form.errorMessage);\\n                        });\\n                    }\\n                    return resolve(null);\\n                });\\n            },\\n            getSubmissionDetails(ID) {\\n                const url = `${app.baseUrl}/query/JobSubmission?fields=${app.SUBMISSION_DETAILS_FIELDS}&where=id=${ID}`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    return Promise.resolve(result.data[0]);\\n                }, (err) => {\\n                    console.error(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && form.isFormValid === true) {\\n            if (API.pageContext !== 'MoveToPlacement') {\\n                return app.validateSubmission();\\n            }\\n        }\\n        return Promise.resolve();\",\"sortOrder\":10,\"dateLastModified\":1782984890947},{\"id\":4507,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":18813622,\"firstName\":\"interactionapiuser.ingenovis\",\"lastName\":\"ingenovishealth\"},\"name\":\"validate-candidate-submission-on-linked-jobs-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            statusToValidate: ['Matched', 'Offer Extended', 'Mass Placement Ready'],\\n            submissionStatusesToIgnore: [\\n                'PreS IGH-Declined Cand',\\n                'PreS Cand-Offer Declined',\\n                'PreS Cand-Withdrew Bfr Offer',\\n                'PreS Company-Declined Cand',\\n                'PreS Company-Withdrew Offer',\\n                'PreS IGH-Declined Cand',\\n                'PreS IGH-Missing/Expired Docs',\\n                'PreS IGH-Move to a New Order',\\n                'PreS IGH-Position Pend/Fill',\\n                'PreS Insufficient Test Scores',\\n                'PreS Moved to a New Order',\\n                'PreS Strike Settle-Aftr Notice',\\n                'PreS Strike Settle-Bfr Notice',\\n            ],\\n            jobOrderFields: 'id,correlatedCustomTextBlock1,customText35',\\n            opportunitySearchFields: 'id,correlatedCustomTextBlock1,jobOrders(submissions(status,candidate))',\\n            candidateSearchFields: 'id,status,jobOrder(id,opportunity(correlatedCustomTextBlock1),customText35),candidate',\\n            submission: form.controls,\\n            init: () => {\\n                console.log('validate-candidate-submission-on-linked-jobs-1218');\\n                const isMassUpdate = API.pageContext === '';\\n                if (isMassUpdate && API.currentEntityId) {\\n                    return app.validateMultipleSubmissions();\\n                }\\n                return app.validateSingleSubmission();\\n            },\\n            validateMultipleSubmissions: () => {\\n                const entityIds = API.currentEntityId.split(',').map((id) => {\\n                    return id.trim();\\n                });\\n                const validationPromises = entityIds.map((submissionId) => {\\n                    return app.validateSubmissionById(submissionId);\\n                });\\n                return Promise.all(validationPromises).then((results) => {\\n                    const foundConflict = results.some((result) => {\\n                        return result !== null;\\n                    });\\n                    if (foundConflict) {\\n                        form.isFormValid = false;\\n                        form.errorMessage = 'One or more candidates are already matched to jobs with linked opportunities';\\n                    }\\n                    return form;\\n                });\\n            },\\n            validateSubmissionById: (submissionId) => {\\n                const submissionUrl = `${API.http.restURL}entity/JobSubmission/${submissionId}?fields=id,status,candidate,jobOrder`;\\n                return API.http.get(submissionUrl).toPromise().then((submissionResult) => {\\n                    const status = submissionResult.data.status;\\n                    if (!app.statusToValidate.includes(status)) {\\n                        return Promise.resolve(null);\\n                    }\\n                    const candidateId = submissionResult.data.candidate.id;\\n                    const jobId = submissionResult.data.jobOrder.id;\\n                    return app.candidateMatches(candidateId).then((matches) => {\\n                        if (!matches || matches.length === 0) {\\n                            return Promise.resolve(null);\\n                        }\\n                        return app.getCurrentJobdata(jobId).then((jobData) => {\\n                            const customText35Value = jobData.customText35;\\n                            if (!customText35Value) {\\n                                return Promise.resolve(null);\\n                            }\\n                            return app.getCurrentJobOpportunity(customText35Value).then((opportunityData) => {\\n                                const foundMatch = matches.some((match) => {\\n                                    if (!opportunityData || !opportunityData.correlatedCustomTextBlock1) {\\n                                        return false;\\n                                    }\\n                                    return opportunityData.correlatedCustomTextBlock1.some((item) => {\\n                                        const parts = item.split(' | ');\\n                                        return parts.length > 1 && parts[1] === match.jobOrder.customText35 && app.submissionStatusesToIgnore.indexOf(match.status) === -1;\\n                                    });\\n                                });\\n                                return foundMatch ? customText35Value : null;\\n                            });\\n                        });\\n                    });\\n                }).catch((err) => {\\n                    console.log('Error validating submission:', err);\\n                    return null;\\n                });\\n            },\\n            validateSingleSubmission: () => {\\n                const status = form.controls.status.value;\\n                if (!app.statusToValidate.includes(status)) {\\n                    return Promise.resolve(form);\\n                }\\n                let candidate;\\n                if (API.currentEntityId === '' || API.currentEntityId == null || API.currentEntityId === undefined) {\\n                    candidate = app.submission.candidate.value[0];\\n                }\\n                else {\\n                    candidate = app.submission.candidate.value;\\n                }\\n                if (!candidate) {\\n                    return Promise.resolve(form);\\n                }\\n                return app.candidateMatches(candidate.id).then(app.checkMatches);\\n            },\\n            candidateMatches: (candidateId) => {\\n                if (!candidateId) {\\n                    return Promise.resolve(null);\\n                }\\n                const url = 'query/JobSubmission';\\n                const payload = {\\n                    fields: app.candidateSearchFields,\\n                    where: `candidate.id=${candidateId} AND isDeleted=false`,\\n                    count: 100,\\n                };\\n                return API.appBridge.httpPOST(url, payload).then((result) => {\\n                    return Promise.resolve(result.data.data);\\n                });\\n            },\\n            checkMatches: (matches) => {\\n                return new Promise((resolve) => {\\n                    if (!matches || matches.length === 0) {\\n                        return resolve(form);\\n                    }\\n                    const jobID = app.submission.jobOrder.value.id || app.submission.jobOrder.value[0].id;\\n                    return app.getCurrentJobdata(jobID).then((jobData) => {\\n                        const customText35Value = jobData.customText35;\\n                        if (!customText35Value) {\\n                            console.warn('customText35 is missing from jobData');\\n                            return resolve(form);\\n                        }\\n                        return app.getCurrentJobOpportunity(customText35Value).then((opportunityData) => {\\n                            const foundMatch = matches.some((match) => {\\n                                if (!opportunityData || !opportunityData.correlatedCustomTextBlock1) {\\n                                    return false;\\n                                }\\n                                return opportunityData.correlatedCustomTextBlock1.some((item) => {\\n                                    const parts = item.split(' | ');\\n                                    return parts.length > 1 && parts[1] === match.jobOrder.customText35 && app.submissionStatusesToIgnore.indexOf(match.status) === -1;\\n                                });\\n                            });\\n                            if (foundMatch) {\\n                                form.isFormValid = false;\\n                                form.errorMessage = `Candidate already matched to job with linked opportunity ID ${customText35Value}`;\\n                            }\\n                            return resolve(form);\\n                        });\\n                    });\\n                });\\n            },\\n            getCurrentJobOpportunity: (opportunityID) => {\\n                if (!opportunityID) {\\n                    return Promise.resolve(null);\\n                }\\n                const url = `entity/Opportunity/${opportunityID}?fields=correlatedCustomTextBlock1`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    return Promise.resolve(result.data.data);\\n                });\\n            },\\n            getCurrentJobdata: (jobID) => {\\n                if (!jobID) {\\n                    return Promise.resolve(null);\\n                }\\n                const url = `entity/JobOrder/${jobID}?fields=${app.jobOrderFields}`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    return Promise.resolve(result.data.data);\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return Promise.resolve(true);\",\"sortOrder\":20,\"dateLastModified\":1782984891087},{\"id\":4278,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"fill-portal-uploader-copy-with-portal-uploader-value-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            portalUploaderField: 'customText1',\\n            portalUploaderFieldCopy: 'customTextBlock7',\\n            init: () => {\\n                console.log('fill-portal-uploader-copy-with-portal-uploader-value');\\n                if (form.data\\n                    && form.data.customText1) {\\n                    form.data[app.portalUploaderFieldCopy] = form.data.customText1;\\n                    return form;\\n                }\\n                return form;\\n            },\\n        };\\n        if (API.currentEntity === 'PlacementCertification') {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":20,\"dateLastModified\":1763366225937},{\"id\":4279,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2256,\"firstName\":\"Leonardo\",\"lastName\":\"Salatino\"},\"name\":\"1218G- Candidate validations on placement Approval\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\r\\n            placementId: API.currentEntityId,\\r\\n            statusToCheck: 'Approved',\\r\\n            errorMessage: '',\\r\\n            addressFieldsToCheck: [\\r\\n                {\\r\\n                    field: 'address1',\\r\\n                    label: 'address',\\r\\n                },\\r\\n                {\\r\\n                    field: 'city',\\r\\n                    label: 'city',\\r\\n                },\\r\\n                {\\r\\n                    field: 'state',\\r\\n                    label: 'state',\\r\\n                },\\r\\n                {\\r\\n                    field: 'zip',\\r\\n                    label: 'zip',\\r\\n                },\\r\\n                {\\r\\n                    field: 'countryID',\\r\\n                    label: 'Country',\\r\\n                },\\r\\n            ],\\r\\n            candidateFieldsToCheck: [\\r\\n                'ssn',\\r\\n                'dateOfBirth',\\r\\n                'address(address1,city,state,zip,countryID)',\\r\\n            ],\\r\\n            // Checks if we should run validations\\r\\n            shouldValidationsRun() {\\r\\n                const selectedStatus = form.controls.status.value;\\r\\n                return app.statusToCheck === selectedStatus;\\r\\n            },\\r\\n            getCandidateDetails() {\\r\\n                const url = `${API.http.restURL}/query/Placement?where=id=${app.placementId}&fields=candidate(${app.candidateFieldsToCheck.join(',')})`;\\r\\n                return API.http.get(url).toPromise().then((result) => {\\r\\n                    if (result.data[0].candidate) {\\r\\n                        return Promise.resolve(result.data[0].candidate);\\r\\n                    }\\r\\n                    return Promise.reject(new Error('Cannot get Candidate to run validations on Approval'));\\r\\n                }, (err) => {\\r\\n                    console.error(err);\\r\\n                    return Promise.reject(err);\\r\\n                });\\r\\n            },\\r\\n            runAddressValidation(candidate) {\\r\\n                app.addressFieldsToCheck.forEach((field) => {\\r\\n                    if (candidate.address[field.field] === undefined || candidate.address[field.field] === null || candidate.address[field.field] === '') {\\r\\n                        app.errorMessage += `Please update Candidate ${field.label}.\\\\n`;\\r\\n                    }\\r\\n                });\\r\\n            },\\r\\n            // Run the validations\\r\\n            validate() {\\r\\n                return new Promise((resolve, reject) => {\\r\\n                    return app.getCandidateDetails()\\r\\n                        .then((candidate) => {\\r\\n                        app.candidateFieldsToCheck.forEach((field) => {\\r\\n                            if (field.indexOf('address') === 0) {\\r\\n                                app.runAddressValidation(candidate);\\r\\n                            }\\r\\n                            else if (candidate[field] === undefined || candidate[field] === null || candidate[field] === '') {\\r\\n                                app.errorMessage += `Please update Candidate ${field}.\\\\n`;\\r\\n                            }\\r\\n                        });\\r\\n                        if (app.errorMessage) {\\r\\n                            form.isFormValid = false;\\r\\n                            API.displayToast({\\r\\n                                title: 'Candidate validations on Placement Approval',\\r\\n                                icon: 'caution',\\r\\n                                theme: 'danger',\\r\\n                                position: 'fixedTop',\\r\\n                                hideDelay: 8000,\\r\\n                                message: app.errorMessage,\\r\\n                            });\\r\\n                            form.errorMessage = `CANDIDATE VALIDATIONS ON PLACEMENT APPROVAL\\\\n${app.errorMessage}`;\\r\\n                        }\\r\\n                        return resolve(form.errorMessage);\\r\\n                    })\\r\\n                        .catch((reason) => {\\r\\n                        return reject(reason);\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Placement' && app.shouldValidationsRun() && form.isFormValid === true) {\\r\\n            return app.validate();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":20,\"dateLastModified\":1767792883540},{\"id\":4269,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"update-candidate-working-brand-on-status-change-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            statusField: 'status',\\n            init: () => {\\n                if (!API.currentEntityId) {\\n                    return Promise.resolve();\\n                }\\n                let candidateID;\\n                if (API\\n                    && API.pageDK\\n                    && API.pageDK.config\\n                    && API.pageDK.config.record\\n                    && API.pageDK.config.record.candidate\\n                    && typeof API.pageDK.config.record.candidate.id !== 'undefined') {\\n                    candidateID = API.pageDK.config.record.candidate.id;\\n                }\\n                if (!candidateID) {\\n                    return Promise.resolve();\\n                }\\n                return app.getPlacementData(candidateID).then((placementData) => {\\n                    const brand = app.getBrand(placementData);\\n                    if (!brand) {\\n                        return Promise.resolve(null);\\n                    }\\n                    return app.commitChanges({\\n                        id: candidateID,\\n                        customText17: brand,\\n                    });\\n                });\\n            },\\n            hasFieldChanged: (field) => {\\n                if (!field) {\\n                    return false;\\n                }\\n                return (!field.pristine)\\n                    && (field.valueHistory.length > 1\\n                        && field.valueHistory[0] !== field.valueHistory[field.valueHistory.length - 1]);\\n            },\\n            commitChanges: (changeObject) => {\\n                const url = `${API.http.restURL}entity/Candidate/${changeObject.id}`;\\n                return API.http.post(url, changeObject).toPromise().then(() => {\\n                    console.log('committed');\\n                    return Promise.resolve(null);\\n                }).catch(() => {\\n                    console.error('could not update working brand on candidate');\\n                    return Promise.resolve(null);\\n                });\\n            },\\n            getBrand: (data) => {\\n                if (!data || data.length === 0)\\n                    return null;\\n                if (data.length === 1) {\\n                    return data[0].correlatedCustomText3;\\n                }\\n                const latest = data[0];\\n                const status = form.controls[app.statusField];\\n                if (app.hasFieldChanged(status) && status.value === 'Approved' && latest.id === API.currentEntityId) {\\n                    return latest.correlatedCustomText3;\\n                }\\n                return null;\\n            },\\n            getPlacementData: (candidateID) => {\\n                const query = {\\n                    fields: 'id,status,correlatedCustomText3',\\n                    where: `candidate.id = ${candidateID}`,\\n                    sortBy: '-dateBegin',\\n                    count: 100,\\n                };\\n                const url = `${API.http.restURL}query/Placement`;\\n                return API.http.post(url, query).toPromise().then((response) => {\\n                    return Promise.resolve(response.data);\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'Placement') {\\n            console.log('update-candidate-working-brand-on-status-change-1218');\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":20,\"dateLastModified\":1755680763143},{\"id\":4270,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"update-candidate-working-brand-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            init: () => {\\n                const candidateId = form.data[1].changedEntityId;\\n                console.log('entityId', candidateId);\\n                if (!candidateId) {\\n                    return form;\\n                }\\n                const changeObject = {\\n                    id: candidateId,\\n                    customText17: null,\\n                };\\n                return app.getPlacementData().then((placementData) => {\\n                    if (placementData && placementData.correlatedCustomText3) {\\n                        changeObject.customText17 = placementData.correlatedCustomText3;\\n                    }\\n                    return app.commitChanges(changeObject).then(() => {\\n                        return Promise.resolve(form);\\n                    }).catch(() => {\\n                        console.warn('could not update candidate working brand');\\n                        return Promise.resolve(form);\\n                    });\\n                });\\n            },\\n            commitChanges: (changeObject) => {\\n                const url = `${API.http.restURL}entity/Candidate/${changeObject.id}`;\\n                return API.http.post(url, changeObject).toPromise();\\n            },\\n            getPlacementId: () => {\\n                const dataObj = (form.data[0].data) ? form.data[0].data[0] : form.data[0];\\n                const placementEntity = Array.isArray(dataObj) ? dataObj.find((element) => {\\n                    return element.changedEntityType === 'Placement';\\n                }) : null;\\n                if (!placementEntity) {\\n                    return null;\\n                }\\n                return placementEntity.changedEntityId;\\n            },\\n            getPlacementData: () => {\\n                const placementId = app.getPlacementId();\\n                if (!placementId) {\\n                    Promise.resolve();\\n                }\\n                const url = `${API.http.restURL}entity/Placement/${placementId}?fields=id,correlatedCustomText3`;\\n                return API.http.get(url).toPromise().then((response) => {\\n                    return Promise.resolve(response.data);\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\n            console.log('update-candidate-source-brand-on-placement-creation-1218');\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":20,\"dateLastModified\":1755680763143},{\"id\":4271,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"limit-status-change-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            allowedUserTypes: new Set([\\n                '146357',\\n                '207953',\\n                '207954',\\n                '207955',\\n                '207956',\\n                '123523',\\n            ]),\\n            init: () => {\\n                const status = form.controls.status.value;\\n                if (status === 'Agency Cleared' || status === 'Client Approved') {\\n                    const isEditable = app.allowedUserTypes.has(API.globals.user.userTypeId.toString());\\n                    if (!isEditable && app.hasFieldChanged('status')) {\\n                        form.errorMessage = `Only Credentialing user type is allowed to change the status to ${status}`;\\n                        form.isFormValid = false;\\n                        return form;\\n                    }\\n                }\\n                return form;\\n            },\\n            hasFieldChanged: (field) => {\\n                if (!form.controls[field]) {\\n                    return false;\\n                }\\n                const control = form.controls[field];\\n                return (!control.pristine)\\n                    && (control.valueHistory.length > 1\\n                        && control.valueHistory[0] !== control.valueHistory[control.valueHistory.length - 1]);\\n            },\\n        };\\n        return app.init();\",\"sortOrder\":20,\"dateLastModified\":1756891155317},{\"id\":4039,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2256,\"firstName\":\"Leonardo\",\"lastName\":\"Salatino\"},\"name\":\"1218G. End Date validations\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            TERM_REASONS_ON_END_DATE: [\\r\\n                'Post-Start Candidate Leave Early',\\r\\n                'Post-Start Company Early End',\\r\\n                'Post-Start Company Termination-Clinical',\\r\\n                'Post-Start Company Termination-Prof',\\r\\n                'Post-Start Completed Assignment',\\r\\n                'Post-Start Ingenovis Moved to a New Order',\\r\\n                'Post-Start Insufficient Test Scores',\\r\\n                'Post-Start Missing/Expired Documents',\\r\\n                'Post-Start Traveler No Show',\\r\\n                'Post-Start Violation of Company Policy',\\r\\n                'Post-Start Worker\\\\'s Comp Injury/Illness',\\r\\n            ],\\r\\n            validatePlacement: function () {\\r\\n                return new Promise(function (resolve) {\\r\\n                    var termReason = form.controls.terminationReason;\\r\\n                    var dateEnd = form.controls.dateEnd;\\r\\n                    var status = form.controls.status;\\r\\n                    var dateBegin = form.controls.dateBegin;\\r\\n                    var assignedRecruiter = form.controls.customText43;\\r\\n                    // Actual End Date must be changed if any of the Termination End Reasons\\r\\n                    if (termReason) {\\r\\n                        if (termReason.value !== null && termReason.value !== undefined\\r\\n                            && termReason.value !== termReason.initialValue) {\\r\\n                            if (app.TERM_REASONS_ON_END_DATE.includes(termReason.value)\\r\\n                                && dateEnd.value === dateEnd.initialValue) {\\r\\n                                form.errorMessage = dateEnd.label + \\\" must be changed when this \\\" + termReason.label + \\\" is selected\\\";\\r\\n                            }\\r\\n                        }\\r\\n                    }\\r\\n                    // Placement is changed from Ended to any, Actual End Date must be changed to an End Date in the future\\r\\n                    if (status.value !== status.initialValue\\r\\n                        && status.initialValue === 'Ended') {\\r\\n                        if (dateEnd.value <= dateEnd.initialValue) {\\r\\n                            form.errorMessage = dateEnd.label + \\\" must be changed to a future date when Placement stops being Ended\\\";\\r\\n                        }\\r\\n                    }\\r\\n                    // Start Date cannot be grater or equal to End Date\\r\\n                    if (dateEnd.value <= dateBegin.value) {\\r\\n                        form.errorMessage = dateBegin.label + \\\" cannot be grater or equal to \\\" + dateEnd.label;\\r\\n                    }\\r\\n                    // Assigned Recruiter must contain the character \\\"|\\\"\\r\\n                    if (assignedRecruiter.value !== null && assignedRecruiter.value !== undefined && !assignedRecruiter.value.includes('|')) {\\r\\n                        form.errorMessage = assignedRecruiter.label + \\\" must contain the character \\\\\\\"|\\\\\\\"\\\";\\r\\n                    }\\r\\n                    if (form.errorMessage) {\\r\\n                        form.isFormValid = false;\\r\\n                    }\\r\\n                    return resolve(form.errorMessage);\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Placement' && form.isFormValid === true) {\\r\\n            return app.validatePlacement();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":20,\"dateLastModified\":1708693798267},{\"id\":4254,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2256,\"firstName\":\"Leonardo\",\"lastName\":\"Salatino\"},\"name\":\"1218G-Candidate Actions on Approved\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            FLD_MATCH_ELIG_DT: 'customDate6',\\r\\n            FLD_ORIGINAL_HIRE_DT: 'customDate7',\\r\\n            init: function () {\\r\\n                return new Promise(function (resolve) {\\r\\n                    var status = form.controls.status;\\r\\n                    if (status.valueHistory) {\\r\\n                        if (status.value !== status.valueHistory[0] && status.value === 'Approved') {\\r\\n                            return app.getCandidate(API.currentEntityId).then(function (placement) {\\r\\n                                if (placement.candidate) {\\r\\n                                    if (placement.candidate.id) {\\r\\n                                        if (placement.candidate[app.FLD_MATCH_ELIG_DT] === null || placement.candidate[app.FLD_MATCH_ELIG_DT] === undefined) {\\r\\n                                            var matchEligDate = void 0;\\r\\n                                            if (placement.candidate[app.FLD_ORIGINAL_HIRE_DT] === null || placement.candidate[app.FLD_ORIGINAL_HIRE_DT] === undefined) {\\r\\n                                                matchEligDate = new Date(form.controls.dateBegin.value);\\r\\n                                            }\\r\\n                                            else {\\r\\n                                                matchEligDate = new Date(placement.candidate[app.FLD_ORIGINAL_HIRE_DT]);\\r\\n                                            }\\r\\n                                            var monthsToAdd = matchEligDate.getDate() === 1 ? 0 : 1;\\r\\n                                            matchEligDate.setFullYear(matchEligDate.getFullYear() + 1, matchEligDate.getMonth() + monthsToAdd, 1);\\r\\n                                            matchEligDate.setHours(12);\\r\\n                                            return app.setCandidateMatchEligibleDate(placement.candidate.id, matchEligDate.getTime()).then(function () {\\r\\n                                                return resolve(null);\\r\\n                                            });\\r\\n                                        }\\r\\n                                    }\\r\\n                                    else {\\r\\n                                        console.error('Candidate Actions on Approved: Cannot get Candidate ID');\\r\\n                                    }\\r\\n                                }\\r\\n                                else {\\r\\n                                    console.error('Candidate Actions on Approved: Cannot get Candidate');\\r\\n                                }\\r\\n                                return resolve(null);\\r\\n                            });\\r\\n                        }\\r\\n                    }\\r\\n                    return resolve(null);\\r\\n                });\\r\\n            },\\r\\n            getCandidate: function (placementId) {\\r\\n                var url = app.baseUrl + \\\"/entity/Placement/\\\" + placementId + \\\"?fields=candidate(id,\\\" + app.FLD_MATCH_ELIG_DT + \\\",\\\" + app.FLD_ORIGINAL_HIRE_DT + \\\")\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data);\\r\\n                }, function (err) {\\r\\n                    console.error(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n            setCandidateMatchEligibleDate: function (candId, eligDate) {\\r\\n                var _a;\\r\\n                var url = app.baseUrl + \\\"/entity/Candidate/\\\" + candId;\\r\\n                return API.http.post(url, (_a = {},\\r\\n                    _a[app.FLD_MATCH_ELIG_DT] = eligDate,\\r\\n                    _a)).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result);\\r\\n                }, function (err) {\\r\\n                    console.error(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Placement') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":30,\"dateLastModified\":1738609770107},{\"id\":4030,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":19193534,\"firstName\":\"Zwelithini\",\"lastName\":\"Mphanza\"},\"name\":\"59-update-customDate2-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            baseUrl: API.http.restURL,\\n            init() {\\n                return new Promise((resolve) => {\\n                    // +  Leonardo Ariel Salatino - 23-06-30 - Support #153\\n                    let JobSubmissionId = API.currentEntityId;\\n                    let Status = form.data.status;\\n                    // Get data in different way for: Page Context = MoveToClientSubmission\\n                    if (JobSubmissionId === undefined || JobSubmissionId === null || JobSubmissionId === '') {\\n                        if (API.pageContext['selected']) {\\n                            JobSubmissionId = API.pageContext['selected'][0].id;\\n                        }\\n                    }\\n                    if (Status === undefined || Status === null || Status === '') {\\n                        if (API.pageContext['selected']) {\\n                            Status = API.pageContext['selected'][0].status;\\n                        }\\n                    }\\n                    if (API.pageContext === 'MoveToClientSubmission') {\\n                        Status = 'DoChangeMeNow';\\n                    }\\n                    // Set the date\\n                    if (JobSubmissionId !== undefined && JobSubmissionId !== null && JobSubmissionId !== '') {\\n                        if (Status !== undefined && Status !== null && Status !== '') {\\n                            app.getDetails(JobSubmissionId).then((result) => {\\n                                if (result.status !== Status) {\\n                                    // -  Leonardo Ariel Salatino - 23-06-30 - Support #153\\n                                    API.appBridge.httpPOST(`entity/JobSubmission/${JobSubmissionId}`, {\\n                                        // +  Leonardo Ariel Salatino - 23-05-15 - Support #153\\n                                        // customDate2: result.dateLastModified,\\n                                        customDate2: new Date().getTime(),\\n                                    }).then(() => {\\n                                        console.log('Update Done');\\n                                    });\\n                                }\\n                            });\\n                        }\\n                    }\\n                    resolve(null);\\n                });\\n            },\\n            getDetails(ID) {\\n                const url = `${app.baseUrl}/query/JobSubmission?fields=id,status,dateLastModified&where=id=${ID}`;\\n                return API.http.get(url).toPromise().then((result) => {\\n                    return Promise.resolve(result.data[0]);\\n                }, (err) => {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && form.isFormValid === true\\n            // +  Leonardo Ariel Salatino - 23-05-15 - Support #153\\n            && API.pageContext !== 'Record'\\n        // -  Leonardo Ariel Salatino - 23-05-15 - Support #153\\n        ) {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":90,\"dateLastModified\":1757419237323}]}"
