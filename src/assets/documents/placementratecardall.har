    float1: dealsheet.callBackPayRate || 0,\\n                            float2: dealsheet.DealSheetJob.callBackBillRate || 0 // job rates\\n                        },\\n                        {\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\"Holiday Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.hourlyPayRate || 0,\\n                            float2: dealsheet.DealSheetJob.holidayBill || 0 // job rates\\n                        },\\n                        {\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\"Charge Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.chargeBack || 0,\\n                            float2: dealsheet.DealSheetJob.chargeBillRate || 0 // job rates\\n                        }\\n                    ];\\n                    if (dealsheet.payRate8 && dealsheet.payRate8.length) {\\n                        rates.push({\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\">8 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate8 || 0,\\n                            float2: otBillRate8 || 0 // job rates\\n                        });\\n                    }\\n                    if (dealsheet.payRate12 && dealsheet.payRate12.length) {\\n                        rates.push({\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\">12 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate12 || 0,\\n                            float2: otBillRate12 || 0 // job rates\\n                        });\\n                    }\\n                    if (dealsheet.payRate40 && dealsheet.payRate40.length) {\\n                        rates.push({\\n                            text1: \\\"Hourly\\\",\\n                            text2: \\\">40 Hours Rate\\\",\\n                            text3: \\\"Hours\\\",\\n                            text4: \\\"TBD\\\",\\n                            text5: \\\"Hourly\\\",\\n                            text6: \\\"Hourly\\\",\\n                            text9: \\\"No\\\",\\n                            date2: placement.dateBegin,\\n                            date3: placement.dateBegin,\\n                            float1: dealsheet.payRate40 || 0,\\n                            float2: otBillRate40 || 0 // job rates\\n                        });\\n                    }\\n                    i