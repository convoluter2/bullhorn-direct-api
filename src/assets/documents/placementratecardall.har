e]\\n                    //   }\\n                    // )\\n                    placementRateCardLineGroups = placementRateCardLineGroups.filter(function (placementRateCardLineGroup) {\\n                        var lines = placementRateCardLineGroup.placementRateCardLines.filter(function (placementRateCardLine) {\\n                            return placementRateCardLine.earnCode.id;\\n                        });\\n                        return lines.length === placementRateCardLineGroup.placementRateCardLines.length;\\n                    });\\n                    var rateObject = {\\n                        placement: { id: placement.id },\\n                        placementRateCardLineGroups: placementRateCardLineGroups,\\n                        effectiveDate: rateEffectiveDate\\n                    };\\n                    console.log(\\\"Newbury copy DS to placement: rateObject\\\", rateObject);\\n                    var placementRateCardLineGroupsAsObject = {};\\n                    var placementRateCardLinesAsObject = {};\\n                    placementRateCardLineGroups.forEach(function (item) {\\n                        placementRateCardLineGroupsAsObject[item.earnCodeGroup.id] = item;\\n                        item.placementRateCardLines.forEach(function (placementRateCardLine) {\\n                            placementRateCardLinesAsObject[placementRateCardLine.earnCode.id] = placementRateCardLine;\\n                        });\\n                    });\\n                    console.log(\\\"placementRateCardLinesAsObject\\\", placementRateCardLinesAsObject);\\n                    console.log(\\\"placementRateCardLineGroupsAsObject\\\", placementRateCardLineGroupsAsObject);\\n                    console.log(\\\"updatedVersion earnCodesToBeRemoved\\\", earnCodesToBeRemoved);\\n                    controller.getBasicVersionIds(placement.id, placementRateCardStatus).then(function (existingPlacementRateCard) {\\n                        console.log(\\\"existingPlacementRateCard\\\", existingPlacementRateCard);\\n                        if (existingPlacementRateCard.length) {\\n                            var item_1 = existingPlacementRateCard[0].versions.data.find(function (item) {\\n                                var date1 = new Date(item.effectiveDate + \\\" 12:00\\\");\\n                                var date2 = new Date(rateEffectiveDate + \\\" 12:00\\\");\\n                                return date1.getFullYear() === date2.getFullYear() && date1.getMonth() === date2.getMonth() && date1.getDate() === date2.getDate();\\n                            });\\n                            if (item_1) {\\n                                console.log(\\\"UPDATING EXISTING VERSION\\\");\\n                                controller.getCurrentVersion(existingPlacementRateCard[0].id, item_1.effectiveDate).then(function (version) {\\n                                    var updatedVersion = {\\n                                        id: existingPlacementRateCard[0].id,\\n                                        placement: { id: placement.id },\\n                                        placementRateCardLineGroups: [],\\n                                        versionID: item_1.id,\\n                                    };\\n                                    var existingLineGroups = [];\\n                                    console.log(\\\"version\\\", version);\\n                                    console.log(\\\"placementRateCardLineGroupsAsObject\\\", placementRateCardLineGroupsAsObject);\\n                                    console.log(\\\"placementRateCardLinesAsObject\\\", placementRateCardLinesAsObject);\\n                                    version.placementRateCardLineGroups.data.forEach(function (placementRateCardLineGroup) {\\n                                        existingLineGroups.push(placementRateCardLineGroup.earnCodeGroup.id);\\n                                        if (placementRateCardLineGroupsAsObject[p