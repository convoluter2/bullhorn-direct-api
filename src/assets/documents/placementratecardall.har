                       }),\\n                                            });\\n                                        }\\n                                        else {\\n                                            console.log(\\\"GROUP DOESNT USED FOR DS\\\");\\n                                            updatedVersion.placementRateCardLineGroups.push({\\n                                                id: placementRateCardLineGroup.id,\\n                                                earnCodeGroup: { id: placementRateCardLineGroup.earnCodeGroup.id },\\n                                                isBase: placementRateCardLineGroup.isBase,\\n                                                placementRateCardLines: placementRateCardLineGroup.placementRateCardLines.data.map(function (item) {\\n                                                    return {\\n                                                        alias: item.alias,\\n                                                        billMultiplier: item.billMultiplier,\\n                                                        billRate: item.billRate,\\n                                                        earnCode: { id: item.earnCode.id },\\n                                                        id: item.id,\\n                                                        markupPercent: item.markupPercent,\\n                                                        markupValue: item.markupValue,\\n                                                        payMultiplier: item.payMultiplier,\\n                                                        payRate: item.payRate,\\n                                                    };\\n                                                }),\\n                                            });\\n                                        }\\n                                    });\\n                                    var newGroups = placementRateCardLineGroups.filter(function (item) { return existingLineGroups.indexOf(item.earnCodeGroup.id) === -1; });\\n                                    updatedVersion.placementRateCardLineGroups = updatedVersion.placementRateCardLineGroups.concat(newGroups);\\n                                    updatedVersion.placementRateCardLineGroups = updatedVersion.placementRateCardLineGroups.filter(function (item) { return !earnCodesToBeRemoved[item.earnCodeGroup.id]; });\\n                                    controller.updateExisitngPlacementRateCard(updatedVersion, existingPlacementRateCard[0].id).then(function () {\\n                                        console.log(\\\"Newbury copy DS to placement: saving rates done\\\");\\n                                        resolve(null);\\n                                    });\\n                                });\\n                            }\\n                            else {\\n                                console.log(\\\"INSERTING NEW VERSION\\\");\\n                                controller.insertNewVersion(rateObject, existingPlacementRateCard[0].id).then(function () {\\n                                    console.log(\\\"Newbury copy DS to placement: saving rates done\\\");\\n                                    resolve(null);\\n                                });\\n                            }\\n                        }\\n                        else {\\n                            console.log(\\\"add NEW RECORD\\\");\\n                            controller.saveRateBH1(rateObject).then(function () {\\n                                console.log(\\\"Newbury copy DS to placement: saving rates done\\\");\\n                                resolve(null);\\n                            });\\n                        }\\n                    });\\n                    // controller.saveRateBH1(rateObject).then(function(){\\n                    //     console.log(\\\"Newbury copy DS to placement: saving rates done\\\")\\n                    //     resolve(null)        \\n                    // })\\n                });\\n            },\\n            getHighLevelSettings: function () {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/highLevelSettings/highLevelSettings/read?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    fetch(url, {\\n                        method: 'get',\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: highLevelSettings', data);\\n                        resolve(data);\\n                    });\\n                });\\n            },\\n            getPlacementRateCardStatus: function () {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"query/PlacementRateCardStatusLookup?where=id>0\\\" + \\\"&fields=id,label&count=500\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        if (API.appBridge)\\n                            resolve(result.data.data);\\n                        else\\n                            resolve(result.data);\\n                    });\\n                });\\n            },\\n            copyDealsheetDataToPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    controller.getPlacement(id).then(function (placement) {\\n                        console.log(\\\"Newbury copy DS to placement: placement Object\\\", placement);\\n                        if (placement[controller.dealsheetPathAtPlacement] && placement[controller.dealsheetPathAtPlacement].length) {\\n                            Promise.all([\\n                                controller.getJob(placement.jobOrder.id),\\n                                controller.getDealsheet(placement[controller.dealsheetPathAtPlacement]),\\n                       