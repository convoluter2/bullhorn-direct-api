te = advancedStateIndex > -1 ? Number(dealsheet.payRate8) || 0 : Number(dealsheet[\\\"payRate40\\\"]) || 0;\\n                                doubleTimeRate = advancedStateIndex > -1 ? Number(dealsheet.payRate12) || 0 : 2 * dealsheet.regularPay;\\n                                if (dealsheet.DealSheetJob.jobState === \\\"Colorado\\\") {\\n                                    overTimePayRate = dealsheet.payRate12;\\n                                }\\n                                dealsheet.benefits = dealsheet.benefits && dealsheet.benefits.length ? dealsheet.benefits.split(\\\",\\\") : [];\\n                                var selectedBenefits = healthBenefits.filter(function (item) {\\n                                    return dealsheet.benefits.indexOf(item.fieldId.toString()) > -1;\\n                                });\\n                                console.log(\\\"Newbury copy DS to placement: selectedBenefits\\\", selectedBenefits);\\n                                if (placement.employmentType !== \\\"PRN\\\") {\\n                                    if (+dealsheet.DealSheetJob.shifts === 3) {\\n                                        customText9 = \\\"3 Scheduled Shifts per Week\\\";\\n                                    }\\n                                    else if (+dealsheet.DealSheetJob.shifts === 4) {\\n                                        customText9 = \\\"4 Scheduled Shifts per Week\\\";\\n                                    }\\n                                    else if (+dealsheet.DealSheetJob.shifts === 5) {\\n                                        customText9 = \\\"5 Scheduled Shifts per Week\\\";\\n                                    }\\n                                }\\n                                else {\\n                                    customText9 = \\\"PRN Days Worked\\\";\\n                                }\\n                                var body = {\\n                                    customTextBlock3: dealsheet.DealSheetCandidate.preApprovedTimeOff ? dealsheet.DealSheetCandidate.preApprovedTimeOff.slice(0, 100) : \\\"\\\",\\n                                    customPayRate7: (dealsheet.lodgingWeekly / 7).toFixed(2),\\n                                    customPayRate10: (dealsheet.miWeekly / 7).toFixed(2),\\n                                    dateBegin: new Date(dealsheet.DealSheetCandidate.startDate).setHours(12),\\n                                    dateEnd: new Date(dealsheet.DealSheetCandidate.endDate).setHours(12),\\n                                    durationWeeks: dealsheet.DealSheetJob.contractLengthWeeks,\\n                                    correlatedCustomFloat3: dealsheet.DealSheetJob.scheduledHours,\\n                                    correlatedCustomInt1: parseInt(dealsheet.DealSheetJob.shifts),\\n                                    customText39: dealsheet.DealSheetClient.shiftDetails,\\n                                    customInt2: parseInt(dealsheet.DealSheetClient.nonBillableOrientationHours),\\n                                    customFloat4: dealsheet.DealSheetClient.vmsFeePercentage,\\n                                    customFloat5: dealsheet.grossMarginPercentage,\\n                                    customText9: customText9,\\n                                    payRate: dealsheet.regularPay,\\n                                    clientBillRate: dealsheet.DealSheetJob.billRate\\n                                };\\n                                if (API.globals.user.stopUpdatingStartAndEndDate) {\\n                                    delete body.customText9;\\n                                }\\n                                if (dealsheet.dealOrExtension !== \\\"Deal\\\") {\\n                                    delete body.dateBegin;\\n                                    delete body.correlatedCustomFloat3;\\n                                    delete body.correlatedCustomInt1;\\n                                    delete body.customText39;\\n                                    delete body.customInt2;\\n                                    delete body.customFloat4;\\n                                    delete body.customFloat5;\\n                                }\\n                                controller.updatePlacement(id, body).then(function (result) {\\n                                    console.log(\\\"Newbury copy DS to placement: save placement result\\\", result);\\n                                    // controller.addRateObjects(dealsheet,placement).then(function(result2){\\n                                    controller.buildRateObjectBH1(dealsheet, earnCodes, placement, overTimePayRate, doubleTimeRate, placementRateCardStatus, advancedStateIndex, billingTerm).then(function (result3) {\\n                                        resolve();\\n                                    });\\n                                    // })\\n                                });\\n                            });\\n                        }\\n                        else {\\n                            resolve();\\n                        }\\n                    });\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            console.log(\\\"Newbury copy DS to placement: API\\\", API);\\n            console.log(\\\"Newbury copy DS to placement: form\\\", form);\\n            var data;\\n            if (Array.isArray(form.data[0].data))\\n                data = form.data[0].data[0];\\n            else if (Array.isArray(form.data[0]))\\n                data = form.data[0];\\n            else\\n                data = form.data[1].data[0];\\n            var placementId = data.filter(function (item) { return item.changedEntityType === \\\"Placement\\\"; })[0].changedEntityId;\\n            console.log(\\\"Newbury copy DS to placement: placementId\\\", placementId);\\n            if (placementId) {\\n                return controller.copyDealsheetDataToPlacement(placementId);\\n            }\\n        }\\n        else {\\n            return;\\n        }\",\"sortOrder\":10,\"dateLastModified\":1764071348687},{\"id\":403,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"prevent-duplicate-pcr-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            init: function () {\\r\\n                return app.findOtherPcrs().then(function (pcrList) {\\r\\n                    if (pcrList.length > 0) {\\r\\n                        form.isFormValid = false;\\r\\n                        form.errorMessage = 'There can not be more than one Change Request on this Placement.';\\r\\n                    }\\r\\n                });\\r\\n            },\\r\\n            findOtherPcrs: function () {\\r\\n                var placementId = form.data.placement.id;\\r\\n                var where = \\\"placement.id=\\\" + placementId + \\\" AND (requestStatus='Submitted' OR requestStatus='Revision Needed')\\\";\\r\\n                var url = \\\"query/PlacementChangeRequest?where=\\\" + where + \\\"&fields=id&count=1\\\";\\r\\n                return API.appBridge.httpGET(url).then(function (result) {\\r\\n                    return Promise.resolve(result.data.data);\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        console.log('prevent-duplicate-pcr');\\r\\n        if (API.currentEntity === 'PlacementChangeRequest' && API.pageContext === 'FastAdd') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1731419294413},{\"id\":391,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"enrich-placement-data-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var transformFuntions = {\\r\\n            CustomPickerInternalRegex: /^.* \\\\| ([\\\\d]+)$/,\\r\\n            fromCustomPickerInternal: function (mapItem) {\\r\\n                var value = null;\\r\\n                var fromValue = transformFuntions.getFormControlValue(mapItem.fromField);\\r\\n                console.log('fromValue', fromValue);\\r\\n                if (fromValue && transformFuntions.CustomPickerInternalRegex.test(fromValue)) {\\r\\n                    value = fromValue.match(transformFuntions.CustomPickerInternalRegex)[1];\\r\\n                }\\r\\n                transformFuntions.setControlValue(mapItem.toField, (!value) ? null : parseInt(value));\\r\\n            },\\r\\n            hasChanged: function (field) {\\r\\n                var control = form.controls[field];\\r\\n                return (!control.pristine)\\r\\n                    && (control.valueHistory.length > 1\\r\\n                        && control.valueHistory[0] !== control.valueHistory[control.valueHistory.length - 1]);\\r\\n            },\\r\\n            getFormControlValue: function (field) {\\r\\n                if (!form.controls[field]) {\\r\\n                    return null;\\r\\n                }\\r\\n                return form.controls[field].value;\\r\\n            },\\r\\n            setControlValue: function (field, value) {\\r\\n                form.data[field] = value;\\r\\n            },\\r\\n        };\\r\\n        var app = {\\r\\n            FlowDownConfig: {\\r\\n                fieldMap: [\\r\\n                    {\\r\\n                        toField: 'customInt1', fromField: 'customText44', transform: 'fromCustomPickerInternal',\\r\\n                    },\\r\\n                ],\\r\\n            },\\r\\n            init: function () {\\r\\n                var promises = [];\\r\\n                app.FlowDownConfig.fieldMap.forEach(function (item) {\\r\\n                    if (!transformFuntions.hasChanged(item.fromField)) {\\r\\n                        return;\\r\\n                    }\\r\\n                    if (item.transform) {\\r\\n                        promises.push(transformFuntions[item.transform](item));\\r\\n                    }\\r\\n                });\\r\\n                return Promise.all(promises).then(function () {\\r\\n                    return Promise.resolve(form);\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Placement') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1724969585330},{\"id\":336,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"Change Request add job and company names 1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"// Company - requestCustomText3\\n        // Job - requestCustomText4\\n        var app = {\\n            init: function () {\\n                var entityId = API.currentEntityId || form.data.changedEntityId;\\n                var placementId = form.data.data.placement.id;\\n                return app.getPlacement(placementId).then(function (placementData) {\\n                    var changeObject = {\\n                        requestCustomText3: placementData.clientCorporation.name,\\n                        requestCustomText4: placementData.jobOrder.title,\\n                    };\\n                    return app.savePlacementChangeRequest(entityId, changeObject).then(function () {\\n                        return form;\\n                    });\\n                });\\n            },\\n            savePlacementChangeRequest: function (placementId, changeObject) {\\n                var url = API.http.restURL + \\\"entity/PlacementChangeRequest/\\\" + placementId;\\n                return API.http.post(url, changeObject).toPromise();\\n            },\\n            getPlacement: function (placementId) {\\n                var url = API.http.restURL + \\\"entity/Placement/\\\" + placementId + \\\"?fields=clientCorporation(name),jobOrder(title)\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    return result.data;\\n                });\\n            },\\n        };\\n        console.log('pcr - add job & company names');\\n        if (API.currentEntity === 'PlacementChangeRequest') {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1722811733447},{\"id\":67,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"job-submission-matched-candidate-lockdown\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            baseUrl: API.http.restURL,\\n            error: 'Candidate already Placed, edit from Placement',\\n            init: function () {\\n                var status = form.controls.status.value;\\n                var candidateID = '';\\n                if (API.currentEntityId === '' || API.currentEntityId === null || API.currentEntityId === undefined) {\\n                    candidateID = form.controls.candidate.value[0].id;\\n                }\\n                else {\\n                    candidateID = form.controls.candidate.value.id;\\n                }\\n                if (status === 'Offer Accepted' || status === 'Placed') {\\n                    return app.getCandidatePlacements(candidateID).then(function (data) {\\n                        if (data.placements.total > 0) {\\n                            API.promptUser({\\n                                headerText: 'Action Forbidden',\\n                                subheaderText: app.error,\\n                            });\\n                            form.isFormValid = false;\\n                            form.errorMessage = app.error;\\n                            return form;\\n                        }\\n                        return Promise.resolve();\\n                    });\\n                }\\n                return Promise.resolve();\\n            },\\n            getCandidatePlacements: function (candidateID) {\\n                var url = app.baseUrl + \\\"/entity/Candidate/\\\" + candidateID + \\\"?fields=placements(id)\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    var finalresult = result.data;\\n                    return Promise.resolve(finalresult);\\n                }, function (err) {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement') {\\n            console.log('run job-submission-matched-candidate-lockdown');\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":10,\"dateLastModified\":1702008562953},{\"id\":89,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"1218G-placement-chg-req-validation-onapproval\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            placementId: API.currentEntityId,\\r\\n            statusToCheck: 'Approved',\\r\\n            errorMessage: '',\\r\\n            placementFieldsToCheck: [\\r\\n                'customText9',\\r\\n                'customText8',\\r\\n                'timeAndExpense.timeAndExpenseSource',\\r\\n                'approvingUserID',\\r\\n                'billingProfile',\\r\\n                'workWeekStart',\\r\\n                'location',\\r\\n                'timeAndExpense.employeeOtType',\\r\\n                'timeAndExpense.approvalMethod',\\r\\n                'timeAndExpense.timeAndExpenseBranch',\\r\\n                'timeAndExpense.rounding',\\r\\n                'timeAndExpense.inOutIndicator',\\r\\n                'timeAndExpense.timeAndLaborEnabledDate',\\r\\n                'employeeType',\\r\\n                'timesheetCycle',\\r\\n            ],\\r\\n            // Initialize\\r\\n            init: function () {\\r\\n                var placement = form.controls;\\r\\n                return app.validate(placement);\\r\\n            },\\r\\n            // Checks if we should run validations\\r\\n            shouldValidationsRun: function () {\\r\\n                var selectedStatus = form.controls.status.value;\\r\\n                return app.statusToCheck === selectedStatus;\\r\\n            },\\r\\n            // Run the validations\\r\\n            validate: function (placement) {\\r\\n                // Placement fields\\r\\n                app.placementFieldsToCheck.forEach(function (field) {\\r\\n                    if (placement[field]) {\\r\\n                        if (field === 'customText9' && placement.housingStatus && placement.housingStatus.value === 'Local') {\\r\\n                            return;\\r\\n                        }\\r\\n                        if (placement[field].value === null || placement[field].value === '') {\\r\\n                            app.errorMessage += \\\"Please update \\\" + placement[field].label + \\\".\\\\n\\\";\\r\\n                        }\\r\\n                    }\\r\\n                });\\r\\n                if (app.errorMessage) {\\r\\n                    form.isFormValid = false;\\r\\n                    API.displayToast({\\r\\n                        title: 'Placement validations for BTE',\\r\\n                        icon: 'caution',\\r\\n                        theme: 'danger',\\r\\n                        position: 'fixedTop',\\r\\n                        hideDelay: 4000,\\r\\n                        message: app.errorMessage,\\r\\n                    });\\r\\n                    app.errorMessage = \\\"PLACEMENT VALIDATION FOR BTE\\\\n\\\" + app.errorMessage;\\r\\n                    form.errorMessage = app.errorMessage;\\r\\n                }\\r\\n                return form;\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'PlacementChangeRequest' && app.shouldValidationsRun()) {\\r\\n            return app.init();\\r\\n        }\\r\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1708115164623},{\"id\":119,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"job-submission-product-from-category-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            productAndCategories: [\\r\\n                {\\r\\n                    product: 'ALLI',\\r\\n                    categories: [\\r\\n                        'Allied - Cardiopulmonary',\\r\\n                        'Allied - General',\\r\\n                        'Allied - Laboratory',\\r\\n                        'Allied - Leadership',\\r\\n                        'Allied - Pharmacy',\\r\\n                        'Allied - Radiology',\\r\\n                        'Allied - Therapy',\\r\\n                    ],\\r\\n                },\\r\\n                {\\r\\n                    product: 'MEDL',\\r\\n                    categories: [\\r\\n                        'Nursing - APRN',\\r\\n                        'Nursing - Leadership',\\r\\n                        'Nursing - LPN',\\r\\n                        'Nursing - RN',\\r\\n                    ],\\r\\n                },\\r\\n                {\\r\\n                    product: 'DOCS',\\r\\n                    categories: [\\r\\n                        'Physician - Cardiac Surgeon',\\r\\n                        'Physician - Electrophysiologist',\\r\\n                        'Physician - Interventional Cardiologist',\\r\\n                        'Physician - Invasive Cardiologist',\\r\\n                        'Physician - Non-Invasive Cardiologist',\\r\\n                    ],\\r\\n                },\\r\\n                {\\r\\n                    product: 'ANCI',\\r\\n                    categories: [\\r\\n                        'Ancillary - Support',\\r\\n                    ],\\r\\n                },\\r\\n            ],\\r\\n            getEntityId: function () {\\r\\n                var dataObj = (form.data[0].data) ? form.data[0].data[0] : form.data[0];\\r\\n                var placementEntity = Array.isArray(dataObj) ? dataObj.find(function (element) {\\r\\n                    return element.changedEntityType === 'Placement';\\r\\n                }) : null;\\r\\n                if (!placementEntity) {\\r\\n                    return null;\\r\\n                }\\r\\n                return placementEntity.changedEntityId;\\r\\n            },\\r\\n            init: function () {\\r\\n                return new Promise(function (resolve, reject) {\\r\\n                    var entityId = app.getEntityId();\\r\\n                    if (!entityId) {\\r\\n                        return resolve(null);\\r\\n                    }\\r\\n                    return app.getPlacement(entityId)\\r\\n                        .then(function (placementData) {\\r\\n                        return app.categoriesToWorkdayProduct(placementData.data.jobOrder.id)\\r\\n                            .then(function (product) {\\r\\n                            if (!product) {\\r\\n                                return resolve();\\r\\n                            }\\r\\n                            var changeObject = { id: entityId, customText14: product };\\r\\n                            return app.savePlacement(entityId, changeObject)\\r\\n                                .then(function () {\\r\\n                                return resolve();\\r\\n                            })\\r\\n                                .catch(function (reason) {\\r\\n                                return reject(reason);\\r\\n                            });\\r\\n                        })\\r\\n                            .catch(function (reason) {\\r\\n                            return reject(reason);\\r\\n                        });\\r\\n                    })\\r\\n                        .catch(function (reason) {\\r\\n                        return reject(reason);\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            categoriesToWorkdayProduct: function (jobOrderId) {\\r\\n                return app.getJobOrder(jobOrderId).then(function (jobOrderData) {\\r\\n                    var categories = jobOrderData.data.categories;\\r\\n                    if (!categories || !categories.data || !Array.isArray(categories.data) || categories.data.length === 0) {\\r\\n                        return undefined;\\r\\n                    }\\r\\n                    var category = categories.data[0].name;\\r\\n                    var productAndCategory = app.productAndCategories.find(function (item) {\\r\\n                        return item.categories.includes(category);\\r\\n                    });\\r\\n                    if (!productAndCategory) {\\r\\n                        return undefined;\\r\\n                    }\\r\\n                    return productAndCategory.product;\\r\\n                });\\r\\n            },\\r\\n            getPlacement: function (placementId) {\\r\\n                return API.appBridge.httpGET(\\\"/entity/Placement/\\\" + placementId + \\\"?fields=jobOrder(id),customText14\\\").then(function (response) {\\r\\n                    return response.data;\\r\\n                });\\r\\n            },\\r\\n            getJobOrder: function (jobOrderId) {\\r\\n                return API.appBridge.httpGET(\\\"/entity/JobOrder/\\\" + jobOrderId + \\\"?fields=categories\\\").then(function (response) {\\r\\n                    return response.data;\\r\\n                });\\r\\n            },\\r\\n            savePlacement: function (placementId, changeObject) {\\r\\n                return API.appBridge.httpPOST(\\\"/entity/Placement/\\\" + placementId, changeObject);\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\r\\n            console.log('job-submission-product-from-category-1218');\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":10,\"dateLastModified\":1710256190120},{\"id\":147,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"1218G-job ratecard update\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                return new Promise(function (resolve, reject) {\\r\\n                    var updBody = {};\\r\\n                    if (!form.data) {\\r\\n                        resolve(null);\\r\\n                    }\\r\\n                    if (!form.data.data) {\\r\\n                        resolve(null);\\r\\n                    }\\r\\n                    if (!form.data.data.data) {\\r\\n                        resolve(null);\\r\\n                    }\\r\\n                    if (!form.data.data.data.jobPosting) {\\r\\n                        resolve(null);\\r\\n                    }\\r\\n                    var jobOrderId = form.data.data.data.jobPosting.id;\\r\\n                    if (!jobOrderId) {\\r\\n                        resolve(null);\\r\\n                    }\\r\\n                    if (!form.controls) {\\r\\n                        resolve(null);\\r\\n                    }\\r\\n                    if (!form.controls.jobOrderRateCardLineGroups) {\\r\\n                        resolve(null);\\r\\n                    }\\r\\n                    if (!form.controls.jobOrderRateCardLineGroups.controls) {\\r\\n                        resolve(null);\\r\\n                    }\\r\\n                    var groups = form.controls.jobOrderRateCardLineGroups.controls;\\r\\n                    if (!groups) {\\r\\n                        resolve(null);\\r\\n                    }\\r\\n                    groups.forEach(function (group) {\\r\\n                        if (group.controls) {\\r\\n                            if (group.controls.jobOrderRateCardLines) {\\r\\n                                if (group.controls.jobOrderRateCardLines.controls) {\\r\\n                                    var lines = group.controls.jobOrderRateCardLines.controls;\\r\\n                                    lines.forEach(function (line) {\\r\\n                                        if (line.controls) {\\r\\n                                            if (line.controls.earnCode) {\\r\\n                                                if (line.controls.earnCode.value) {\\r\\n                                                    if (line.controls.earnCode.value.code) {\\r\\n                                                        // REG for Contracts, XST (X Strike Straight Time) for Strikes. Ratecard will only have one of these\\r\\n                                                        var earnCode = line.controls.earnCode.value.code;\\r\\n                                                        if (earnCode && (earnCode === \\\"REG\\\" || earnCode === \\\"XST\\\")) {\\r\\n                                                            updBody['clientBillRate'] = line.controls.billRate.value;\\r\\n                                                            updBody['payRate'] = line.controls.payRate.value;\\r\\n                                                            updBody['correlatedCustomFloat2'] = line.controls.payRate.value;\\r\\n                                                            updBody['customInt4'] = Math.round(line.controls.payRate.value);\\r\\n                                                            updBody['customInt5'] = Math.round(line.controls.payRate.value);\\r\\n                                                        }\\r\\n                                                    }\\r\\n                                                }\\r\\n                                            }\\r\\n                                        }\\r\\n                                    });\\r\\n                                }\\r\\n                            }\\r\\n                        }\\r\\n                    });\\r\\n                    if (updBody === {}) {\\r\\n                        resolve(null);\\r\\n                    }\\r\\n                    API.appBridge.httpPOST(\\\"entity/JobOrder/\\\" + jobOrderId, updBody)\\r\\n                        .then(function () {\\r\\n                        resolve(null);\\r\\n                    })\\r\\n                        .catch(function (reason) {\\r\\n                        reject(reason);\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobOrderRateCard') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":10,\"dateLastModified\":1712608551440},{\"id\":299,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"job-submission-time-labor-enabled-date-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            getEntityId: function () {\\n                var dataObj = (form.data[0].data) ? form.data[0].data[0] : form.data[0];\\n                var placementEntity = Array.isArray(dataObj) ? dataObj.find(function (element) {\\n                    return element.changedEntityType === 'Placement';\\n                }) : null;\\n                if (!placementEntity) {\\n                    return null;\\n                }\\n                return placementEntity.changedEntityId;\\n            },\\n            init: function () {\\n                var entityId = app.getEntityId();\\n                if (!entityId) {\\n                    return form;\\n                }\\n                return app.getPlacement(entityId).then(function (placementData) {\\n                    var changeObject = {\\n                        id: entityId,\\n                        timeAndExpense: {\\n                            timeAndLaborEnabledDate: placementData.dateBegin,\\n                        },\\n                    };\\n                    return app.savePlacement(entityId, changeObject).then(function () {\\n                        return form;\\n                    });\\n                });\\n            },\\n            getPlacement: function (placementId) {\\n                var url = API.http.restURL + \\\"entity/Placement/\\\" + placementId + \\\"?fields=dateBegin\\\";\\n                return API.http.get(url).toPromise().then(function (response) {\\n                    return Promise.resolve(response.data);\\n                });\\n            },\\n            savePlacement: function (placementId, changeObject) {\\n                var url = API.http.restURL + \\\"entity/Placement/\\\" + placementId + \\\"?fields=dateBegin\\\";\\n                return API.http.post(url, changeObject).toPromise();\\n            },\\n        };\\n        console.log('test');\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\n            console.log('job-submission-time-labor-enabled-date-1218');\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1717435796543},{\"id\":300,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"placement-validation-onapproval-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"// 1218 Global - 22/08/05 - Leonardo Ariel Salatino\\n        // Placement validations\\n        var app = {\\n            placementId: API.currentEntityId,\\n            statusToCheck: 'Approved',\\n            errorMessage: '',\\n            placementFieldsToCheck: [\\n                { map: 'customText9', trackToIgnore: 'Placement3' },\\n                { map: 'customText8', trackToIgnore: 'Placement3' },\\n                'timeAndExpense.timeAndExpenseSource',\\n                'approvingUserID',\\n                'billingProfile',\\n                // 'customText41',\\n                'workWeekStart',\\n                'location',\\n                'timeAndExpense.employeeOtType',\\n                'timeAndExpense.approvalMethod',\\n                'timeAndExpense.timeAndExpenseBranch',\\n                'timeAndExpense.rounding',\\n                'timeAndExpense.inOutIndicator',\\n                'timeAndExpense.timeAndLaborEnabledDate',\\n                'employeeType',\\n                { map: 'timesheetCycle', trackToIgnore: 'Placement3' },\\n            ],\\n            // Initialize\\n            init: function () {\\n                var placement = form.controls;\\n                return app.validate(placement);\\n            },\\n            // Checks if we should run validations\\n            shouldValidationsRun: function () {\\n                var selectedStatus = form.controls.status.value;\\n                return app.statusToCheck === selectedStatus;\\n            },\\n            // Run the validations\\n            validate: function (placement) {\\n                // Placement fields\\n                app.placementFieldsToCheck.forEach(function (field) {\\n                    var fieldMap = field.map ? field.map : field;\\n                    if (field.trackToIgnore && field.trackToIgnore === API.currentEntityTrack) {\\n                        return;\\n                    }\\n                    if (placement[fieldMap]) {\\n                        if (fieldMap === 'customText9' && placement.housingStatus && placement.housingStatus.value === 'Local') {\\n                            return;\\n                        }\\n                        if (placement[fieldMap].value === null || placement[fieldMap].value === '' || (fieldMap === 'timesheetCycle' && placement[fieldMap].valueHistory.length < 1)) {\\n                            app.errorMessage += \\\"Please update \\\" + placement[fieldMap].label + \\\".\\\\n\\\";\\n                        }\\n                    }\\n                });\\n                if (app.errorMessage) {\\n                    form.isFormValid = false;\\n                    API.displayToast({\\n                        title: 'Placement validations for BTE',\\n                        icon: 'caution',\\n                        theme: 'danger',\\n                        position: 'fixedTop',\\n                        hideDelay: 4000,\\n                        message: app.errorMessage,\\n                    });\\n                    app.errorMessage = \\\"PLACEMENT VALIDATION FOR BTE\\\\n\\\" + app.errorMessage;\\n                    form.errorMessage = app.errorMessage;\\n                }\\n                return form;\\n            },\\n        };\\n        console.log('approval update');\\n        if (API.currentEntity === 'Placement' && app.shouldValidationsRun()) {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":10,\"dateLastModified\":1717435796563},{\"id\":225,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"Candidate val on placement Approval-1218G\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            placementId: API.currentEntityId,\\n            statusToCheck: 'Approved',\\n            errorMessage: '',\\n            addressFieldsToCheck: [\\n                {\\n                    field: 'address1',\\n                    label: 'address',\\n                },\\n                {\\n                    field: 'city',\\n                    label: 'city',\\n                },\\n                {\\n                    field: 'state',\\n                    label: 'state',\\n                },\\n                {\\n                    field: 'zip',\\n                    label: 'zip',\\n                },\\n            ],\\n            candidateFieldsToCheck: [\\n                'ssn',\\n                'dateOfBirth',\\n                'email',\\n                'mobile',\\n                'address(address1,city,state,zip)',\\n            ],\\n            // Checks if we should run validations\\n            shouldValidationsRun: function () {\\n                var selectedStatus = form.controls.status.value;\\n                return app.statusToCheck === selectedStatus;\\n            },\\n            getCandidateDetails: function () {\\n                var url = API.http.restURL + \\\"/query/Placement?where=id=\\\" + app.placementId + \\\"&fields=candidate(\\\" + app.candidateFieldsToCheck.join(',') + \\\")\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    if (result.data[0].candidate) {\\n                        return Promise.resolve(result.data[0].candidate);\\n                    }\\n                    return Promise.reject(new Error('Cannot get Candidate to run validations on Approval'));\\n                }, function (err) {\\n                    console.error(err);\\n                    return Promise.reject(err);\\n                });\\n            },\\n            runAddressValidation: function (candidate) {\\n                app.addressFieldsToCheck.forEach(function (field) {\\n                    if (candidate.address[field.field] === undefined || candidate.address[field.field] === null || candidate.address[field.field] === '') {\\n                        app.errorMessage += \\\"Please update Candidate \\\" + field.label + \\\".\\\\n\\\";\\n                    }\\n                });\\n            },\\n            // Run the validations\\n            validate: function () {\\n                return new Promise(function (resolve, reject) {\\n                    return app.getCandidateDetails()\\n                        .then(function (candidate) {\\n                        app.candidateFieldsToCheck.forEach(function (field) {\\n                            if (field.indexOf('address') === 0) {\\n                                app.runAddressValidation(candidate);\\n                            }\\n                            else if (candidate[field] === undefined || candidate[field] === null || candidate[field] === '') {\\n                                app.errorMessage += \\\"Please update Candidate \\\" + field + \\\".\\\\n\\\";\\n                            }\\n                        });\\n                        if (app.errorMessage) {\\n                            form.isFormValid = false;\\n                            API.displayToast({\\n                                title: 'Candidate validations on Placement Approval',\\n                                icon: 'caution',\\n                                theme: 'danger',\\n                                position: 'fixedTop',\\n                                hideDelay: 4000,\\n                                message: app.errorMessage,\\n                            });\\n                            form.errorMessage = \\\"CANDIDATE VALIDATIONS ON PLACEMENT APPROVAL\\\\n\\\" + app.errorMessage;\\n                        }\\n                        return resolve(form.errorMessage);\\n                    })\\n                        .catch(function (reason) {\\n                        return reject(reason);\\n                    });\\n                });\\n            },\\n        };\\n        console.log('pre-save validations');\\n        if (API.currentEntity === 'Placement' && app.shouldValidationsRun() && form.isFormValid === true) {\\n            return app.validate();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":20,\"dateLastModified\":1714418746483},{\"id\":69,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"1218G-Submission Reject Validations\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            init: function () {\\n                return new Promise(function (resolve) {\\n                    if (form.controls.status.value === 'Choose a Rejection Reason') {\\n                        form.isFormValid = false;\\n                        form.errorMessage = 'Select a Rejection Status';\\n                    }\\n                    return resolve(null);\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":20,\"dateLastModified\":1702008562993},{\"id\":117,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":8,\"firstName\":\"1218\",\"lastName\":\"Admin User NPE\"},\"name\":\"Candidate val on placement ChgReq Approval-1218G\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            statusToCheck: 'Approved',\\n            errorMessage: '',\\n            candidateFieldsToCheck: [\\n                'ssn',\\n                'dateOfBirth'\\n            ],\\n            // Checks if we should run validations\\n            shouldValidationsRun: function () {\\n                var selectedStatus = form.controls.status.value;\\n                return app.statusToCheck === selectedStatus;\\n            },\\n            getCandidateDetails: function () {\\n                var url = API.http.restURL + \\\"query/Placement?where=id=\\\" + form.data.placement.id + \\\"&fields=candidate(\\\" + app.candidateFieldsToCheck.join(\\\",\\\") + \\\")\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    if (result.data[0].candidate) {\\n                        return Promise.resolve(result.data[0].candidate);\\n                    }\\n                    else {\\n                        return Promise.reject(\\\"Cannot get Candidate to run validations on Approval\\\");\\n                    }\\n                }, function (err) {\\n                    console.error(err);\\n                    return Promise.reject(err);\\n                });\\n            },\\n            // Run the validations\\n            validate: function () {\\n                return new Promise(function (resolve, reject) {\\n                    return app.getCandidateDetails()\\n                        .then(function (candidate) {\\n                        app.candidateFieldsToCheck.forEach(function (field) {\\n                            if (candidate[field] === undefined || candidate[field] === null || candidate[field] === '') {\\n                                app.errorMessage += \\\"Please update Candidate \\\" + field + \\\".\\\\n\\\";\\n                            }\\n                        });\\n                        if (app.errorMessage) {\\n                            form.isFormValid = false;\\n                            API.displayToast({\\n                                title: 'Candidate validations on Placement Approval',\\n                                icon: 'caution',\\n                                theme: 'danger',\\n                                position: 'fixedTop',\\n                                hideDelay: 4000,\\n                                message: app.errorMessage,\\n                            });\\n                            form.errorMessage = \\\"CANDIDATE VALIDATIONS ON PLACEMENT APPROVAL\\\\n\\\" + app.errorMessage;\\n                        }\\n                        return resolve(form.errorMessage);\\n                    })\\n                        .catch(function (reason) {\\n                        return reject(reason);\\n                    });\\n                });\\n            }\\n        };\\n        if (API.currentEntity === 'PlacementChangeRequest' && app.shouldValidationsRun() && form.isFormValid === true) {\\n            return app.validate();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":20,\"dateLastModified\":1710255899503},{\"id\":747,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":9007369,\"firstName\":\"zmphanza\",\"lastName\":\"1218\"},\"name\":\"validate-candidate-submission-on-linked-jobs-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            statusToValidate: ['Matched', 'Offer Extended', 'Mass Placement Ready'],\\n            submissionStatusesToIgnore: [\\n                'PreS IGH-Declined Cand',\\n                'PreS Cand-Offer Declined',\\n                'PreS Cand-Withdrew Bfr Offer',\\n                'PreS Company-Declined Cand',\\n                'PreS Company-Withdrew Offer',\\n                'PreS IGH-Declined Cand',\\n                'PreS IGH-Missing/Expired Docs',\\n                'PreS IGH-Move to a New Order',\\n                'PreS IGH-Position Pend/Fill',\\n                'PreS Insufficient Test Scores',\\n                'PreS Moved to a New Order',\\n                'PreS Strike Settle-Aftr Notice',\\n                'PreS Strike Settle-Bfr Notice',\\n            ],\\n            jobOrderFields: 'id,correlatedCustomTextBlock1,customText35',\\n            opportunitySearchFields: 'id,correlatedCustomTextBlock1,jobOrders(submissions(status,candidate))',\\n            candidateSearchFields: 'id,status,jobOrder(id,opportunity(correlatedCustomTextBlock1),customText35),candidate',\\n            submission: form.controls,\\n            init: () => {\\n                console.log('validate-candidate-submission-on-linked-jobs-1218');\\n                const status = form.controls.status.value;\\n                if (!app.statusToValidate.includes(status)) {\\n                    return Promise.resolve(form);\\n                }\\n                let candidate;\\n                if (API.currentEntityId === '' || API.currentEntityId == null || API.currentEntityId === undefined) {\\n                    candidate = app.submission.candidate.value[0];\\n                }\\n                else {\\n                    candidate = app.submission.candidate.value;\\n                }\\n                if (!candidate) {\\n                    return Promise.resolve(form);\\n                }\\n                return app.candidateMatches(candidate.id).then(app.checkMatches);\\n            },\\n            candidateMatches: (candidateId) => {\\n                if (!candidateId) {\\n                    return Promise.resolve(null);\\n                }\\n                const url = 'query/JobSubmission';\\n                const payload = {\\n                    fields: app.candidateSearchFields,\\n                    where: `candidate.id=${candidateId} AND isDeleted=false`,\\n                    count: 100,\\n                };\\n                return API.appBridge.httpPOST(url, payload).then((result) => {\\n                    return Promise.resolve(result.data.data);\\n                });\\n            },\\n            checkMatches: (matches) => {\\n                return new Promise((resolve) => {\\n                    if (!matches || matches.length === 0) {\\n                        return resolve(form);\\n                    }\\n                    const jobID = app.submission.jobOrder.value.id || app.submission.jobOrder.value[0].id;\\n                    return app.getCurrentJobdata(jobID).then((jobData) => {\\n                        const customText35Value = jobData.customText35;\\n                        if (!customText35Value) {\\n                            console.warn('customText35 is missing from jobData');\\n                            return resolve(form);\\n                        }\\n                        return app.getCurrentJobOpportunity(customText35Value).then((opportunityData) => {\\n                            const foundMatch = matches.some((match) => {\\n                                if (!opportunityData || !opportunityData.correlatedCustomTextBlock1) {\\n                                    return false;\\n                                }\\n                                return opportunityData.correlatedCustomTextBlock1.some((item) => {\\n                                    const parts = item.split(' | ');\\n                                    return parts.length > 1 && parts[1] === match.jobOrder.customText35 && app.submissionStatusesToIgnore.indexOf(match.status) === -1;\\n                                });\\n                            });\\n                            if (foundMatch) {\\n                                form.isFormValid = false;\\n                                form.errorMessage = `Candidate already matched to job with linked opportunity ID ${customText35Value}`;\\n                            }\\n                            return resolve(form);\\n                        });\\n                    });\\n                });\\n            },\\n            getCurrentJobOpportunity: (opportunityID) => {\\n                if (!opportunityID) {\\n                    return Promise.resolve(null);\\n                }\\n                const url = `entity/Opportunity/${opportunityID}?fields=correlatedCustomTextBlock1`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    return Promise.resolve(result.data.data);\\n                });\\n            },\\n            getCurrentJobdata: (jobID) => {\\n                if (!jobID) {\\n                    return Promise.resolve(null);\\n                }\\n                const url = `entity/JobOrder/${jobID}?fields=${app.jobOrderFields}`;\\n                return API.appBridge.httpGET(url).then((result) => {\\n                    return Promise.resolve(result.data.data);\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return Promise.resolve(true);\",\"sortOrder\":20,\"dateLastModified\":1768463167717},{\"id\":462,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"1218G-Candidate Actions on Approved\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            FLD_MATCH_ELIG_DT: 'customDate6',\\r\\n            FLD_ORIGINAL_HIRE_DT: 'customDate7',\\r\\n            init: function () {\\r\\n                return new Promise(function (resolve) {\\r\\n                    var status = form.controls.status;\\r\\n                    if (status.valueHistory) {\\r\\n                        if (status.value !== status.valueHistory[0] && status.value === 'Approved') {\\r\\n                            return app.getCandidate(API.currentEntityId).then(function (placement) {\\r\\n                                if (placement.candidate) {\\r\\n                                    if (placement.candidate.id) {\\r\\n                                        if (placement.candidate[app.FLD_MATCH_ELIG_DT] === null || placement.candidate[app.FLD_MATCH_ELIG_DT] === undefined) {\\r\\n                                            var matchEligDate = void 0;\\r\\n                                            if (placement.candidate[app.FLD_ORIGINAL_HIRE_DT] === null || placement.candidate[app.FLD_ORIGINAL_HIRE_DT] === undefined) {\\r\\n                                                matchEligDate = new Date(form.controls.dateBegin.value);\\r\\n                                            }\\r\\n                                            else {\\r\\n                                                matchEligDate = new Date(placement.candidate[app.FLD_ORIGINAL_HIRE_DT]);\\r\\n                                            }\\r\\n                                            var monthsToAdd = matchEligDate.getDate() === 1 ? 0 : 1;\\r\\n                                            matchEligDate.setFullYear(matchEligDate.getFullYear() + 1, matchEligDate.getMonth() + monthsToAdd, 1);\\r\\n                                            matchEligDate.setHours(12);\\r\\n                                            return app.setCandidateMatchEligibleDate(placement.candidate.id, matchEligDate.getTime()).then(function () {\\r\\n                                                return resolve(null);\\r\\n                                            });\\r\\n                                        }\\r\\n                                    }\\r\\n                                    else {\\r\\n                                        console.error('Candidate Actions on Approved: Cannot get Candidate ID');\\r\\n                                    }\\r\\n                                }\\r\\n                                else {\\r\\n                                    console.error('Candidate Actions on Approved: Cannot get Candidate');\\r\\n                                }\\r\\n                                return resolve(null);\\r\\n                            });\\r\\n                        }\\r\\n                    }\\r\\n                    return resolve(null);\\r\\n                });\\r\\n            },\\r\\n            getCandidate: function (placementId) {\\r\\n                var url = app.baseUrl + \\\"/entity/Placement/\\\" + placementId + \\\"?fields=candidate(id,\\\" + app.FLD_MATCH_ELIG_DT + \\\",\\\" + app.FLD_ORIGINAL_HIRE_DT + \\\")\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data);\\r\\n                }, function (err) {\\r\\n                    console.error(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n            setCandidateMatchEligibleDate: function (candId, eligDate) {\\r\\n                var _a;\\r\\n                var url = app.baseUrl + \\\"/entity/Candidate/\\\" + candId;\\r\\n                return API.http.post(url, (_a = {},\\r\\n                    _a[app.FLD_MATCH_ELIG_DT] = eligDate,\\r\\n                    _a)).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result);\\r\\n                }, function (err) {\\r\\n                    console.error(err);\\r\\n                    return Promise.reject();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'Placement') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":30,\"dateLastModified\":1738154993067},{\"id\":80,\"action\":\"overview-field-modify\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"disable-edits-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"field.readOnly = true;\",\"sortOrder\":401,\"dateLastModified\":1702008563207}]}"
          },
