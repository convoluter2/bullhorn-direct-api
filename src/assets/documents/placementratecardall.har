            "text": "{\"total\":44,\"start\":0,\"count\":44,\"data\":[{\"id\":65,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"job-submission-candidate-status-check\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            baseUrl: API.http.restURL,\\n            init: function () {\\n                var candidateID = '';\\n                if (API.currentEntityId === '' || API.currentEntityId == null || API.currentEntityId === undefined) {\\n                    candidateID = form.controls.candidate.value[0].id;\\n                }\\n                else {\\n                    candidateID = form.controls.candidate.value.id;\\n                }\\n                return app.getCandidate(candidateID).then(function (candidate) {\\n                    var status = candidate.status;\\n                    var statusError = app.validateStatus(status);\\n                    if (statusError) {\\n                        form.isFormValid = false;\\n                        form.errorMessage = statusError.errorMessage;\\n                    }\\n                    return Promise.resolve();\\n                });\\n            },\\n            validateStatus: function (result) {\\n                if (result === 'Clinical Review' || result === 'Not Qualified' || result === 'Inactive' || result === 'Terminated' || result === 'Deceased' || result === 'Do Not Contact') {\\n                    return { isFormValid: false, errorMessage: 'Candidate status invalid' };\\n                }\\n                return undefined;\\n            },\\n            getCandidate: function (candidateID) {\\n                var url = app.baseUrl + \\\"/entity/Candidate/\\\" + candidateID + \\\"?fields=id,status\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    var finalresult = result.data;\\n                    return Promise.resolve(finalresult);\\n                }, function (err) {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && form.isFormValid === true && API.pageContext !== 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1702008562893},{\"id\":95,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"company-credit-hold-check-job-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                var employmentType = form.data.employmentType;\\r\\n                if (employmentType !== 'Contract' &&\\r\\n                    // + 1218 Global - 2024-02-29 - Leonardo Salatino - Live Support #169\\r\\n                    employmentType !== 'Shared') {\\r\\n                    // - 1218 Global - 2024-02-29 - Leonardo Salatino - Live Support #169\\r\\n                    return Promise.resolve();\\r\\n                }\\r\\n                var clientCorporationControl = form.controls.clientCorporation;\\r\\n                if (clientCorporationControl.value === null) {\\r\\n                    return Promise.resolve();\\r\\n                }\\r\\n                return app.getClientCorporation(clientCorporationControl.value.id).then(function (clientCorporation) {\\r\\n                    if (clientCorporation.status === 'Credit Hold') {\\r\\n                        form.isFormValid = false;\\r\\n                        form.errorMessage = 'Company has Credit Hold status';\\r\\n                    }\\r\\n                    else if (clientCorporation.status === 'Do Not Service') {\\r\\n                        form.isFormValid = false;\\r\\n                        form.errorMessage = 'Company brand status invalid';\\r\\n                    }\\r\\n                    return form;\\r\\n                });\\r\\n            },\\r\\n            getClientCorporation: function (companyId) {\\r\\n                var url = app.baseUrl + \\\"/entity/ClientCorporation/\\\" + companyId + \\\"?fields=id,status\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data);\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobOrder') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1709210386497},{\"id\":97,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"company-credit-hold-check-job-submission-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                var jobId;\\r\\n                if (API.currentEntityId === '' || API.currentEntityId == null || API.currentEntityId === undefined) {\\r\\n                    jobId = form.controls.jobOrder.value[0].id;\\r\\n                }\\r\\n                else {\\r\\n                    jobId = form.controls.jobOrder.value.id;\\r\\n                }\\r\\n                return app.getJobOrder(jobId).then(function (jobOrder) {\\r\\n                    var employmentType = jobOrder.employmentType;\\r\\n                    if (employmentType !== 'Contract' &&\\r\\n                        // + 1218 Global - 2024-02-29 - Leonardo Salatino - Live Support #169\\r\\n                        employmentType !== 'Shared') {\\r\\n                        // - 1218 Global - 2024-02-29 - Leonardo Salatino - Live Support #169\\r\\n                        return form;\\r\\n                    }\\r\\n                    if (jobOrder.clientCorporation.status === 'Credit Hold') {\\r\\n                        form.isFormValid = false;\\r\\n                        form.errorMessage = 'Company has Credit Hold status';\\r\\n                    }\\r\\n                    return form;\\r\\n                });\\r\\n            },\\r\\n            getJobOrder: function (jobOrderId) {\\r\\n                var url = app.baseUrl + \\\"/entity/JobOrder/\\\" + jobOrderId + \\\"?fields=id,employmentType,clientCorporation(status)\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data);\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && form.isFormValid === true && API.pageContext !== 'MoveToPlacement') {\\r\\n            console.log('JobSubmission', API, form);\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1709210386547},{\"id\":99,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"company-credit-hold-check-placement-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            baseUrl: API.http.restURL,\\r\\n            init: function () {\\r\\n                var employmentType = form.data.employmentType;\\r\\n                if (employmentType !== 'Contract' &&\\r\\n                    // + 1218 Global - 2024-02-29 - Leonardo Salatino - Live Support #169\\r\\n                    employmentType !== 'Shared') {\\r\\n                    // - 1218 Global - 2024-02-29 - Leonardo Salatino - Live Support #169\\r\\n                    return Promise.resolve();\\r\\n                }\\r\\n                var jobID = form.data.jobOrder.id;\\r\\n                return app.getClientCorporation(jobID).then(function (clientCorporation) {\\r\\n                    if (clientCorporation.status === 'Credit Hold') {\\r\\n                        form.isFormValid = false;\\r\\n                        form.errorMessage = 'Company has Credit Hold status';\\r\\n                    }\\r\\n                    return form;\\r\\n                });\\r\\n            },\\r\\n            getClientCorporation: function (jobID) {\\r\\n                var url = app.baseUrl + \\\"/entity/JobOrder/\\\" + jobID + \\\"?fields=id,clientCorporation(id,status)\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data.clientCorporation);\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1709210386590},{\"id\":249,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"pre-save-handler-job-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            aboutUsField: 'publicDescription',\\n            init: function () {\\n                form.data[app.aboutUsField] = '';\\n                return form;\\n            },\\n        };\\n        console.log('pre-save-add-handler');\\n        if (API.currentEntity === 'JobOrder' && API.pageContext === 'FastAdd') {\\n            return app.init();\\n        }\\n        return form;\",\"sortOrder\":0,\"dateLastModified\":1715282174220},{\"id\":284,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"merge-duplicate-matches-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            baseUrl: API.http.restURL,\\n            existingSubmissionError: 'There already exists a submission on this job with this candidate.',\\n            submissionFields: [],\\n            init: function () {\\n                // See if a jobSubmission exists with the same job and candidate.\\n                // If so, see what differences exist on the form\\n                // If any, merge them\\n                var candidates = form.controls.candidate.value;\\n                var jobs = form.controls.jobOrder.value;\\n                if (candidates && candidates.length > 0 && jobs && jobs.length > 0) {\\n                    var promises_1 = [];\\n                    jobs.forEach(function (job) {\\n                        candidates.forEach(function (candidate) {\\n                            promises_1.push(app.findExistingSubmission(candidate.id, job.id));\\n                        });\\n                    });\\n                    return Promise.all(promises_1).then(function (submissions) {\\n                        var updatePromises = [];\\n                        submissions.forEach(function (submission) {\\n                            var updateBody = app.makeSubmissionUpdateBody();\\n                            if (updateBody) {\\n                                updatePromises.push(app.makeSubmissionUpdates(submission[0].id, updateBody));\\n                            }\\n                        });\\n                        return Promise.all(updatePromises).then(function () {\\n                            return form;\\n                        });\\n                    });\\n                }\\n                return form;\\n            },\\n            makeSubmissionUpdateBody: function () {\\n                var submissionUpdateBody = {};\\n                var keysToIgnore = ['jobOrder', 'candidate', 'recipients', 'distributionLists', 'scheduleNextAction', 'sendingUser'];\\n                var dateKeys = ['startDate', 'endDate'];\\n                Object.keys(form.controls).forEach(function (key) {\\n                    if (form.controls[key].value) {\\n                        if (dateKeys.indexOf(key) > -1) {\\n                            submissionUpdateBody[key] = form.controls[key].value.getTime();\\n                        }\\n                        else if (keysToIgnore.indexOf(key) === -1) {\\n                            submissionUpdateBody[key] = form.controls[key].value;\\n                        }\\n                    }\\n                });\\n                return submissionUpdateBody;\\n            },\\n            makeSubmissionFields: function () {\\n                var submissionFields = Object.keys(form.controls);\\n                submissionFields.splice(submissionFields.indexOf('recipients'), 1);\\n                submissionFields.splice(submissionFields.indexOf('distributionLists'), 1);\\n                submissionFields.splice(submissionFields.indexOf('scheduleNextAction'), 1);\\n                return submissionFields;\\n            },\\n            makeSubmissionUpdates: function (submissionId, updateBody) {\\n                var url = app.baseUrl + \\\"entity/JobSubmission/\\\" + submissionId;\\n                return API.http.post(url, updateBody).toPromise().then(function (result) {\\n                    return Promise.resolve(result);\\n                });\\n            },\\n            findExistingSubmission: function (candidateId, jobId) {\\n                var submissionFields = app.makeSubmissionFields();\\n                var url = app.baseUrl + \\\"query/JobSubmission?where=candidate.id=\\\" + candidateId + \\\" AND jobOrder.id=\\\" + jobId + \\\"&fields=id\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n        };\\n        console.log('merge-duplicate');\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'FastAdd') {\\n            console.log('JobSubmission', API, form);\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1716480511843},{\"id\":301,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"rate-card-update-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            baseUrl: API.http.restURL,\\n            init: function () {\\n                var changedEntityId = form.data.data.changedEntityId;\\n                return API.appBridge.httpGET(\\\"/query/PlacementRateCard?fields=id&where=id=\\\" + changedEntityId).then(function (data) {\\n                    var placementRateCardId = data.data.data[0].id;\\n                    return API.appBridge.httpGET(\\\"/query/PlacementRateCardLineGroup?fields=placementRateCardLines(earnCode(customText1))\\\\n          &where=placementRateCard.id=\\\" + placementRateCardId).then(function (result) {\\n                        // get placementRateCardLine where group.id = ^^. Get earn code group from PRCLG.earnCodeGroup.id. For each PRCL, update prcl.alias = group.customText1\\n                        if (result && result.data && result.data.data) {\\n                            var rateCardLineGroups = result.data.data;\\n                            rateCardLineGroups.forEach(function (rateCardLineGroup) {\\n                                var rateCardLines = rateCardLineGroup.placementRateCardLines.data;\\n                                rateCardLines.forEach(function (rateCardLine) {\\n                                    API.appBridge.httpPOST(\\\"entity/PlacementRateCardLine/\\\" + rateCardLine.id, {\\n                                        alias: rateCardLine.earnCode.customText1,\\n                                    });\\n                                });\\n                            });\\n                        }\\n                    });\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'PlacementRateCard')\\n            return app.init();\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1717435796583},{\"id\":390,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"strike-notice-recieved-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            jobOrderId: form.data.changedEntityId,\\r\\n            init: function () {\\r\\n                console.log('strike-notice-recieved', API, form);\\r\\n                var newOpportunityId = (form.controls.customText35.value === '') ? null : form.controls.customText35.value;\\r\\n                var changeObject = {};\\r\\n                return app.getJobOrderData().then(function (jobOrderData) {\\r\\n                    var existingOppId = (jobOrderData.opportunity) ? jobOrderData.opportunity.id : null;\\r\\n                    if (String(existingOppId) !== String(newOpportunityId)) {\\r\\n                        if (!newOpportunityId) {\\r\\n                            changeObject.customText35 = String(existingOppId);\\r\\n                            if (jobOrderData.opportunity.type === 'Project' && jobOrderData.opportunity.customText3 === 'Active Job Action') {\\r\\n                                changeObject.startDate = jobOrderData.opportunity.estimatedStartDate;\\r\\n                                changeObject.dateEnd = jobOrderData.opportunity.estimatedEndDate;\\r\\n                                changeObject.customDate3 = jobOrderData.opportunity.customDate2;\\r\\n                                changeObject.durationWeeks = jobOrderData.opportunity.estimatedDuration;\\r\\n                                changeObject.hoursPerWeek = jobOrderData.opportunity.estimatedHoursPerWeek;\\r\\n                            }\\r\\n                            return app.commitChanges(changeObject);\\r\\n                        }\\r\\n                        return app.getOpportunityData(newOpportunityId).then(function (oppData) {\\r\\n                            changeObject.opportunity = { id: oppData.id };\\r\\n                            if (oppData.type === 'Project' && oppData.customText3 === 'Active Job Action') {\\r\\n                                changeObject.startDate = oppData.estimatedStartDate;\\r\\n                                changeObject.dateEnd = oppData.estimatedEndDate;\\r\\n                                changeObject.customDate3 = oppData.customDate2;\\r\\n                                changeObject.durationWeeks = oppData.estimatedDuration;\\r\\n                                changeObject.hoursPerWeek = oppData.estimatedHoursPerWeek;\\r\\n                            }\\r\\n                            return app.commitChanges(changeObject);\\r\\n                        });\\r\\n                    }\\r\\n                    return Promise.resolve();\\r\\n                });\\r\\n            },\\r\\n            getOpportunityData: function (oppId) {\\r\\n                var fields = 'customText3,customDate2,estimatedStartDate,estimatedEndDate,estimatedDuration,estimatedHoursPerWeek,type,id';\\r\\n                return API.appBridge.httpGET(\\\"/entity/Opportunity/\\\" + oppId + \\\"?fields=\\\" + fields).then(function (result) {\\r\\n                    return Promise.resolve(result.data.data);\\r\\n                });\\r\\n            },\\r\\n            getJobOrderData: function () {\\r\\n                var fields = 'opportunity(customText3,customDate2,estimatedStartDate,estimatedEndDate,estimatedDuration,estimatedHoursPerWeek,type,id)';\\r\\n                return API.appBridge.httpGET(\\\"/entity/JobOrder/\\\" + app.jobOrderId + \\\"?fields=\\\" + fields).then(function (result) {\\r\\n                    return Promise.resolve(result.data.data);\\r\\n                });\\r\\n            },\\r\\n            commitChanges: function (changeObject) {\\r\\n                return API.appBridge.httpPOST(\\\"/entity/JobOrder/\\\" + app.jobOrderId, changeObject).then(function () {\\r\\n                    return Promise.resolve();\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobOrder') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1724969585307},{\"id\":418,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"post-save-handler-job-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            ENRICH_FIELDS: [\\r\\n                { from: 'clientAgreementPicker', to: 'clientAgreementPicker', transform: 'jobRateHandler' },\\r\\n                { from: 'correlatedCustomFloat2', to: 'customInt5', transform: 'roundHandler' },\\r\\n                { from: 'customFloat1', to: 'customInt7', transform: 'roundHandler' },\\r\\n                { from: 'payRate', to: 'customInt4', transform: 'roundHandler' },\\r\\n            ],\\r\\n            customToId: function (changeObject, to, value) {\\r\\n                if (value) {\\r\\n                    changeObject[to] = { id: value.id };\\r\\n                }\\r\\n                Promise.resolve(true);\\r\\n            },\\r\\n            roundHandler: function (changeObject, to, value) {\\r\\n                var roundedVal = null;\\r\\n                if (value) {\\r\\n                    roundedVal = Math.round(value);\\r\\n                }\\r\\n                changeObject[to] = roundedVal;\\r\\n                return Promise.resolve(true);\\r\\n            },\\r\\n            jobRateHandler: function (changeObject, to, value) {\\r\\n                console.log('jobRateHandler');\\r\\n                console.log(changeObject, to, value);\\r\\n                if (!value || !value.id) {\\r\\n                    return Promise.resolve(false);\\r\\n                }\\r\\n                return app.getJobRate(changeObject.id).then(function (result) {\\r\\n                    if (result) {\\r\\n                        return Promise.resolve(false);\\r\\n                    }\\r\\n                    return app.createJobRates(changeObject, to, value).then(function (created) {\\r\\n                        var cra = {\\r\\n                            id: changeObject.id,\\r\\n                            customText25: value.name + \\\" | \\\" + value.id,\\r\\n                        };\\r\\n                        return app.commitChanges(cra).then(function () {\\r\\n                            return Promise.resolve(created);\\r\\n                        });\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            createJobRates: function (changeObject, to, craValue) {\\r\\n                var effectiveDate = (form.controls.startDate) ? form.controls.startDate.value : null;\\r\\n                if (!effectiveDate) {\\r\\n                    return Promise.resolve(false);\\r\\n                }\\r\\n                var effectiveDateStr = effectiveDate.getFullYear() + \\\"-\\\" + (\\\"0\\\" + (effectiveDate.getMonth() + 1)).slice(-2) + \\\"-\\\" + (\\\"0\\\" + effectiveDate.getDate()).slice(-2);\\r\\n                return app.getCRAData(craValue.id).then(function (result) {\\r\\n                    if (!result.clientCorporationRateAgreementCardLineGroups || result.clientCorporationRateAgreementCardLineGroups.total === 0) {\\r\\n                        return Promise.resolve(false);\\r\\n                    }\\r\\n                    var jobOrderRateCardLineGroups = result.clientCorporationRateAgreementCardLineGroups.data.map(function (group) {\\r\\n                        return {\\r\\n                            isBase: group.isBase,\\r\\n                            earnCodeGroup: {\\r\\n                                id: group.earnCodeGroup.id,\\r\\n                            },\\r\\n                            jobOrderRateCardLines: group.clientCorporationRateAgreementCardLines.data.map(function (line) {\\r\\n                                return {\\r\\n                                    earnCode: {\\r\\n                                        id: line.earnCode.id,\\r\\n                                    },\\r\\n                                    payRate: line.payRate,\\r\\n                                    billRate: line.billRate,\\r\\n                                    payMultiplier: line.payMultiplier,\\r\\n                                    billMultiplier: line.billMultiplier,\\r\\n                                    markupPercent: line.markupPercent,\\r\\n                                    markupValue: line.markupValue,\\r\\n                                };\\r\\n                            }),\\r\\n                        };\\r\\n                    });\\r\\n                    var changeRateObject = {\\r\\n                        jobOrderRateCardLineGroups: jobOrderRateCardLineGroups,\\r\\n                        jobPosting: {\\r\\n                            id: changeObject.id,\\r\\n                        },\\r\\n                        effectiveDate: effectiveDateStr,\\r\\n                    };\\r\\n                    var url = API.http.restURL + \\\"entity/JobOrderRateCard\\\";\\r\\n                    return API.http.put(url, changeRateObject).toPromise().then(function () {\\r\\n                        return Promise.resolve(true);\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            getJobRate: function (jobId) {\\r\\n                var url = API.http.restURL + \\\"entity/JobOrder/\\\" + jobId + \\\"?fields=jobOrderRateCardID,customText25\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data.jobOrderRateCardID);\\r\\n                });\\r\\n            },\\r\\n            getCRAData: function (craID) {\\r\\n                var url = API.http.restURL + \\\"entity/ClientCorporationRateAgreementCard/\\\" + craID + \\\"?fields=clientCorporationRateAgreementCardLineGroups[100]\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data);\\r\\n                });\\r\\n            },\\r\\n            commitChanges: function (changeObject) {\\r\\n                var url = API.http.restURL + \\\"entity/JobOrder/\\\" + changeObject.id;\\r\\n                return API.http.post(url, changeObject).toPromise();\\r\\n            },\\r\\n            init: function () {\\r\\n                var entityId = form.data.changedEntityId;\\r\\n                var changeObject = {\\r\\n                    id: entityId,\\r\\n                };\\r\\n                var promises = [];\\r\\n                var update = false;\\r\\n                app.ENRICH_FIELDS.forEach(function (field) {\\r\\n                    if (form.controls[field.from]) {\\r\\n                        if (field.transform) {\\r\\n                            promises.push(app[field.transform](changeObject, field.to, form.controls[field.from].value));\\r\\n                        }\\r\\n                        else {\\r\\n                            changeObject[field.to] = form.controls[field.from].value;\\r\\n                            update = true;\\r\\n                        }\\r\\n                    }\\r\\n                });\\r\\n                return Promise.all(promises).then(function (jobChanges) {\\r\\n                    update = update || jobChanges.some(function (jobChange) {\\r\\n                        return jobChange;\\r\\n                    });\\r\\n                    if (update) {\\r\\n                        return app.commitChanges(changeObject).then(function () {\\r\\n                            return Promise.resolve(form);\\r\\n                        });\\r\\n                    }\\r\\n                    return Promise.resolve(form);\\r\\n                });\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity !== 'JobOrder') {\\r\\n            return (form);\\r\\n        }\\r\\n        console.log('JobOrder Entry');\\r\\n        return app.init();\",\"sortOrder\":0,\"dateLastModified\":1733939550247},{\"id\":447,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"job-submission-post-save-handler-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            SAVE_FIELDS: [\\r\\n                { from: 'payRate', to: 'payRate' },\\r\\n                { from: 'billRate', to: 'billRate' },\\r\\n                { from: 'customText7', to: 'customText7' },\\r\\n                { from: 'customText8', to: 'customText8' },\\r\\n                { from: 'opportunity.id', to: 'customText12', transform: 'handleLinkedOpportunity' },\\r\\n            ],\\r\\n            handleLinkedOpportunity: function (payload, field) {\\r\\n                // + 1218 Global - 2025-01-13 - Leonardo Salatino - Support #971\\r\\n                // const jobId = form.controls.jobOrder.value[0].id;\\r\\n                var jobId = null;\\r\\n                if (API.pageDK) {\\r\\n                    if (API.pageDK.config) {\\r\\n                        if (API.pageDK.config.entityType === \\\"JobOrder\\\" && API.pageDK.config.entityId) {\\r\\n                            jobId = API.pageDK.config.entityId;\\r\\n                        }\\r\\n                        else if (API.pageDK.config.entityType === \\\"JobOrder\\\" && API.pageDK.config.id) {\\r\\n                            jobId = API.pageDK.config.id;\\r\\n                        }\\r\\n                        else if (API.pageDK.config.record) {\\r\\n                            if (API.pageDK.config.record._subtype === \\\"JobOrder\\\" && API.pageDK.config.record.id) {\\r\\n                                jobId = API.pageDK.config.record.id;\\r\\n                            }\\r\\n                        }\\r\\n                    }\\r\\n                    else if (API.pageDK.baseURL) {\\r\\n                        var urlParts = API.pageDK.baseURL.split(\\\"/\\\");\\r\\n                        if (urlParts.length > 0) {\\r\\n                            urlParts.forEach(function (part) {\\r\\n                                if (/^\\\\d+$/.test(part)) {\\r\\n                                    jobId = parseInt(part);\\r\\n                                    return;\\r\\n                                }\\r\\n                            });\\r\\n                        }\\r\\n                    }\\r\\n                }\\r\\n                if (!jobId) {\\r\\n                    if (form.controls.jobOrder) {\\r\\n                        jobId = form.controls.jobOrder.value ? form.controls.jobOrder.value.id : null;\\r\\n                    }\\r\\n                }\\r\\n                if (!jobId) {\\r\\n                    return Promise.reject(\\\"Cannot find JobOrder Id\\\");\\r\\n                }\\r\\n                // - 1218 Global - 2025-01-13 - Leonardo Salatino - Support #971\\r\\n                var fields = 'fields=id,opportunity(id)';\\r\\n                return app.getJob(jobId, fields).then(function (res) {\\r\\n                    if (res) {\\r\\n                        payload[field.to] = res.opportunity.id;\\r\\n                    }\\r\\n                });\\r\\n            },\\r\\n            getEntityId: function () {\\r\\n                // + 1218 Global - 2025-01-13 - Leonardo Salatino - Support #971\\r\\n                // const dataObj = (Object.keys(form.data[0].data).length > 0) ? form.data[0].data[0] : form.data[0];\\r\\n                if (API.currentEntity === \\\"JobSubmission\\\" && API.currentEntityId) {\\r\\n                    return API.currentEntityId;\\r\\n                }\\r\\n                var dataObj = null;\\r\\n                if (form.data) {\\r\\n                    if (form.data.data) {\\r\\n                        if (form.data.data.length > 0) {\\r\\n                            dataObj = form.data.data[0];\\r\\n                        }\\r\\n                        else {\\r\\n                            dataObj = form.data.data;\\r\\n                        }\\r\\n                    }\\r\\n                    else if (form.data.length > 0) {\\r\\n                        if (form.data[0].data) {\\r\\n                            if (form.data[0].data.length > 0) {\\r\\n                                dataObj = form.data[0].data[0];\\r\\n                            }\\r\\n                            else {\\r\\n                                dataObj = form.data[0].data;\\r\\n                            }\\r\\n                        }\\r\\n                        else {\\r\\n                            dataObj = form.data[0];\\r\\n                        }\\r\\n                    }\\r\\n                    else {\\r\\n                        dataObj = form.data;\\r\\n                    }\\r\\n                }\\r\\n                if (!dataObj) {\\r\\n                    console.error(\\\"Cannot get Submission Id to run post-save handler\\\");\\r\\n                    return null;\\r\\n                }\\r\\n                // - 1218 Global - 2025-01-13 - Leonardo Salatino - Support #971\\r\\n                var jobSubmissionEntity = Array.isArray(dataObj) ? dataObj.find(function (element) {\\r\\n                    return element.changedEntityType === 'JobSubmission';\\r\\n                }) : dataObj.changedEntityId;\\r\\n                if (typeof jobSubmissionEntity === 'number') {\\r\\n                    return jobSubmissionEntity;\\r\\n                }\\r\\n                if (!jobSubmissionEntity) {\\r\\n                    return null;\\r\\n                }\\r\\n                return jobSubmissionEntity.changedEntityId;\\r\\n            },\\r\\n            commitChanges: function (jobSubmissionId, payload) {\\r\\n                var url = API.http.restURL + \\\"entity/JobSubmission/\\\" + jobSubmissionId;\\r\\n                return API.http.post(url, payload).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data);\\r\\n                });\\r\\n            },\\r\\n            getJob: function (jobId, fields) {\\r\\n                var url = API.http.restURL + \\\"entity/JobOrder/\\\" + jobId + \\\"?\\\" + fields;\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data);\\r\\n                });\\r\\n            },\\r\\n            init: function () {\\r\\n                var entityId = app.getEntityId();\\r\\n                var payload = {};\\r\\n                var promises = [];\\r\\n                app.SAVE_FIELDS.forEach(function (field) {\\r\\n                    if (field.transform) {\\r\\n                        promises.push(app[field.transform](payload, field));\\r\\n                    }\\r\\n                    else if (form.controls[field.from]) {\\r\\n                        var value = form.controls[field.from].value;\\r\\n                        payload[field.to] = value;\\r\\n                    }\\r\\n                });\\r\\n                if (promises.length > 0) {\\r\\n                    Promise.all(promises).then(function () {\\r\\n                        if (payload) {\\r\\n                            app.commitChanges(entityId, payload);\\r\\n                        }\\r\\n                    });\\r\\n                }\\r\\n                else if (payload) {\\r\\n                    app.commitChanges(entityId, payload);\\r\\n                }\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement') {\\r\\n            console.log('job-submission-post-save-handler Entry');\\r\\n            return app.init();\\r\\n        }\\r\\n        return Promise.resolve(true);\",\"sortOrder\":0,\"dateLastModified\":1736779415397},{\"id\":392,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"job-submission-validations\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            baseUrl: API.http.restURL,\\n            init: function () {\\n                var jobID = '';\\n                var candidateID = '';\\n                if (API.currentEntityId === '' || API.currentEntityId == null || API.currentEntityId === undefined) {\\n                    candidateID = form.controls.candidate.value[0].id;\\n                    jobID = form.controls.jobOrder.value[0].id;\\n                }\\n                else {\\n                    candidateID = form.controls.candidate.value.id;\\n                    jobID = form.controls.jobOrder.value.id;\\n                }\\n                return app.getJobOrder(jobID).then(function (jobOrder) {\\n                    // + 1218 Global - 2024-02-29 - Leonardo Salatino - Live Support #169\\n                    // const isContract = jobOrder.employmentType === 'Contract';\\n                    var isContract = jobOrder.employmentType === 'Contract' || jobOrder.employmentType === 'Shared';\\n                    // - 1218 Global - 2024-02-29 - Leonardo Salatino - Live Support #169\\n                    if (isContract) {\\n                        var doNotServiceError = app.validateDoNotService(jobOrder.clientCorporation);\\n                        if (doNotServiceError) {\\n                            form.isFormValid = false;\\n                            form.errorMessage = doNotServiceError.errorMessage;\\n                            return Promise.resolve();\\n                        }\\n                    }\\n                    return app.getCandidate(candidateID).then(function (candidate) {\\n                        var blacklistError = app.validateBlacklist(jobOrder.clientCorporation, candidate);\\n                        if (blacklistError) {\\n                            form.isFormValid = false;\\n                            form.errorMessage = blacklistError.errorMessage;\\n                            return Promise.resolve();\\n                        }\\n                        var mspError = app.validateMsp(jobOrder, candidate);\\n                        if (mspError) {\\n                            form.isFormValid = false;\\n                            form.errorMessage = mspError.errorMessage;\\n                        }\\n                        return Promise.resolve();\\n                    });\\n                });\\n            },\\n            validateBlacklist: function (clientCorporation, candidate) {\\n                if (!candidate.customTextBlock9) {\\n                    return undefined;\\n                }\\n                var name = clientCorporation.name.trim();\\n                var hasAny = false;\\n                if (Array.isArray(candidate.customTextBlock9)) {\\n                    hasAny = candidate.customTextBlock9.some(function (data) {\\n                        return data.trim() === name;\\n                    });\\n                }\\n                else {\\n                    hasAny = candidate.customTextBlock9.trim() === name;\\n                }\\n                if (!hasAny) {\\n                    return undefined;\\n                }\\n                return { isFormValid: false, errorMessage: 'Candidate is blacklisted' };\\n            },\\n            validateDoNotService: function (clientCorporation) {\\n                if (!clientCorporation.status) {\\n                    return undefined;\\n                }\\n                var hasAny = false;\\n                if (Array.isArray(clientCorporation.status)) {\\n                    hasAny = clientCorporation.status.some(function (data) {\\n                        return data === 'Do Not Service';\\n                    });\\n                }\\n                else {\\n                    hasAny = clientCorporation.status === 'Do Not Service';\\n                }\\n                if (!hasAny) {\\n                    return undefined;\\n                }\\n                return { isFormValid: false, errorMessage: 'Company brand status invalid' };\\n            },\\n            validateMsp: function (jobOrder, candidate) {\\n                if (!candidate.customTextBlock8) {\\n                    return undefined;\\n                }\\n                var hasAny = candidate.customTextBlock8.some(function (data) {\\n                    return data === jobOrder.customText7;\\n                });\\n                if (!hasAny) {\\n                    return undefined;\\n                }\\n                return { isFormValid: false, errorMessage: 'Cannot submit with a candidate opting out from MSP with the same value as 3rd Party Provider' };\\n            },\\n            getCandidate: function (candidateID) {\\n                var url = app.baseUrl + \\\"/entity/Candidate/\\\" + candidateID + \\\"?fields=id,customTextBlock9,customTextBlock8\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    var finalresult = result.data;\\n                    return Promise.resolve(finalresult);\\n                }, function (err) {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n            getJobOrder: function (jobID) {\\n                var url = app.baseUrl + \\\"/entity/JobOrder/\\\" + jobID + \\\"?fields=id,employmentType,customText7,clientCorporation(id,name,status)\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    var finalresult = result.data;\\n                    return Promise.resolve(finalresult);\\n                }, function (err) {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext !== 'MoveToPlacement') {\\n            console.log('job-submission-validations');\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1725554714970},{\"id\":393,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"placement-validations\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            baseUrl: API.http.restURL,\\n            init: function () {\\n                var candidateID = form.data.candidate.id;\\n                var jobID = form.data.jobOrder.id;\\n                return app.getJobOrder(jobID).then(function (jobOrder) {\\n                    // + 1218 Global - 2024-02-29 - Leonardo Salatino - Live Support #169\\n                    // const isContract = jobOrder.employmentType === 'Contract';\\n                    var isContract = jobOrder.employmentType === 'Contract' || jobOrder.employmentType === 'Shared';\\n                    // - 1218 Global - 2024-02-29 - Leonardo Salatino - Live Support #169\\n                    if (isContract) {\\n                        var doNotServiceError = app.validateDoNotService(jobOrder.clientCorporation);\\n                        if (doNotServiceError) {\\n                            form.isFormValid = false;\\n                            form.errorMessage = doNotServiceError.errorMessage;\\n                            return Promise.resolve();\\n                        }\\n                    }\\n                    return app.getCandidate(candidateID).then(function (candidate) {\\n                        var blacklistError = app.validateBlacklist(jobOrder.clientCorporation, candidate);\\n                        if (blacklistError) {\\n                            form.isFormValid = false;\\n                            form.errorMessage = blacklistError.errorMessage;\\n                            return Promise.resolve();\\n                        }\\n                        var mspError = app.validateMsp(jobOrder, candidate);\\n                        if (mspError) {\\n                            form.isFormValid = false;\\n                            form.errorMessage = mspError.errorMessage;\\n                        }\\n                        return Promise.resolve();\\n                    });\\n                });\\n            },\\n            validateBlacklist: function (clientCorporation, candidate) {\\n                if (!candidate.customTextBlock9) {\\n                    return undefined;\\n                }\\n                var name = clientCorporation.name.trim();\\n                var hasAny = candidate.customTextBlock9.some(function (data) {\\n                    return data.trim() === name;\\n                });\\n                if (!hasAny) {\\n                    return undefined;\\n                }\\n                return { isFormValid: false, errorMessage: 'Candidate is blacklisted' };\\n            },\\n            validateDoNotService: function (clientCorporation) {\\n                if (!clientCorporation.status) {\\n                    return undefined;\\n                }\\n                var hasAny = false;\\n                if (Array.isArray(clientCorporation.status)) {\\n                    hasAny = clientCorporation.status.some(function (data) {\\n                        return data === 'Do Not Service';\\n                    });\\n                }\\n                else {\\n                    hasAny = clientCorporation.status === 'Do Not Service';\\n                }\\n                if (!hasAny) {\\n                    return undefined;\\n                }\\n                return { isFormValid: false, errorMessage: 'Company brand status invalid' };\\n            },\\n            validateMsp: function (jobOrder, candidate) {\\n                if (!candidate.customTextBlock8) {\\n                    return undefined;\\n                }\\n                var hasAny = candidate.customTextBlock8.some(function (data) {\\n                    return data === jobOrder.customText7;\\n                });\\n                if (!hasAny) {\\n                    return undefined;\\n                }\\n                return { isFormValid: false, errorMessage: 'Cannot submit with a candidate opting out from MSP with the same value as 3rd Party Provider' };\\n            },\\n            getCandidate: function (candidateID) {\\n                var url = app.baseUrl + \\\"/entity/Candidate/\\\" + candidateID + \\\"?fields=id,customTextBlock9,customTextBlock8\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    var finalresult = result.data;\\n                    return Promise.resolve(finalresult);\\n                }, function (err) {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n            getJobOrder: function (jobID) {\\n                var url = app.baseUrl + \\\"/entity/JobOrder/\\\" + jobID + \\\"?fields=id,employmentType,customText7,clientCorporation(id,name,status)\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    var finalresult = result.data;\\n                    return Promise.resolve(finalresult);\\n                }, function (err) {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\n            console.log('Executing placement-validations');\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":0,\"dateLastModified\":1725554714993},{\"id\":632,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"copy-review-notes-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            jobSubmission: 'JobSubmission',\\n            candidateFields: 'id,candidate',\\n            init: function () {\\n                console.log('copy-review-notes-1218');\\n                var entityId = app.getEntityId();\\n                if (!entityId) {\\n                    return Promise.resolve();\\n                }\\n                var reviewNotesCheckbox = form.controls.reviewNotesCheckbox.value;\\n                if (reviewNotesCheckbox === 'No' || !reviewNotesCheckbox) {\\n                    return Promise.resolve();\\n                }\\n                var comments = form.controls.comments.value;\\n                return app.getCandidateData(entityId).then(function (candidateData) {\\n                    var changeObject = {\\n                        id: candidateData.id,\\n                        customTextBlock10: comments,\\n                    };\\n                    return app.commitChanges(changeObject).then(function () {\\n                        return Promise.resolve();\\n                    });\\n                }).catch(function (error) {\\n                    console.error('Error getting candidate data', error);\\n                });\\n            },\\n            getEntityId: function () {\\n                var dataObj = null;\\n                if (form.data) {\\n                    if (form.data[0]) {\\n                        if (form.data[0].data) {\\n                            if (Array.isArray(form.data[0].data) && form.data[0].data.length > 0) {\\n                                dataObj = form.data[0].data[0];\\n                            }\\n                        }\\n                        else {\\n                            dataObj = form.data[0];\\n                        }\\n                    }\\n                    else if (Array.isArray(form.data.data) && form.data.data.length > 0) {\\n                        dataObj = form.data.data[0];\\n                    }\\n                }\\n                var entity = (Array.isArray(dataObj)) ? dataObj.find(function (element) {\\n                    return element.changedEntityType === app.jobSubmission;\\n                }) : dataObj;\\n                return entity && entity.changedEntityId ? entity.changedEntityId : API.currentEntityId;\\n            },\\n            getCandidateData: function (submissionId) {\\n                var url = API.http.restURL + \\\"entity/\\\" + app.jobSubmission + \\\"/\\\" + submissionId + \\\"?fields=\\\" + app.candidateFields;\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    return Promise.resolve(result.data.candidate);\\n                }).catch(function (error) {\\n                    console.error('Error getting candidate data', error);\\n                });\\n            },\\n            commitChanges: function (changeObject) {\\n                var url = API.http.restURL + \\\"entity/Candidate/\\\" + changeObject.id;\\n                return API.http.post(url, changeObject).toPromise().then(function (result) {\\n                    return Promise.resolve(result.data);\\n                });\\n            },\\n        };\\n        if (API.currentEntity === app.jobSubmission) {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":1,\"dateLastModified\":1742364919147},{\"id\":665,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"placement-flowdown-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"const transformFuntions = {\\r\\n            // eslint-disable-next-line no-template-curly-in-string\\r\\n            weekEndingToTimesheetCycleMap: JSON.parse('[{\\\\\\\"weekEnding\\\\\\\": \\\\\\\"1\\\\\\\", \\\\\\\"timeSheetCycle\\\\\\\": 13 },{\\\\\\\"weekEnding\\\\\\\": \\\\\\\"2\\\\\\\", \\\\\\\"timeSheetCycle\\\\\\\": 12 }, {\\\\\\\"weekEnding\\\\\\\": \\\\\\\"5\\\\\\\", \\\\\\\"timeSheetCycle\\\\\\\": 11 }, {\\\\\\\"weekEnding\\\\\\\": \\\\\\\"6\\\\\\\", \\\\\\\"timeSheetCycle\\\\\\\": 10 }, {\\\\\\\"weekEnding\\\\\\\": \\\\\\\"7\\\\\\\", \\\\\\\"timeSheetCycle\\\\\\\": 9 }]'),\\r\\n            CustomPickerInternalRegex: /^.* \\\\| ([\\\\d]+)$/,\\r\\n            toIntFromLookup: (mapItem, data, changeObject) => {\\r\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\r\\n                if (!fromValue) {\\r\\n                    transformFuntions.setValue(mapItem.toField, changeObject, null);\\r\\n                    return;\\r\\n                }\\r\\n                transformFuntions.setValue(mapItem.toField, changeObject, fromValue.id);\\r\\n            },\\r\\n            toCustomPickerInternal: (mapItem, data, changeObject) => {\\r\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\r\\n                if (!fromValue) {\\r\\n                    transformFuntions.setValue(mapItem.toField, changeObject, '');\\r\\n                    return;\\r\\n                }\\r\\n                transformFuntions.setValue(mapItem.toField, changeObject, `${fromValue.firstName} ${fromValue.lastName} | ${fromValue.id}`);\\r\\n            },\\r\\n            fromCustomPickerInternal: (mapItem, data, changeObject) => {\\r\\n                let value = '';\\r\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\r\\n                if (fromValue && transformFuntions.CustomPickerInternalRegex.test(fromValue)) {\\r\\n                    value = fromValue.match(transformFuntions.CustomPickerInternalRegex)[1];\\r\\n                }\\r\\n                transformFuntions.setValue(mapItem.toField, changeObject, (value === '') ? '' : parseInt(value));\\r\\n            },\\r\\n            specialtiesToText: (mapItem, data, changeObject) => {\\r\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\r\\n                const url = `${API.http.restURL}entity/JobOrder/${fromValue}?fields=specialties`;\\r\\n                return API.http.get(url).toPromise().then((response) => {\\r\\n                    const specialties = response.data.specialties;\\r\\n                    if (!specialties || !specialties.data || !Array.isArray(specialties.data) || specialties.data.length === 0) {\\r\\n                        return Promise.resolve(null);\\r\\n                    }\\r\\n                    const placSpec = [];\\r\\n                    specialties.data.forEach((spec) => {\\r\\n                        placSpec.push(spec.name);\\r\\n                    });\\r\\n                    if (placSpec && placSpec.length > 0) {\\r\\n                        transformFuntions.setValue(mapItem.toField, changeObject, placSpec.join(';'));\\r\\n                    }\\r\\n                    return Promise.resolve(null);\\r\\n                });\\r\\n            },\\r\\n            stringToInt: (mapItem, data, changeObject) => {\\r\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\r\\n                if (!fromValue || fromValue === '') {\\r\\n                    return;\\r\\n                }\\r\\n                transformFuntions.setValue(mapItem.toField, changeObject, parseInt(fromValue));\\r\\n            },\\r\\n            setRate: (mapItem, data, changeObject) => {\\r\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\r\\n                if (!fromValue) {\\r\\n                    transformFuntions.setValue(mapItem.toField, changeObject, 0);\\r\\n                }\\r\\n                else {\\r\\n                    transformFuntions.setValue(mapItem.toField, changeObject, fromValue);\\r\\n                }\\r\\n            },\\r\\n            setDate: (mapItem, data, changeObject) => {\\r\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\r\\n                if (!fromValue || fromValue === '') {\\r\\n                    return;\\r\\n                }\\r\\n                transformFuntions.setValue(mapItem.toField, changeObject, fromValue);\\r\\n            },\\r\\n            setTimesheetCycle: (mapItem, data, changeObject) => {\\r\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\r\\n                if (!fromValue) {\\r\\n                    return;\\r\\n                }\\r\\n                const mItem = transformFuntions.weekEndingToTimesheetCycleMap.filter((item) => {\\r\\n                    return item.weekEnding === fromValue;\\r\\n                });\\r\\n                if (mItem.length > 0) {\\r\\n                    transformFuntions.setValue(mapItem.toField, changeObject, mItem[0].timeSheetCycle);\\r\\n                }\\r\\n            },\\r\\n            getValue: (item, data) => {\\r\\n                if (!item.entity) {\\r\\n                    return data[item.fromField];\\r\\n                }\\r\\n                const entityArr = item.entity.split('.');\\r\\n                let retVal = data[entityArr[0]];\\r\\n                if (retVal && entityArr.length > 1) {\\r\\n                    retVal = retVal[entityArr[1]];\\r\\n                }\\r\\n                return (retVal) ? retVal[item.fromField] : null;\\r\\n            },\\r\\n            setValue: (tofield, changeObject, value) => {\\r\\n                const toFieldArr = tofield.split('.');\\r\\n                let i = 0;\\r\\n                let co = changeObject;\\r\\n                for (i; i < toFieldArr.length - 1; i += 1) {\\r\\n                    if (!co[toFieldArr[i]]) {\\r\\n                        co[toFieldArr[i]] = {};\\r\\n                    }\\r\\n                    co = co[toFieldArr[i]];\\r\\n                }\\r\\n                co[toFieldArr[toFieldArr.length - 1]] = value;\\r\\n            },\\r\\n            addressPullState: (mapItem, data, changeObject) => {\\r\\n                const fromValue = transformFuntions.getValue(mapItem, data);\\r\\n                if (!fromValue || fromValue === '') {\\r\\n                    return;\\r\\n                }\\r\\n                transformFuntions.setValue(mapItem.toField, changeObject, fromValue.state);\\r\\n            },\\r\\n        };\\r\\n        const app = {\\r\\n            FlowDownConfig: {\\r\\n                flowFromEntity: 'Placement',\\r\\n                fieldMap: [\\r\\n                    { toField: 'timeAndExpense.timeAndExpenseBranch', fromField: 'customText1', entity: 'jobOrder.billingProfile' },\\r\\n                    { toField: 'timeAndExpense.rounding', fromField: 'customText17', entity: 'jobOrder.billingProfile' },\\r\\n                    {\\r\\n                        toField: 'timesheetCycle.id', fromField: 'customText22', entity: 'jobOrder', transform: 'setTimesheetCycle',\\r\\n                    },\\r\\n                    { toField: 'customText35', fromField: 'customText19', entity: 'jobOrder' },\\r\\n                    {\\r\\n                        toField: 'customText36', fromField: 'customText21', entity: 'jobOrder',\\r\\n                    },\\r\\n                    {\\r\\n                        toField: 'customText29', fromField: 'customText17', entity: 'jobOrder',\\r\\n                    },\\r\\n                    {\\r\\n                        toField: 'customText31', fromField: 'customText16', entity: 'jobOrder',\\r\\n                    },\\r\\n                    {\\r\\n                        toField: 'customText44', fromField: 'owner', entity: 'jobOrder', transform: 'toCustomPickerInternal',\\r\\n                    },\\r\\n                    {\\r\\n                        toField: 'customInt1', fromField: 'owner', entity: 'jobOrder', transform: 'toIntFromLookup',\\r\\n                    },\\r\\n                    {\\r\\n                        toField: 'customText37', fromField: 'customText18', entity: 'jobOrder',\\r\\n                    },\\r\\n                    {\\r\\n                        toField: 'workWeekStart', fromField: 'customText22', entity: 'jobOrder', transform: 'stringToInt',\\r\\n                    },\\r\\n                    { toField: 'customText33', fromField: 'customText7', entity: 'jobOrder' },\\r\\n                    { toField: 'customText41', fromField: 'customText23', entity: 'jobOrder' },\\r\\n                    { toField: 'bonusPackage', fromField: 'bonusPackage', entity: 'jobOrder' },\\r\\n                    {\\r\\n                        toField: 'customText4', fromField: 'id', entity: 'jobOrder', transform: 'specialtiesToText',\\r\\n                    },\\r\\n                    // + 1218 Global - 2025-04-10 - Leonardo Salatino - Support #1082\\r\\n                    // {\\r\\n                    //   toField: 'dateBegin', fromField: 'startDate', entity: 'jobSubmission', transform: 'setDate',\\r\\n                    // },\\r\\n                    // {\\r\\n                    //   toField: 'dateEnd', fromField: 'endDate', entity: 'jobSubmission', transform: 'setDate',\\r\\n                    // },\\r\\n                    // - 1218 Global - 2025-04-10 - Leonardo Salatino - Support #1082\\r\\n                    {\\r\\n                        toField: 'customDate2', fromField: 'dateEnd', entity: 'jobOrder', transform: 'setDate',\\r\\n                    },\\r\\n                    {\\r\\n                        toField: 'customText60', fromField: 'customText24', entity: 'jobSubmission',\\r\\n                    },\\r\\n                    {\\r\\n                        toField: 'customText34', fromField: 'customText25', entity: 'jobSubmission',\\r\\n                    },\\r\\n                    {\\r\\n                        toField: 'customText43', fromField: 'customText10', entity: 'jobSubmission',\\r\\n                    },\\r\\n                    {\\r\\n                        toField: 'customText42', fromField: 'sendingUser', entity: 'jobSubmission', transform: 'toCustomPickerInternal',\\r\\n                    },\\r\\n                    { toField: 'customText13', fromField: 'customText13', entity: 'jobSubmission' },\\r\\n                    { toField: 'customText51', fromField: 'customTextBlock5', entity: 'jobSubmission' },\\r\\n                    { toField: 'customText39', fromField: 'customText6', entity: 'jobSubmission' },\\r\\n                    {\\r\\n                        toField: 'customText38', fromField: 'customText21', entity: 'jobSubmission',\\r\\n                    },\\r\\n                    // + 1218 Global - 2025-07-28 - Leonardo Salatino - Support #1232\\r\\n                    // {\\r\\n                    //   toField: 'payRate', fromField: 'payRate', entity: 'jobSubmission', transform: 'setRate',\\r\\n                    // },\\r\\n                    // {\\r\\n                    //   toField: 'clientBillRate', fromField: 'billRate', entity: 'jobSubmission', transform: 'setRate',\\r\\n                    // },\\r\\n                    // - 1218 Global - 2025-07-28 - Leonardo Salatino - Support #1232\\r\\n                    {\\r\\n                        toField: 'customText5', fromField: 'id', entity: 'jobOrder.opportunity',\\r\\n                    },\\r\\n                    { toField: 'customTextBlock4', fromField: 'address', entity: 'jobOrder.location', transform: 'addressPullState' },\\r\\n                ],\\r\\n            },\\r\\n            getEntityId: () => {\\r\\n                const dataObj = (form.data[0].data) ? form.data[0].data[0] : form.data[0];\\r\\n                const placementEntity = Array.isArray(dataObj) ? dataObj.find((element) => {\\r\\n                    return element.changedEntityType === 'Placement';\\r\\n                }) : null;\\r\\n                if (!placementEntity) {\\r\\n                    return null;\\r\\n                }\\r\\n                return placementEntity.changedEntityId;\\r\\n            },\\r\\n            init: () => {\\r\\n                console.log('Entering Placementdefaultsonadd');\\r\\n                const entityId = app.getEntityId();\\r\\n                if (!entityId) {\\r\\n                    return form;\\r\\n                }\\r\\n                const changeObject = {\\r\\n                    id: entityId,\\r\\n                };\\r\\n                return app.getFlowDownData(entityId).then((data) => {\\r\\n                    const promises = app.setFlowDownData(data, changeObject);\\r\\n                    Promise.all(promises).then(() => {\\r\\n                        app.commitChanges(changeObject).then(() => {\\r\\n                            console.log('Leaving Placementdefaultsonadd');\\r\\n                            return Promise.resolve(form);\\r\\n                        });\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            commitChanges: (changeObject) => {\\r\\n                const url = `${API.http.restURL}entity/Placement/${changeObject.id}`;\\r\\n                console.log('Placement Payload', changeObject);\\r\\n                return API.http.post(url, changeObject).toPromise();\\r\\n            },\\r\\n            getFlowDownData(entity) {\\r\\n                if (!entity) {\\r\\n                    return Promise.resolve(null);\\r\\n                }\\r\\n                const fields = {};\\r\\n                app.FlowDownConfig.fieldMap.forEach((field) => {\\r\\n                    const entityName = (field.entity) ? field.entity : 'PARENT';\\r\\n                    if (fields[entityName]) {\\r\\n                        fields[entityName].push(field.fromField);\\r\\n                    }\\r\\n                    else {\\r\\n                        fields[entityName] = [field.fromField];\\r\\n                    }\\r\\n                });\\r\\n                const efields = {};\\r\\n                let fieldStr = '';\\r\\n                Object.keys(fields).forEach((key) => {\\r\\n                    const uFields = fields[key].sort().filter((el, i, a) => {\\r\\n                        return !i || el !== a[i - 1];\\r\\n                    });\\r\\n                    const keyArr = key.split('.');\\r\\n                    if (!efields[keyArr[0]]) {\\r\\n                        efields[keyArr[0]] = [];\\r\\n                    }\\r\\n                    if (keyArr.length > 1) {\\r\\n                        efields[keyArr[0]].push(`${keyArr[1]}(${uFields.join(',')})`);\\r\\n                    }\\r\\n                    else {\\r\\n                        efields[keyArr[0]].push(...uFields);\\r\\n                    }\\r\\n                });\\r\\n                Object.keys(efields).forEach((key) => {\\r\\n                    fieldStr = (fieldStr !== '') ? `${fieldStr},` : '';\\r\\n                    if (key === 'PARENT') {\\r\\n                        fieldStr = `${fieldStr}${efields[key].join(',')}`;\\r\\n                    }\\r\\n                    else {\\r\\n                        fieldStr = `${fieldStr}${key}(${efields[key].join(',')})`;\\r\\n                    }\\r\\n                });\\r\\n                const url = `${API.http.restURL}entity/${app.FlowDownConfig.flowFromEntity}/${entity}?fields=${fieldStr}`;\\r\\n                return API.http.get(url).toPromise().then((response) => {\\r\\n                    return Promise.resolve(response.data);\\r\\n                });\\r\\n            },\\r\\n            setFlowDownData: (data, changeObject) => {\\r\\n                const promises = [];\\r\\n                if (!data) {\\r\\n                    return promises;\\r\\n                }\\r\\n                app.FlowDownConfig.fieldMap.forEach((item) => {\\r\\n                    if (!item.transform) {\\r\\n                        const fromValue = transformFuntions.getValue(item, data);\\r\\n                        transformFuntions.setValue(item.toField, changeObject, (fromValue) || '');\\r\\n                        return;\\r\\n                    }\\r\\n                    promises.push(transformFuntions[item.transform](item, data, changeObject));\\r\\n                });\\r\\n                return promises;\\r\\n            },\\r\\n        };\\r\\n        console.log('flowdown');\\r\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\r\\n            return app.init();\\r\\n        }\\r\\n        return form;\",\"sortOrder\":1,\"dateLastModified\":1753721623023},{\"id\":408,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"assign-pay-bill-rules-on-job-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\r\\n            jobOrderId: form.data.changedEntityId,\\r\\n            init: function () {\\r\\n                if (!app.jobOrderId) {\\r\\n                    return form;\\r\\n                }\\r\\n                return app.getCRAFromJob(app.jobOrderId).then(function (craID) {\\r\\n                    if (!craID)\\r\\n                        return Promise.resolve(false);\\r\\n                    var id = craID.split('|')[1].trim();\\r\\n                    return app.getCRA(id).then(function (cra) {\\r\\n                        if (!cra)\\r\\n                            return Promise.resolve(false);\\r\\n                        var guranteeMapping = JSON.parse('[{\\\"name\\\":\\\"Weekly 40\\\",\\\"ruleSetId\\\":100},{\\\"name\\\":\\\"Weekly 20\\\",\\\"ruleSetId\\\":125},{\\\"name\\\":\\\"Weekly 24\\\",\\\"ruleSetId\\\":122},{\\\"name\\\":\\\"Weekly 34.5\\\",\\\"ruleSetId\\\":120},{\\\"name\\\":\\\"Weekly 36\\\",\\\"ruleSetId\\\":103},{\\\"name\\\":\\\"Weekly 37.5\\\",\\\"ruleSetId\\\":126},{\\\"name\\\":\\\"Weekly 42.5\\\",\\\"ruleSetId\\\":127},{\\\"name\\\":\\\"Weekly 45\\\",\\\"ruleSetId\\\":123},{\\\"name\\\":\\\"Weekly 46\\\",\\\"ruleSetId\\\":119},{\\\"name\\\":\\\"Weekly 48\\\",\\\"ruleSetId\\\":104},{\\\"name\\\":\\\"Weekly 50\\\",\\\"ruleSetId\\\":121},{\\\"name\\\":\\\"Weekly 57.5\\\",\\\"ruleSetId\\\":128},{\\\"name\\\":\\\"Weekly 60\\\",\\\"ruleSetId\\\":124},{\\\"name\\\":\\\"Weekly 32\\\",\\\"ruleSetId\\\":162}]');\\r\\n                        var flsaAdjustment = JSON.parse('139');\\r\\n                        var payRuleSetIds = cra.customText1 ? app.convertToIntArray(cra.customText1) : [];\\r\\n                        var billRuleSetIds = cra.customText2 ? app.convertToIntArray(cra.customText2) : [];\\r\\n                        var guranteeRuleSetIds = cra.customText3 ? app.mapCustomTextToRuleSetIds(guranteeMapping, [cra.customText3]) : [];\\r\\n                        payRuleSetIds.push(flsaAdjustment);\\r\\n                        // If the value is greater than 0\\r\\n                        if (guranteeRuleSetIds.length > 0) {\\r\\n                            payRuleSetIds = payRuleSetIds.concat(guranteeRuleSetIds);\\r\\n                        }\\r\\n                        var payPayload = {\\r\\n                            effectiveDate: cra.effectiveDate,\\r\\n                            timeLaborEvalRules: { replaceAll: payRuleSetIds },\\r\\n                            jobOrder: { id: app.jobOrderId },\\r\\n                        };\\r\\n                        app.assignPayRule(payPayload);\\r\\n                        if (guranteeRuleSetIds.length > 0) {\\r\\n                            billRuleSetIds = billRuleSetIds.concat(guranteeRuleSetIds);\\r\\n                        }\\r\\n                        var billPayload = {\\r\\n                            effectiveDate: cra.effectiveDate,\\r\\n                            timeLaborEvalRules: { replaceAll: billRuleSetIds },\\r\\n                            jobOrder: { id: app.jobOrderId },\\r\\n                        };\\r\\n                        app.assignBillRule(billPayload);\\r\\n                        return Promise.resolve();\\r\\n                    });\\r\\n                });\\r\\n            },\\r\\n            getCRAFromJob: function (jobId) {\\r\\n                var url = API.http.restURL + \\\"entity/JobOrder/\\\" + jobId + \\\"?fields=customText25\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data.customText25);\\r\\n                });\\r\\n            },\\r\\n            getCRA: function (craID) {\\r\\n                var url = API.http.restURL + \\\"entity/ClientCorporationRateAgreementCard/\\\" + craID + \\\"?fields=customText1,customText2,customText3,effectiveDate\\\";\\r\\n                return API.http.get(url).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data);\\r\\n                });\\r\\n            },\\r\\n            assignPayRule: function (data) {\\r\\n                var url = API.http.restURL + \\\"entity/JobOrderPayRuleset\\\";\\r\\n                return API.http.put(url, data).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data);\\r\\n                });\\r\\n            },\\r\\n            assignBillRule: function (data) {\\r\\n                var url = API.http.restURL + \\\"entity/JobOrderBillRuleset\\\";\\r\\n                return API.http.put(url, data).toPromise().then(function (result) {\\r\\n                    return Promise.resolve(result.data);\\r\\n                });\\r\\n            },\\r\\n            convertToIntArray: function (arr) {\\r\\n                return arr.map(function (i) {\\r\\n                    return parseInt(i);\\r\\n                });\\r\\n            },\\r\\n            mapCustomTextToRuleSetIds: function (mapping, customTextValues) {\\r\\n                var ruleSetIds = [];\\r\\n                customTextValues.forEach(function (value) {\\r\\n                    var matchingItem = mapping.find(function (item) {\\r\\n                        return item.name === value;\\r\\n                    });\\r\\n                    if (matchingItem) {\\r\\n                        ruleSetIds.push(matchingItem.ruleSetId);\\r\\n                    }\\r\\n                });\\r\\n                return ruleSetIds;\\r\\n            },\\r\\n        };\\r\\n        if (API.currentEntity === 'JobOrder' && API.pageContext === 'FastAdd') {\\r\\n            console.log('Assign PayBillRules');\\r\\n            return app.init();\\r\\n        }\\r\\n        return form;\",\"sortOrder\":1,\"dateLastModified\":1732785442860},{\"id\":456,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2,\"firstName\":\"Unassigned\",\"lastName\":\"User\"},\"name\":\"Test\",\"page\":\"record\",\"enabled\":true,\"script\":\"console.log(API,form);\",\"sortOrder\":1,\"dateLastModified\":1737386878637},{\"id\":810,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":8454912,\"firstName\":\"Deal Sheet NPE\",\"lastName\":\"Admin User\"},\"name\":\"Prevent Placement Creation for ds pending approval\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            allowedStatus: [\\\"Active\\\"],\\n            getSubmission: function (candidateId, jobOrderId) {\\n                var url = \\\"query/JobSubmission?where=candidate.id=\\\" + candidateId + \\\" AND jobOrder.id=\\\" + jobOrderId + \\\" AND isDeleted=false&fields=id,customFloat3,status\\\";\\n                return API.appBridge.httpGET(url).then(function (response) {\\n                    return Promise.resolve(response.data.data);\\n                });\\n            },\\n            getDealsheet: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    var query = {\\n                        query: {\\n                            type: 'getMostIncrementedDs',\\n                            params: {\\n                                dealSheetId: id,\\n                            },\\n                            data: {}\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            },\\n            checkDealsheetAndPreventForm: function (approvalRequested, approved, rejected) {\\n                var preventCreation = approvalRequested || (!approvalRequested && rejected);\\n                var messageStatus = approvalRequested ? \\\"pending managers approval\\\" : \\\"rejected\\\";\\n                if (preventCreation) {\\n                    var errorMessage = \\\"Deal Sheet is \\\" + messageStatus + \\\", placement can not be created\\\";\\n                    // controller.displayToastMessage(errorMessage)\\n                    form.isFormValid = false;\\n                    form.errorMessage = errorMessage;\\n                    return true;\\n                }\\n            },\\n            displayToastMessage: function (errorMessage) {\\n                API.displayToast({\\n                    message: errorMessage,\\n                    isCloseable: true,\\n                    theme: 'danger',\\n                    hideDelay: 6000,\\n                });\\n            },\\n            init: function () {\\n                return new Promise(function (resolve) {\\n                    var jobOrderId = form.data.jobOrder.id;\\n                    var candidateId = form.data.candidate.id;\\n                    if (jobOrderId && candidateId) {\\n                        controller.getSubmission(candidateId, jobOrderId).then(function (submission) {\\n                            var dealsheetId = submission.length ? submission[0].customFloat3 : null;\\n                            console.log(\\\"submission\\\", submission);\\n                            console.log(\\\"dealsheetId\\\", dealsheetId);\\n                            if (dealsheetId) {\\n                                controller.getDealsheet(dealsheetId).then(function (dealsheet) {\\n                                    if (dealsheet)\\n                                        controller.checkDealsheetAndPreventForm(dealsheet.approvalRequested, dealsheet.approved, dealsheet.rejected);\\n                                    resolve();\\n                                });\\n                            }\\n                            else {\\n                                resolve();\\n                            }\\n                        });\\n                    }\\n                    else {\\n                        console.log(\\\"DOESN't HAVE COMPANY OR JOB ID\\\");\\n                        resolve();\\n                    }\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            console.log(\\\"Newbury Prevent Placement Creation\\\", form.data);\\n            return controller.init();\\n        }\",\"sortOrder\":1,\"dateLastModified\":1764071348723},{\"id\":811,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":8454912,\"firstName\":\"Deal Sheet NPE\",\"lastName\":\"Admin User\"},\"name\":\"copy ds id to placement\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            dealsheetPathAtJobSubmission: \\\"customFloat3\\\",\\n            dealsheetPathAtPlacement: \\\"customText32\\\",\\n            getPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id + \\\"?fields=id,jobSubmission(customFloat3,customText8,customText10)\\\";\\n                    console.log(\\\"Newbury copy DS id to placement FI  getPlacement url\\\", url);\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            updatePlacementUsingLoggedInUser: function (id, body) {\\n                console.log(\\\"Newbury copy DS to placement: updatePlacement params\\\", id, body);\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id;\\n                    API.appBridge.httpPOST(url, body).then(function (result) {\\n                        resolve(result);\\n                    });\\n                });\\n            },\\n            getSubmission: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/JobSubmission/\\\" + id + \\\"?fields=id,customText6,customText8,customFloat3\\\";\\n                    console.log(\\\"Newbury copy DS id to placement FI  getSubmission url\\\", url);\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            updatePlacementFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    var query = {\\n                        query: {\\n                            type: 'updatePlacement',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"updatePlacementFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object updatePlacementFunc', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"updatePlacementFunc error\\\", error);\\n                        controller.updatePlacementUsingLoggedInUser(data.id, data.body).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            updatePlacement: function (id, body) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return controller.updatePlacementFunc({ id: id, body: body });\\n            },\\n            copyDealsheetIdToPlacement: function (id, submissionId) {\\n                return new Promise(function (resolve) {\\n                    controller.getSubmission(submissionId).then(function (jobSubmission) {\\n                        console.log(\\\"Newbury copy DS id to placement FI  placement\\\", jobSubmission);\\n                        if (jobSubmission[controller.dealsheetPathAtJobSubmission] && jobSubmission[controller.dealsheetPathAtJobSubmission]) {\\n                            console.log(\\\"Newbury copy DS id to placement FI  DS ID\\\", jobSubmission[controller.dealsheetPathAtJobSubmission]);\\n                            controller.updatePlacement(id, { customText32: jobSubmission[controller.dealsheetPathAtJobSubmission] }).then(function () {\\n                                resolve();\\n                            });\\n                        }\\n                        else {\\n                            resolve();\\n                        }\\n                    });\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            var data;\\n            if (Array.isArray(form.data[0].data))\\n                data = form.data[0].data[0];\\n            else if (Array.isArray(form.data[0]))\\n                data = form.data[0];\\n            else\\n                data = form.data[1].data[0];\\n            var placementId = data.filter(function (item) { return item.changedEntityType === \\\"Placement\\\"; })[0].changedEntityId;\\n            var submissionId = data.filter(function (item) { return item.changedEntityType === \\\"JobSubmission\\\"; })[0].changedEntityId;\\n            console.log(\\\"Newbury MAK testing\\\", placementId, submissionId);\\n            if (placementId) {\\n                return controller.copyDealsheetIdToPlacement(placementId, submissionId);\\n            }\\n            else {\\n                return;\\n            }\\n        }\\n        else {\\n            return;\\n        }\",\"sortOrder\":1,\"dateLastModified\":1764071348747},{\"id\":812,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":8454912,\"firstName\":\"Deal Sheet NPE\",\"lastName\":\"Admin User\"},\"name\":\"copy job submission status to ds\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            getSubmission: function (id) {\\n                var url = \\\"entity/JobSubmission/\\\" + id + \\\"?fields=id,customFloat3,status\\\";\\n                return API.appBridge.httpGET(url).then(function (response) {\\n                    return Promise.resolve(response.data.data);\\n                });\\n            },\\n            copyStatus: function (jobSubmission) {\\n                var url = \\\"https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1\\\";\\n                var query = {\\n                    auditData: {\\n                        userId: API.globals.user.userId\\n                    },\\n                    query: {\\n                        type: 'updateSubmission',\\n                        params: {\\n                            dealSheetId: jobSubmission.customFloat3,\\n                        },\\n                        data: {\\n                            jobSubmissionStatus: jobSubmission.status,\\n                            jobSubmissionId: jobSubmission.id\\n                        }\\n                    }\\n                };\\n                if (controller.isDuplicateSubmission()) {\\n                    return;\\n                }\\n                fetch(url, {\\n                    method: 'post',\\n                    body: JSON.stringify(query)\\n                }).then(function (response) {\\n                    return response.json();\\n                }).then(function (data) {\\n                    console.log('done updating');\\n                });\\n            },\\n            isDuplicateSubmission: function () {\\n                return form.data[0] && form.data[0].messages && form.data[0].messages.length > 0;\\n            },\\n            isDealSheet: function (submission) {\\n                return submission.customFloat3;\\n            },\\n            init: function () {\\n                console.log(\\\"Newbury  the form\\\", form);\\n                var contexts = ['ChangeStatus', '', 'FastAdd'];\\n                // @ts-ignore\\n                if (API.currentEntity === 'JobSubmission' && contexts.indexOf(API.pageContext) > -1) {\\n                    var submissionId_1 = (form.data && form.data.changedEntityId) || (form.data && form.data[0] && form.data[0].changedEntityId) || form.data.data[0].changedEntityId;\\n                    controller.getSubmission(submissionId_1).then(function (jobSubmission) {\\n                        if (controller.isDealSheet(jobSubmission)) {\\n                            console.log('isDealsheet');\\n                            controller.copyStatus(jobSubmission);\\n                        }\\n                        console.log('the form', form.data, form.controls);\\n                    });\\n                }\\n                else if (API.currentEntity === 'JobSubmission' && API.pageContext === \\\"MoveToPlacement\\\") {\\n                    var data;\\n                    if (Array.isArray(form.data[0].data))\\n                        data = form.data[0].data[0];\\n                    else if (Array.isArray(form.data[0]))\\n                        data = form.data[0];\\n                    else\\n                        data = form.data[1].data[0];\\n                    console.log(\\\"Newbury data\\\", data);\\n                    var submissionId;\\n                    if (data[0] && data[0].changedEntityType == \\\"JobSubmission\\\") {\\n                        submissionId = data[0].changedEntityId;\\n                    }\\n                    else if (data[1] && data[1].changedEntityType == \\\"JobSubmission\\\") {\\n                        submissionId = data[1].changedEntityId;\\n                    }\\n                    else if (data[2] && data[2].changedEntityType == \\\"JobSubmission\\\") {\\n                        submissionId = data[2].changedEntityId;\\n                    }\\n                    console.log(\\\"Newbury submissionId\\\", submissionId);\\n                    controller.getSubmission(submissionId).then(function (jobSubmission) {\\n                        if (controller.isDealSheet(jobSubmission)) {\\n                            console.log('isDealsheet');\\n                            controller.copyStatus(jobSubmission);\\n                        }\\n                        console.log('the form', form.data, form.controls);\\n                    });\\n                }\\n            }\\n        };\\n        controller.init();\",\"sortOrder\":1,\"dateLastModified\":1764071348777},{\"id\":813,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":8454912,\"firstName\":\"Deal Sheet NPE\",\"lastName\":\"Admin User\"},\"name\":\"track rate card changes\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            dealsheetEarnCodes: [\\\"REG\\\", \\\"OT\\\"],\\n            getLatestChange: function (jobOrderId) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"query/JobOrderRateCardEditHistory?where=targetEntity.jobPosting.id=\\\" + jobOrderId + \\\"&orderBy=-dateAdded&count=1&fields=id,dateAdded,\\\\n          lineFieldChanges[500](id,columnName,earnCode(id,code)),versionID,versionEditHistoryActionLookup,targetEntity(jobPosting(id,startDate))\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data[0]);\\n                    });\\n                });\\n            },\\n            callAutoDealsheet: function (jobId) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"https://dev.fastaff.dl-sheet.com/automatedDealsheet/automatedDealsheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1\\\";\\n                    var query = {\\n                        auditData: {\\n                            userId: API.globals.user.userId\\n                        },\\n                        entityIds: [jobId]\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('done updating');\\n                    });\\n                });\\n            },\\n            getCurrentVersion: function (mainVerionId, versionDate) {\\n                console.log(\\\"getCurrentVersion\\\");\\n                return new Promise(function (resolve) {\\n                    var url = \\\"/entity/JobOrderRateCard/\\\" + mainVerionId + \\\"?effectiveOn=\\\" + versionDate + \\\"&fields=id,versionID\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            checkIfThisVersionUsedOnDealsheet: function (mainVersionId, jobStartDate, versionId) {\\n                return new Promise(function (resolve) {\\n                    jobStartDate = new Date(jobStartDate);\\n                    var formattedDate = jobStartDate.getFullYear() + \\\"-\\\" + (jobStartDate.getMonth() + 1) + \\\"-\\\" + jobStartDate.getDate();\\n                    controller.getCurrentVersion(mainVersionId, formattedDate).then(function (currentVersion) {\\n                        console.log(\\\"currentVersion\\\", currentVersion);\\n                        console.log(\\\"formattedDate\\\", formattedDate);\\n                        if (Number(currentVersion.versionID) === Number(versionId)) {\\n                            resolve(true);\\n                        }\\n                        else {\\n                            resolve(false);\\n                        }\\n                    });\\n                });\\n            },\\n            checkDealsheetRateChanges: function () {\\n                var jobOrderId = form.data.data.data.jobPosting.id;\\n                var mainVersionId = form.data.data.changedEntityId;\\n                controller.getLatestChange(jobOrderId).then(function (editRecord) {\\n                    console.log(\\\"editRecord\\\", editRecord);\\n                    var jobStartDate = editRecord.targetEntity.jobPosting.startDate;\\n                    var versionId = editRecord.versionID;\\n                    console.log(\\\"mainVersionId\\\", mainVersionId);\\n                    console.log(\\\"jobStartDate\\\", jobStartDate);\\n                    console.log(\\\"versionId\\\", versionId);\\n                    if (editRecord.versionEditHistoryActionLookup.label.toLowerCase() === \\\"update\\\") {\\n                        var hasDealsheetRateChange = editRecord.lineFieldChanges.data\\n                            .find(function (item) { return item.columnName === \\\"billRate\\\" && controller.dealsheetEarnCodes.indexOf(item.earnCode.code) > -1; });\\n                        console.log(\\\"hasDealsheetRateChange\\\", hasDealsheetRateChange);\\n                        if (hasDealsheetRateChange) {\\n                            controller.checkIfThisVersionUsedOnDealsheet(mainVersionId, jobStartDate, versionId).then(function (isVersionUsedOnDealsheet) {\\n                                if (isVersionUsedOnDealsheet) {\\n                                    console.log(\\\"VERSION USED AND WILL CALL AUTO DS HERE\\\");\\n                                    controller.callAutoDealsheet(jobOrderId);\\n                                }\\n                                else {\\n                                    console.log(\\\"VERSION NOT USED ON DS\\\");\\n                                }\\n                            });\\n                        }\\n                    }\\n                    else {\\n                        controller.checkIfThisVersionUsedOnDealsheet(mainVersionId, jobStartDate, versionId).then(function (isVersionUsedOnDealsheet) {\\n                            if (isVersionUsedOnDealsheet) {\\n                                console.log(\\\"VERSION USED AND WILL CALL AUTO DS HERE\\\");\\n                                controller.callAutoDealsheet(jobOrderId);\\n                            }\\n                            else {\\n                                console.log(\\\"VERSION NOT USED ON DS\\\");\\n                            }\\n                        });\\n                    }\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobOrderRateCard\\\") {\\n            controller.checkDealsheetRateChanges();\\n        }\",\"sortOrder\":1,\"dateLastModified\":1764071348800},{\"id\":814,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":8454912,\"firstName\":\"Deal Sheet NPE\",\"lastName\":\"Admin User\"},\"name\":\"set ds status to final\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            getJobSubmission: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/JobSubmission/\\\" + id + \\\"?fields=id,customFloat3\\\";\\n                    console.log(\\\"Newbury DS SET TO FINAL getJobSubmission url\\\", url);\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            setDealSheetToFinal: function (id) {\\n                return new Promise(function (resolve) {\\n                    controller.getJobSubmission(API.currentEntityId).then(function (jobSubmission) {\\n                        console.log(\\\"Newbury DS SET TO FINAL jobSubmission\\\", jobSubmission);\\n                        if (jobSubmission.customFloat3 && jobSubmission.customFloat3.length) {\\n                            console.log(\\\"Newbury DS SET TO FINAL DS ID\\\", jobSubmission.customFloat3);\\n                            var url = 'https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                            var query = {\\n                                auditData: {\\n                                    userId: API.globals.user.userId\\n                                },\\n                                query: {\\n                                    type: 'setToFinal',\\n                                    params: {\\n                                        dealSheetId: jobSubmission.customFloat3,\\n                                    },\\n                                    data: {}\\n                                }\\n                            };\\n                            fetch(url, {\\n                                method: 'post',\\n                                body: JSON.stringify(query)\\n                            }).then(function (response) {\\n                                return response.json();\\n                            }).then(function (data) {\\n                                console.log('DS SET TO FINAL done updating');\\n                                resolve();\\n                            });\\n                        }\\n                        else {\\n                            resolve();\\n                        }\\n                    });\\n                });\\n            }\\n        };\\n        if (API.currentEntity === \\\"JobSubmission\\\" && API.pageContext === \\\"MoveToPlacement\\\") {\\n            console.log(\\\"Newbury DS SET TO FINAL API\\\", API);\\n            console.log(\\\"Newbury PDS SET TO FINAL ID\\\", API.currentEntityId);\\n            console.log(\\\"Newbury DS SET TO FINAL form\\\", form);\\n            if (API.currentEntityId) {\\n                return controller.setDealSheetToFinal(API.currentEntityId);\\n            }\\n        }\\n        else {\\n            return;\\n        }\",\"sortOrder\":1,\"dateLastModified\":1764071348827},{\"id\":815,\"action\":\"overview-field-modify\",\"modifyingUser\":{\"id\":8454912,\"firstName\":\"Deal Sheet NPE\",\"lastName\":\"Admin User\"},\"name\":\"redirect-to-ds\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            getDealsheet: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    var query = {\\n                        query: {\\n                            type: 'getMostIncrementedDs',\\n                            params: {\\n                                dealSheetId: id,\\n                            },\\n                            data: {}\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            },\\n            getPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id + \\\"?fields=id,jobOrder(id)\\\";\\n                    console.log(\\\"Newbury copy DS id to placement FI  getPlacement url\\\", url);\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            buildDealseheetUrl: function () {\\n                return new Promise(function (resolve) {\\n                    controller.getPlacement(API.currentEntityId).then(function (placement) {\\n                        var userId = API.globals.user.userId;\\n                        var corpId = API.globals.user.corporationId;\\n                        var plId = API.globals.user.privateLabelId;\\n                        var dealsheetId = data.customText32;\\n                        var entityID = placement.jobOrder.id;\\n                        controller.getDealsheet(dealsheetId).then(function (dealSheet) {\\n                            console.log(\\\"Newbury dealSheet\\\", dealSheet);\\n                            dealsheetId = dealSheet.id;\\n                            var baseUrl = \\\"https://dealsheet-ng-dev-fastaff.s3.amazonaws.com/index.html#/compare-deal-sheet?isComparable=y\\\";\\n                            var url = baseUrl + \\\"&dealSheetIdParam=\\\" + dealsheetId + \\\"&EntityType=JobOrder&EntityID=\\\" + entityID + \\\"&UserID=\\\" + userId + \\\"&CorporationID=\\\" + corpId + \\\"&PrivateLabelID=\\\" + plId;\\n                            console.log(\\\"Newbury adding on click function\\\", API, field, data, url);\\n                            field.onClick = function () {\\n                                var openedWindow = window.open(url);\\n                                openedWindow = window;\\n                            };\\n                            resolve();\\n                        });\\n                    });\\n                });\\n            },\\n        };\\n        if (field.name === 'customText32' && data.customText32 && API.currentEntity === \\\"Placement\\\") {\\n            console.log(\\\"Newbury opening DS \\\");\\n            return controller.buildDealseheetUrl();\\n        }\",\"sortOrder\":1,\"dateLastModified\":1764071348863},{\"id\":816,\"action\":\"tab-modify\",\"modifyingUser\":{\"id\":8454912,\"firstName\":\"Deal Sheet NPE\",\"lastName\":\"Admin User\"},\"name\":\"add count to dealsheet tab\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            dealSheetTabName: 'Deal Sheet',\\n            clientDomain: \\\"dev.fastaff.dl-sheet.com\\\",\\n            getJob: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/JobOrder/\\\" + id + \\\"?fields=id,correlatedCustomText3\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getDealSheetCount: function (id, entity) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"https://\\\" + controller.clientDomain + \\\"/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1\\\";\\n                    var whereObj = entity == 'Candidate' ? { \\\"DealSheetCandidate.bullhornCandidateId\\\": id } : { \\\"DealSheetJob.bullhornJobId\\\": id };\\n                    whereObj[\\\"status\\\"] = [\\\"Sent\\\", \\\"Final\\\", \\\"Draft\\\", \\\"Submitted\\\", \\\"Locked\\\"];\\n                    var query = {\\n                        \\\"query\\\": {\\n                            \\\"type\\\": \\\"getDealSheets\\\",\\n                            \\\"params\\\": {\\n                                \\\"where\\\": whereObj,\\n                                \\\"sort\\\": { \\\"updatedAt\\\": \\\"desc\\\" },\\n                                \\\"offset\\\": 0,\\n                                \\\"limit\\\": 10\\n                            }\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('ds data ==>', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            }\\n        };\\n        if ((API.currentEntity === 'Candidate' || API.currentEntity === 'JobOrder') && item.label === controller.dealSheetTabName) {\\n            var id_1 = API.currentEntityId;\\n            controller.getDealSheetCount(id_1, API.currentEntity).then(function (res) {\\n                console.log(\\\"for \\\" + API.currentEntity + \\\" with entity id \\\" + id_1 + \\\" res is ==>\\\", res);\\n                item.label = item.label + (\\\" (\\\" + res.parentLength + \\\")\\\");\\n            }).catch(function (err) {\\n                console.log('error=>', err);\\n            });\\n        }\\n        // if(API.currentEntity === 'JobOrder' && item.label.startsWith(controller.dealSheetTabName)){\\n        //     controller.getJob(API.currentEntityId).then((res:any)=>{\\n        //         if(!res.correlatedCustomText3 || res.correlatedCustomText3 !== \\\"Fastaff\\\" || res.correlatedCustomText3 !== \\\"Springboard\\\"){\\n        //             item.hidden = true;\\n        //         }\\n        //     })\\n        // }\",\"sortOrder\":1,\"dateLastModified\":1764071348893},{\"id\":61,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"create-location-from-address-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            init: function () {\\n                return app.createLocation();\\n            },\\n            createLocation: function () {\\n                var address = form.controls.address.value;\\n                var stateIds = form.controls.address.config.state.pickerConfig.defaultOptions;\\n                var stateID = stateIds.findIndex(function (item) {\\n                    return item.value === address.state;\\n                });\\n                var clientCorporationId = form.data.changedEntityId;\\n                return API.appBridge.httpPUT('entity/Location', {\\n                    address: {\\n                        address1: address.address1,\\n                        address2: address.address2,\\n                        city: address.city,\\n                        state: address.state,\\n                        zip: address.zip,\\n                        countryID: address.countryID,\\n                        stateID: stateID,\\n                    },\\n                    title: 'Company Address',\\n                    clientCorporation: {\\n                        id: clientCorporationId,\\n                    },\\n                    effectiveDate: app.getTodayDate(),\\n                    status: 'Active',\\n                    declineToApplyTaxes: true,\\n                    isBillTo: true,\\n                    isWorkSite: true,\\n                }).then(function () {\\n                    console.log('Saved new location');\\n                    return Promise.resolve();\\n                });\\n            },\\n            getTodayDate: function () {\\n                var date = new Date().toJSON().slice(0, 10).split('-')\\n                    .reverse();\\n                return date[2] + \\\"-\\\" + date[1] + \\\"-\\\" + date[0];\\n            },\\n        };\\n        if (API.currentEntity === 'ClientCorporation' && form.data.changeType === 'INSERT') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":1,\"dateLastModified\":1702008562810},{\"id\":73,\"action\":\"overview-field-modify\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"make-placement-overview-status-field-readonly\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            init: function () {\\n                if (field.name === 'status') {\\n                    field.readOnly = true;\\n                }\\n            },\\n        };\\n        if (API.currentEntity === 'Placement') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":5,\"dateLastModified\":1702008563070},{\"id\":74,\"action\":\"add-edit-presave\",\"modifyingUser\":{\"id\":2916727,\"firstName\":\"1218 USN\",\"lastName\":\"API User\"},\"name\":\"placement-candidate-status-check\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            baseUrl: API.http.restURL,\\n            init: function () {\\n                var candidateID = form.data.candidate.id;\\n                return app.getCandidate(candidateID).then(function (candidate) {\\n                    var status = candidate.status;\\n                    var statusError = app.validateStatus(status);\\n                    if (statusError) {\\n                        form.isFormValid = false;\\n                        form.errorMessage = statusError.errorMessage;\\n                    }\\n                    return Promise.resolve();\\n                });\\n            },\\n            validateStatus: function (result) {\\n                if (result === 'Clinical Review' || result === 'Not Qualified' || result === 'Inactive' || result === 'Terminated' || result === 'Deceased' || result === 'Do Not Contact') {\\n                    return { isFormValid: false, errorMessage: 'Candidate status invalid' };\\n                }\\n                return undefined;\\n            },\\n            getCandidate: function (candidateID) {\\n                var url = app.baseUrl + \\\"/entity/Candidate/\\\" + candidateID + \\\"?fields=id,status\\\";\\n                return API.http.get(url).toPromise().then(function (result) {\\n                    var finalresult = result.data;\\n                    return Promise.resolve(finalresult);\\n                }, function (err) {\\n                    console.log(err);\\n                    return Promise.reject();\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'JobSubmission' && API.pageContext === 'MoveToPlacement') {\\n            return app.init();\\n        }\\n        return Promise.resolve();\",\"sortOrder\":5,\"dateLastModified\":1702008563090},{\"id\":817,\"action\":\"overview-field-modify\",\"modifyingUser\":{\"id\":9011908,\"firstName\":\"fastaff ms\",\"lastName\":\"api npe\"},\"name\":\"contract-created-toggle-1218_SOLEN-8182\",\"page\":\"record\",\"enabled\":true,\"script\":\"const app = {\\n            toggleField: 'customFloat1',\\n            brandField: 'customText20',\\n            init() {\\n                return app.getOpportunity().then(app.handleOpportunity);\\n            },\\n            handleOpportunity(entity) {\\n                const defaultValue = entity[app.toggleField] || 0;\\n                if (defaultValue === 1) {\\n                    data[app.toggleField] = 'Yes';\\n                }\\n                else {\\n                    data[app.toggleField] = 'Generate Candidate Contract';\\n                    API.injectCustomStyles('custom-style', '.customFloat1custom>value { color: #4a89dc; font-weight: 500; } .customFloat1custom>value:hover { color: rgb(39.375, 110.25, 203.625); }');\\n                    field.className = 'customFloat1custom';\\n                    field.onClick = () => {\\n                        console.log('Opportunity - contract-created-toggle-1218', data, API);\\n                        API.appBridge.httpPOST(`entity/Opportunity/${API.currentEntityId}`, {\\n                            [app.toggleField]: 1,\\n                        }).then(() => {\\n                            data[app.toggleField] = 'Yes';\\n                            field.className = '';\\n                            field.onClick = null;\\n                            API.appBridge.open({\\n                                type: 'record', entityType: 'Opportunity', entityId: API.currentEntityId,\\n                            });\\n                        });\\n                    };\\n                }\\n                return Promise.resolve(data);\\n            },\\n            // : Promise<{} | undefined>\\n            getOpportunity() {\\n                return API.appBridge.httpGET(`/entity/Opportunity/${API.currentEntityId}?fields=${app.brandField},${app.toggleField}`).then((result) => {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data;\\n                    }\\n                    return undefined;\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'Opportunity' && field.name === app.toggleField) {\\n            console.log('Opportunity - contract-created-toggle-1218', field, data, API);\\n            return app.init();\\n        }\\n        return Promise.resolve(data);\",\"sortOrder\":5,\"dateLastModified\":1776105546447},{\"id\":752,\"action\":\"overview-field-modify\",\"modifyingUser\":{\"id\":21,\"firstName\":\"Jessie\",\"lastName\":\"Levi NPE\"},\"name\":\"contract-created-toggle-1218\",\"page\":\"record\",\"enabled\":true,\"script\":\"var app = {\\n            toggleField: 'correlatedCustomInt2',\\n            brandField: 'customText20',\\n            init: function () {\\n                return app.getOpportunity().then(app.handleOpportunity);\\n            },\\n            handleOpportunity: function (entity) {\\n                // if (entity[app.brandField] !== 'USN') {\\n                //     return Promise.resolve(data);\\n                // }\\n                \\n                \\n\\n        const defaultValue = entity[app.toggleField] || 0;\\n        if (defaultValue === 1) {\\n          data[app.toggleField] = 'Yes';\\n        } else {\\n          data[app.toggleField] = 'Generate Candidate Contract';\\n          API.injectCustomStyles(\\n            'custom-style',\\n            '.correlatedCustomInt2custom>value { color: #4a89dc; font-weight: 500; } .correlatedCustomInt2custom>value:hover { color: rgb(39.375, 110.25, 203.625); }',\\n          );\\n          field.className = 'correlatedCustomInt2custom';\\n          field.onClick = () => {\\n            console.log('Opportunity - contract-created-toggle-1218', data, API);\\n            API.appBridge.httpPOST(`entity/Opportunity/${API.currentEntityId}`, { [app.toggleField]: 1 })\\n              .then(() => {\\n                data[app.toggleField] = 'Yes';\\n                field.className = '';\\n                field.onClick = null;\\n                API.appBridge.open({ type: 'record', entityType: 'Opportunity', entityId: API.currentEntityId });\\n              });\\n          };\\n        }\\n                return Promise.resolve(data);\\n            },\\n            // : Promise<{} | undefined>\\n            getOpportunity: function () {\\n                return API.appBridge.httpGET(\\\"/entity/Opportunity/\\\" + API.currentEntityId + \\\"?fields=\\\" + app.brandField + \\\",\\\" + app.toggleField).then(function (result) {\\n                    if (result.data && result.data.data) {\\n                        return result.data.data;\\n                    }\\n                    return undefined;\\n                });\\n            },\\n        };\\n        if (API.currentEntity === 'Opportunity' && field.name === app.toggleField) {\\n            console.log('Opportunity - contract-created-toggle-1218', field, data, API);\\n            return app.init();\\n        }\\n        return Promise.resolve(data);\",\"sortOrder\":5,\"dateLastModified\":1751259188543},{\"id\":809,\"action\":\"add-edit-postsave\",\"modifyingUser\":{\"id\":8454912,\"firstName\":\"Deal Sheet NPE\",\"lastName\":\"Admin User\"},\"name\":\"copy ds data to placement\",\"page\":\"record\",\"enabled\":true,\"script\":\"var controller = {\\n            dealsheetPathAtPlacement: \\\"customText32\\\",\\n            clientName: \\\"Fastaff\\\",\\n            coInstance: \\\"2\\\",\\n            getPlacement: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id + \\\"?fields=id,employmentType,customText32,dateBegin,jobOrder(id,billingProfile(id),customInt1,correlatedCustomInt3,customFloat3,customText5,correlatedCustomFloat3,correlatedCustomFloat2),clientCorporation(customFloat2)\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getBillingCustomObject: function (jobId) {\\n                var url = \\\"query/JobOrderCustomObjectInstance\\\" + controller.coInstance + \\\"?where=jobOrder.id=\\\" + jobId + \\\"&fields=text1,text4,float1,float2,float3,float4,float5,float6,float7,float8,float9&count=500\\\"; // should never reach that count amount so no need for any recursive calls with more data\\n                return new Promise(function (resolve) {\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getJob: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/JobOrder/\\\" + id + \\\"?fields=id,skills,categories,customInt1\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getBillingTerm: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"https://dev.fastaff.dl-sheet.com/billingTermsIntegration/getProfile/\\\" + id + \\\"?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1\\\";\\n                    fetch(url, {\\n                        method: 'get',\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('getBillingTerm ', data);\\n                        resolve(data);\\n                    });\\n                });\\n            },\\n            getCurrentVersionUsingLoggedInUser: function (mainVerionId, versionDate) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return new Promise(function (resolve) {\\n                    var url = \\\"/entity/PlacementRateCard/\\\" + mainVerionId + \\\"?effectiveOn=\\\" + versionDate + \\\"&fields=id,placementRateCardLineGroups[200]\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        resolve(result.data.data);\\n                    });\\n                });\\n            },\\n            getBasicVersionIdsUsingLoggedInUser: function (placementId, placementRateCardStatus) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"query/PlacementRateCard?where=placement.id=\\\" + placementId + \\\"&&fields=id,versions,placementRateCardStatusLookup(id,label)\\\";\\n                    API.appBridge.httpGET(url).then(function (response) {\\n                        console.log(\\\"responseresponseresponseresponse\\\", response);\\n                        console.log(\\\"placementRateCardStatus\\\", placementRateCardStatus);\\n                        if (response.data.data.length && response.data.data[0].placementRateCardStatusLookup.id !== placementRateCardStatus.id) {\\n                            API.appBridge.httpPOST(\\\"entity/PlacementRateCard/\\\" + response.data.data[0].id, {\\n                                placementRateCardStatusLookup: { id: placementRateCardStatus.id }\\n                            }).then(function (res2) {\\n                                resolve(response.data.data);\\n                            });\\n                        }\\n                        else {\\n                            resolve(response.data.data);\\n                        }\\n                    });\\n                });\\n            },\\n            updateExisitngPlacementRateCardUsingLoggedInUser: function (rate, mainVerionId) {\\n                console.log(\\\"updatedVersion\\\", rate);\\n                return new Promise(function (resolve) {\\n                    var url = \\\"/entity/PlacementRateCard/\\\" + mainVerionId;\\n                    API.appBridge.httpPOST(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            insertNewVersionUsingLoggedInUser: function (rate, mainVerionId) {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"/entity/PlacementRateCard/\\\" + mainVerionId;\\n                    API.appBridge.httpPOST(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            saveRateBH1UsingLoggedInUser: function (rate) {\\n                console.log(\\\"Newbury copy DS to placement: saveRateBH1UsingLoggedInUser\\\");\\n                return new Promise(function (resolve) {\\n                    var url = '/entity/PlacementRateCard';\\n                    API.appBridge.httpPUT(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            getCurrentVersionFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    var query = {\\n                        query: {\\n                            type: 'getCurrentVersion',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"getCurrentVersionFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object getCurrentVersion', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"getCurrentVersionFunc error\\\", error);\\n                        controller.getCurrentVersionUsingLoggedInUser(data.mainVerionId, data.versionDate).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            getBasicVersionIdsFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    var query = {\\n                        query: {\\n                            type: 'getBasicVersionIds',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"getBasicVersionIdsFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object getBasicVersionIds', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"getBasicVersionIdsFunc error\\\", error);\\n                        controller.getBasicVersionIdsUsingLoggedInUser(data.placementId, data.placementRateCardStatus).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            updateExisitngPlacementRateCardFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    var query = {\\n                        query: {\\n                            type: 'updateExisitngPlacementRateCard',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"updateExisitngPlacementRateCardFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object updateExisitngPlacementRateCard', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"updateExisitngPlacementRateCardFunc error\\\", error);\\n                        controller.updateExisitngPlacementRateCardUsingLoggedInUser(data.rate, data.mainVerionId).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            insertNewVersionFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    var query = {\\n                        query: {\\n                            type: 'insertNewVersion',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"insertNewVersionFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object insertNewVersion', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"insertNewVersionFunc error\\\", error);\\n                        controller.insertNewVersionUsingLoggedInUser(data.rate, data.mainVerionId).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            saveRateBH1Func: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    var query = {\\n                        query: {\\n                            type: 'saveRateBH1',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"saveRateBH1Func response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object saveRateBH1', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"saveRateBH1Func error\\\", error);\\n                        controller.saveRateBH1UsingLoggedInUser(data.rate).then(function () { resolve(); });\\n                    });\\n                });\\n            },\\n            getDealsheet: function (id) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    var query = {\\n                        query: {\\n                            type: 'getMostIncrementedDs',\\n                            params: {\\n                                dealSheetId: id,\\n                            },\\n                            data: {}\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object', data);\\n                        resolve(data.result);\\n                    });\\n                });\\n            },\\n            getHealthBenefitsRecords: function () {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/healthBenefits/healthBenefits/read?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    fetch(url, {\\n                        method: 'get',\\n                    }).then(function (response) {\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: healthBenefits', data);\\n                        resolve(data);\\n                    });\\n                });\\n            },\\n            mapBillRatesToObject: function (job, jobCo) {\\n                console.log(\\\"Newbury jobCo\\\", jobCo);\\n                var jobSpeciality = job.skills && job.skills.data && job.skills.data.length ? job.skills.data[0].name : \\\"\\\";\\n                var jobProfession = job.categories && job.categories.data && job.categories.data.length ? job.categories.data[0].name : \\\"\\\";\\n                var billRateObject, onCallRate, onCallRateObject, chargeRate, chargeRatebject, rate8Object, rate12Object, rate40Object, rate48Object, billRatebject, holidayRatebject, callBackRatebject, rate8, rate12, rate40, rate48, billRate, hoildayRate, callBackRate;\\n                if (controller.clientName == \\\"TaleMed\\\" || controller.clientName == \\\"HAN\\\") {\\n                    billRatebject = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float1 && item.float1 > 0; });\\n                    rate8Object = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float3 && item.float3 > 0; });\\n                    rate12Object = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float5 && item.float5 > 0; });\\n                    rate40Object = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float2 && item.float2 > 0; });\\n                    rate48Object = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float4 && item.float4 > 0; });\\n                    holidayRatebject = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float6 && item.float6 > 0; });\\n                    callBackRatebject = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float8 && item.float8 > 0; });\\n                    chargeRatebject = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float9 && item.float9 > 0; });\\n                    onCallRateObject = jobCo.find(function (item) { return item.text1 === jobSpeciality && item.text4 == jobProfession && item.float7 && item.float7 > 0; });\\n                    billRate = billRatebject ? billRatebject.float1 : 0;\\n                    rate8 = rate8Object ? rate8Object.float3 : 0;\\n                    rate12 = rate12Object ? rate12Object.float5 : 0;\\n                    rate40 = rate40Object ? rate40Object.float2 : 0;\\n                    rate48 = rate48Object ? rate48Object.float4 : 0;\\n                    hoildayRate = holidayRatebject ? holidayRatebject.float6 : 0;\\n                    callBackRate = callBackRatebject ? callBackRatebject.float8 : 0;\\n                    chargeRate = chargeRatebject ? chargeRatebject.float9 : 0;\\n                    onCallRate = onCallRateObject ? onCallRateObject.float7 : 0;\\n                }\\n                else {\\n                    billRateObject = jobCo.find(function (item) { return item.text1 === \\\"Bill Rate $\\\"; });\\n                    rate8Object = jobCo.find(function (item) { return item.text1 === \\\">8 Bill Rate\\\"; });\\n                    rate12Object = jobCo.find(function (item) { return item.text1 === \\\">12 Bill Rate\\\"; });\\n                    rate40Object = jobCo.find(function (item) { return item.text1 === \\\">40 Bill Rate\\\"; });\\n                    rate48Object = jobCo.find(function (item) { return item.text1 === \\\">48 Bill Rate\\\"; });\\n                    holidayRatebject = jobCo.find(function (item) { return item.text1 === \\\"Holiday Bill Rate\\\"; });\\n                    callBackRatebject = jobCo.find(function (item) { return item.text1 === \\\"Call Back Bill Rate\\\"; });\\n                    onCallRateObject = jobCo.find(function (item) { return item.text1 === \\\"On-Call Bill Rate\\\"; });\\n                    chargeRatebject = jobCo.find(function (item) { return item.text1 === \\\"Charge Rate\\\"; });\\n                    rate8 = rate8Object ? rate8Object.float1 : 0;\\n                    rate12 = rate12Object ? rate12Object.float1 : 0;\\n                    rate40 = rate40Object ? rate40Object.float1 : 0;\\n                    rate48 = rate48Object ? rate48Object.float1 : 0;\\n                    hoildayRate = holidayRatebject ? holidayRatebject.float1 : 0;\\n                    callBackRate = callBackRatebject ? callBackRatebject.float1 : 0;\\n                    chargeRate = chargeRatebject ? chargeRatebject.float1 : 0;\\n                    onCallRate = onCallRateObject ? onCallRateObject.float1 : 0;\\n                    billRate = billRateObject ? billRateObject.float1 : 0;\\n                }\\n                console.log(\\\"Newbury chargeRate\\\", chargeRate);\\n                billRateObject = {\\n                    billRate: billRate,\\n                    rate8: rate8,\\n                    rate12: rate12,\\n                    rate40: rate40,\\n                    rate48: rate48,\\n                    hoildayRate: hoildayRate,\\n                    callBackRate: callBackRate,\\n                    chargeRate: chargeRate,\\n                    onCallRate: onCallRate\\n                };\\n                return billRateObject;\\n            },\\n            updatePlacementUsingLoggedInUser: function (id, body) {\\n                console.log(\\\"Newbury copy DS to placement: updatePlacement params\\\", id, body);\\n                return new Promise(function (resolve) {\\n                    var url = \\\"entity/Placement/\\\" + id;\\n                    API.appBridge.httpPOST(url, body).then(function (result) {\\n                        resolve(result);\\n                    });\\n                });\\n            },\\n            updatePlacementFunc: function (data) {\\n                return new Promise(function (resolve) {\\n                    var url = 'https://dev.fastaff.dl-sheet.com/dealsheet/dealSheet?apiKey=ZILaanMFncCPEIXm0lzs3viVCgTtHVt1';\\n                    var query = {\\n                        query: {\\n                            type: 'updatePlacement',\\n                            data: data\\n                        }\\n                    };\\n                    fetch(url, {\\n                        method: 'post',\\n                        body: JSON.stringify(query)\\n                    }).then(function (response) {\\n                        console.log(\\\"updatePlacementFunc response\\\", response);\\n                        if (!response.ok) {\\n                            return Promise.reject(response);\\n                        }\\n                        return response.json();\\n                    }).then(function (data) {\\n                        console.log('copy DS to placement: DS Object updatePlacementFunc', data);\\n                        resolve(data.result);\\n                    }).catch(function (error) {\\n                        console.log(\\\"updatePlacementFunc error\\\", error);\\n                        controller.updatePlacementUsingLoggedInUser(data.id, data.body).then(function (res) { resolve(res); });\\n                    });\\n                });\\n            },\\n            updatePlacement: function (id, body) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return controller.updatePlacementFunc({ id: id, body: body });\\n            },\\n            addRateObjects: function (dealsheet, placement) {\\n                return new Promise(function (resolve) {\\n                    console.log(\\\"Newbury copy DS to placement: rates\\\", dealsheet);\\n                    var otBillRate8, otBillRate12, otBillRate40, otBillRate48;\\n                    otBillRate8 = dealsheet.DealSheetClient.billableOT === \\\"Over 8\\\" ? dealsheet.DealSheetJob.otBillRate : 0;\\n                    otBillRate12 = dealsheet.DealSheetClient.billableOT === \\\"Over 12\\\" ? dealsheet.DealSheetJob.otBillRate : 0;\\n                    otBillRate40 = dealsheet.DealSheetClient.billableOT === \\\"Over 40\\\" ? dealsheet.DealSheetJob.otBillRate : 0;\\n                    otBillRate48 = dealsheet.DealSheetClient.billableOT === \\\"Over 48\\\" ? dealsheet.DealSheetJob.otBillRate 