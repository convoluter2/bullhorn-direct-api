"Newbury copy DS to placement: saving rates done\\\");\\n                        resolve();\\n                    });\\n                });\\n            },\\n            getCurrentVersion: function (mainVerionId, versionDate) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return controller.getCurrentVersionFunc({ mainVerionId: mainVerionId, versionDate: versionDate });\\n            },\\n            getBasicVersionIds: function (placementId, placementRateCardStatus) {\\n                return controller.getBasicVersionIdsFunc({ placementId: placementId, placementRateCardStatus: placementRateCardStatus });\\n            },\\n            updateExisitngPlacementRateCard: function (rate, mainVerionId) {\\n                console.log(\\\"updatedVersion\\\", rate);\\n                return controller.updateExisitngPlacementRateCardFunc({ rate: rate, mainVerionId: mainVerionId });\\n            },\\n            insertNewVersion: function (rate, mainVerionId) {\\n                return controller.insertNewVersionFunc({ rate: rate, mainVerionId: mainVerionId });\\n            },\\n            saveRateBH1: function (rate) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return controller.saveRateBH1Func({ rate: rate });\\n            },\\n            saveRate: function (rate, id) {\\n                console.log(\\\"Newbury copy DS to placement: saving rate\\\");\\n                return new Promise(function (resolve) {\\n                    rate.placement = { id: id };\\n                    var url = '/entity/PlacementCustomObjectInstance1';\\n                    API.appBridge.httpPUT(url, rate).then(function () {\\n                        resolve();\\n                    });\\n                });\\n            },\\n            getEarnCodes: function () {\\n                return new Promise(function (resolve) {\\n                    var url = \\\"query/EarnCode?where=id>0\\\" + \\\"&fields=id,code,earnCodeGroup&count=500\\\";\\n                    API.appBridge.httpGET(url).then(function (result) {\\n                        if (API.appBridge)\\n                            resolve(result.data.data);\\n                        else\\n                            resolve(result.data);\\n                    });\\n                });\\n            },\\n            mapEarnCodeArrToObj: function (earnCodes) {\\n                var earnCodesObj = {};\\n                earnCodes.forEach(function (item) {\\n                    earnCodesObj[item.code] = item;\\n                });\\n                return earnCodesObj;\\n            },\\n            getDTBillRateModifier: function (billingTerm) {\\n                var multipler = billingTerm.dt_multiplier;\\n                var addOn = billingTerm.dt_add_on;\\n                if (multipler && addOn) {\\n                    multipler = 1;\\n                    addOn = 0;\\n                }\\n                var modifier = multipler ? \\\"*\\\" + multipler : addOn ? \\\"+\\\" + addOn : \\\"*1\\\";\\n                return modifier;\\n            },\\n            calculateRate: function (baseRate, modifier) {\\n                console.log('baseRate', baseRate, 'mod', modifier);\\n                var rateOperator, rateFactor;\\n                if (modifier && modifier.length && modifier[0] != \\\"*\\\" && modifier[0] != \\\"+\\\") {\\n                    rateOperator = '*';\\n                    rateFactor = modifier;\\n                }\\n                else {\\n                    modifier = modifier || '';\\n                    rateOperator = modifier[0] || '*';\\n                    rateFactor = modifier.slice(1) || '1';\\n                }\\n                var rate = 0;\\n                if (rateOperator === \\\"*\\\") {\\n                    rate = Number(baseRate) * Number(rateFactor);\\n                }\\n                else {\\n                    rate = Number(baseRate) + Number(rateFactor);\\n                }\\n                return rate;\\n            },\\n            getHolidayModifier: function (multiplier, addon) {\\n                if (!multiplier && !addon) {\\n                    return \\\"*1\\\";\\n                }\\n                if (multiplier && addon) {\\n                    multiplier = 0;\\n                }\\n                if (multiplier) {\\n                    return \\\"*\\\" + multiplier;\\n                }\\n                if (addon) {\\n                    return \\\"+\\\" + addon;\\n                }\\n            },\\n            getChargeModifier: function (multiplier, addon) {\\n                if (addon) {\\n                    return \\\"+\\\" + addon;\\n                }\\n                if (multiplier) {\\n                    return \\\"*\\\" + multiplier;\\n                }\\n            },\\n            calculateAdditionalCostRate: function (dealsheetData, item) {\\n                var amount;\\n                var shifts = dealsheetData.DealSheetJob.shifts;\\n                if (item.frequency === \\\"One-time\\\") {\\n                    if (item.calculation === \\\"$\\\") {\\n                        amount = Number(item.defaultAmount);\\n                    }\\n                    else {\\n                        if (item.calcAppliesTo !== \\\"Taxable Wages\\\") {\\n                            amount =\\n                                (Number(item.defaultAmount) * dealsheetData.assignmentRevenueAmount) / 100;\\n                        }\\n                        else {\\n                            amount =\\n                                (Number(item.defaultAmount) * dealsheetData.taxableWagesAmount) / 100;\\n                        }\\n                    }\\n                }\\n                else if (item.frequency == \\\"Weekly\\\") {\\n                    amount =\\n                        Number(item.defaultAmount) *\\n                            dealsheetData.DealSheetJob.contractLengthWeeks;\\n                }\\n                else if (item.frequency == \\\"Monthly\\\") {\\n                    amount =\\n                        (Number(item.defaultAmount) *\\n                            dealsheetData.DealSheetJob.contractLengthWeeks) /\\n                            4.34;\\n                }\\n                else if (item.frequency == \\\"Hourly\\\") {\\n                    amount =\\n                        Number(item.defaultAmount) * dealsheetData.totalPayableHours;\\n                }\\n                else if (item.frequency == \\\"Per Shift\\\") {\\n                    amount =\\n                        Number(item.defaultAmount) *\\n                            dealsheetData.DealSheetJob.contractLengthWeeks *\\n                            shifts;\\n                }\\n                return amount;\\n            },\\n            buildRateObjectBH1: function (dealsheet, earnCodes, placement, otPayRate, dtPayRate, placementRateCardStatus, isAdvancedState, billingTerm) {\\n                return new Promise(function (resolve) {\\n                    console.log(\\\"Newbury copy DS to placement: buildRateObjectBH1 params\\\", dealsheet);\\n                    var otBillRate, dtBillRate, regPay, regBillRate, onCallPayRate, onCallBillRate, chargePayRate, chargeBillRate, holidayPayRate, holidayBillRate, callBackPayRate, callBackBillRate, wkndRegPay, wkndRegBillRate, wkndOtPayRate, wkndOtBillRate, wkndDtPayRate, wkndDtBillRate, overtimeDailyBillRate, bonusPayRate, prepFeePayRate, holidayOTBillRate, holidayDTBillRate, callBackOtPayRate, callBackDtPayRate, holidayOtPayRate, holidayDtPayRate, chargeOtBillRate, chargeHolidayBillRate, totalStipend, totalStipendPerShift, totalLodgigPerShift, totalMiPerShift, housingDaily, miDaily;\\n                    var holidayMultiplier = billingTerm.hl_multiplier;\\n                    var holidayAddOn = billingTerm.hl_add_on;\\n                    var chargeAddOn = billingTerm.cp_add_on;\\n                    var chargeMultiplier = billingTerm.cp_multiplier;\\n                    onCallBillRate = Number(dealsheet.DealSheetJob.onCallBillRate) || 0;\\n                    chargeBillRate = Number(dealsheet.DealSheetJob.chargeBillRate) || 0;\\n                    holidayBillRate = Number(dealsheet.DealSheetJob.holidayBill) || 0;\\n                    callBackBillRate = Number(dealsheet.DealSheetJob.callBackBillRate) || 0;\\n                    onCallPayRate = Number(dealsheet.onCallPayRate) || 0;\\n                    chargePayRate = Number(dealsheet.chargePay) || 0;\\n                    holidayPayRate = Number(dealsheet.hourlyPayRate) || 0;\\n                    callBackPayRate = Number(dealsheet.callBackPayRate) || 0;\\n                    otBillRate = Number(dealsheet.DealSheetJob.otBillRate) || 0;\\n                    regPay = Number(dealsheet.regularPay) || 0;\\n                    regBillRate = Number(dealsheet.DealSheetJob.billRate) || 0;\\n                    totalStipend = Number(dealsheet.miWeekly) + Number(dealsheet.lodgingWeekly);\\n                    totalStipendPerShift = (totalStipend / dealsheet.DealSheetJob.shifts).toFixed(2);\\n                    totalLodgigPerShift = (Number(dealsheet.lodgingWeekly) / dealsheet.DealSheetJob.shifts).toFixed(2);\\n                    totalMiPerShift = (Number(dealsheet.miWeekly) / dealsheet.DealSheetJob.shifts).toFixed(2);\\n                    housingDaily = (Number(dealsheet.lodgingWeekly) / 7).toFixed(2) || 0;\\n                    miDaily = (Number(dealsheet.miWeekly) / 7).toFixed(2) || 0;\\n                    var dividedBy = 7;\\n                    if (dealsheet.DealSheetJob.jobState === \\\"California\\\") {\\n                        if (dealsheet.DealSheetClient.billableOT !== \\\"Over 8\\\") {\\n                            otBillRate = regBillRate;\\n                        }\\n                    }\\n                    else if (dealsheet.DealSheetClient.billableOT === \\\"Colorado\\\") {\\n                        if (dealsheet.DealSheetClient.billableOT !== \\\"Over 12\\\") {\\n                            otBillRate = regBillRate;\\n                        }\\n                    }\\n                    else if (dealsheet.DealSheetClient.billableOT === \\\"Alaska\\\") {\\n                        if (dealsheet.DealSheetClient.billableOT !== \\\"Over 8\\\") {\\n                            otBillRate = regBillRate;\\n                        }\\n                    }\\n                    dtBillRate = 0;\\n                    var chargeRateModifier = controller.getChargeModifier(chargeMultiplier, chargeAddOn);\\n                    chargeOtBillRate = controller.calculateRate(regBillRate, chargeRateModifier);\\n                    var holidayRateModifier = controller.getHolidayModifier(holidayMultiplier, holidayAddOn);\\n                    chargeHolidayBillRate = controller.calculateRate(regBillRate, holidayRateModifier);\\n                    var earnCodesObj = {};\\n                    dealsheet.DealSheetAdditionalCosts.forEach(function (item) {\\n                        if (item.label === \\\"Quick Start Bonus\\\")\\n                            bonusPayRate = Number(Number(item.totalCost).toFixed(2)) || controller.calculateAdditionalCostRate(dealsheet, item) || 0;\\n                        if (item.label === \\\"Prep Fee\\\")\\n                            prepFeePayRate = Number(Number(item.totalCost).toFixed(2)) || controller.calculateAdditionalCostRate(dealsheet, item) || 0;\\n                    });\\n                    earnCodesObj = controller.mapEarnCodeArrToObj(earnCodes);\\n                    var mappedEarnCodes = [\\\"REG\\\", \\\"OT\\\", \\\"DT\\\", \\\"GH\\\", \\\"FAC\\\", \\\"R2\\\", \\\"R3\\\", \\\"R4\\\", \\\"R5\\\", \\\"M2\\\", \\\"M3\\\", \\\"M4\\\", \\\"M5\\\", \\\"28\\\", \\\"30\\\", \\\"30O\\\", \\\"30D\\\", \\\"31\\\", \\\"10\\\", \\\"11\\\", \\\"12\\\", \\\"CH\\\", \\\"CHO\\\", \\\"CHD\\\", \\\"H\\\", \\\"HWO\\\", \\\"HDT\\\", \\\"TRV\\\", \\\"MPD\\